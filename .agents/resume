#!/usr/bin/env bash
# Restarts the backing services an orb loses while paused. Fast and idempotent.
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/../server"
export PATH="$HOME/.local/bin:$HOME/.local/share/mise/shims:$PATH"

# PostgreSQL is a systemd unit enabled by setup; only check it.
pg_isready -q -h localhost || sudo systemctl start postgresql@16-main

# ClickHouse runs detached from the repository's own launcher, which returns
# immediately when it is already up.
mise run --no-deps clickhouse:start
