#!/usr/bin/env bash
# Runs the dev server for the orb's `server` service. Setup migrates the dev
# database without seeding it, so the first start seeds it before the server
# boots; threads that never start the server skip the seed. Seeding next to a
# running dev server does not fit in a 4 GiB orb.
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/../server"

dev_db="$(mise exec -- printenv TUIST_SERVER_POSTGRES_DB)"
if ! psql -h localhost -d "$dev_db" -Atqc "SELECT EXISTS (SELECT 1 FROM users)" | grep -qx t; then
  echo "Seeding $dev_db before the first server start"
  mise run --no-deps db:seed
fi

exec mise exec -- mise/tasks/dev.sh
