#!/usr/bin/env bash
# Prepares an Amp orb (Debian 12) for working on this monorepo: the root and
# server mise toolchains, PostgreSQL 16, ClickHouse, and a bootstrapped,
# compiled server. Idempotent; warm runs only verify what is already there.
set -euo pipefail

# macOS Orbs serve CLI and app work and have their own setup.
if [[ "$(uname -s)" == Darwin ]]; then
  exec "$(dirname "${BASH_SOURCE[0]}")/setup-macos" "$@"
fi

# The stdout and stderr Amp gives setup can fail a write with EAGAIN when its
# reader falls behind a burst of output. awk, coreutils and Rust's println!
# abort on that; on fresh orbs it killed db:migrate's awk filter mid-migration.
# Relay both streams through Node, whose stream writes wait for the stream to
# drain, so every step below writes to an ordinary blocking pipe. Orb images
# ship Node; mise's toolchains are not installed yet at this point.
relay='process.stdin.pipe(process.stdout)'
exec 3>&1 4>&2
exec 1> >(node -e "$relay" >&3 3>&- 4>&-)
stdout_relay=$!
exec 2> >(node -e "$relay" >&4 3>&- 4>&-)
stderr_relay=$!
exec 3>&- 4>&-
# Exit only after the relays have passed on the last output, often the error.
trap 'exec >&- 2>&-; wait "$stdout_relay" "$stderr_relay"' EXIT

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

step() {
  printf '\n==> %s (%s)\n' "$1" "$(date +%T)"
}

# Keep durations next to their operation. The `time` output used to be emitted
# after a command's logs, so a slow setup's transcript did not reliably show
# which of the tool downloads, dependency installs, compiles, or migrations
# consumed the time.
timed() {
  local label="$1"
  local started status
  shift
  started=$SECONDS
  if "$@"; then
    status=0
  else
    status=$?
  fi
  printf '<== %s: %ss\n' "$label" "$((SECONDS - started))"
  return "$status"
}

# mise's own retries back off for only a few seconds, which a GitHub release
# outage (504s) outlasts. A failed setup publishes no snapshot, so retry with
# longer pauses; each rerun installs only what is still missing.
retry() {
  local attempt
  for attempt in 1 2 3; do
    "$@" && return 0
    ((attempt < 3)) || return 1
    echo "Attempt $attempt failed; retrying in $((attempt * 30))s" >&2
    sleep $((attempt * 30))
  done
}

# --- System packages -------------------------------------------------------
# Erlang builds from source (mise.lock has no Linux URL for core:erlang), so
# keep its build dependencies alongside PostgreSQL 16, which the server
# requires and Debian 12 does not ship.
apt_packages=(
  autoconf build-essential libssl-dev libncurses-dev unzip
  ffmpeg inotify-tools postgresql-16 postgresql-client-16
)
missing_packages=()
for package in "${apt_packages[@]}"; do
  dpkg-query -W -f='${Status}' "$package" 2>/dev/null | grep -q "install ok installed" ||
    missing_packages+=("$package")
done
if ((${#missing_packages[@]})); then
  step "Installing ${missing_packages[*]}"
  # Orb providers differ in base image (Debian 12, Ubuntu 24.04), so match the
  # PGDG suite to this distribution; a mismatched suite has unmet dependencies.
  pgdg_list="deb [signed-by=/usr/share/postgresql-common/pgdg/apt.postgresql.org.asc] https://apt.postgresql.org/pub/repos/apt $(. /etc/os-release && echo "$VERSION_CODENAME")-pgdg main"
  if [[ "$(cat /etc/apt/sources.list.d/pgdg.list 2>/dev/null)" != "$pgdg_list" ]]; then
    sudo install -d /usr/share/postgresql-common/pgdg
    sudo curl -fsSL -o /usr/share/postgresql-common/pgdg/apt.postgresql.org.asc \
      https://www.postgresql.org/media/keys/ACCC4CF8.asc
    echo "$pgdg_list" | sudo tee /etc/apt/sources.list.d/pgdg.list >/dev/null
  fi
  sudo apt-get update -q
  sudo DEBIAN_FRONTEND=noninteractive apt-get install -y -q "${missing_packages[@]}"
fi

# --- PostgreSQL 16 ---------------------------------------------------------
# Orbs are disposable: trade durability for speed and trust local
# connections. Dev connects as the OS user, tests as postgres/postgres.
# start.conf `manual` keeps systemd from booting the cluster in every orb;
# threads that need it start it on demand (see the orb guidance below).
step "Configuring PostgreSQL 16"
pg_conf=/etc/postgresql/16/main
sudo tee "$pg_conf/conf.d/amp-orb.conf" >/dev/null <<'EOF'
fsync = off
synchronous_commit = off
full_page_writes = off
max_connections = 300
EOF
sudo tee "$pg_conf/pg_hba.conf" >/dev/null <<'EOF'
local all all trust
host  all all 127.0.0.1/32 trust
host  all all ::1/128 trust
EOF
echo manual | sudo tee "$pg_conf/start.conf" >/dev/null
sudo chown postgres:postgres "$pg_conf/pg_hba.conf" "$pg_conf/conf.d/amp-orb.conf" "$pg_conf/start.conf"
# pg_ctlcluster goes through systemd when it runs and pg_ctl otherwise, since
# some orb providers boot without systemd.
sudo pg_ctlcluster 16 main restart
for _ in $(seq 1 30); do
  pg_isready -q -h localhost && break
  sleep 1
done
sudo -u postgres psql -qtAc "SELECT 1 FROM pg_roles WHERE rolname = '$(id -un)'" | grep -qx 1 ||
  sudo -u postgres createuser --superuser "$(id -un)"
sudo -u postgres psql -qc "ALTER USER postgres PASSWORD 'postgres'"

# --- mise and toolchains ---------------------------------------------------
# Keep in sync with .github/actions/mise/action.yml.
mise_version="2026.5.15"
mise_bin="$HOME/.local/bin/mise"
if [[ ! -x "$mise_bin" ]] || [[ "$("$mise_bin" --version 2>/dev/null)" != "$mise_version "* ]]; then
  step "Installing mise $mise_version"
  curl -fsSL https://mise.run | MISE_VERSION="v$mise_version" MISE_INSTALL_PATH="$mise_bin" sh
fi
export PATH="$HOME/.local/bin:$HOME/.local/share/mise/shims:$PATH"
export MISE_YES=1
# github: tools (ClickHouse, MinIO) verify attestations through api.github.com.
# Orbs share egress IPs, so anonymous requests hit the 60/hour limit and the
# install fails; authenticate with the orb's gh login when there is one.
if [[ -z "${GITHUB_TOKEN:-}${MISE_GITHUB_TOKEN:-}" ]] && token="$(gh auth token 2>/dev/null)"; then
  export MISE_GITHUB_TOKEN="$token"
fi

profile_marker="# tuist: mise toolchain"
if ! grep -Fqx "$profile_marker" "$HOME/.bash_profile" 2>/dev/null; then
  cat >>"$HOME/.bash_profile" <<'EOF'

# tuist: mise toolchain
case ":$PATH:" in
  *":$HOME/.local/share/mise/shims:"*) ;;
  *) export PATH="$HOME/.local/bin:$HOME/.local/share/mise/shims:$PATH" ;;
esac
EOF
fi

# mise records Linux checksums into these lockfiles while installing. Restore
# them afterwards so orbs start with a clean worktree, unless they already
# carried someone's edits.
clean_lockfiles=()
for lockfile in mise.lock server/mise.lock; do
  git diff --quiet -- "$lockfile" && clean_lockfiles+=("$lockfile")
done

mise trust --quiet "$repo_root/mise.toml"
mise trust --quiet "$repo_root/server/mise.toml"

# Pin this checkout's development instance so ports and database names are
# stable across orbs: server on 8180, databases tuist_development_100.
# Instance 1 would put the server on 8081, which the orb itself listens on.
# Overwrite rather than fill in: a mise invocation before this point persists a
# random instance (seen on a self-hosted orb), which would otherwise win.
printf '100' >"$(git rev-parse --path-format=absolute --git-path tuist-dev-instance)"

step "Installing root tools"
timed "Installing root tools" retry mise install --quiet

# The postinstall hook bootstraps databases before ClickHouse runs; its CI
# guard skips it here and the bootstrap runs explicitly below.
step "Installing server tools"
(cd server && CI=1 timed "Installing server tools" retry mise install --quiet)
mise reshim

step "Installing root Node dependencies"
# npm ci deletes node_modules, so skip it when the installed tree matches.
if ! npm ls >/dev/null 2>&1; then
  timed "Installing root Node dependencies" npm ci --ignore-scripts --no-audit --no-fund
fi

# --- Server ----------------------------------------------------------------
cd "$repo_root/server"

# Setup has no user/thread identity. Keep the project token only in this
# process and its children, never in credentials saved into the snapshot.
# Leave an explicitly supplied workload identity alone. A cold setup can take
# longer than the default ten-minute token lifetime.
if [[ -z "${TUIST_OIDC_TOKEN:-}" ]]; then
  step "Minting the project setup identity"
  TUIST_OIDC_TOKEN="$(amp orb id-token --audience https://tuist.dev --subject-scope project --ttl-seconds 3600)"
  export TUIST_OIDC_TOKEN
fi

step "Starting ClickHouse"
mise run --no-deps clickhouse:start

# deps.get, aube installs, Noora build, dev compile, and database
# create/migrate; on a stale snapshot only what changed.
step "Bootstrapping server dependencies and databases"
timed "Bootstrapping server dependencies and databases" mise run --no-deps install --no-seed

# Seed here so the snapshot carries the data to every thread. A stale
# snapshot is seeded already, and the seeds are not idempotent.
dev_db="$(mise exec -- printenv TUIST_SERVER_POSTGRES_DB)"
if ! psql -h localhost -d "$dev_db" -Atqc "SELECT EXISTS (SELECT 1 FROM users)" | grep -qx t; then
  step "Seeding $dev_db"
  timed "Seeding $dev_db" mise run --no-deps db:seed
fi

# What the test alias does before running tests, so a thread's first
# `mix test` starts testing right away. Enter through the compile alias before
# database-task discovery can compile dependencies without the cache wrapper.
step "Compiling the server test build"
timed "Compiling the server test build" env MIX_ENV=test mise exec -- mix compile

step "Creating and migrating the server test databases"
timed "Creating and migrating the server test databases" env MIX_ENV=test mise exec -- mix "do" ecto.create --quiet + run priv/repo/timezone.exs + ecto.migrate --quiet

# Stop the databases cleanly so their data directories are consistent in
# the snapshot. Nothing restarts them on resume: most threads never touch the
# server, so the server service and the orb guidance start them on demand.
step "Stopping ClickHouse and PostgreSQL"
mise run --no-deps clickhouse:stop
sudo pg_ctlcluster 16 main stop

cd "$repo_root"
((${#clean_lockfiles[@]} == 0)) || git checkout -- "${clean_lockfiles[@]}"

step "Writing orb kubeconfig"
# Contexts for the kube-orb-<env> gateways. The file holds no credential:
# kubectl runs infra/k8s/orb-kube-credential, which mints a short-lived Amp
# workload identity token per call, so a project snapshot carries nothing.
mkdir -p "$HOME/.kube"
credential="$repo_root/infra/k8s/orb-kube-credential"
{
  printf 'apiVersion: v1\nkind: Config\ncurrent-context: tuist-k8s-staging\nclusters:\n'
  for pair in staging:staging canary:canary production:prod; do
    printf '  - name: tuist-k8s-%s\n    cluster: { server: "https://kube-orb-%s.tuist.dev" }\n' "${pair%%:*}" "${pair##*:}"
  done
  printf 'contexts:\n'
  for env in staging canary production; do
    printf '  - name: tuist-k8s-%s\n    context: { cluster: tuist-k8s-%s, user: amp-orb-%s }\n' "$env" "$env" "$env"
  done
  printf 'users:\n'
  for pair in staging:staging canary:canary production:prod; do
    printf '  - name: amp-orb-%s\n    user:\n      exec:\n        apiVersion: client.authentication.k8s.io/v1\n        command: "%s"\n        args: ["https://kube-orb-%s.tuist.dev"]\n        interactiveMode: Never\n' \
      "${pair%%:*}" "$credential" "${pair##*:}"
  done
} >"$HOME/.kube/config"
chmod 600 "$HOME/.kube/config"

step "Writing orb agent guidance"
guidance="$HOME/.config/amp/AGENTS.md"
guidance_marker="# Tuist orb environment"
mkdir -p "$(dirname "$guidance")"
# Replace the section rather than keep it: a rerun on a stale snapshot would
# otherwise carry an older setup's guidance forward.
other_guidance=""
[[ -f "$guidance" ]] && other_guidance="$(sed "/^$guidance_marker\$/,\$d" "$guidance")"
{
  [[ -z "$other_guidance" ]] || printf '%s\n\n' "$other_guidance"
  cat <<'EOF'
# Tuist orb environment

- `.agents/setup` installed the root and `server/` mise toolchains (shims on PATH),
  PostgreSQL 16 (pg_ctlcluster, trust auth), compiled the server's dev and test builds, created and
  migrated its databases, and seeded the dev database.
- PostgreSQL and ClickHouse are stopped when a thread starts. Before `mix test` or other
  database work, run from `server/`:
  `(pg_isready -q -h localhost || sudo pg_ctlcluster 16 main start) && mise run --no-deps clickhouse:start`.
  The `server` service starts both itself.
- This checkout's dev instance is 100: server on port 8180, databases `tuist_development_100`.
- Start the server with `amp orb services ensure` (service `server`).
  Seed login: `tuistrocks@tuist.dev` / `tuistrocks`.
- macOS-only work (Xcode, `tuist generate`, Swift app targets) is not possible in this orb.
- `kubectl --context tuist-k8s-<staging|canary|production>` reaches the clusters through
  `kube-orb-<env>.tuist.dev` with this thread's Amp identity: read access everywhere and
  staging writes. For a canary/production write, call the Atlas MCP tool
  `request_cluster_elevation` (`thread_id` = `$AMP_CURRENT_THREAD_ID`): it returns a link
  the human approves in Atlas, then the identical call grants this thread the access.
  Never approve it yourself, and never run `infra/k8s/orb-kube-credential`
  directly (its output is a bearer token). Follow infra/AGENTS.md "Cluster access for agents".
- OVH reads (datacenter, range, state, install tasks, displayName, orders) go through
  the Atlas MCP tools `ovh-servers__*`, `ovh-services__*` and `ovh-orders__*`, which run
  as your own OVH login. To prep a box, use `ovh-servers__reinstall-dedicated-server`
  as infra/AGENTS.md "From an Amp orb" describes, not `baremetal:prep-ovh`: each call
  needs the person to approve it at the link it returns. Then rename it into the fleet
  with `ovh_set_server_display_name`, which needs approval the same way. Never approve
  either yourself, never ask for or use the fleet's `OVH_API`
  token, and never use 1Password from an orb.
- Vultr reads (bare metal state, region, plan, tags) go through the Atlas MCP tools
  `vultr-compute__*`, which run as your own Vultr login and cannot write. Tagging a box
  into a fleet stays a human step in the Vultr console; never ask for or use the
  fleet's `VULTR_API` key.
EOF
} >"$guidance.tmp"
mv "$guidance.tmp" "$guidance"

step "Setup finished"
