                      "kind": "DataQuery",
                      "spec": {
                        "expr": "label_replace(8 * max by (tenant_id, region, pod) ((1 - max by (cluster, pod) (kura_ready_state{cluster=~\"tuist-$env\"})) * on (cluster, pod) group_left(tenant_id, region) max by (cluster, pod, tenant_id, region) (kura_node_info{cluster=~\"tuist-$env\", region=~\"$region\"})) + 4 * max by (tenant_id, region, pod) ((max by (cluster, pod) (kura_backfill_initial_cycle_mode{cluster=~\"tuist-$env\"}) == bool 2) * on (cluster, pod) group_left(tenant_id, region) max by (cluster, pod, tenant_id, region) (kura_node_info{cluster=~\"tuist-$env\", region=~\"$region\"})) + 2 * (sum by (tenant_id, region, pod) (sum by (cluster, pod) (rate(kura_peer_connection_failures_total_total{cluster=~\"tuist-$env\"}[$__range])) * on (cluster, pod) group_left(tenant_id, region) max by (cluster, pod, tenant_id, region) (kura_node_info{cluster=~\"tuist-$env\", region=~\"$region\"})) \u003e bool 0) + 1 * max by (tenant_id, region, pod) ((max by (cluster, pod) (kura_memory_pressure_state{cluster=~\"tuist-$env\"}) == bool 2) * on (cluster, pod) group_left(tenant_id, region) max by (cluster, pod, tenant_id, region) (kura_node_info{cluster=~\"tuist-$env\", region=~\"$region\"})), \"replica\", \"$1\", \"pod\", \"^kura-.+?-((?:[a-z]{2}-[a-z]+(?:-[0-9]+)?|scw-fr-par)-[0-9]+)$\")",
                        "format": "table",
