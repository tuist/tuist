                      "spec": {
                        "expr": "(((sum by (tenant_id, region, pod) (sum by (cluster, pod) (rate(kura_artifact_reads_total_total{cluster=~\"tuist-$env\", result=\"ok\"}[$__range])) * on (cluster, pod) group_left(tenant_id, region) max by (cluster, pod, tenant_id, region) (kura_node_info{cluster=~\"tuist-$env\", region=~\"$region\"})) / sum by (tenant_id, region, pod) (sum by (cluster, pod) (rate(kura_artifact_reads_total_total{cluster=~\"tuist-$env\", result=~\"ok|not_found\"}[$__range])) * on (cluster, pod) group_left(tenant_id, region) max by (cluster, pod, tenant_id, region) (kura_node_info{cluster=~\"tuist-$env\", region=~\"$region\"}))) - (sum by (tenant_id, region, pod) (sum by (cluster, pod) (rate(kura_artifact_reads_total_total{cluster=~\"tuist-$env\", result=\"ok\"}[7d])) * on (cluster, pod) group_left(tenant_id, region) max by (cluster, pod, tenant_id, region) (kura_node_info{cluster=~\"tuist-$env\", region=~\"$region\"})) / sum by (tenant_id, region, pod) (sum by (cluster, pod) (rate(kura_artifact_reads_total_total{cluster=~\"tuist-$env\", result=~\"ok|not_found\"}[7d])) * on (cluster, pod) group_left(tenant_id, region) max by (cluster, pod, tenant_id, region) (kura_node_info{cluster=~\"tuist-$env\", region=~\"$region\"})))) and sum by (tenant_id, region, pod) (sum by (cluster, pod) (rate(kura_artifact_reads_total_total{cluster=~\"tuist-$env\", result=~\"ok|not_found\"}[$__range])) * on (cluster, pod) group_left(tenant_id, region) max by (cluster, pod, tenant_id, region) (kura_node_info{cluster=~\"tuist-$env\", region=~\"$region\"})) \u003e 0.5) or max by (tenant_id, region, pod) (kura_node_info{cluster=~\"tuist-$env\", region=~\"$region\"}) * NaN",
