                      "kind": "DataQuery",
                      "spec": {
                        "expr": "(sum by (tenant_id, region, pod) (sum by (cluster, pod) (rate(kura_http_requests_total_total{cluster=~\"tuist-$env\", route!~\"/_internal/.*|/up|/ready|/status/rollout|/metrics|/_unmatched\"}[$__range])) * on (cluster, pod) group_left(tenant_id, region) max by (cluster, pod, tenant_id, region) (kura_node_info{cluster=~\"tuist-$env\", region=~\"$region\"})) + (sum by (tenant_id, region, pod) (sum by (cluster, pod) (rate(kura_artifact_reads_total_total{cluster=~\"tuist-$env\", producer=\"reapi\"}[$__range])) * on (cluster, pod) group_left(tenant_id, region) max by (cluster, pod, tenant_id, region) (kura_node_info{cluster=~\"tuist-$env\", region=~\"$region\"})) or 0 * sum by (tenant_id, region, pod) (sum by (cluster, pod) (rate(kura_http_requests_total_total{cluster=~\"tuist-$env\", route!~\"/_internal/.*|/up|/ready|/status/rollout|/metrics|/_unmatched\"}[$__range])) * on (cluster, pod) group_left(tenant_id, region) max by (cluster, pod, tenant_id, region) (kura_node_info{cluster=~\"tuist-$env\", region=~\"$region\"})))) or max by (tenant_id, region, pod) (kura_node_info{cluster=~\"tuist-$env\", region=~\"$region\"}) * 0",
