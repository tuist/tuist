                      "spec": {
                        "expr": "(sum by (tenant_id, region, pod) (sum by (cluster, pod) (increase(kube_pod_container_status_restarts_total{cluster=~\"tuist-$env\", namespace=\"kura\", container=\"kura\"}[6h])) * on (cluster, pod) group_left(tenant_id, region) max by (cluster, pod, tenant_id, region) (kura_node_info{cluster=~\"tuist-$env\", region=~\"$region\"}))) or max by (tenant_id, region, pod) (kura_node_info{cluster=~\"tuist-$env\", region=~\"$region\"}) * 0",
