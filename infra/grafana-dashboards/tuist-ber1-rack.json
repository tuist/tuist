        },
        "targets": [
          {
            "datasource": "$datasource",
            "editorMode": "code",
            "expr": "max by (instance) (macos_thermal_pressure_level{rack_host=\"true\"})",
            "legendFormat": "{{instance}}",
            "refId": "A",
            "range": true,
            "instant": false
          }
        ]
      },
      {
        "id": 11,
        "type": "timeseries",
        "title": "Fan speed",
        "description": "",
        "datasource": "$datasource",
        "gridPos": {
          "x": 0,
          "y": 44,
          "w": 12,
          "h": 8
        },
        "fieldConfig": {
          "defaults": {
            "unit": "rotrpm",
            "custom": {
              "lineWidth": 1,
              "fillOpacity": 10,
              "showPoints": "never"
            }
          },
          "overrides": []
        },
        "options": {
          "legend": {
            "displayMode": "list",
