        },
        "targets": [
          {
            "datasource": "$datasource",
            "editorMode": "code",
            "expr": "max by (ats) (capt_rackats_redundant{cluster=\"tuist-production\"})",
            "legendFormat": "{{ats}}",
            "refId": "A",
            "range": false,
            "instant": true
          }
        ]
      },
      {
        "id": 14,
        "type": "stat",
        "title": "Switches connected",
        "description": "",
        "datasource": "$datasource",
        "gridPos": {
          "x": 8,
          "y": 53,
          "w": 8,
          "h": 4
        },
        "fieldConfig": {
          "defaults": {
            "unit": "none",
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "red",
                  "value": null
                },
