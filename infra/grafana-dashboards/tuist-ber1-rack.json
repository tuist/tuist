        "targets": [
          {
            "datasource": "$datasource",
            "editorMode": "code",
            "expr": "max by (instance) (macos_fan_speed_rpm{rack_host=\"true\"})",
            "legendFormat": "{{instance}}",
            "refId": "A",
            "range": true,
            "instant": false
          }
        ]
      },
      {
        "id": 12,
        "type": "timeseries",
        "title": "Outlet power by host",
        "description": "",
        "datasource": "$datasource",
        "gridPos": {
          "x": 12,
          "y": 44,
          "w": 12,
          "h": 8
        },
        "fieldConfig": {
          "defaults": {
            "unit": "watt",
            "custom": {
              "lineWidth": 1,
              "fillOpacity": 10,
              "showPoints": "never"
            }
          },
          "overrides": []
        },
        "options": {
          "legend": {
            "displayMode": "list",
            "placement": "bottom"
          },
          "tooltip": {
            "mode": "multi",
            "sort": "desc"
          }
        },
        "targets": [
          {
            "datasource": "$datasource",
            "editorMode": "code",
            "expr": "sum by (host) (capt_rackhost_outlet_active_power_watts{cluster=\"tuist-production\"})",
            "legendFormat": "{{host}}",
            "refId": "A",
            "range": true,
            "instant": false
          }
        ]
      },
      {
        "id": 103,
        "type": "row",
        "title": "Power and switches",
        "collapsed": false,
        "panels": [],
        "gridPos": {
          "x": 0,
          "y": 52,
          "w": 24,
          "h": 1
        }
      },
      {
        "id": 13,
        "type": "stat",
        "title": "Transfer switch redundancy",
        "description": "",
        "datasource": "$datasource",
        "gridPos": {
          "x": 0,
          "y": 53,
          "w": 8,
          "h": 4
        },
        "fieldConfig": {
          "defaults": {
            "unit": "none",
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "red",
