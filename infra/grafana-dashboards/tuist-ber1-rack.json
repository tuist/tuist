            "values": false
          }
        },
        "targets": [
          {
            "datasource": "$datasource",
            "editorMode": "code",
            "expr": "max by (switch) (rack_switch_up{cluster=\"tuist-production\"})",
            "legendFormat": "{{switch}}",
            "refId": "A",
            "range": false,
            "instant": true
          }
        ]
      },
      {
        "id": 15,
        "type": "stat",
        "title": "Remote power reachable",
        "description": "",
        "datasource": "$datasource",
        "gridPos": {
          "x": 16,
          "y": 53,
          "w": 8,
          "h": 4
        },
        "fieldConfig": {
          "defaults": {
            "unit": "none",
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "blue",
                  "value": null
