{
  "apiVersion": "dashboard.grafana.app/v1",
  "kind": "Dashboard",
  "metadata": {
    "name": "tuist-processor-service"
  },
  "spec": {
    "annotations": {
      "list": [
        {
          "builtIn": 1,
          "datasource": {
            "type": "grafana",
            "uid": "-- Grafana --"
          },
          "enable": true,
          "hide": true,
          "iconColor": "rgba(0, 211, 255, 1)",
          "name": "Annotations & Alerts",
          "type": "dashboard"
        }
      ]
    },
    "editable": true,
    "fiscalYearStartMonth": 0,
    "graphTooltip": 1,
    "id": null,
    "links": [
      {
        "title": "Test-result processing",
        "type": "link",
        "url": "/d/tuist-xcresult-processor",
        "keepTime": true
      },
      {
        "title": "PostgreSQL server and pooler",
        "type": "link",
        "url": "/d/tuist-postgresql-cnpg",
        "keepTime": true
      }
    ],
    "panels": [
      {
        "id": 1,
        "title": "Waiting for a database connection",
        "description": "Operations waiting inside application pools, summed by workload. Gauge snapshots can miss short bursts; compare with the starvation percentage.",
        "type": "timeseries",
        "datasource": {
          "type": "prometheus",
          "uid": "$datasource"
        },
        "gridPos": {
          "x": 0,
          "y": 0,
          "w": 12,
          "h": 8
        },
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "min": 0,
            "color": {
              "mode": "palette-classic"
            }
          },
          "overrides": []
        },
        "options": {
          "legend": {
            "displayMode": "list",
            "placement": "bottom"
          },
          "tooltip": {
            "mode": "multi"
          }
        },
        "targets": [
          {
            "refId": "A",
            "expr": "sum by (workload, repo) (tuist_repo_pool_checkout_queue_length{cluster=\"$cluster\",workload=~\"$workload\",repo=~\"$repo\"})",
            "legendFormat": "{{workload}} / {{repo}}",
            "range": true,
            "editorMode": "code",
            "datasource": {
              "type": "prometheus",
              "uid": "$datasource"
            }
          }
        ]
      },
      {
        "id": 2,
        "title": "Available and configured connections",
        "description": "Available connections versus total configured connections across the selected workload. A healthy replica can hide a saturated peer in this aggregate.",
        "type": "timeseries",
        "datasource": {
          "type": "prometheus",
          "uid": "$datasource"
        },
        "gridPos": {
          "x": 12,
          "y": 0,
          "w": 12,
          "h": 8
        },
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "min": 0,
            "color": {
              "mode": "palette-classic"
            }
          },
          "overrides": []
        },
        "options": {
          "legend": {
            "displayMode": "list",
            "placement": "bottom"
          },
          "tooltip": {
            "mode": "multi"
          }
        },
        "targets": [
          {
            "refId": "A",
            "expr": "sum by (workload, repo) (tuist_repo_pool_ready_conn_count{cluster=\"$cluster\",workload=~\"$workload\",repo=~\"$repo\"})",
            "legendFormat": "{{workload}} / {{repo}} available",
            "range": true,
            "editorMode": "code",
            "datasource": {
              "type": "prometheus",
              "uid": "$datasource"
            }
          },
          {
            "refId": "B",
            "expr": "sum by (workload, repo) (tuist_repo_pool_size{cluster=\"$cluster\",workload=~\"$workload\",repo=~\"$repo\"})",
            "legendFormat": "{{workload}} / {{repo}} configured",
            "range": true,
            "editorMode": "code",
            "datasource": {
              "type": "prometheus",
              "uid": "$datasource"
            }
          }
        ]
      },
      {
        "id": 3,
        "title": "Pool starvation",
        "description": "Percentage of 100-millisecond pool polls with queued work and no available connection. Preserves brief pressure between scrapes.",
        "type": "timeseries",
        "datasource": {
          "type": "prometheus",
          "uid": "$datasource"
        },
        "gridPos": {
          "x": 0,
          "y": 8,
          "w": 12,
          "h": 8
        },
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "min": 0,
            "color": {
              "mode": "palette-classic"
            }
          },
          "overrides": []
        },
        "options": {
          "legend": {
            "displayMode": "list",
            "placement": "bottom"
          },
          "tooltip": {
            "mode": "multi"
          }
        },
        "targets": [
          {
            "refId": "A",
            "expr": "100 * sum by (workload, repo) (rate(tuist_repo_pool_checkout_queue_starved_samples{cluster=\"$cluster\",workload=~\"$workload\",repo=~\"$repo\"}[$__rate_interval])) / sum by (workload, repo) (rate(tuist_repo_pool_checkout_queue_total_samples{cluster=\"$cluster\",workload=~\"$workload\",repo=~\"$repo\"}[$__rate_interval]))",
            "legendFormat": "{{workload}} / {{repo}}",
            "range": true,
            "editorMode": "code",
            "datasource": {
              "type": "prometheus",
              "uid": "$datasource"
            }
          }
        ]
      },
      {
        "id": 4,
        "title": "Average queued operations",
        "description": "Mean queue depth across all pool polls, including short bursts that the instantaneous queue chart can miss.",
        "type": "timeseries",
        "datasource": {
          "type": "prometheus",
          "uid": "$datasource"
        },
        "gridPos": {
          "x": 12,
          "y": 8,
          "w": 12,
          "h": 8
        },
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "min": 0,
            "color": {
              "mode": "palette-classic"
            }
          },
          "overrides": []
        },
        "options": {
          "legend": {
            "displayMode": "list",
            "placement": "bottom"
          },
          "tooltip": {
            "mode": "multi"
          }
        },
        "targets": [
          {
            "refId": "A",
            "expr": "sum by (workload, repo) (rate(tuist_repo_pool_checkout_queue_observed{cluster=\"$cluster\",workload=~\"$workload\",repo=~\"$repo\"}[$__rate_interval])) / sum by (workload, repo) (rate(tuist_repo_pool_checkout_queue_total_samples{cluster=\"$cluster\",workload=~\"$workload\",repo=~\"$repo\"}[$__rate_interval]))",
            "legendFormat": "{{workload}} / {{repo}}",
            "range": true,
            "editorMode": "code",
            "datasource": {
              "type": "prometheus",
              "uid": "$datasource"
            }
          }
        ]
      },
      {
        "id": 5,
        "title": "Query attempts per second",
        "description": "All attempts by outcome, including rejected checkouts that never reached the database. No statement text or customer identifiers are attached.",
        "type": "timeseries",
        "datasource": {
          "type": "prometheus",
          "uid": "$datasource"
        },
        "gridPos": {
          "x": 0,
          "y": 16,
          "w": 12,
          "h": 8
        },
        "fieldConfig": {
          "defaults": {
            "unit": "ops",
            "min": 0,
            "color": {
              "mode": "palette-classic"
            }
          },
          "overrides": []
        },
        "options": {
          "legend": {
            "displayMode": "list",
            "placement": "bottom"
          },
          "tooltip": {
            "mode": "multi"
          }
        },
        "targets": [
          {
            "refId": "A",
            "expr": "sum by (workload, repo, result) (rate(tuist_repo_query_count{cluster=\"$cluster\",workload=~\"$workload\",repo=~\"$repo\"}[$__rate_interval]))",
            "legendFormat": "{{workload}} / {{repo}} / {{result}}",
            "range": true,
            "editorMode": "code",
            "datasource": {
              "type": "prometheus",
              "uid": "$datasource"
            }
          }
        ]
      },
      {
        "id": 6,
        "title": "Query failures per second",
        "description": "Queue timeouts, connection failures, and other database errors. No data means no matching error series; it is not proof of telemetry health.",
        "type": "timeseries",
        "datasource": {
          "type": "prometheus",
          "uid": "$datasource"
        },
        "gridPos": {
          "x": 12,
          "y": 16,
          "w": 12,
          "h": 8
        },
        "fieldConfig": {
          "defaults": {
            "unit": "ops",
            "min": 0,
            "color": {
              "mode": "palette-classic"
            }
          },
          "overrides": []
        },
        "options": {
          "legend": {
            "displayMode": "list",
            "placement": "bottom"
          },
          "tooltip": {
            "mode": "multi"
          }
        },
        "targets": [
          {
            "refId": "A",
            "expr": "sum by (workload, repo, result) (rate(tuist_repo_query_count{cluster=\"$cluster\",workload=~\"$workload\",repo=~\"$repo\",result!=\"ok\"}[$__rate_interval]))",
            "legendFormat": "{{workload}} / {{repo}} / {{result}}",
            "range": true,
            "editorMode": "code",
            "datasource": {
              "type": "prometheus",
              "uid": "$datasource"
            }
          }
        ]
      },
      {
        "id": 7,
        "title": "Connection wait average",
        "description": "Time waiting for an application connection, before execution. Successful queries only; missing phases are omitted, not recorded as zero.",
        "type": "timeseries",
        "datasource": {
          "type": "prometheus",
          "uid": "$datasource"
        },
        "gridPos": {
          "x": 0,
          "y": 24,
          "w": 12,
          "h": 8
        },
        "fieldConfig": {
          "defaults": {
            "unit": "ms",
            "min": 0,
            "color": {
              "mode": "palette-classic"
            }
          },
          "overrides": []
        },
        "options": {
          "legend": {
            "displayMode": "list",
            "placement": "bottom"
          },
          "tooltip": {
            "mode": "multi"
          }
        },
        "targets": [
          {
            "refId": "A",
            "expr": "sum by (workload, repo) (rate(tuist_repo_query_queue_time_milliseconds_sum{cluster=\"$cluster\",workload=~\"$workload\",repo=~\"$repo\",result=\"ok\"}[$__rate_interval])) / sum by (workload, repo) (rate(tuist_repo_query_queue_time_milliseconds_count{cluster=\"$cluster\",workload=~\"$workload\",repo=~\"$repo\",result=\"ok\"}[$__rate_interval]))",
            "legendFormat": "{{workload}} / {{repo}}",
            "range": true,
            "editorMode": "code",
            "datasource": {
              "type": "prometheus",
              "uid": "$datasource"
            }
          }
        ]
      },
      {
        "id": 8,
        "title": "Connection wait percentiles",
        "description": "Time waiting for an application connection, before execution. Successful queries only. Histogram buckets are retained only in production.",
        "type": "timeseries",
        "datasource": {
          "type": "prometheus",
          "uid": "$datasource"
        },
        "gridPos": {
          "x": 12,
          "y": 24,
          "w": 12,
          "h": 8
        },
        "fieldConfig": {
          "defaults": {
            "unit": "ms",
            "min": 0,
            "color": {
              "mode": "palette-classic"
            }
          },
          "overrides": []
        },
        "options": {
          "legend": {
            "displayMode": "list",
            "placement": "bottom"
          },
          "tooltip": {
            "mode": "multi"
          }
        },
        "targets": [
          {
            "refId": "A",
            "expr": "histogram_quantile(0.5, sum by (workload, repo, le) (rate(tuist_repo_query_queue_time_milliseconds_bucket{cluster=\"$cluster\",workload=~\"$workload\",repo=~\"$repo\",result=\"ok\"}[$__rate_interval])))",
            "legendFormat": "{{workload}} / {{repo}} / 50th percentile",
            "range": true,
            "editorMode": "code",
            "datasource": {
              "type": "prometheus",
              "uid": "$datasource"
            }
          },
          {
            "refId": "B",
            "expr": "histogram_quantile(0.95, sum by (workload, repo, le) (rate(tuist_repo_query_queue_time_milliseconds_bucket{cluster=\"$cluster\",workload=~\"$workload\",repo=~\"$repo\",result=\"ok\"}[$__rate_interval])))",
            "legendFormat": "{{workload}} / {{repo}} / 95th percentile",
            "range": true,
            "editorMode": "code",
            "datasource": {
              "type": "prometheus",
              "uid": "$datasource"
            }
          },
          {
            "refId": "C",
            "expr": "histogram_quantile(0.99, sum by (workload, repo, le) (rate(tuist_repo_query_queue_time_milliseconds_bucket{cluster=\"$cluster\",workload=~\"$workload\",repo=~\"$repo\",result=\"ok\"}[$__rate_interval])))",
            "legendFormat": "{{workload}} / {{repo}} / 99th percentile",
            "range": true,
            "editorMode": "code",
            "datasource": {
              "type": "prometheus",
              "uid": "$datasource"
            }
          }
        ]
      },
      {
        "id": 9,
        "title": "Query execution average",
        "description": "Time executing the query, including the network round trip. This is not isolated database-engine execution time. Successful queries only; missing phases are omitted, not recorded as zero.",
        "type": "timeseries",
        "datasource": {
          "type": "prometheus",
          "uid": "$datasource"
        },
        "gridPos": {
          "x": 0,
          "y": 32,
          "w": 12,
          "h": 8
        },
        "fieldConfig": {
          "defaults": {
            "unit": "ms",
            "min": 0,
            "color": {
              "mode": "palette-classic"
            }
          },
          "overrides": []
        },
        "options": {
          "legend": {
            "displayMode": "list",
            "placement": "bottom"
          },
          "tooltip": {
            "mode": "multi"
          }
        },
        "targets": [
          {
            "refId": "A",
            "expr": "sum by (workload, repo) (rate(tuist_repo_query_query_time_milliseconds_sum{cluster=\"$cluster\",workload=~\"$workload\",repo=~\"$repo\",result=\"ok\"}[$__rate_interval])) / sum by (workload, repo) (rate(tuist_repo_query_query_time_milliseconds_count{cluster=\"$cluster\",workload=~\"$workload\",repo=~\"$repo\",result=\"ok\"}[$__rate_interval]))",
            "legendFormat": "{{workload}} / {{repo}}",
            "range": true,
            "editorMode": "code",
            "datasource": {
              "type": "prometheus",
              "uid": "$datasource"
            }
          }
        ]
      },
      {
        "id": 10,
        "title": "Query execution percentiles",
        "description": "Time executing the query, including the network round trip. This is not isolated database-engine execution time. Successful queries only. Histogram buckets are retained only in production.",
        "type": "timeseries",
        "datasource": {
          "type": "prometheus",
          "uid": "$datasource"
        },
        "gridPos": {
          "x": 12,
          "y": 32,
          "w": 12,
          "h": 8
        },
        "fieldConfig": {
          "defaults": {
            "unit": "ms",
            "min": 0,
            "color": {
              "mode": "palette-classic"
            }
          },
          "overrides": []
        },
        "options": {
          "legend": {
            "displayMode": "list",
            "placement": "bottom"
          },
          "tooltip": {
            "mode": "multi"
          }
        },
        "targets": [
          {
            "refId": "A",
            "expr": "histogram_quantile(0.5, sum by (workload, repo, le) (rate(tuist_repo_query_query_time_milliseconds_bucket{cluster=\"$cluster\",workload=~\"$workload\",repo=~\"$repo\",result=\"ok\"}[$__rate_interval])))",
            "legendFormat": "{{workload}} / {{repo}} / 50th percentile",
            "range": true,
            "editorMode": "code",
            "datasource": {
              "type": "prometheus",
              "uid": "$datasource"
            }
          },
          {
            "refId": "B",
            "expr": "histogram_quantile(0.95, sum by (workload, repo, le) (rate(tuist_repo_query_query_time_milliseconds_bucket{cluster=\"$cluster\",workload=~\"$workload\",repo=~\"$repo\",result=\"ok\"}[$__rate_interval])))",
            "legendFormat": "{{workload}} / {{repo}} / 95th percentile",
            "range": true,
            "editorMode": "code",
            "datasource": {
              "type": "prometheus",
              "uid": "$datasource"
            }
          },
          {
            "refId": "C",
            "expr": "histogram_quantile(0.99, sum by (workload, repo, le) (rate(tuist_repo_query_query_time_milliseconds_bucket{cluster=\"$cluster\",workload=~\"$workload\",repo=~\"$repo\",result=\"ok\"}[$__rate_interval])))",
            "legendFormat": "{{workload}} / {{repo}} / 99th percentile",
            "range": true,
            "editorMode": "code",
            "datasource": {
              "type": "prometheus",
              "uid": "$datasource"
            }
          }
        ]
      },
      {
        "id": 11,
        "title": "Result decoding average",
        "description": "Time spent decoding returned data. Successful queries only; missing phases are omitted, not recorded as zero.",
        "type": "timeseries",
        "datasource": {
          "type": "prometheus",
          "uid": "$datasource"
        },
        "gridPos": {
          "x": 0,
          "y": 40,
          "w": 12,
          "h": 8
        },
        "fieldConfig": {
          "defaults": {
            "unit": "ms",
            "min": 0,
            "color": {
              "mode": "palette-classic"
            }
          },
          "overrides": []
        },
        "options": {
          "legend": {
            "displayMode": "list",
            "placement": "bottom"
          },
          "tooltip": {
            "mode": "multi"
          }
        },
        "targets": [
          {
            "refId": "A",
            "expr": "sum by (workload, repo) (rate(tuist_repo_query_decode_time_milliseconds_sum{cluster=\"$cluster\",workload=~\"$workload\",repo=~\"$repo\",result=\"ok\"}[$__rate_interval])) / sum by (workload, repo) (rate(tuist_repo_query_decode_time_milliseconds_count{cluster=\"$cluster\",workload=~\"$workload\",repo=~\"$repo\",result=\"ok\"}[$__rate_interval]))",
            "legendFormat": "{{workload}} / {{repo}}",
            "range": true,
            "editorMode": "code",
            "datasource": {
              "type": "prometheus",
              "uid": "$datasource"
            }
          }
        ]
      },
      {
        "id": 12,
        "title": "Result decoding percentiles",
        "description": "Time spent decoding returned data. Successful queries only. Histogram buckets are retained only in production.",
        "type": "timeseries",
        "datasource": {
          "type": "prometheus",
          "uid": "$datasource"
        },
        "gridPos": {
          "x": 12,
          "y": 40,
          "w": 12,
          "h": 8
        },
        "fieldConfig": {
          "defaults": {
            "unit": "ms",
            "min": 0,
            "color": {
              "mode": "palette-classic"
            }
          },
          "overrides": []
        },
        "options": {
          "legend": {
            "displayMode": "list",
            "placement": "bottom"
          },
          "tooltip": {
            "mode": "multi"
          }
        },
        "targets": [
          {
            "refId": "A",
            "expr": "histogram_quantile(0.5, sum by (workload, repo, le) (rate(tuist_repo_query_decode_time_milliseconds_bucket{cluster=\"$cluster\",workload=~\"$workload\",repo=~\"$repo\",result=\"ok\"}[$__rate_interval])))",
            "legendFormat": "{{workload}} / {{repo}} / 50th percentile",
            "range": true,
            "editorMode": "code",
            "datasource": {
              "type": "prometheus",
              "uid": "$datasource"
            }
          },
          {
            "refId": "B",
            "expr": "histogram_quantile(0.95, sum by (workload, repo, le) (rate(tuist_repo_query_decode_time_milliseconds_bucket{cluster=\"$cluster\",workload=~\"$workload\",repo=~\"$repo\",result=\"ok\"}[$__rate_interval])))",
            "legendFormat": "{{workload}} / {{repo}} / 95th percentile",
            "range": true,
            "editorMode": "code",
            "datasource": {
              "type": "prometheus",
              "uid": "$datasource"
            }
          },
          {
            "refId": "C",
            "expr": "histogram_quantile(0.99, sum by (workload, repo, le) (rate(tuist_repo_query_decode_time_milliseconds_bucket{cluster=\"$cluster\",workload=~\"$workload\",repo=~\"$repo\",result=\"ok\"}[$__rate_interval])))",
            "legendFormat": "{{workload}} / {{repo}} / 99th percentile",
            "range": true,
            "editorMode": "code",
            "datasource": {
              "type": "prometheus",
              "uid": "$datasource"
            }
          }
        ]
      },
      {
        "id": 13,
        "title": "Total query time average",
        "description": "Total adapter-reported time, including connection wait, execution, and decoding. Successful queries only; missing phases are omitted, not recorded as zero.",
        "type": "timeseries",
        "datasource": {
          "type": "prometheus",
          "uid": "$datasource"
        },
        "gridPos": {
          "x": 0,
          "y": 48,
          "w": 12,
          "h": 8
        },
        "fieldConfig": {
          "defaults": {
            "unit": "ms",
            "min": 0,
            "color": {
              "mode": "palette-classic"
            }
          },
          "overrides": []
        },
        "options": {
          "legend": {
            "displayMode": "list",
            "placement": "bottom"
          },
          "tooltip": {
            "mode": "multi"
          }
        },
        "targets": [
          {
            "refId": "A",
            "expr": "sum by (workload, repo) (rate(tuist_repo_query_total_time_milliseconds_sum{cluster=\"$cluster\",workload=~\"$workload\",repo=~\"$repo\",result=\"ok\"}[$__rate_interval])) / sum by (workload, repo) (rate(tuist_repo_query_total_time_milliseconds_count{cluster=\"$cluster\",workload=~\"$workload\",repo=~\"$repo\",result=\"ok\"}[$__rate_interval]))",
            "legendFormat": "{{workload}} / {{repo}}",
            "range": true,
            "editorMode": "code",
            "datasource": {
              "type": "prometheus",
              "uid": "$datasource"
            }
          }
        ]
      },
      {
        "id": 14,
        "title": "Total query time percentiles",
        "description": "Total adapter-reported time, including connection wait, execution, and decoding. Successful queries only. Histogram buckets are retained only in production.",
        "type": "timeseries",
        "datasource": {
          "type": "prometheus",
          "uid": "$datasource"
        },
        "gridPos": {
          "x": 12,
          "y": 48,
          "w": 12,
          "h": 8
        },
        "fieldConfig": {
          "defaults": {
            "unit": "ms",
            "min": 0,
            "color": {
              "mode": "palette-classic"
            }
          },
          "overrides": []
        },
        "options": {
          "legend": {
            "displayMode": "list",
            "placement": "bottom"
          },
          "tooltip": {
            "mode": "multi"
          }
        },
        "targets": [
          {
            "refId": "A",
            "expr": "histogram_quantile(0.5, sum by (workload, repo, le) (rate(tuist_repo_query_total_time_milliseconds_bucket{cluster=\"$cluster\",workload=~\"$workload\",repo=~\"$repo\",result=\"ok\"}[$__rate_interval])))",
            "legendFormat": "{{workload}} / {{repo}} / 50th percentile",
            "range": true,
            "editorMode": "code",
            "datasource": {
              "type": "prometheus",
              "uid": "$datasource"
            }
          },
          {
