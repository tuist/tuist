diff --git a/Sources/tart/USBDiskHotplug.swift b/Sources/tart/USBDiskHotplug.swift
new file mode 100644
index 0000000..74acba2
--- /dev/null
+++ b/Sources/tart/USBDiskHotplug.swift
@@ -0,0 +1,139 @@
+import Foundation
+import Virtualization
+
+#if canImport(DiskImageKit)
+  import DiskImageKit
+#endif
+
+/// Hot-plugs USB mass storage disks into a running VM on a host process's
+/// request. The host writes `<id>.attach` (JSON, see `AttachRequest`) or
+/// `<id>.detach` into a directory only it can write; Tart removes the request
+/// and answers with `<id>.attached`, `<id>.detached` or `<id>.error`, each
+/// published by renaming a complete file into place.
+///
+/// An attached disk is a DiskImageKit stack: read-only layers, base first,
+/// under a private writable ASIF overlay that Tart creates when it is missing.
+@available(macOS 27.0, *)
+@MainActor
+final class USBDiskHotplug {
+  struct AttachRequest: Decodable {
+    /// Read-only layers, base (raw or ASIF) first, then ASIF overlays.
+    let layers: [String]
+    /// The writable ASIF overlay; created on top of `layers` when missing.
+    let overlay: String
+    /// Grows the stack to this many blocks when it is smaller.
+    let blockCount: Int?
+  }
+
+  let directory: URL
+  let virtualMachine: VZVirtualMachine
+  private var devices: [String: VZUSBDevice] = [:]
+
+  init(directory: URL, virtualMachine: VZVirtualMachine) {
+    self.directory = directory
+    self.virtualMachine = virtualMachine
+  }
+
+  func run() async throws {
+    while !Task.isCancelled {
+      let names = (try? FileManager.default.contentsOfDirectory(atPath: directory.path)) ?? []
+      for name in names.sorted() {
+        if name.hasSuffix(".attach") {
+          await serve(id: String(name.dropLast(".attach".count)), request: name, reply: "attached") { id, data in
+            try await self.attach(id: id, try JSONDecoder().decode(AttachRequest.self, from: data))
+          }
+        } else if name.hasSuffix(".detach") {
+          await serve(id: String(name.dropLast(".detach".count)), request: name, reply: "detached") { id, _ in
+            try await self.detach(id: id)
+          }
+        }
+      }
+      try await Task.sleep(nanoseconds: 250_000_000)
+    }
+  }
+
+  private func serve(id: String, request: String, reply: String, _ body: (String, Data) async throws -> [String: String]) async {
+    let requestURL = directory.appendingPathComponent(request)
+    guard let data = try? Data(contentsOf: requestURL) else {
+      return
+    }
+    try? FileManager.default.removeItem(at: requestURL)
+
+    do {
+      publish(id: id, suffix: reply, try await body(id, data))
+    } catch {
+      publish(id: id, suffix: "error", ["error": "\(error)"])
+    }
+  }
+
+  private func publish(id: String, suffix: String, _ body: [String: String]) {
+    let final = directory.appendingPathComponent("\(id).\(suffix)")
+    let temporary = directory.appendingPathComponent(".\(id).\(suffix).tmp")
+    guard let data = try? JSONSerialization.data(withJSONObject: body) else {
+      return
+    }
+    try? data.write(to: temporary)
+    _ = rename(temporary.path, final.path)
+  }
+
+  private func attach(id: String, _ request: AttachRequest) async throws -> [String: String] {
+    guard devices[id] == nil else {
+      throw RuntimeError.Generic("USB disk \(id) is already attached")
+    }
+    guard let controller = virtualMachine.usbControllers.first else {
+      throw RuntimeError.Generic("the VM has no USB controller; run it with --usb-disk-requests")
+    }
+
+    let attachment = try VZDiskImageStorageDeviceAttachment(
+      diskImage: try stack(request),
+      cachingMode: .automatic,
+      synchronizationMode: .full
+    )
+    let device = VZUSBMassStorageDevice(configuration: VZUSBMassStorageDeviceConfiguration(attachment: attachment))
+    try await controller.attach(device: device)
+    devices[id] = device
+
+    return ["uuid": device.uuid.uuidString]
+  }
+
+  private func detach(id: String) async throws -> [String: String] {
+    guard let device = devices[id], let controller = virtualMachine.usbControllers.first else {
+      throw RuntimeError.Generic("USB disk \(id) is not attached")
+    }
+    try await controller.detach(device: device)
+    devices[id] = nil
+
+    return [:]
+  }
+
+  private func stack(_ request: AttachRequest) throws -> any StackedImage {
+    guard let base = request.layers.first else {
+      throw RuntimeError.Generic("a USB disk needs at least a base layer")
+    }
+
+    var parent: DiskImage = try DiskImage(opening: .open(url: URL(fileURLWithPath: base), mode: .readOnly))
+    for layer in request.layers.dropFirst() {
+      let overlay = try DiskImage(opening: .open(url: URL(fileURLWithPath: layer), mode: .readOnly))
+      parent = try parent.appending(overlay)
+    }
+
+    let overlayURL = URL(fileURLWithPath: request.overlay)
+    if !FileManager.default.fileExists(atPath: overlayURL.path) {
+      _ = try parent.appending(.asifLayer(url: overlayURL, type: .overlay))
+    }
+    let overlay = try DiskImage(opening: .open(url: overlayURL, mode: .readWrite))
+    guard overlay.format == .asif else {
+      throw RuntimeError.Generic("the writable overlay must use ASIF format")
+    }
+    let stacked = try parent.appending(overlay)
+    guard stacked.layers.last?.layerType == .overlay else {
+      throw RuntimeError.Generic("the writable layer is not an ASIF overlay")
+    }
+
+    if let blockCount = request.blockCount, let top = stacked.layers.last, blockCount > top.blockCount {
+      try top.truncate(blockCount: blockCount)
+    }
+
+    return stacked
+  }
+}
