{
  "receiver": "Slack #notifications-non-prod",
  "object_matchers": [
    [
      "alertname",
      "=",
      "Kura instance has no ready replicas"
    ],
    [
      "grafana_folder",
      "=",
      "Alerts"
    ]
  ],
  "routes": [
    {
      "receiver": "Slack #notifications 2",
      "object_matchers": [
        [
          "cluster",
          "=",
          "tuist-production"
        ]
      ],
      "continue": true
    },
    {
      "receiver": "Incidents",
      "object_matchers": [
        [
          "cluster",
          "=",
          "tuist-production"
        ]
      ]
    }
  ]
}
