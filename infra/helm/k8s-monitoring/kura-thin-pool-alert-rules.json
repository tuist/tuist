  {
    "annotations": {
      "description": "A node labelled tuist.dev/kura-thin-ready=true has published no fresh pool observation for 15 minutes. Either its CSI plugin is down or not scraped, or the plugin's observations fail, which also withdraws the node's tuist.dev/kura-disk capacity. The usage alerts are blind for this node until it recovers. Read the driver container's logs for the observation error and check the pod's scrape target.",
      "runbook_url": "https://github.com/tuist/tuist/blob/main/infra/helm/k8s-monitoring/alerts.md#kura-thin-pool-metrics-missing",
      "summary": "Kura thin pool metrics are missing on {{ $labels.node }} ({{ $labels.cluster }})"
    },
    "condition": "C",
    "data": [
      {
        "datasourceUid": "grafanacloud-prom",
        "model": {
          "editorMode": "code",
          "expr": "max by (cluster, node) (kube_node_labels{label_tuist_dev_kura_thin_ready=\"true\"}) unless on (cluster, node) (max by (cluster, node) (kura_volumes_thin_pool_data_size_bytes) and on (cluster, node) (max by (cluster, node) (time() - kura_volumes_thin_pool_last_observation_timestamp_seconds) < 600))",
          "instant": true,
