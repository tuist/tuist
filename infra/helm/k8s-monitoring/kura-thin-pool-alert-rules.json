[
  {
    "annotations": {
      "description": "The pool is created with error_if_no_space, so once its data is full every new write from a tenant on this node fails with an I/O error instead of queueing. In ceiling-backed-v1 every volume is fully backed, so growth past the reserve means unattributed mappings or a pool shared beyond its ceilings. Read /v1/node on the node's allocator socket, compare committed and mapped bytes, and reclaim or move volumes before it fills. Never extend or convert the pool by hand as a fix.",
      "runbook_url": "https://github.com/tuist/tuist/blob/main/infra/helm/k8s-monitoring/alerts.md#kura-thin-pool-data-usage",
      "summary": "Kura thin pool {{ $labels.vg }}/{{ $labels.pool }} on {{ $labels.node }} ({{ $labels.cluster }}) data is {{ $values.A.Value | humanizePercentage }} used"
    },
    "condition": "C",
    "data": [
      {
        "datasourceUid": "grafanacloud-prom",
        "model": {
          "editorMode": "code",
          "expr": "max by (cluster, node, vg, pool) (kura_volumes_thin_pool_data_used_bytes) / max by (cluster, node, vg, pool) (kura_volumes_thin_pool_data_size_bytes)",
          "instant": true,
          "intervalMs": 1000,
          "legendFormat": "__auto",
