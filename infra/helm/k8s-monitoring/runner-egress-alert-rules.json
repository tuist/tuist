  {
    "annotations": {
      "description": "Dispatch skips accounts with a dedicated egress gateway on fleets that cannot route through one (today: any non-macOS fleet), so this job stays queued until GitHub times it out. Tell the account, or move it off dedicated egress if it now needs Linux runners.",
      "runbook_url": "https://github.com/tuist/tuist/blob/main/infra/helm/k8s-monitoring/alerts.md#runner-egress-account-job-on-a-fleet-it-cannot-use",
      "summary": "Account {{ $labels.account_id }} (egress gateway {{ $labels.gateway }}) has jobs queued on {{ $labels.fleet }}, which cannot route through a dedicated egress gateway"
    },
    "condition": "C",
    "data": [
      {
        "datasourceUid": "grafanacloud-prom",
        "model": {
