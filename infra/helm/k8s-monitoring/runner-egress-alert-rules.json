[
  {
    "annotations": {
      "description": "Every account assigned to this dedicated egress gateway has its macOS jobs held in the queue: dispatch skips the account until a host lists the gateway in tuist.dev/runner-egress-ready-gateways. Jobs never fall back to the shared host address, so this is an outage for those accounts, not a leak. Check the gateway pod and Service (externalIPs) in tuist-runner-egress, the Floating IP's assignment, and the active egress node's tuist.dev/stable-egress-ips label (an unresolved Cilium egress policy drops all gateway traffic).",
      "runbook_url": "https://github.com/tuist/tuist/blob/main/infra/helm/k8s-monitoring/alerts.md#runner-egress-gateway-unusable",
      "summary": "No Mac host can route runner egress gateway {{ $labels.gateway }} in {{ $labels.env }}"
    },
    "condition": "C",
    "data": [
      {
        "datasourceUid": "grafanacloud-prom",
        "model": {
          "editorMode": "code",
          "expr": "max by (cluster, env, gateway) (tart_kubelet_runner_egress_tunnel_healthy)",
          "instant": true,
          "intervalMs": 1000,
          "maxDataPoints": 43200,
          "range": false,
          "refId": "A"
        },
        "refId": "A",
        "relativeTimeRange": {
          "from": 600,
          "to": 0
        }
      },
