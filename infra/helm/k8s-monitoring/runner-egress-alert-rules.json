  {
    "annotations": {
      "description": "This Mac host lost its tunnel to a dedicated egress gateway while others may still have it. It stops advertising the gateway, so the gateway's accounts dispatch elsewhere with less room. A stale tart_kubelet_runner_egress_handshake_age_seconds points at the network between host and Floating IP; a fresh handshake points at the gateway's /healthz. On the host see /var/run/tuist-egress/<gateway>.json and /var/log/tuist-runner-egress-<gateway>.log.",
      "runbook_url": "https://github.com/tuist/tuist/blob/main/infra/helm/k8s-monitoring/alerts.md#runner-egress-tunnel-unhealthy-on-a-host",
      "summary": "Runner egress tunnel to {{ $labels.gateway }} unhealthy on {{ $labels.instance }}"
    },
    "condition": "C",
    "data": [
      {
        "datasourceUid": "grafanacloud-prom",
        "model": {
          "editorMode": "code",
          "expr": "min by (cluster, env, instance, gateway) (tart_kubelet_runner_egress_tunnel_healthy)",
          "instant": true,
          "intervalMs": 1000,
          "maxDataPoints": 43200,
