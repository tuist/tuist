[
  {
    "annotations": {
      "description": "5xx responses from ingress-nginx for the server Ingress are above 14.4 times the 0.1% budget over both the last hour and the last 5 minutes: at this rate 2% of the 30-day budget is gone in an hour. Split by status and path (sum by (status) (rate(nginx_ingress_controller_requests{cluster=\"tuist-production\", ingress=\"tuist-tuist-server\", status=~\"5..\"}[5m]))) and correlate with the last deploy.",
      "runbook_url": "https://github.com/tuist/tuist/blob/main/infra/helm/k8s-monitoring/alerts.md#server-ingress-slo-fast-burn",
      "summary": "The server is burning its 99.9% availability budget {{ $values.A.Value | printf \"%.1f\" }}x too fast"
    },
    "condition": "C",
    "data": [
      {
        "datasourceUid": "grafanacloud-prom",
        "model": {
          "editorMode": "code",
          "expr": "sum by (cluster) (rate(nginx_ingress_controller_requests{cluster=\"tuist-production\", namespace=\"tuist\", ingress=\"tuist-tuist-server\", status=~\"5..\"}[1h])) / sum by (cluster) (rate(nginx_ingress_controller_requests{cluster=\"tuist-production\", namespace=\"tuist\", ingress=\"tuist-tuist-server\"}[1h])) / 0.001",
          "instant": true,
          "intervalMs": 1000,
          "legendFormat": "__auto",
          "maxDataPoints": 43200,
          "range": false,
          "refId": "A"
        },
        "queryType": "",
        "refId": "A",
        "relativeTimeRange": {
          "from": 3600,
          "to": 0
        }
      },
      {
        "datasourceUid": "grafanacloud-prom",
        "model": {
          "editorMode": "code",
          "expr": "sum by (cluster) (rate(nginx_ingress_controller_requests{cluster=\"tuist-production\", namespace=\"tuist\", ingress=\"tuist-tuist-server\", status=~\"5..\"}[5m])) / sum by (cluster) (rate(nginx_ingress_controller_requests{cluster=\"tuist-production\", namespace=\"tuist\", ingress=\"tuist-tuist-server\"}[5m])) / 0.001",
          "instant": true,
          "intervalMs": 1000,
          "legendFormat": "__auto",
          "maxDataPoints": 43200,
          "range": false,
          "refId": "B"
        },
        "queryType": "",
        "refId": "B",
        "relativeTimeRange": {
          "from": 300,
          "to": 0
        }
      },
      {
        "datasourceUid": "__expr__",
        "model": {
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          },
          "expression": "$A > 14.4 && $B > 14.4",
          "intervalMs": 1000,
          "maxDataPoints": 43200,
          "refId": "C",
          "type": "math"
        },
        "queryType": "expression",
        "refId": "C",
        "relativeTimeRange": {
          "from": 0,
          "to": 0
        }
      }
    ],
    "execErrState": "Error",
