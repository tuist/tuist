[
  {
    "annotations": {
      "summary": "Pulse datanode {{ $labels.pod }} ({{ $labels.cluster }}) rejected {{ $values.A.Value }} scans in 10 minutes for lack of scan memory",
      "description": "Each rejected scan is a failed PromQL or SQL read: Grafana alert rules on Pulse error and the Tuist Pulse pages fail or stall. The scan budget is 25% of the datanode memory limit and is shared by every region the datanode serves, including the single metric region. Check which datanode holds the metric region, raise the datanode memory limit in infra/helm/pulse/values-production.yaml, or spread the regions.",
      "runbook_url": "https://github.com/tuist/tuist/blob/main/infra/helm/k8s-monitoring/alerts.md#pulse-rejecting-scans-for-lack-of-memory"
    },
    "condition": "C",
    "data": [
      {
        "datasourceUid": "cg3i1jh2k1v5sb",
        "model": {
          "datasource": {
            "type": "prometheus",
            "uid": "cg3i1jh2k1v5sb"
          },
          "editorMode": "code",
          "expr": "sum by (cluster, pod) (increase(pulse_mito_scan_requests_rejected_total[10m]))",
