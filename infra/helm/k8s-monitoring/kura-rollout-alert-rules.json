  {
    "annotations": {
      "description": "The Kura rollout has been in the running state, unpaused, for six hours. Every wave has a one-hour deadline that pauses the rollout, so a healthy one either finishes or pauses long before this; the longest unpaused production rollout on record took about 3.5 hours. Reaching six hours means the reconciler is not advancing the rollout: it is not ticking, it is erroring before the deadline check, or waves keep being re-scoped. Check the server logs for Tuist.Kura.Rollouts and the rollout page under /ops/kura/rollouts.",
      "runbook_url": "https://github.com/tuist/tuist/blob/main/infra/helm/k8s-monitoring/alerts.md#kura-rollout-running-without-progress",
      "summary": "Kura rollout of {{ $labels.image_tag }} has been running for {{ $values.A.Value | printf \"%.1f\" }} of the last 6 hours in {{ $labels.env }}"
    },
    "condition": "C",
    "data": [
      {
        "datasourceUid": "grafanacloud-prom",
        "model": {
          "editorMode": "code",
          "expr": "sum_over_time((max by (cluster, env, image_tag, mode) (tuist_kura_rollout_active) - max by (cluster, env, image_tag, mode) (tuist_kura_rollout_paused))[6h:5m]) * 5 / 60",
          "instant": true,
          "intervalMs": 1000,
          "legendFormat": "__auto",
          "maxDataPoints": 43200,
          "range": false,
          "refId": "A"
        },
        "queryType": "",
