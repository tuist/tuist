  {
    "uid": "rustfs-drive-metrics-missing",
    "orgID": 1,
    "folderUID": "df5dn1g4rckxsf",
    "ruleGroup": "RustFS",
    "title": "RustFS drive metrics missing",
    "condition": "C",
    "data": [
      {
        "refId": "A",
        "queryType": "",
        "relativeTimeRange": {
          "from": 600,
          "to": 0
        },
        "datasourceUid": "cg3i1jh2k1v5sb",
        "model": {
          "datasource": {
            "type": "prometheus",
            "uid": "cg3i1jh2k1v5sb"
          },
          "editorMode": "code",
          "expr": "max by (cluster, namespace) (kube_statefulset_replicas{statefulset=\"rustfs\", namespace=~\"rustfs-.*\"}) unless on (cluster) max by (cluster) (rustfs_cluster_drive_total_bytes)",
          "instant": true,
          "intervalMs": 1000,
          "legendFormat": "__auto",
          "maxDataPoints": 43200,
          "range": false,
          "refId": "A"
        }
      },
      {
        "refId": "C",
        "queryType": "",
        "relativeTimeRange": {
          "from": 0,
          "to": 0
        },
        "datasourceUid": "__expr__",
        "model": {
          "conditions": [
            {
              "evaluator": {
                "params": [
                  0
                ],
                "type": "gt"
              },
              "operator": {
                "type": "and"
              },
              "query": {
                "params": [
                  "C"
                ]
              },
              "reducer": {
                "type": "last"
              }
            }
          ],
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          },
          "expression": "A",
          "intervalMs": 1000,
          "maxDataPoints": 43200,
          "refId": "C",
          "type": "threshold"
        }
      }
    ],
    "noDataState": "OK",
    "execErrState": "KeepLast",
    "for": "15m",
    "isPaused": false,
    "labels": {
      "severity": "warning"
    },
    "annotations": {
      "summary": "RustFS drive metrics are missing for {{ $labels.namespace }} ({{ $labels.cluster }})",
      "description": "A RustFS StatefulSet is running but no rustfs_cluster_drive_total_bytes has reached Pulse for 15 minutes, so the free-space alerts are blind. RustFS pushes these over OTLP to the alloy receiver (metricsEndpoint in the shard-storage-rustfs chart). Check the store's network policy egress to observability:4318, the receiver's otelcol pipeline, and the pod's RUSTFS_OBS_* environment.",
      "runbook_url": "https://github.com/tuist/tuist/blob/main/infra/helm/k8s-monitoring/alerts.md#rustfs-drive-metrics-missing"
    }
  }
]
