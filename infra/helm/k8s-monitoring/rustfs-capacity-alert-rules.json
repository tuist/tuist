    "annotations": {
      "summary": "RustFS drive {{ $labels.drive }} on {{ $labels.server }} ({{ $labels.cluster }}) has {{ $values.A.Value | humanizePercentage }} free",
      "description": "A RustFS drive has had under 5% of its capacity free for 5 minutes and will start rejecting writes. RustFS answers 503 to every upload, and to deletes, once a drive is full, so shard uploads fail for every account routed to this store and the server's cleanup cannot free space through the S3 API. Drive total is the volume's XFS project quota, not the host disk. Check that the server's shard cleanup and the bucket's 31-day expiry are running, then follow the runbook to free space or grow the quota.",
      "runbook_url": "https://github.com/tuist/tuist/blob/main/infra/helm/k8s-monitoring/alerts.md#rustfs-drive-free-space"
