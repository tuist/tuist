[
  {
    "uid": "rustfs-drive-free-low",
    "orgID": 1,
    "folderUID": "df5dn1g4rckxsf",
    "ruleGroup": "RustFS",
    "title": "RustFS drive free space low",
    "condition": "C",
    "data": [
      {
        "refId": "A",
        "queryType": "",
        "relativeTimeRange": {
          "from": 600,
          "to": 0
        },
        "datasourceUid": "cg3i1jh2k1v5sb",
        "model": {
          "datasource": {
            "type": "prometheus",
            "uid": "cg3i1jh2k1v5sb"
          },
          "editorMode": "code",
          "expr": "min by (cluster, server, drive) (rustfs_cluster_drive_free_bytes) / max by (cluster, server, drive) (rustfs_cluster_drive_total_bytes)",
          "instant": true,
          "intervalMs": 1000,
          "legendFormat": "__auto",
          "maxDataPoints": 43200,
          "range": false,
          "refId": "A"
        }
      },
      {
        "refId": "C",
        "queryType": "",
        "relativeTimeRange": {
          "from": 0,
          "to": 0
        },
        "datasourceUid": "__expr__",
        "model": {
          "conditions": [
            {
              "evaluator": {
                "params": [
                  0.15
                ],
                "type": "lt"
              },
              "operator": {
                "type": "and"
              },
              "query": {
                "params": [
                  "C"
                ]
              },
              "reducer": {
                "type": "last"
              }
            }
          ],
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          },
          "expression": "A",
          "intervalMs": 1000,
          "maxDataPoints": 43200,
          "refId": "C",
          "type": "threshold"
        }
      }
    ],
    "noDataState": "OK",
    "execErrState": "KeepLast",
    "for": "15m",
    "isPaused": false,
    "labels": {
      "severity": "warning"
    },
    "annotations": {
      "summary": "RustFS drive {{ $labels.drive }} on {{ $labels.server }} ({{ $labels.cluster }}) has {{ $values.A.Value | humanizePercentage }} free",
      "description": "A RustFS drive has had under 15% of its capacity free for 15 minutes. RustFS answers 503 to every upload, and to deletes, once a drive is full, so shard uploads fail for every account routed to this store and the server's cleanup cannot free space through the S3 API. Drive total is the volume's XFS project quota, not the host disk. Check that the server's shard cleanup and the bucket's 31-day expiry are running, then follow the runbook to free space or grow the quota.",
      "runbook_url": "https://github.com/tuist/tuist/blob/main/infra/helm/k8s-monitoring/alerts.md#rustfs-drive-free-space"
    }
  },
