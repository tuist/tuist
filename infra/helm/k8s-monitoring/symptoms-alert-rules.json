    "annotations": {
      "description": "Grafana Cloud's tail sampler keeps every trace with an error span, so error spans are the one span count both pipelines should agree on. Over the 15 minutes ending 10 minutes ago, Pulse's symptoms_trace_counts_1m counted under 90% of the error calls Grafana Cloud Tempo's span metrics did. Paused until the span-metrics selector is previewed (see alerts.md).",
      "runbook_url": "https://github.com/tuist/tuist/blob/main/infra/helm/k8s-monitoring/alerts.md#pulse-error-spans-behind-grafana-cloud",
      "summary": "Pulse holds {{ $values.C.Value | humanizePercentage }} of the error spans Grafana Cloud received over 15 minutes"
    },
    "condition": "D",
    "data": [
      {
        "datasourceUid": "pulse-sql",
        "model": {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pulse-sql"
          },
          "editorMode": "code",
          "format": "table",
          "intervalMs": 1000,
          "maxDataPoints": 43200,
          "rawQuery": true,
          "rawSql": "SELECT sum(error_count) AS value FROM symptoms_trace_counts_1m WHERE time_window >= now() - INTERVAL '25 minutes' AND time_window < now() - INTERVAL '10 minutes'",
          "refId": "A"
        },
        "refId": "A",
        "relativeTimeRange": {
          "from": 1800,
          "to": 0
        }
      },
      {
        "datasourceUid": "grafanacloud-prom",
        "model": {
          "editorMode": "code",
          "expr": "sum(increase(traces_spanmetrics_calls_total{status_code=\"STATUS_CODE_ERROR\", deployment_environment=\"production\"}[15m] offset 10m))",
          "instant": true,
          "intervalMs": 1000,
          "legendFormat": "__auto",
          "maxDataPoints": 43200,
          "range": false,
          "refId": "B"
        },
        "queryType": "",
        "refId": "B",
        "relativeTimeRange": {
          "from": 1800,
          "to": 0
        }
      },
