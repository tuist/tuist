  {
    "annotations": {
      "description": "The same collectors send every log line to Grafana Cloud and to Pulse. Over the 15 minutes ending 10 minutes ago, Pulse's symptoms_log_totals_1m (service tuist) counted under 90% of the lines Grafana Cloud Loki holds for service_name tuist in tuist-production. The evaluator's log evidence is then incomplete. Check Pulse ingestion (loki_otlp pipeline, frontends), the collectors' Pulse destination, and the symptoms_log_totals_1m Flow on pulse-flownode. A query error here means Grafana cannot reach Pulse through PDC.",
      "runbook_url": "https://github.com/tuist/tuist/blob/main/infra/helm/k8s-monitoring/alerts.md#pulse-log-lines-behind-grafana-cloud",
      "summary": "Pulse holds {{ $values.C.Value | humanizePercentage }} of the server log lines Grafana Cloud received over 15 minutes"
    },
    "condition": "D",
    "data": [
      {
        "datasourceUid": "pulse-sql",
        "model": {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pulse-sql"
          },
          "editorMode": "code",
          "format": "table",
          "intervalMs": 1000,
          "maxDataPoints": 43200,
          "rawQuery": true,
          "rawSql": "SELECT sum(line_count) AS value FROM symptoms_log_totals_1m WHERE service = 'tuist' AND time_window >= now() - INTERVAL '25 minutes' AND time_window < now() - INTERVAL '10 minutes'",
          "refId": "A"
        },
        "refId": "A",
        "relativeTimeRange": {
          "from": 1800,
          "to": 0
        }
      },
      {
        "datasourceUid": "grafanacloud-logs",
        "model": {
          "datasource": {
            "type": "loki",
            "uid": "grafanacloud-logs"
          },
          "editorMode": "code",
          "expr": "sum(count_over_time({cluster=\"tuist-production\", service_name=\"tuist\"} [15m] offset 10m))",
          "intervalMs": 1000,
          "maxDataPoints": 43200,
          "queryType": "instant",
          "refId": "B"
