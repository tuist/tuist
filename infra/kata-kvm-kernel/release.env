# The release tag is kata-kvm-kernel@<KATA_VERSION>-<REVISION>. KATA_VERSION
# must equal kataVersion in
# infra/cluster-api-provider-tuist/controllers/linux/linux_cloudinit.go: the
# guest kernel is built from that release's packaging, config version and
# patches, so it boots that release's guest image. Bump REVISION when the
# fragment changes on the same Kata release.
KATA_VERSION=3.30.0
REVISION=2
