#!/usr/bin/env bash
# kubectl exec credential plugin for Amp orbs. Prints an ExecCredential
# holding a fresh Amp workload identity token for the given gateway
# audience (https://kube-orb-<env>.tuist.dev). The kube-impersonator's
# orb listener verifies it; see kube-impersonator/orb.go.
#
#   users:
#     - name: amp-orb-production
#       user:
#         exec:
#           apiVersion: client.authentication.k8s.io/v1
#           command: /path/to/infra/k8s/orb-kube-credential
#           args: ["https://kube-orb-prod.tuist.dev"]
#           interactiveMode: Never
#
# The token lives ten minutes; kubectl reruns this when it expires.
set -euo pipefail

audience="${1:?usage: orb-kube-credential <audience>}"
token="$(amp orb id-token --audience "$audience" --ttl-seconds 600)"
expires="$(date -u -d '+9 minutes' +%Y-%m-%dT%H:%M:%SZ)"

jq -cn --arg token "$token" --arg expires "$expires" '{
  apiVersion: "client.authentication.k8s.io/v1",
  kind: "ExecCredential",
  status: {token: $token, expirationTimestamp: $expires}
}'
