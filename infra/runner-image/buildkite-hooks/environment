#!/bin/bash
# Buildkite global `environment` hook. Runs inside the agent before the
# job's command, for every job the agent takes.
#
# Identical on the macOS and Linux fleets; only the path it reads differs,
# and that arrives as TUIST_RUNNER_JOB_ENV. Keep the two copies in step.
#
# dispatch-poll.sh writes the settings the server sent with this job's
# dispatch, but the agent sanitizes the job environment, so a variable
# exported by the parent process does not necessarily survive into the
# job. Re-exporting them here is what puts them in front of the build.
#
# The billable window is measured server-side and is not stamped here.
# This hook runs inside the customer's job and its credential is readable
# from there, so a timestamp taken at this point would be the job's own
# claim about how long it ran.

set -uo pipefail

STATE_DIR="${TUIST_RUNNER_STATE_DIR:-/var/log/tuist-runner}"
JOB_ENV="${TUIST_RUNNER_JOB_ENV:-/etc/tuist-runner-job.env}"

mkdir -p "${STATE_DIR}" 2>/dev/null || true

# Absent file, or absent variable, means the server sent nothing and the
# build falls back to normal cache resolution.
if [ -f "${JOB_ENV}" ]; then
  # shellcheck disable=SC1090
  source "${JOB_ENV}"
fi

# Never `exit` from here. The agent sources this hook from a wrapper that
# dumps the environment afterwards to learn what changed; exiting skips
# that dump, and an empty dump is read as "the hook early-exited", so
# every export below is discarded and the build silently loses its cache
# settings. `if` blocks rather than `&&` so the hook also ends with a
# zero status when a variable is absent.
if [ -n "${TUIST_CACHE_ENDPOINT:-}" ]; then
  export TUIST_CACHE_ENDPOINT
fi

if [ -n "${TUIST_CACHE_SIGNING_GRANT:-}" ]; then
  export TUIST_CACHE_SIGNING_GRANT
fi
