#!/usr/bin/env bash
# Git calls this for each authentication; never persist an Origin access token.
set -euo pipefail
trap 'printf "quit=true\n"' ERR

if [ "${1:-}" != get ]; then
  exit 0
fi

protocol= host= path=
while IFS='=' read -r key value && [ -n "${key}" ]; do
  case "${key}" in
    protocol) protocol=${value} ;;
    host) host=${value} ;;
    path) path=${value} ;;
  esac
done

if [ "${protocol}" != https ] || [ "${host}" != origin.cursor.com ] || [ -z "${path}" ]; then
  printf 'quit=true\n'
  exit 1
fi

body=$(jq -nc --arg url "https://${host}/${path}" '{repo_url: $url}')
response=$(curl --silent --show-error --fail --retry 2 --retry-max-time 15 --max-time 10 \
  --header 'Content-Type: application/json' --config - --data "${body}" \
  "${TUIST_RUNNER_REPORT_URL}/jobs/origin-credentials" <<CURL
header = "Authorization: Bearer ${TUIST_ORIGIN_CHECKOUT_TOKEN}"
CURL
)
token=$(printf '%s' "${response}" | jq -er '.token | select(type == "string" and length > 0)')
printf 'username=x-access-token\npassword=%s\n' "${token}"
