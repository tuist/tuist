# Source pin for the ingress-nginx images built by
# .github/workflows/ingress-nginx-image.yml (see README.md in this directory).
# Sourced by bash: plain KEY=value lines only.

FORK_REPOSITORY=https://github.com/chainguard-forks/ingress-nginx
FORK_TAG=controller-v1.15.16
# The commit FORK_TAG must resolve to. The build fails if the tag moves.
FORK_COMMIT=29e7c87140a9d88ffd3cf26ff07852bb81dc0a4a

# The fork's nginx build clones ModSecurity and the OWASP CRS by git tag, and
# its kube-webhook-certgen image starts FROM a floating distroless tag. source.sh
# fails the build unless those tags still resolve to these commits, and pins the
# distroless base to this digest, so an upstream tag move cannot change what we
# ship. A fork release that bumps one of them fails until its pin is updated.
MODSECURITY_COMMIT=a555e5a44573e50f04ad997b3b24c214c42f8e29
CRS_COMMIT=f13d4c53c449bd1055817f0f9d212eae69fdc3af
DISTROLESS_IMAGE=gcr.io/distroless/static:nonroot@sha256:aafe993665bf6200db38a02c11a9351e782a84b6a45e7f33b6695638c88e3931

# Our build number for FORK_TAG. Published tags are immutable: bump it for any
# change that alters the images (patches, Go toolchain, a rebuild for Alpine
# package fixes), and reset it to 1 when FORK_TAG changes.
TUIST_BUILD=1

# Go toolchain for the controller binaries and kube-webhook-certgen. The fork's
# GOLANG_VERSION file pins 1.26.2; we build with the newest 1.26 patch release
# for its standard-library security fixes. Same minor version, so the binaries
# are otherwise what the fork's own build produces.
GO_IMAGE_ALPINE=golang:1.26.11-alpine3.23@sha256:23f198931d4bd83b4f5a613bd75656257ae8bf832dcbc2db80e1050b5219ca2a
GO_IMAGE_DEBIAN_TAG=1.26.11@sha256:4165ee6bf3b7811fd7b40373290405c83d0167dcb87ee5f29c427cdcef45ff8f

# Official images these must stay drop-in replacements for (chart 4.15.1).
UPSTREAM_CONTROLLER_IMAGE=registry.k8s.io/ingress-nginx/controller:v1.15.1@sha256:594ceea76b01c592858f803f9ff4d2cb40542cae2060410b2c95f75907d659e1
UPSTREAM_CERTGEN_IMAGE=registry.k8s.io/ingress-nginx/kube-webhook-certgen:v1.6.9@sha256:01038e7de14b78d702d2849c3aad72fd25903c4765af63cf16aa3398f5d5f2dd
