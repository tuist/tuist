# Source pin for the ingress-nginx images built by
# .github/workflows/ingress-nginx-image.yml (see README.md in this directory).
# Sourced by bash: plain KEY=value lines only.

FORK_REPOSITORY=https://github.com/rancher/ingress-nginx
FORK_TAG=v1.15.2-prime5
# The commit FORK_TAG must resolve to. The build fails if the tag moves.
# Rancher re-tags the same commit for image-only rebuilds (prime1 to prime3
# share one), so check the commit, not just the tag name.
FORK_COMMIT=eae3c3319e7ec2768cb54f51cdaf551958a93b74

# The fork's nginx build clones ModSecurity and the OWASP CRS by git tag and
# ssdeep at whatever its default branch points to, and its kube-webhook-certgen
# image starts FROM a floating distroless tag. source.sh fails the build unless
# the tags still resolve to these commits, checks ssdeep out at SSDEEP_COMMIT,
# and pins the distroless base to this digest, so an upstream move cannot
# change what we ship. Tarballs are pinned in sources.sha256.
MODSECURITY_COMMIT=a555e5a44573e50f04ad997b3b24c214c42f8e29
CRS_COMMIT=f13d4c53c449bd1055817f0f9d212eae69fdc3af
SSDEEP_COMMIT=5ae3e5363281eacfac6292aebe77ebb0bde18c6e
DISTROLESS_IMAGE=gcr.io/distroless/static:nonroot@sha256:aafe993665bf6200db38a02c11a9351e782a84b6a45e7f33b6695638c88e3931

# The nginx image builds on SUSE BCI 16.0 (the fork's BCI_BUILD_IMAGE and
# BCI_RUNTIME_IMAGE build arguments), pinned here by digest. Bump them, and
# TUIST_BUILD, to pick up SUSE package fixes.
BCI_BUILD_IMAGE=registry.suse.com/bci/bci-base:16.0@sha256:38bb07164a0b64c429a285e877277d618fa7531eccd0d31d34375b9ea247c843
BCI_RUNTIME_IMAGE=registry.suse.com/bci/bci-minimal:16.0@sha256:affb8e286c9a536cb0d92a9c20b6f848082dfea48db6df3cbbc1162ed3ced15e

# Our build number for FORK_TAG. Published tags are immutable: bump it for any
# change that alters the images (patches, toolchains, base images), and reset
# it to 1 when FORK_TAG changes.
TUIST_BUILD=1

# Toolchains, as the fork's own release uses them. The controller binaries are
# built with Rancher's hardened Go image (BoringCrypto, static), which `make
# build` selects from GOLANG_VERSION (1.26.11): rancher/hardened-build-base:
# v<GOLANG_VERSION>b1. kube-webhook-certgen builds FROM golang:<GOLANG_VERSION>.
GO_BUILD_IMAGE=rancher/hardened-build-base:v1.26.11b1@sha256:22cf9af80ad1d59b604013fea4e0f8f95ebed13dbf227b6b8b729f92660b28c5
GO_IMAGE_DEBIAN_TAG=1.26.11@sha256:4165ee6bf3b7811fd7b40373290405c83d0167dcb87ee5f29c427cdcef45ff8f

# Images verify.sh compares ours with. These builds are not drop-in
# replacements for either (see README.md), so differences are reported, not
# fatal: the official chart 4.15.1 images, and the Chainguard-fork build the
# platform and rack-cache-gateways charts run today.
UPSTREAM_CONTROLLER_IMAGE=registry.k8s.io/ingress-nginx/controller:v1.15.1@sha256:594ceea76b01c592858f803f9ff4d2cb40542cae2060410b2c95f75907d659e1
UPSTREAM_CERTGEN_IMAGE=registry.k8s.io/ingress-nginx/kube-webhook-certgen:v1.6.9@sha256:01038e7de14b78d702d2849c3aad72fd25903c4765af63cf16aa3398f5d5f2dd
CURRENT_CONTROLLER_IMAGE=ghcr.io/tuist/ingress-nginx-controller:v1.15.16-tuist.1@sha256:85740990b9ec9a27dfa0f4bd62f522f16cda7d3406d7e6195a63be8ff39a5771
CURRENT_CERTGEN_IMAGE=ghcr.io/tuist/ingress-nginx-kube-webhook-certgen:v1.15.16-tuist.1@sha256:e2fb85522b193171ffec2fdfe39d620c2014e1e4090fd50f73c5cf32f6e724bb
