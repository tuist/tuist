diff --git a/Sources/tart/ResumeProfile.swift b/Sources/tart/ResumeProfile.swift
new file mode 100644
index 0000000..bbd1ed0
--- /dev/null
+++ b/Sources/tart/ResumeProfile.swift
@@ -0,0 +1,23 @@
+// Benchmark-only instrumentation. No paths, arguments or guest data are logged.
+import Foundation
+import Darwin
+
+private let resumeProfileEnabled = ProcessInfo.processInfo.environment["TUIST_TART_PROFILE"] == "1"
+
+func resumeProfile(_ event: String) {
+  guard resumeProfileEnabled else { return }
+  let uptime = DispatchTime.now().uptimeNanoseconds
+  var usage = rusage()
+  getrusage(RUSAGE_SELF, &usage)
+  let cpuUS = Int64(usage.ru_utime.tv_sec + usage.ru_stime.tv_sec) * 1_000_000
+    + Int64(usage.ru_utime.tv_usec + usage.ru_stime.tv_usec)
+  let record: [String: Any] = [
+    "event": event, "uptime_ns": uptime, "pid": getpid(),
+    "cpu_us": cpuUS, "max_rss_bytes": usage.ru_maxrss,
+    "page_faults": usage.ru_majflt, "block_inputs": usage.ru_inblock,
+  ]
+  if let json = try? JSONSerialization.data(withJSONObject: record, options: [.sortedKeys]) {
+    // Direct write avoids stdout buffering changing observed phase boundaries.
+    FileHandle.standardError.write(Data("TUIST_RESUME_PROFILE ".utf8) + json + Data("\n".utf8))
+  }
+}
