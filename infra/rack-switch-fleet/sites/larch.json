    "edge": {
      "description": "WAN termination, the path every other node reaches the internet through, the management segment's DHCP, the ToRs' zero-touch provisioning and consoles, and the tailnet subnet routes. Two of them, active and standby, sharing the floating addresses through keepalived"
    },
    "storage": {
      "description": "bulk storage: the cache volumes the runners pull from, beside them on their segment",
      "segment": "machines"
    },
    "runner": {
      "description": "Mac mini running the runner fleet",
      "segment": "machines"
    },
    "power": {
      "description": "PDU or transfer-switch management card"
    }
