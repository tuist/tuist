# syntax=docker/dockerfile:1.7

# Runtime-only image for releases. The Kura binaries are compiled natively
# (amd64 and arm64) by the release-kura-binaries job and copied in here, so
# this build performs no compilation and needs no QEMU-emulated Rust build.
# The base is ubuntu:24.04 to match the glibc/libstdc++ of the runners that
# produce those binaries.

FROM ubuntu:24.04@sha256:68ee22004a9109b44973313b02ff7b1de250f1de0f5ecb628d73f579aaff33ac

ARG TARGETARCH

COPY --from=certificate-trust /pem-store.sh /policy.json /opt/tuist/certificate-trust/

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      ca-certificates \
      openssl \
      curl \
      tini \
      libstdc++6 && \
    sed -i -e 's|^mozilla/emSign_ECC_Root_CA_-_G3.crt|!&|' -e 's|^mozilla/Comodo_AAA_Services_root.crt|!&|' /etc/ca-certificates.conf && \
    update-ca-certificates && \
    bash /opt/tuist/certificate-trust/pem-store.sh check /etc/ssl/certs/ca-certificates.crt && \
    rm -rf /var/lib/apt/lists/*

ENV RUST_LOG=info

WORKDIR /app

COPY bin/${TARGETARCH}/kura /usr/local/bin/kura

EXPOSE 4000

ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/kura"]
