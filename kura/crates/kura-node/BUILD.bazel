load("@crates//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("//bazel:deny_warnings.bzl", "DENY_WARNINGS")
load("//bazel:rust_junit_test.bzl", "rust_junit_test")
load("//bazel:version.bzl", "KURA_VERSION")

# The running node below its REAPI services (state, HTTP, replication, auth, analytics). Named
# after the Cargo package because rules_rs maps the `kura-node` dependency of the crates above to
# this label.
rust_library(
    name = "kura-node",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    crate_name = "kura_node",
    edition = "2024",
    # tuist-memory-gb also sets the remote-execution VM's CPUs (two per 4 GB), and rustc's codegen
    # spreads across them. Ignored outside remote execution.
    rustc_flags = DENY_WARNINGS,
    version = KURA_VERSION,
    visibility = ["//visibility:public"],
    deps = all_crate_deps(normal = True),
)

# A test binary must link one kura_core, so the test-support variants depend on each other rather
# than on the shipped libraries.
_TEST_ALIASES = dict(aliases())

_TEST_ALIASES.update({"//crates/kura-core:kura_core_test_support": "kura_core"})

_TEST_DEPS = all_crate_deps(cargo_only = True, normal = True) + [
    "//crates/kura-core:kura_core_test_support",
]

# The crate with its `test-support` feature, which the unit tests of the crates above build on.
# Only test binaries link it, so the shipped binary never contains the test helpers.
rust_library(
    name = "kura_node_test_support",
    srcs = glob(["src/**/*.rs"]),
    aliases = _TEST_ALIASES,
    crate_features = ["test-support"],
    crate_name = "kura_node",
    edition = "2024",
    # Only test binaries link it, and it is on their critical path, so like them it skips rustc's
    # crate-local ThinLTO.
    rustc_flags = DENY_WARNINGS + ["-Clto=off"],
    version = KURA_VERSION,
    visibility = [
        "//:__pkg__",
        "//crates/kura-reapi:__pkg__",
    ],
    deps = _TEST_DEPS,
)

rust_junit_test(
    name = "kura_node_test",
    srcs = glob(["src/**/*.rs"]),
    aliases = _TEST_ALIASES,
    crate_name = "kura_node",
    crate_root = "src/lib.rs",
    edition = "2024",
    # The largest of the test binaries; rustc needs more than the default 4 GiB VM, and the 16 GB
    # VM's 8 vCPUs shorten the compile. Ignored outside remote execution.
    # The suite waits on timeouts more than it uses CPU, so shards run it in parallel VMs.
    shard_count = 4,
    # Test binaries skip rustc's crate-local ThinLTO: it is a large share of the compile and the
    # tests run just as fast without it.
    rustc_flags = DENY_WARNINGS + ["-Clto=off"],
    size = "medium",
    version = KURA_VERSION,
    deps = all_crate_deps(cargo_only = True, normal = True, normal_dev = True) + [
        "//crates/kura-core:kura_core_test_support",
    ],
)
