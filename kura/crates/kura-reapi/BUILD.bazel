load("@crates//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("//bazel:deny_warnings.bzl", "DENY_WARNINGS")
load("//bazel:rust_junit_test.bzl", "rust_junit_test")
load("//bazel:version.bzl", "KURA_VERSION")

# Kura's REAPI services, on top of kura-node. Named after the Cargo package because rules_rs maps
# the kura crate's `kura-reapi` dependency to this label.
rust_library(
    name = "kura-reapi",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    crate_name = "kura_reapi",
    edition = "2024",
    # tuist-memory-gb also sets the remote-execution VM's CPUs (two per 4 GB), and rustc's codegen
    # spreads across them. Ignored outside remote execution.
    exec_properties = {"tuist-memory-gb": "8"},
    rustc_flags = DENY_WARNINGS,
    version = KURA_VERSION,
    visibility = ["//visibility:public"],
    deps = all_crate_deps(normal = True),
)

# A test binary must link one kura_core and one kura_node, so the test variants link the
# test-support variants below (see //crates/kura-node).
_TEST_ALIASES = dict(aliases())

_TEST_ALIASES.update({
    "//crates/kura-core:kura_core_test_support": "kura_core",
    "//crates/kura-node:kura_node_test_support": "kura_node",
})

_TEST_DEPS = all_crate_deps(cargo_only = True, normal = True) + [
    "//crates/kura-core:kura_core_test_support",
    "//crates/kura-node:kura_node_test_support",
]

# The crate as the kura crate's unit tests link it.
rust_library(
    name = "kura_reapi_test_support",
    srcs = glob(["src/**/*.rs"]),
    aliases = _TEST_ALIASES,
    crate_name = "kura_reapi",
    edition = "2024",
    exec_properties = {"tuist-memory-gb": "8"},
    # Only test binaries link it, and it is on their critical path, so like them it skips rustc's
    # crate-local ThinLTO.
    rustc_flags = DENY_WARNINGS + ["-Clto=off"],
    version = KURA_VERSION,
    visibility = ["//:__pkg__"],
    deps = _TEST_DEPS,
)

rust_junit_test(
    name = "kura_reapi_test",
    srcs = glob(["src/**/*.rs"]),
    aliases = _TEST_ALIASES,
    crate_name = "kura_reapi",
    crate_root = "src/lib.rs",
    edition = "2024",
    exec_properties = {"tuist-memory-gb": "8"},
    # The suite waits on timeouts more than it uses CPU, so shards run it in parallel VMs.
    shard_count = 2,
    # Test binaries skip rustc's crate-local ThinLTO: it is a large share of the compile and the
    # tests run just as fast without it.
    rustc_flags = DENY_WARNINGS + ["-Clto=off"],
    size = "medium",
    version = KURA_VERSION,
    deps = all_crate_deps(cargo_only = True, normal = True, normal_dev = True) + [
        "//crates/kura-core:kura_core_test_support",
        "//crates/kura-node:kura_node_test_support",
    ],
)
