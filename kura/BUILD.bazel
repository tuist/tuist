load("@crates//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rs//rs:rust_binary.bzl", "rust_binary")
load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("//bazel:deny_warnings.bzl", "DENY_WARNINGS")
load("//bazel:rust_junit_test.bzl", "rust_junit_test")
load("//bazel:version.bzl", "KURA_VERSION")


# CI-only gate: deny warnings on the first-party crates (the bazel equivalent of cargo's
# RUSTFLAGS="-D warnings"). Off by default so local `bazel build` / `mise run compile`
# stay warning-tolerant, like `cargo build` locally; CI flips it on with
# `--define=kura_deny_warnings=true`. It is referenced only by the targets below, so the
# third-party crate graph never receives -Dwarnings (cargo caps lints on deps).
config_setting(
    name = "deny_warnings",
    define_values = {"kura_deny_warnings": "true"},
    visibility = ["//visibility:public"],
)

# The kura crate is a lib + bin: main.rs calls `kura::run()`, so the library must compile under the
# crate name `kura`.
# (rules_rs folds proc-macro deps into all_crate_deps, so there is no separate proc_macro_deps.)
rust_library(
    name = "kura_lib",
    srcs = glob(["src/**/*.rs"], exclude = ["src/main.rs"]),
    aliases = aliases(),
    crate_name = "kura",
    edition = "2024",
    rustc_flags = DENY_WARNINGS,
    version = KURA_VERSION,
    visibility = ["//visibility:public"],
    deps = all_crate_deps(normal = True),
)

rust_binary(
    name = "kura",
    srcs = ["src/main.rs"],
    aliases = aliases(),
    edition = "2024",
    rustc_flags = DENY_WARNINGS,
    version = KURA_VERSION,
    visibility = ["//visibility:public"],
    deps = all_crate_deps(normal = True) + [":kura_lib"],
)

rust_junit_test(
    name = "kura_bin_test",
    srcs = ["src/main.rs"],
    aliases = aliases(),
    edition = "2024",
    rustc_flags = DENY_WARNINGS,
    size = "small",
    deps = all_crate_deps(normal = True, normal_dev = True) + [":kura_lib"],
)

# A test binary must link one kura_core and one kura_node, so the kura crate's test binary links
# the test-support variants of the crates below it rather than reusing kura_lib's dependencies.
_TEST_ALIASES = dict(aliases())

_TEST_ALIASES.update({
    "//crates/kura-core:kura_core_test_support": "kura_core",
    "//crates/kura-node:kura_node_test_support": "kura_node",
    "//crates/kura-reapi:kura_reapi_test_support": "kura_reapi",
})

# Compiles the kura crate with --test so its #[cfg(test)] unit tests run under `bazel test`.
rust_junit_test(
    name = "kura_lib_test",
    srcs = glob(["src/**/*.rs"], exclude = ["src/main.rs"]),
    aliases = _TEST_ALIASES,
    crate_name = "kura",
    crate_root = "src/lib.rs",
    edition = "2024",
    # Test binaries skip rustc's crate-local ThinLTO: it is a large share of the compile and the
    # tests run just as fast without it. The libraries and shipped binary keep the default.
    rustc_flags = DENY_WARNINGS + ["-Clto=off"],
    size = "medium",
    version = KURA_VERSION,
    deps = all_crate_deps(
        cargo_only = True,
        normal = True,
        normal_dev = True,
    ) + [
        "//crates/kura-core:kura_core_test_support",
        "//crates/kura-node:kura_node_test_support",
        "//crates/kura-reapi:kura_reapi_test_support",
    ],
)
