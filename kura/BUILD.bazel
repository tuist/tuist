load("@crates//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rs//rs:rust_binary.bzl", "rust_binary")
load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("//bazel:rust_junit_test.bzl", "rust_junit_test")
load("//bazel:version.bzl", "KURA_VERSION")


# CI-only gate: deny warnings on the first-party crates (the bazel equivalent of cargo's
# RUSTFLAGS="-D warnings"). Off by default so local `bazel build` / `mise run compile`
# stay warning-tolerant, like `cargo build` locally; CI flips it on with
# `--define=kura_deny_warnings=true`. It is referenced only by the targets below, so the
# third-party crate graph never receives -Dwarnings (cargo caps lints on deps).
config_setting(
    name = "deny_warnings",
    define_values = {"kura_deny_warnings": "true"},
    visibility = ["//visibility:public"],
)

_DENY_WARNINGS = select({
    "//:deny_warnings": ["-Dwarnings"],
    "//conditions:default": [],
})

# The kura crate is a lib + bin: main.rs calls `kura::run()`, so the library must compile under the
# crate name `kura`. test_support.rs is `#[cfg(test)]`, so it is inert in this non-test build.
# (rules_rs folds proc-macro deps into all_crate_deps, so there is no separate proc_macro_deps.)
rust_library(
    name = "kura_lib",
    srcs = glob(["src/**/*.rs"], exclude = ["src/main.rs"]),
    aliases = aliases(),
    crate_name = "kura",
    edition = "2024",
    # This crate and its test binary are the longest compiles in the build, and the kura binary
    # waits on this one. tuist-memory-gb also sets the remote-execution VM's CPUs (two per 4 GB),
    # and rustc's codegen spreads across them. Ignored outside remote execution.
    exec_properties = {"tuist-memory-gb": "8"},
    rustc_flags = _DENY_WARNINGS,
    version = KURA_VERSION,
    visibility = ["//visibility:public"],
    deps = all_crate_deps(normal = True),
)

rust_binary(
    name = "kura",
    srcs = ["src/main.rs"],
    aliases = aliases(),
    edition = "2024",
    rustc_flags = _DENY_WARNINGS,
    version = KURA_VERSION,
    visibility = ["//visibility:public"],
    deps = all_crate_deps(normal = True) + [":kura_lib"],
)

rust_junit_test(
    name = "kura_bin_test",
    srcs = ["src/main.rs"],
    aliases = aliases(),
    edition = "2024",
    rustc_flags = _DENY_WARNINGS,
    size = "small",
    deps = all_crate_deps(normal = True, normal_dev = True) + [":kura_lib"],
)

# The kura crate.s unit tests reach into kura-core through its test-support helpers, so the test
# binary links that variant of kura-core rather than reusing kura_lib.s dependencies.
_TEST_ALIASES = dict(aliases())

_TEST_ALIASES.update({"//crates/kura-core:kura_core_test_support": "kura_core"})

# Compiles the kura crate with --test so its #[cfg(test)] unit tests (and the test_support module)
# run under `bazel test`.
rust_junit_test(
    name = "kura_lib_test",
    srcs = glob(["src/**/*.rs"], exclude = ["src/main.rs"]),
    aliases = _TEST_ALIASES,
    crate_name = "kura",
    crate_root = "src/lib.rs",
    edition = "2024",
    # rustc peaks near 6.5 GB compiling the crate as a test binary, more than the default 4 GiB
    # remote-execution VM holds. The 16 GB VM also has 8 vCPUs, which took the compile from about
    # 123 s to 81 s on production remote execution. Ignored outside remote execution.
    exec_properties = {"tuist-memory-gb": "16"},
    # The suite is wait-bound: about 90 s of test time but under 10 s of CPU, mostly timeouts and
    # sleeps, and libtest runs one case per CPU, so the default 2 vCPU remote-execution VM took
    # 45 s. Shards run in parallel VMs at the same per-VM concurrency; more test threads instead
    # made a store test that races two tasks fail.
    shard_count = 4,
    # Test binaries skip rustc's crate-local ThinLTO, which took 55 s of this one's 150 s compile,
    # the longest action in the build. Tests run just as fast without it, and the libraries and
    # shipped binary keep the default.
    rustc_flags = _DENY_WARNINGS + ["-Clto=off"],
    size = "medium",
    version = KURA_VERSION,
    deps = all_crate_deps(
        cargo_only = True,
        normal = True,
        normal_dev = True,
    ) + ["//crates/kura-core:kura_core_test_support"],
)
