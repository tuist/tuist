"""Kura — distributed cache mesh (Rust).

Bazel foundation: workspace skeleton, the host Rust + C/C++ toolchains, and the
third-party crate graph — enough to build the lib, binary, and tests. Each
release arch is built natively on a runner of that arch (no cross-compilation).
The runtime OCI image (rules_oci/rules_pkg/rules_distroless + the apt layers)
is added in a later change; it is intentionally not part of this foundation.
"""

module(
    name = "kura",
)

bazel_dep(name = "rules_cc", version = "0.2.19")

# Referenced by //bazel/platforms' constraint values; @platforms is only visible from the root
# module when the root declares it, even though deps pull it in transitively.
bazel_dep(name = "platforms", version = "1.1.0")

# sh_test wrapper around rust_test binaries (see //bazel:rust_junit_test.bzl). Bazel 8 removed
# native.sh_test, so rules_shell has to be declared explicitly even though rules_cc pulls it in
# transitively for its own cc_test wiring.
bazel_dep(name = "rules_shell", version = "0.8.0")

# Crate graph + Rust toolchains via rules_rs: it resolves the third-party crates directly from
# Cargo.toml/Cargo.lock for the platform_triples below, regenerating on each build with no committed
# crate lockfile, so the same checked-in tree builds identically on every host.
bazel_dep(name = "rules_rs", version = "0.0.108")

# rocksdb (librocksdb-sys) compiles its C++ with the LZ4 compression backend on (the only one its
# resolved feature set enables here). lz4 comes from the BCR @lz4 module: it's linked into lz4-sys
# (replacing lz4-sys's own build script) and its headers are fed to rocksdb's build script (see the
# librocksdb-sys annotation below for why rules_rs can't propagate them automatically).
bazel_dep(name = "lz4", version = "1.10.0.bcr.1")

# Pin the Rust toolchain to match rust-toolchain.toml / mise.toml (1.94.1, edition 2024). Each arch
# is built natively on a runner of that arch; the C/C++ for the -sys crates (rocksdb, aws-lc,
# jemalloc) comes from the autodetected host cc toolchain (no cross C/C++ toolchain).
toolchains = use_extension("@rules_rs//rs/toolchains:module_extension.bzl", "toolchains")
toolchains.toolchain(
    edition = "2024",
    version = "1.94.1",
)
use_repo(toolchains, "default_rust_toolchains")

register_toolchains("@default_rust_toolchains//...")

# Make @rules_rust visible here so labels that name it resolve from this module: the clippy aspect
# (@rules_rust//rust:defs.bzl%rust_clippy_aspect) on the `mise run clippy` command line, and the
# use_hermetic_macos_sdkroot flag set in .bazelrc. rules_rs already provisions this repo;
# re-importing its extension only adds it to our repo mapping, it does not create a second copy.
rules_rust = use_extension("@rules_rs//rs:rules_rust.bzl", "rules_rust")
use_repo(rules_rust, "rules_rust")

crate = use_extension("@rules_rs//rs:extensions.bzl", "crate")

# lz4-sys: link the BCR @lz4 cc_library instead of compiling lz4 from the crate's own build script
# (rules_rs's well-known -sys pattern). This satisfies lz4-sys's own Rust linking, but it does NOT
# feed lz4's headers to librocksdb-sys's build script (see below).
crate.annotation(
    crate = "lz4-sys",
    gen_build_script = "off",
    deps = [
        "@lz4//:lz4",
        "@lz4//:lz4_hc",
        "@lz4//:lz4_frame",
    ],
)

# aws-lc-sys's build script compiles all of AWS-LC (377 C and assembly files) inside one action,
# which sits on the path to everything that links rustls. We compile the same vendored sources as
# cc_library targets instead (the same move as rocksdb below), so each file is its own cacheable
# action that remote execution spreads across workers, and turn the build script off. Without it
# nothing emits --cfg=universal (which selects the crate's pregenerated, prefixed bindings) or the
# DEP_AWS_LC_* variables, so we pass the cfg here and give aws-lc-rs the one variable its build
# script asserts on. Sources, defines, and flags mirror builder/cc_builder.rs; on an aws-lc-sys bump,
# regenerate //bazel/third_party/aws_lc:aws_lc_sources.bzl and the prefix and repo names below.
crate.annotation(
    crate = "aws-lc-sys",
    gen_build_script = "off",
    rustc_flags = ["--cfg=universal"],
    deps = ["@crates//:aws_lc_cc-0.45.0"],
    extra_aliased_targets = {"aws_lc_cc": "aws_lc_crypto"},
    additive_build_file_content = """
# Injected into aws-lc-sys's generated BUILD; refs use canonical repo names (see librocksdb-sys).
load("@@rules_cc+//cc:defs.bzl", "cc_library")
load(
    "@@//bazel/third_party/aws_lc:aws_lc_sources.bzl",
    "AWS_LC_APPLE_AARCH64_ASM",
    "AWS_LC_APPLE_AARCH64_S2N",
    "AWS_LC_APPLE_X86_64_ASM",
    "AWS_LC_APPLE_X86_64_S2N",
    "AWS_LC_C",
    "AWS_LC_JITTER",
    "AWS_LC_LINUX_AARCH64_ASM",
    "AWS_LC_LINUX_AARCH64_S2N",
    "AWS_LC_LINUX_X86_64_ASM",
    "AWS_LC_LINUX_X86_64_S2N",
)

# Symbols get the crate's prefix (aws_lc_0_45_0_*), which its pregenerated bindings link against.
# generated-include must come first: aws-lc/include has stub copies of the prefix headers.
_AWS_LC_INCLUDES = [
    "generated-include",
    "include",
    "aws-lc/include",
    "aws-lc/third_party/s2n-bignum/include",
    "aws-lc/third_party/s2n-bignum/s2n-bignum-imported/include",
    "aws-lc/third_party/jitterentropy/jitterentropy-library",
    "aws-lc/third_party/jitterentropy/jitterentropy-library/src",
]

_AWS_LC_PREFIX_DEFINES = [
    "BORINGSSL_IMPLEMENTATION=1",
    "BORINGSSL_PREFIX=aws_lc_0_45_0",
]

_AWS_LC_HDRS = glob(["generated-include/**/*.h", "include/**/*.h", "aws-lc/**/*.h"])

# Sources that other sources #include.
_AWS_LC_TEXTUAL_HDRS = glob(["aws-lc/**/*.c", "aws-lc/**/*.inc", "aws-lc/**/*.S"])

# What the crate's compiler checks find on the toolchains we build with (run_compiler_checks).
_AWS_LC_DEFINES = _AWS_LC_PREFIX_DEFINES + [
    "AWS_LC_STDALIGN_AVAILABLE=1",
    "AWS_LC_BUILTIN_SWAP_SUPPORTED=1",
] + select({
    "@@platforms//os:linux": ["_XOPEN_SOURCE=700", "HAVE_LINUX_RANDOM_H=1"],
    "@@platforms//os:macos": ["_DARWIN_C_SOURCE=1"],
    "//conditions:default": [],
})

_AWS_LC_COPTS = ["-std=c11", "-Wno-unused-parameter", "-pthread"] + select({
    "@@platforms//os:linux": ["-Wa,--noexecstack"],
    "//conditions:default": [],
})

# Each platform compiles its own assembly; the crate's builder picks it by target OS and arch.
[
    config_setting(
        name = os + "_" + cpu,
        constraint_values = ["@@platforms//os:" + os, "@@platforms//cpu:" + cpu],
    )
    for os in ["linux", "macos"]
    for cpu in ["x86_64", "aarch64"]
]

# s2n-bignum assembly, with the assembly symbol-prefix header forced in.
cc_library(
    name = "aws_lc_s2n_bignum",
    srcs = select({
        ":linux_x86_64": AWS_LC_LINUX_X86_64_S2N,
        ":linux_aarch64": AWS_LC_LINUX_AARCH64_S2N,
        ":macos_x86_64": AWS_LC_APPLE_X86_64_S2N,
        ":macos_aarch64": AWS_LC_APPLE_AARCH64_S2N,
    }),
    hdrs = _AWS_LC_HDRS,
    textual_hdrs = _AWS_LC_TEXTUAL_HDRS,
    includes = _AWS_LC_INCLUDES,
    local_defines = _AWS_LC_DEFINES + ["S2N_BN_HIDE_SYMBOLS=1"],
    copts = _AWS_LC_COPTS + ["--include=openssl/boringssl_prefix_symbols_asm.h"],
    linkstatic = True,
)

# CPU jitter entropy must be built without optimization.
cc_library(
    name = "aws_lc_jitterentropy",
    srcs = AWS_LC_JITTER,
    hdrs = _AWS_LC_HDRS,
    textual_hdrs = _AWS_LC_TEXTUAL_HDRS,
    includes = _AWS_LC_INCLUDES,
    local_defines = _AWS_LC_PREFIX_DEFINES + ["AWSLC=1"] + select({
        "@@platforms//os:macos": ["_DARWIN_C_SOURCE=1"],
        "//conditions:default": [],
    }),
    copts = [
        "--include=openssl/boringssl_prefix_symbols.h",
        "-fwrapv",
        "--param",
        "ssp-buffer-size=4",
        "-fvisibility=hidden",
        "-O0",
        "-U_FORTIFY_SOURCE",
    ],
    linkstatic = True,
)

cc_library(
    name = "aws_lc_crypto",
    srcs = AWS_LC_C + select({
        ":linux_x86_64": AWS_LC_LINUX_X86_64_ASM,
        ":linux_aarch64": AWS_LC_LINUX_AARCH64_ASM,
        ":macos_x86_64": AWS_LC_APPLE_X86_64_ASM,
        ":macos_aarch64": AWS_LC_APPLE_AARCH64_ASM,
    }),
    hdrs = _AWS_LC_HDRS,
    textual_hdrs = _AWS_LC_TEXTUAL_HDRS,
    includes = _AWS_LC_INCLUDES,
    local_defines = _AWS_LC_DEFINES,
    copts = _AWS_LC_COPTS,
    linkstatic = True,
    deps = [":aws_lc_s2n_bignum", ":aws_lc_jitterentropy"],
    visibility = ["//visibility:public"],
)
""",
)

# aws-lc-rs's build script re-exports aws-lc-sys's DEP_AWS_LC_* variables and asserts that the
# include one is set. With aws-lc-sys's build script off (above) nothing sets it, and no crate here
# reads the re-exported value, so any value satisfies the assertion.
crate.annotation(
    crate = "aws-lc-rs",
    build_script_env = {"DEP_AWS_LC_0_45_0_INCLUDE": "unused"},
)

# rules_rust runs every Cargo build script with NUM_JOBS=1, so jemalloc's build runs `make -j1`. It
# lies on the path to the test binary, and a build script action gets two CPUs (the default
# remote-execution VM is 2 vCPUs), so let it use both: on two cores this takes tikv-jemalloc-sys
# from 38 s to 20 s.
crate.annotation(
    crate = "tikv-jemalloc-sys",
    build_script_env = {"NUM_JOBS": "2"},
)

# librocksdb-sys's build script compiles rocksdb's C++ with the LZ4 backend (#include <lz4.h>) and
# reads the include dir from $DEP_LZ4_INCLUDE. rules_rs mis-propagates that path across crates,
# leaving an unresolved `${out_dir}` token (hermeticbuild/rules_rs#163), so we set it ourselves:
# lz4-sys's build script is off (above) and DEP_LZ4_INCLUDE points at a directory of lz4 headers
# materialized from the BCR @lz4 cc_library — cc-rs's config.include() wants a directory, which
# $(execpath //bazel/third_party/lz4:lz4_include) yields. Only LZ4 is enabled; if a rocksdb feature
# later turns on zlib/bzip2, repeat this for DEP_Z_INCLUDE / DEP_BZIP2_INCLUDE.
# We compile rocksdb's C++ as a first-class cc_library (//bazel/third_party/rocksdb) from the
# sources vendored in this crate, rather than letting the build script cold-compile it on every
# build — an opaque cargo build script caches unreliably, whereas a hermetic cc_library is served
# from the remote cache (the same move already made for lz4/lua above). The build script still runs
# bindgen against the crate's vendored 10.4.2 headers, so the FFI matches the archive we link.
#
# `additive_build_file_content` defines that cc_library inside this crate's package (so its includes
# resolve against the vendored `rocksdb/` tree) and `extra_aliased_targets` re-exposes it on the
# @crates hub as `rocksdb_cc`. The hub alias cannot be called `rocksdb`: rules_rs also generates an
# unversioned alias of that name for the `rocksdb` crate itself, and two aliases with one name are a
# package error. Setting ROCKSDB_LIB_DIR/ROCKSDB_STATIC makes build.rs link the prebuilt
# archive and skip `build_rocksdb()` (which is what read DEP_LZ4_INCLUDE — now inert but kept as a
# cold-build fallback). On a librocksdb-sys bump, regenerate rocksdb_lib_sources.bzl and the version
# in //bazel/third_party/rocksdb.
crate.annotation(
    crate = "librocksdb-sys",
    build_script_data = [
        "@@//bazel/third_party/lz4:lz4_include",
        "@@//bazel/third_party/rocksdb:rocksdb_lib_dir",
    ],
    build_script_env = {
        "DEP_LZ4_INCLUDE": "$(execpath @@//bazel/third_party/lz4:lz4_include)",
        "ROCKSDB_LIB_DIR": "$(execpath @@//bazel/third_party/rocksdb:rocksdb_lib_dir)",
        "ROCKSDB_STATIC": "1",
    },
    deps = ["@crates//:rocksdb_cc-0.17.3+10.4.2"],
    extra_aliased_targets = {"rocksdb_cc": "rocksdb"},
    additive_build_file_content = """
# This content is injected into librocksdb-sys's generated BUILD, which does not inherit our
# module's apparent repo names, so refs use canonical names: @@rules_cc+, @@lz4+, @@platforms, and
# @@// for our own main-repo targets.
load("@@rules_cc+//cc:defs.bzl", "cc_library")
load("@@//bazel/third_party/rocksdb:rocksdb_lib_sources.bzl", "ROCKSDB_LIB_SOURCES")

# RocksDB 10.4.2 from this crate's vendored sources. srcs/includes/defines/copts mirror the crate's
# build.rs so the compiled ABI matches the bindgen'd headers. Only the LZ4 backend is enabled, to
# match the `lz4` cargo feature; lz4 headers come from the BCR @lz4 module (also linked by lz4-sys).
cc_library(
    name = "rocksdb",
    srcs = ROCKSDB_LIB_SOURCES + ["build_version.cc"] + glob(["rocksdb/**/*.h"]),
    includes = [
        "rocksdb/include",
        "rocksdb",
        "rocksdb/third-party/gtest-1.8.1/fused-src",
        ".",
    ],
    local_defines = [
        "NDEBUG",
        "ROCKSDB_SUPPORT_THREAD_LOCAL",
        "LZ4",
    ] + select({
        "@@platforms//os:linux": [
            "OS_LINUX",
            "ROCKSDB_PLATFORM_POSIX",
            "ROCKSDB_LIB_IO_POSIX",
            "ROCKSDB_SCHED_GETCPU_PRESENT",
        ],
        "@@platforms//os:macos": [
            "OS_MACOSX",
            "ROCKSDB_PLATFORM_POSIX",
            "ROCKSDB_LIB_IO_POSIX",
        ],
        "//conditions:default": [],
    }),
    copts = [
        "-std=c++17",
        "-Wno-unused-parameter",
        "-Wno-unused-variable",
        "-Wno-missing-field-initializers",
        "-Wno-strict-aliasing",
        "-Wno-invalid-offsetof",
    ] + select({
        "@@platforms//cpu:x86_64": ["-msse2"],
        "//conditions:default": [],
    }) + select({
        "@@platforms//os:macos": [
            "-include",
            "cstdint",
        ],
        "//conditions:default": [],
    }),
    deps = [
        "@@lz4+//:lz4",
        "@@lz4+//:lz4_hc",
        "@@lz4+//:lz4_frame",
    ],
    visibility = ["//visibility:public"],
)
""",
)
crate.from_cargo(
    name = "crates",
    cargo_lock = "//:Cargo.lock",
    cargo_toml = "//:Cargo.toml",
    platform_triples = [
        "aarch64-apple-darwin",
        "aarch64-unknown-linux-gnu",
        "x86_64-apple-darwin",
        "x86_64-unknown-linux-gnu",
    ],
)
use_repo(crate, "crates")
