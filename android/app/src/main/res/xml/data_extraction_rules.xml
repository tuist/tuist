<?xml version="1.0" encoding="utf-8"?>
<!-- Push installation IDs identify one physical device and must not be restored onto another. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="tuist_push.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="tuist_push.xml" />
    </device-transfer>
</data-extraction-rules>
