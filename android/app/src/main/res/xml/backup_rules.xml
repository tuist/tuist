<?xml version="1.0" encoding="utf-8"?>
<!-- Push installation IDs and notification permission state belong to one physical device and must not be restored onto another. -->
<full-backup-content>
    <exclude domain="sharedpref" path="tuist_secure_prefs.xml" />
    <exclude domain="sharedpref" path="tuist_push.xml" />
    <exclude domain="sharedpref" path="tuist_notifications.xml" />
</full-backup-content>
