#!/bin/sh

# A single process needs no distribution or image-baked cookie. Kubernetes DNS
# advertises peer pod IPs, including unready pods, so startup never waits on HTTP.
if [ -n "${DNS_CLUSTER_QUERY:-}" ]; then
  if [ -z "${POD_IP:-}" ]; then
    echo "DNS_CLUSTER_QUERY requires POD_IP for the distributed node name." >&2
    exit 1
  fi
  export RELEASE_DISTRIBUTION=name
  export RELEASE_NODE="luft_server@${POD_IP}"
else
  export RELEASE_DISTRIBUTION="${RELEASE_DISTRIBUTION:-none}"
fi

# Only server processes take the fixed port. Remote release commands need their
# own ephemeral listener. Never fall back to the release's image-baked cookie.
case "${RELEASE_COMMAND:-}" in
  start*|daemon*)
    if [ "$RELEASE_DISTRIBUTION" != none ]; then
      case "${RELEASE_COOKIE:-}" in
        ""|*[[:space:]]*)
          echo "Distributed Luft startup requires an explicit private RELEASE_COOKIE without whitespace." >&2
          exit 1
          ;;
      esac
      export ELIXIR_ERL_OPTIONS="${ELIXIR_ERL_OPTIONS:-} -kernel inet_dist_listen_min 9100 inet_dist_listen_max 9100"
    fi
    ;;
esac
