# See https://docs.docker.com/engine/reference/builder/#dockerignore-file

.dockerignore

# Keep .git/HEAD and refs so we can resolve the build's commit SHA.
.git
!.git/HEAD
!.git/refs

# Dev/test artifacts
/cover/
/doc/
/test/
/tmp/
.elixir_ls

# Mix + Rust build outputs
/_build/
/deps/
*.ez
native/**/target/

# priv/native is regenerated by the NIF compile inside the image; the
# host artifacts are OS-specific and would bloat the build context.
priv/native/

# Editor + OS junk
.DS_Store
.idea/
.vscode/

# Scratch / superconductor state
.superconductor/
.super.engineering/

# Local override configs
mise.local.toml

# Runtime crash dumps
erl_crash.dump
