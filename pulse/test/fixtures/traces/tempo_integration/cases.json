{
  "batches": [
    {"spanCount": 2, "name": "foo", "resourceAttr": "firstRes", "resourceAttVal": "bar", "spanAttr": "firstSpan", "spanAttVal": "bar"},
    {"spanCount": 2, "name": "baz", "resourceAttr": "secondRes", "resourceAttVal": "qux", "spanAttr": "secondSpan", "spanAttVal": "qux"},
    {"spanCount": 2, "name": "foo", "resourceAttr": "twoRes", "resourceAttVal": "bar", "spanAttr": "twoSpan", "spanAttVal": "bar"},
    {"spanCount": 2, "name": "baz", "resourceAttr": "twoRes", "resourceAttVal": "qux", "spanAttr": "twoSpan", "spanAttVal": "qux"},
    {"spanCount": 2, "name": "foo", "resourceAttr": "secondRes", "resourceAttVal": "qux", "spanAttr": "secondSpan", "spanAttVal": "bar"},
    {"spanCount": 2, "name": "boo", "resourceAttr": "sameAttr", "resourceAttVal": "qux", "spanAttr": "someSpan", "spanAttVal": "bar"},
    {"spanCount": 2, "name": "boo", "resourceAttr": "someRes", "resourceAttVal": "qux", "spanAttr": "sameAttr", "spanAttVal": "bar"}
  ],
  "tagNames": ["firstRes", "firstSpan", "sameAttr", "secondRes", "secondSpan", "service.name", "someRes", "someSpan", "twoRes", "twoSpan"],
  "names": [
    {"name": "no filtering", "query": "", "scope": "none", "expected": [
      {"name": "resource", "tags": ["firstRes", "sameAttr", "secondRes", "service.name", "someRes", "twoRes"]},
      {"name": "span", "tags": ["firstSpan", "sameAttr", "secondSpan", "someSpan", "twoSpan"]}
    ]},
    {"name": "both batches - name and resource attribute", "query": "{ resource.service.name=\"my-service\"}", "scope": "none", "expected": [
      {"name": "resource", "tags": ["firstRes", "sameAttr", "secondRes", "service.name", "someRes", "twoRes"]},
      {"name": "span", "tags": ["firstSpan", "sameAttr", "secondSpan", "someSpan", "twoSpan"]}
    ]},
    {"name": "first batch - resource att - span", "query": "{ resource.firstRes=\"bar\" }", "scope": "span", "expected": [
      {"name": "span", "tags": ["firstSpan"]}
    ]},
    {"name": "first batch - resource att - resource", "query": "{ resource.firstRes=\"bar\" }", "scope": "resource", "expected": [
      {"name": "resource", "tags": ["firstRes", "service.name"]}
    ]},
    {"name": "second batch - resource attribute - span", "query": "{ resource.secondRes=\"qux\" }", "scope": "span", "expected": [
      {"name": "span", "tags": ["secondSpan"]}
    ]},
    {"name": "too restrictive query", "query": "{ resource.firstRes=\"bar\" && resource.y=\"qux\" }", "scope": "none", "expected": [
      {"name": "resource", "tags": ["service.name"]}
    ]}
  ],
  "values": [
    {"name": "no filtering", "query": "", "tag": "span.twoSpan", "expected": ["bar", "qux"]},
    {"name": "first batch only - resource attribute", "query": "{ resource.twoRes=\"bar\" }", "tag": "span.twoSpan", "expected": ["bar"]},
    {"name": "second batch only - resource attribute", "query": "{ resource.twoRes=\"qux\" }", "tag": "span.twoSpan", "expected": ["qux"]},
    {"name": "too restrictive query", "query": "{ resource.twoRes=\"bar\" && resource.y=\"qux\" }", "tag": "span.twoSpan", "expected": []},
    {"name": "both batches - name and resource attribute", "query": "{ resource.service.name=\"my-service\"}", "tag": "name", "expected": ["baz", "boo", "foo"]},
    {"name": "only resource attributes", "query": "{ resource.twoRes=\"bar\" }", "tag": "resource.service.name", "expected": ["my-service"]}
  ],
  "specialCharacters": [
    ["attr[bracket", "val["],
    ["attr/slash", "val/"],
    ["attr space", "val_"],
    ["attr&ampersand", "val&"],
    ["attr:colon", "val:"],
    ["attr@at", "val@"],
    ["attr#octothorpe", "val#"],
    ["attr🐷oink", "val🐷"],
    ["attr%percent", "val%"],
    ["attr%20valid_escape_code", "val%20"],
    ["attr \"'<>#%{}|\\*", "val😬"],
    ["attr=equals", "val="],
    ["attr?question", "val?"],
    ["attr+plus", "val+"],
    ["attr.dot", "val."],
    ["attr~tilde", "val~"],
    ["attr(paren", "val("],
    ["attr,comma", "val,"],
    ["attr;semicolon", "val;"]
  ]
}
