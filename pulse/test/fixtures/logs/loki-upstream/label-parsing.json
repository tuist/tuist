  "supporting_declarations": [
    {
      "documentation": {
        "original_go": "// ParseLabels parses stream labels from a string using the logql parser.\n//\n// It drops labels with an empty value. An empty value and an absent label mean\n// the same thing in Prometheus, but they hash differently, so Loki normalizes\n// them away to keep a stream's hash stable.",
        "source": "pkg/logql/syntax/parser.go",
        "source_range": {
          "end_byte_exclusive": 7901,
          "end_column": 45,
          "end_line": 295,
          "start_byte": 7621,
          "start_column": 1,
          "start_line": 291
        }
      },
      "name": "ParseLabels",
      "original_go": "func ParseLabels(lbs string) (labels.Labels, error) {\n\tls, err := ParseMetric(lbs)\n\tif err != nil {\n\t\treturn labels.EmptyLabels(), err\n\t}\n\treturn ls.WithoutEmpty(), nil\n}\n",
      "sha256": "e6ca047ff65c97fd86ff7147b7bb902d5ba87c98d4faf620217b9b627bdf16be",
      "source": "pkg/logql/syntax/parser.go",
      "source_range": {
        "end_byte_exclusive": 8072,
        "end_column": 2,
        "end_line": 302,
        "start_byte": 7902,
        "start_column": 1,
        "start_line": 296
      }
    },
    {
      "documentation": {
        "original_go": "// ParseMetric parses a label set from a string using the logql parser,\n// keeping empty-value labels.\n//\n// Use this for labels that come from query processing, such as range-vector\n// aggregation output or extracted fields, where an empty value is distinct\n// from an absent label. Use ParseLabels instead for stream labels read from\n// storage, which Loki normalizes to drop empty values at write time.",
        "source": "pkg/logql/syntax/parser.go",
        "source_range": {
          "end_byte_exclusive": 8479,
          "end_column": 70,
          "end_line": 310,
          "start_byte": 8074,
          "start_column": 1,
          "start_line": 304
        }
      },
      "name": "ParseMetric",
      "original_go": "func ParseMetric(lbs string) (labels.Labels, error) {\n\tif len(lbs) \u003e maxStreamLabelsSize {\n\t\treturn labels.EmptyLabels(), fmt.Errorf(\"labels size %d MiB exceeds limit of %d\", len(lbs)\u003e\u003e20, maxStreamLabelsSize\u003e\u003e20)\n\t}\n\t//nolint:forbidigo // this is the wrapper other packages must call instead\n\treturn promql_parser.NewParser(promql_parser.Options{}).ParseMetric(lbs)\n}\n",
      "sha256": "ad2132476a90e64caf1d2d32e7170e153a8887169b37934be7856a2247926a58",
      "source": "pkg/logql/syntax/parser.go",
      "source_range": {
        "end_byte_exclusive": 8848,
        "end_column": 2,
        "end_line": 317,
        "start_byte": 8480,
        "start_column": 1,
        "start_line": 311
      }
    },
    {
      "name": "maxStreamLabelsSize",
      "original_go": "const (\n\tEmptyMatchers = \"{}\"\n\n\terrAtleastOneEqualityMatcherRequired = \"queries require at least one regexp or equality matcher that does not have an empty-compatible value. For instance, app=~\\\".*\\\" does not meet this requirement, but app=~\\\".+\\\" will\"\n\n\t// Prometheus internal data structure panics if given more than this.\n\tmaxStreamLabelsSize = 1\u003c\u003c24 - 1 // 16MB\n)\n",
      "sha256": "705dec29c2dce742221749cb0407abd97cff094c67ce06ebed23a2ef2181a981",
      "source": "pkg/logql/syntax/parser.go",
      "source_range": {
        "end_byte_exclusive": 631,
        "end_column": 2,
        "end_line": 23,
        "start_byte": 263,
        "start_column": 1,
        "start_line": 16
      },
      "value": 16777215,
