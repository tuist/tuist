clear

# Testing atan2.
load 5m
    trigy{} 10
    trigx{} 20
    trigNaN{} NaN

eval instant at 1m trigy atan2 trigx
    {} 0.4636476090008061

eval instant at 1m trigy atan2 trigNaN
    {} NaN

eval instant at 1m 10 atan2 20
    0.4636476090008061

eval instant at 1m 10 atan2 NaN
    NaN

clear
