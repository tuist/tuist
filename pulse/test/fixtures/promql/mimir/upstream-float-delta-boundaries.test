# Tests for delta() on float-only input.
load 1m
  gauge 0+1x10
  gauge_late _x5 0+1x5
  gauge_early 0+1x5 _x5
  counter 0+9x4 0+9x5

# The range (0m, 10m] holds 10 samples spaced 1m apart. The first sample
# at 1m is within 1.1 intervals of the range start, so the delta is
# extrapolated to both edges: (10-1) * (600s / 540s) = 10.
eval instant at 10m delta(gauge[10m])
  {} 10

# Samples only start at 5m. The gap to the range start is wider than
# 1.1 intervals, so the start is extrapolated by half an interval only:
# (5-0) * (330s / 300s) = 5.5.
eval instant at 10m delta(gauge_late[10m])
  {} 5.5

# Samples end at 5m. Full extrapolation to the start, half an interval at
# the end: (5-1) * (330s / 240s) = 5.5.
eval instant at 10m delta(gauge_early[10m])
  {} 5.5

# A single sample in the range yields no result.
eval instant at 10m delta(gauge[1m])

eval instant at 5m delta(gauge_late[5m])

# delta does not account for counter resets, unlike increase():
# (45-9) * (600s / 540s) = 40.
eval instant at 10m delta(counter[10m])
  {} 40

# Each step sees 5 samples spaced 1m apart, extrapolated to both edges:
# 4 * (300s / 240s) = 5.
eval range from 5m to 10m step 1m delta(gauge[5m])
  {} 5 5 5 5 5 5
