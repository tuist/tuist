load 5m
	trig{l="x"} 10
	trig{l="y"} 20
	trig{l="NaN"} NaN

eval instant at 1m sinh(trig)
	{l="x"} 11013.232920103324
	{l="y"} 2.4258259770489514e+08
	{l="NaN"} NaN

eval instant at 1m cosh(trig)
	{l="x"} 11013.232920103324
	{l="y"} 2.4258259770489514e+08
	{l="NaN"} NaN

eval instant at 1m tanh(trig)
	{l="x"} 0.9999999958776927
	{l="y"} 1
	{l="NaN"} NaN

