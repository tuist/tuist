<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="dev.tuist.atlas">
    <uses-permission android:name="android.permission.INTERNET" />
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.APP_BROWSER" />
        </intent>
    </queries>
    <application
        android:name="dev.tuist.atlas.AtlasApplication"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/AtlasTheme"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:usesCleartextTraffic="false"
        android:supportsRtl="true">
        <activity android:name="dev.tuist.atlas.AtlasAutomationActivity" android:exported="false" />
        <activity android:name="dev.tuist.atlas.MainActivity" android:exported="true" android:launchMode="singleTask" android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="dev.tuist.atlas" android:host="oauth-callback" />
            </intent-filter>
            <!-- Navigation-only links: dev.tuist.atlas://navigate/<screen>[/<uuid>]?server=<origin>. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="dev.tuist.atlas" android:host="navigate" />
            </intent-filter>
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="atlas.tuist.dev" />
                <data android:path="/tasks" />
                <data android:path="/commercial/sales/accounts" />
                <data android:pathPattern="/commercial/sales/accounts/........-....-....-....-............" />
                <data android:path="/people" />
                <data android:path="/people/time-off" />
                <data android:path="/settings" />
                <data android:path="/open/tasks" />
                <data android:path="/open/accounts" />
                <data android:path="/open/invoices" />
                <data android:path="/open/people" />
                <data android:path="/open/time-off" />
                <data android:path="/open/profile" />
                <data android:pathPattern="/open/tasks/........-....-....-....-............" />
                <data android:pathPattern="/open/accounts/........-....-....-....-............" />
                <data android:pathPattern="/open/invoices/........-....-....-....-............" />
            </intent-filter>
        </activity>
    </application>
</manifest>
