// Go workspace tying the infra/ modules together. Each module ships
// its own go.mod (so the modules can be built / released independently)
// but local development resolves cross-module imports through this
// workspace without each consumer needing a `replace` directive.
//
// macos-host-bootstrap is the substrate the Apple Silicon CAPI
// providers consume. Today only the Scaleway one is wired up; the
// AWS EC2 Mac path described in PR #10499's BYOC section will land
// as a sibling module that imports macos-host-bootstrap unchanged.
//
// tart-kubelet and macos-log-shipper have no dependencies on the
// others — both ship as darwin/arm64 binaries baked into each
// provider's controller image and uploaded to the hosts over SSH.
// macos-log-shipper is stdlib-only on purpose: every host binary is
// re-pushed on each drift roll, so its size is roll time multiplied
// by the fleet.

go 1.25.0

use (
	./infra/cluster-api-provider-tuist
	./infra/egress-tree-agent
	./infra/hetzner-robot-controller
	./infra/kura-controller
	./infra/linux-runner-image
	./infra/macos-host-bootstrap
	./infra/macos-log-shipper
	./infra/runner-image
	./infra/runners-controller
	./infra/stable-egress-controller
	./infra/tart-kubelet
	./kube-impersonator
)
