msgstr "5 mln przechodzących przypadków testowych"

#: lib/tuist_web/marketing/controllers/marketing_html/pricing.html.heex:83
#, elixir-autogen, elixir-format
msgid "Cache egress"
msgstr "Wychodzący ruch z cache'a"

#: lib/tuist_web/marketing/controllers/marketing_html/pricing.html.heex:105
#, elixir-autogen, elixir-format
msgid "Cache requests"
msgstr "Żądania do cache'a"

#: lib/tuist_web/marketing/controllers/marketing_html/pricing.html.heex:85
#, elixir-autogen, elixir-format
msgid "Data downloaded from the Module, Xcode, Gradle, and Bazel caches. Uploads and storage are free."
msgstr "Dane pobrane z cache'ów Modułu, Xcode, Gradle i Bazel. Przesyłanie i przechowywanie są darmowe."

#: lib/tuist_web/marketing/controllers/marketing_html/pricing.html.heex:106
#, elixir-autogen, elixir-format
msgid "Downloads served from any of your caches."
msgstr "Pobrania obsługiwane z dowolnego z Twoich cache'ów."

#: lib/tuist_web/marketing/controllers/marketing_html/pricing.html.heex:109
#, elixir-autogen, elixir-format
msgid "Each download from a cache is one request. Every cache shares one allowance each billing period, and requests from Tuist Runners count at half."
msgstr "Każde pobranie z cache'a to jedno żądanie. Wszystkie cache'e współdzielą jeden limit w każdym okresie rozliczeniowym, a żądania z Tuist Runners liczone są jako połowa."

#: lib/tuist_web/marketing/controllers/marketing_controller.ex:996
#, elixir-autogen, elixir-format
msgid "Egress is the data your builds download from Tuist's caches, across the Module, Xcode, Gradle, and Bazel caches, and every download is one request. Both share one free allowance each billing period. Uploads and storage are free."
msgstr "Egress to dane, które Twoje buildy pobierają z cache'ów Tuist, obejmujące cache'e Modułu, Xcode, Gradle i Bazel, przy czym każde pobranie to jedno żądanie. Współdzielą one jeden darmowy limit w każdym okresie rozliczeniowym. Przesyłanie i przechowywanie są darmowe."

#: lib/tuist_web/marketing/controllers/marketing_html/pricing.html.heex:91
#, elixir-autogen, elixir-format
msgid "Every cache shares one allowance each billing period, and traffic from Tuist Runners counts at half."
msgstr "Wszystkie cache'e współdzielą jeden limit w każdym okresie rozliczeniowym, a ruch z Tuist Runners liczony jest jako połowa."

#: lib/tuist_web/marketing/controllers/marketing_html/pricing.html.heex:107
#, elixir-autogen, elixir-format
msgid "How are requests counted?"
msgstr "Jak liczone są żądania?"

#: lib/tuist_web/marketing/controllers/marketing_html/pricing.html.heex:89
#, elixir-autogen, elixir-format
msgid "How is egress measured?"
msgstr "Jak mierzony jest ruch wychodzący (egress)?"

#: lib/tuist_web/marketing/controllers/marketing_controller.ex:1000
#, elixir-autogen, elixir-format
msgid "Is usage on Tuist Runners billed differently?"
msgstr "Czy użycie Tuist Runners jest rozliczane inaczej?"

#: lib/tuist_web/marketing/controllers/marketing_html/pricing.html.heex:131
#, elixir-autogen, elixir-format
msgid "Only passing test cases are billed. Failed and skipped test cases, and tests run on Tuist Runners, are free."
msgstr "Rozliczane są tylko przechodzące przypadki testowe. Nieudane i pominięte przypadki testowe oraz testy uruchamiane na Tuist Runners są darmowe."

#: lib/tuist_web/marketing/controllers/marketing_html/pricing.html.heex:145
#, elixir-autogen, elixir-format
msgid "Selective Testing"
msgstr "Testy selektywne"

