#: lib/tuist_web/controllers/auth_controller.ex:794
#, elixir-autogen, elixir-format
msgid "Tuist couldn't fetch your profile from your identity provider. Ask your organization admin to verify the user info endpoint and configured scopes."
msgstr "Tuist nie mógł pobrać Twojego profilu od dostawcy tożsamości. Poproś administratora organizacji o weryfikację punktu końcowego danych użytkownika i skonfigurowanych zakresów."

#: lib/tuist_web/controllers/auth_controller.ex:850
#, elixir-autogen, elixir-format
msgid "We couldn't complete the SSO callback for this request. Please try again."
msgstr "Nie udało się zakończyć wywołania zwrotnego SSO dla tego żądania. Spróbuj ponownie."

#: lib/tuist_web/controllers/auth_controller.ex:731
#, elixir-autogen, elixir-format
msgid "We couldn't find the organization for this SSO request. Please verify that you are using the correct SSO link."
msgstr "Nie udało się znaleźć organizacji dla tego żądania SSO. Sprawdź, czy używasz poprawnego linku SSO."

#: lib/tuist_web/controllers/auth_controller.ex:843
#, elixir-autogen, elixir-format
msgid "We couldn't start the SSO flow for this organization. Please verify the SSO configuration and try again."
msgstr "Nie udało się uruchomić procesu SSO dla tej organizacji. Sprawdź konfigurację SSO i spróbuj ponownie."

#: lib/tuist_web/controllers/auth_controller.ex:745
#, elixir-autogen, elixir-format
msgid "Your SSO session has expired. Please restart the sign-in flow from the login page."
msgstr "Twoja sesja SSO wygasła. Rozpocznij proces logowania od nowa ze strony logowania."

#: lib/tuist_web/controllers/auth_controller.ex:822
#, elixir-autogen, elixir-format
msgid "Your Tuist account already exists, but it isn't a member of this organization. Ask an organization admin to add you, then sign in with SSO again."
msgstr "Twoje konto Tuist już istnieje, ale nie jesteś członkiem tej organizacji. Poproś administratora organizacji o dodanie Cię, a następnie zaloguj się ponownie przez SSO."

#: lib/tuist_web/controllers/auth_controller.ex:808
#, elixir-autogen, elixir-format
msgid "Your identity provider response is missing a stable user identifier. Ask your organization admin to review the user info claims."
msgstr "Odpowiedź od dostawcy tożsamości nie zawiera stabilnego identyfikatora użytkownika. Poproś administratora organizacji o sprawdzenie roszczeń dotyczących danych użytkownika."

#: lib/tuist_web/controllers/auth_controller.ex:815
#, elixir-autogen, elixir-format
msgid "Your identity provider response is missing an email address. Ask your organization admin to include the email claim."
msgstr "Odpowiedź od dostawcy tożsamości nie zawiera adresu e-mail. Poproś administratora organizacji o uwzględnienie roszczenia dotyczącego adresu e-mail."

#: lib/tuist_web/controllers/auth_controller.ex:766
