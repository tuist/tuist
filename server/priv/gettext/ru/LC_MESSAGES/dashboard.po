msgstr[0] "Заявка на диск Kura снижена до %{claim}. %{count} работающий экземпляр сохраняет свой кэш и удаляет данные до нового лимита."
msgstr[1] "Заявка на диск Kura снижена до %{claim}. %{count} работающих экземпляров сохраняют свои кэши и удаляют данные до нового лимита."
msgstr[2] "Заявка на диск Kura снижена до %{claim}. %{count} работающих экземпляров сохраняют свои кэши и удаляют данные до нового лимита."

#: lib/tuist_web/live/ops_account_live.ex:1430
