msgid "Egress limits updated in %{regions}. %{count} instance is recreated to pick them up."
msgid_plural "Egress limits updated in %{regions}. %{count} instances are recreated to pick them up."
msgstr[0] "Лимиты исходящего трафика обновлены в %{regions}. Для применения изменений пересоздан %{count} экземпляр."
msgstr[1] "Лимиты исходящего трафика обновлены в %{regions}. Для применения изменений пересоздано %{count} экземпляров."
msgstr[2] "Лимиты исходящего трафика обновлены в %{regions}. Для применения изменений пересоздано %{count} экземпляров."

