#: lib/tuist_web/live/ops_account_live.ex:142
#, elixir-autogen, elixir-format
msgid "%{account}'s free tier starts over from now. It has the full allowance again until the end of the month."
msgstr "Бесплатный тариф %{account} начинается заново с этого момента. До конца месяца ему снова доступен полный лимит."

#: lib/tuist_web/live/ops_account_live.html.heex:471
