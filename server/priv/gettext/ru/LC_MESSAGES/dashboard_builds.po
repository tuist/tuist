msgstr "Неудачные выполнения задач"

#: lib/tuist_web/live/build_entity_live.ex:763
#, elixir-autogen, elixir-format
msgid "File compilations"
msgstr "Компиляции файлов"

#: lib/tuist_web/live/build_entity_live.ex:764
#, elixir-autogen, elixir-format
