#: lib/tuist_web/live/module_cache_live.html.heex:232
#, elixir-autogen, elixir-format
msgid "Cache hits represents the total count of targets that were resolved from cache (local or remote) during the given period."
msgstr "Попадания в кэш — это общее количество целей, взятых из кэша (локального или удаленного) за указанный период."

#: lib/tuist_web/live/module_cache_live.ex:375
