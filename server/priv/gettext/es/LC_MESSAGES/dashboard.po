#: lib/tuist_web/controllers/auth_controller.ex:788
#, elixir-autogen, elixir-format
msgid "Failed to authenticate with the SSO provider. Please try again."
msgstr "No se pudo autenticar con el proveedor SSO. Por favor, inténtalo de nuevo."

#: lib/tuist_web/controllers/auth_controller.ex:669
#, elixir-autogen, elixir-format
msgid "SSO is not fully configured for this organization. Ask an organization admin to review the SSO settings."
msgstr "SSO no está completamente configurado para esta organización. Pide a un admin que revise la configuración SSO."

#: lib/tuist_web/controllers/auth_controller.ex:732
#, elixir-autogen, elixir-format
msgid "The SSO authorization code is invalid or expired. Please restart the sign-in flow."
msgstr "El código de autorización SSO es inválido o ha expirado. Por favor, reinicia el proceso de inicio de sesión."

#: lib/tuist_web/controllers/auth_controller.ex:704
#, elixir-autogen, elixir-format
msgid "The SSO provider callback is missing an authorization code. Please restart the sign-in flow."
msgstr "El callback del proveedor SSO no incluye un código de autorización. Por favor, reinicia el proceso de inicio de sesión."

#: lib/tuist_web/controllers/auth_controller.ex:655
#, elixir-autogen, elixir-format
msgid "The SSO request is missing an organization identifier. Please start the sign-in flow again from the login page."
msgstr "La solicitud SSO no tiene un identificador de organización. Por favor, comienza el proceso de inicio de sesión nuevamente desde la página de login."

#: lib/tuist_web/controllers/auth_controller.ex:683
#, elixir-autogen, elixir-format
msgid "The SSO response could not be validated because the request state did not match. Please try again."
msgstr "La respuesta SSO no pudo validarse porque el estado de la solicitud no coincide. Por favor, inténtalo de nuevo."

#: lib/tuist_web/controllers/auth_controller.ex:711
#, elixir-autogen, elixir-format
msgid "The configured SSO endpoints are invalid. Ask your organization admin to review the SSO settings."
msgstr "Los endpoints SSO configurados son inválidos. Pide al admin de tu organización que revise la configuración SSO."

#: lib/tuist_web/components/layouts/ops.html.heex:7
#, elixir-autogen, elixir-format
msgid "Tuist Ops"
msgstr "Tuist Ops"

#: lib/tuist_web/controllers/auth_controller.ex:718
#, elixir-autogen, elixir-format
msgid "Tuist couldn't exchange the authorization code with your identity provider. Ask your organization admin to verify the SSO credentials and callback URL."
msgstr "Tuist no pudo intercambiar el código de autorización con tu proveedor de identidad. Pide al admin que verifique las credenciales SSO y la URL de callback."

#: lib/tuist_web/controllers/auth_controller.ex:725
#, elixir-autogen, elixir-format
msgid "Tuist couldn't fetch your profile from your identity provider. Ask your organization admin to verify the user info endpoint and configured scopes."
msgstr "Tuist no pudo obtener tu perfil de tu proveedor de identidad. Pide al admin que verifique el endpoint de info de usuario y los scopes configurados."

#: lib/tuist_web/controllers/auth_controller.ex:781
#, elixir-autogen, elixir-format
msgid "We couldn't complete the SSO callback for this request. Please try again."
msgstr "No pudimos completar el callback SSO para esta solicitud. Por favor, inténtalo de nuevo."

#: lib/tuist_web/controllers/auth_controller.ex:662
#, elixir-autogen, elixir-format
msgid "We couldn't find the organization for this SSO request. Please verify that you are using the correct SSO link."
msgstr "No pudimos encontrar la organización para esta solicitud SSO. Verifica que estés usando el enlace SSO correcto."

#: lib/tuist_web/controllers/auth_controller.ex:774
#, elixir-autogen, elixir-format
msgid "We couldn't start the SSO flow for this organization. Please verify the SSO configuration and try again."
msgstr "No pudimos iniciar el proceso SSO para esta organización. Verifica la configuración SSO y vuelve a intentarlo."

#: lib/tuist_web/controllers/auth_controller.ex:676
#, elixir-autogen, elixir-format
msgid "Your SSO session has expired. Please restart the sign-in flow from the login page."
msgstr "Tu sesión SSO ha expirado. Por favor, reinicia el proceso de inicio de sesión desde la página de login."

