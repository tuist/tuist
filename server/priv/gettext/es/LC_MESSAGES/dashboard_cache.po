#: lib/tuist_web/helpers/module_cache.ex:59
#, elixir-autogen, elixir-format
msgid "This exact key previously had a remote hit at the same cache endpoint, but now misses. The cached artifact was most likely evicted."
msgstr "Esta clave exacta tuvo anteriormente un acierto remoto en el mismo extremo de caché, pero ahora falla. Es muy probable que el artefacto almacenado en caché haya sido eliminado."

#: lib/tuist_web/helpers/module_cache.ex:38
#, elixir-autogen, elixir-format
msgid "The module's reported inputs changed, such as its files, build settings, configuration, or compiler version."
msgstr "Las entradas reportadas del módulo cambiaron, como sus archivos, configuraciones de compilación, configuración o versión del compilador."

#: lib/tuist_web/helpers/module_cache.ex:52
#, elixir-autogen, elixir-format
msgid "No earlier comparison is available, or the reported inputs and remote-hit history do not explain this miss."
msgstr "No hay una comparación anterior disponible, o las entradas reportadas y el historial de aciertos remotos no explican este fallo."

#: lib/tuist_web/helpers/module_cache.ex:66
#, elixir-autogen, elixir-format
msgid "This observation reports a local or remote cache hit."
msgstr "Esta observación reporta un acierto en la caché local o remota."

#: lib/tuist_web/helpers/module_cache.ex:45
#, elixir-autogen, elixir-format
msgid "The module's own reported inputs stayed the same, but a dependency or external package hash changed."
msgstr "Las entradas reportadas por el propio módulo se mantuvieron iguales, pero cambió un hash de dependencia o paquete externo."

#: lib/tuist_web/helpers/module_cache.ex:70
#, elixir-autogen, elixir-format
msgid "Changed: module inputs changed. Upstream: dependencies changed. Cold: insufficient evidence. Evicted: a previously served key now misses."
msgstr "Cambiado: las entradas del módulo cambiaron. Ascendente: las dependencias cambiaron. Frío: evidencia insuficiente. Expulsado: una clave previamente servida ahora falla."

