#: lib/tuist_web/live/runner_volumes_live.html.heex:21
#: lib/tuist_web/live/runner_volumes_live.html.heex:562
#: lib/tuist_web/live/runner_volumes_live.html.heex:584
#, elixir-autogen, elixir-format
msgid "Clear volume"
msgstr "ボリュームをクリア"

#: lib/tuist_web/live/runner_volumes_live.ex:141
#, elixir-autogen, elixir-format
msgid "Volume cleared. Running jobs can finish."
msgstr "ボリュームがクリアされました。実行中のジョブは完了できます。"

#: lib/tuist_web/live/runner_volumes_live.html.heex:520
#, elixir-autogen, elixir-format
msgid "Mounted at"
msgstr "マウント日時"

#: lib/tuist_web/live/runner_volumes_live.html.heex:120
#, elixir-autogen, elixir-format
msgid "Cache hit rate"
msgstr "キャッシュヒット率"

#: lib/tuist_web/live/runner_volumes_live.html.heex:148
#, elixir-autogen, elixir-format
msgid "Cache hit rate will appear after a volume mount reports its cache result."
msgstr "キャッシュヒット率は、ボリュームマウントがキャッシュ結果を報告した後に表示されます。"

#: lib/tuist_web/live/runner_volumes_live.html.heex:123
#, elixir-autogen, elixir-format
msgid "Percentage of volume mounts that reused saved data during the selected period."
msgstr "選択した期間中に保存されたデータを再利用したボリュームマウントの割合。"

#: lib/tuist_web/live/runner_volumes_live.ex:307
#, elixir-autogen, elixir-format
msgid "No data"
msgstr "データなし"

#: lib/tuist_web/live/runner_volumes_live.ex:310
#, elixir-autogen, elixir-format
msgid "No previous data"
msgstr "過去のデータなし"

#: lib/tuist_web/live/runner_job_live.ex:183
#, elixir-autogen, elixir-format
msgid "%{volume} ran out of space"
msgstr "%{volume}の空き容量がなくなりました"

#: lib/tuist_web/live/runner_job_live.ex:188
#, elixir-autogen, elixir-format
msgid "This job used %{used} of the volume's %{capacity}. Writes to a full volume fail with errors such as \"No space left on device\", which can fail the job."
msgstr "このジョブはボリュームの%{capacity}のうち%{used}を使用しました。一杯になったボリュームへの書き込みは「No space left on device」などのエラーで失敗し、ジョブが失敗する可能性があります。"

#: lib/tuist_web/live/runner_volumes_live.html.heex:304
#, elixir-autogen, elixir-format
msgid "This volume is almost full"
msgstr "このボリュームはほぼ一杯です"

#: lib/tuist_web/live/runner_volumes_live.ex:388
#, elixir-autogen, elixir-format
msgid "The saved snapshot uses %{used} of %{capacity}. If a job runs out of space on it, the next job starts from an empty volume and saves a new snapshot."
msgstr "保存されたスナップショットは%{capacity}のうち%{used}を使用しています。ジョブがそのスナップショットで空き容量不足になった場合、次のジョブは空のボリュームから開始され、新しいスナップショットを保存します。"

#: lib/tuist_web/live/runner_profiles_live.ex:399
#: lib/tuist_web/live/runner_profiles_live.ex:406
#, elixir-autogen, elixir-format
msgid "Any branch"
msgstr "任意のブランチ"

#: lib/tuist_web/live/runner_profiles_live.html.heex:214
#, elixir-autogen, elixir-format
msgid "Save cache from"
msgstr "キャッシュの保存元"

#: lib/tuist_web/live/runner_profiles_live.ex:417
#, elixir-autogen, elixir-format
msgid "%{branches} + %{count} more"
msgid_plural "%{branches} + %{count} more"
msgstr[0] "%{branches} + 他%{count}件"

#: lib/tuist_web/live/runner_profiles_live.html.heex:296
#, elixir-autogen, elixir-format
msgid "Add"
msgstr "追加"

#: lib/tuist_web/live/runner_profiles_live.ex:120
#, elixir-autogen, elixir-format
msgid "Use a branch name, optionally with * to match any characters."
msgstr "ブランチ名を入力します。ワイルドカードとして*を使用すると任意の文字にマッチします。"

#: lib/tuist_web/live/runner_profiles_live.ex:402
#: lib/tuist_web/live/runner_profiles_live.html.heex:254
#, elixir-autogen, elixir-format
msgid "Default branch"
msgstr "デフォルトブランチ"

#: lib/tuist_web/live/runner_profiles_live.html.heex:266
#, elixir-autogen, elixir-format
msgid "Additional branches"
msgstr "追加のブランチ"

#: lib/tuist_web/live/runner_profiles_live.html.heex:305
#, elixir-autogen, elixir-format
msgid "Jobs and pull requests from these branches also save their changes. Use * as a wildcard."
msgstr "これらのブランチからのジョブとプルリクエストも変更を保存します。ワイルドカードとして*を使用できます。"

#: lib/tuist_web/live/runner_profiles_live.html.heex:256
#, elixir-autogen, elixir-format
msgid "Jobs on each repository's default branch save their changes."
msgstr "各リポジトリのデフォルトブランチ上のジョブが変更を保存します。"

#: lib/tuist_web/live/runner_profiles_live.ex:409
#, elixir-autogen, elixir-format
msgid "No branches"
msgstr "ブランチなし"

#: lib/tuist_web/live/runner_profiles_live.html.heex:288
#, elixir-autogen, elixir-format
msgid "e.g. develop, release/* or *"
msgstr "例: develop, release/* または *"

#: lib/tuist_web/live/runner_job_live.ex:209
#: lib/tuist_web/live/runner_volumes_live.html.heex:498
#, elixir-autogen, elixir-format
msgid "Older copy"
msgstr "古いコピー"

#: lib/tuist_web/live/runner_job_live.html.heex:590
#, elixir-autogen, elixir-format
msgid "This step's output couldn't be separated from the rest of the job's log."
msgstr "このステップの出力はジョブのログの他の部分から分離できませんでした。"

#: lib/tuist_web/live/runner_job_live.html.heex:598
#, elixir-autogen, elixir-format
msgid "View the full log"
msgstr "完全なログを表示"

#: lib/tuist_web/live/runner_volumes_live.ex:414
#, elixir-autogen, elixir-format
msgid "Gradle cache"
msgstr "Gradleキャッシュ"

#: lib/tuist_web/live/runner_profiles_live.html.heex:238
#, elixir-autogen, elixir-format
msgid "Every successful job from the repository saves its changes, including pull requests. Forks never save."
msgstr "リポジトリからのすべての成功したジョブは、プルリクエストを含めて変更を保存します。フォークは決して保存されません。"

#: lib/tuist_web/live/runner_profiles_live.html.heex:234
#, elixir-autogen, elixir-format
msgid "Limit to specific branches"
msgstr "特定のブランチに限定"

#: lib/tuist_web/live/runner_profiles_live.html.heex:243
#, elixir-autogen, elixir-format
msgid "Only jobs on the branches below save their changes."
msgstr "以下のブランチ上のジョブのみが変更を保存します。"

#: lib/tuist_web/live/runner_profiles_live.html.heex:190
#, elixir-autogen, elixir-format
msgid "Cached checkouts"
msgstr "キャッシュされたチェックアウト"

#: lib/tuist_web/live/runner_profiles_live.html.heex:192
#, elixir-autogen, elixir-format
msgid "Keeps each repository checked out on a \"checkout\" cache volume, so actions/checkout only fetches what changed."
msgstr "各リポジトリを「checkout」キャッシュボリュームにチェックアウトした状態で保持するため、actions/checkoutは変更された部分のみをフェッチします。"

#: lib/tuist_web/live/runner_job_live.html.heex:615
#, elixir-autogen, elixir-format
msgid "Load earlier lines"
msgstr "以前の行を読み込む"

#: lib/tuist_web/live/runner_job_live.html.heex:577
#, elixir-autogen, elixir-format
msgid "Loading logs"
msgstr "ログを読み込み中"

#: lib/tuist_web/live/runner_job_live.html.heex:614
#, elixir-autogen, elixir-format
msgid "Loading..."
msgstr "読み込み中..."

#: lib/tuist_web/live/runner_job_live.html.heex:584
#, elixir-autogen, elixir-format
msgid "This step's logs couldn't be loaded. Collapse and expand the step to retry."
msgstr "このステップのログを読み込めませんでした。ステップを折りたたんで展開し、再試行してください。"

#: lib/tuist_web/live/runner_volumes_live.html.heex:313
#, elixir-autogen, elixir-format
msgid "A smaller size was requested"
msgstr "より小さいサイズが要求されました"

#: lib/tuist_web/live/runner_volumes_live.ex:403
#, elixir-autogen, elixir-format
msgid "Saved at %{capacity}. New contents will use %{pending} after the next clear."
msgstr "%{capacity}で保存されました。新しいコンテンツは、次のクリア後に%{pending}を使用します。"
