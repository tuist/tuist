#: lib/tuist_web/controllers/auth_controller.ex:738
#, elixir-autogen, elixir-format
msgid "SSO is not fully configured for this organization. Ask an organization admin to review the SSO settings."
msgstr "O SSO não está totalmente configurado para esta organização. Peça a um administrador da organização para revisar as configurações do SSO."

#: lib/tuist_web/controllers/auth_controller.ex:801
#, elixir-autogen, elixir-format
msgid "The SSO authorization code is invalid or expired. Please restart the sign-in flow."
msgstr "O código de autorização do SSO é inválido ou expirou. Por favor, reinicie o fluxo de login."

#: lib/tuist_web/controllers/auth_controller.ex:773
#, elixir-autogen, elixir-format
msgid "The SSO provider callback is missing an authorization code. Please restart the sign-in flow."
msgstr "O callback do provedor de SSO está sem um código de autorização. Por favor, reinicie o fluxo de login."

#: lib/tuist_web/controllers/auth_controller.ex:724
#, elixir-autogen, elixir-format
msgid "The SSO request is missing an organization identifier. Please start the sign-in flow again from the login page."
msgstr "A solicitação do SSO está sem um identificador de organização. Por favor, inicie o fluxo de login novamente a partir da página de login."

#: lib/tuist_web/controllers/auth_controller.ex:752
#, elixir-autogen, elixir-format
msgid "The SSO response could not be validated because the request state did not match. Please try again."
msgstr "A resposta do SSO não pôde ser validada porque o estado da solicitação não correspondia. Por favor, tente novamente."

#: lib/tuist_web/controllers/auth_controller.ex:780
#, elixir-autogen, elixir-format
msgid "The configured SSO endpoints are invalid. Ask your organization admin to review the SSO settings."
msgstr "Os endpoints de SSO configurados são inválidos. Peça ao administrador da sua organização para revisar as configurações do SSO."

