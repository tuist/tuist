msgid "%{volume} ran out of space"
msgstr "%{volume} ficou sem espaço"

#: lib/tuist_web/live/runner_job_live.ex:188
#, elixir-autogen, elixir-format
msgid "This job used %{used} of the volume's %{capacity}. Writes to a full volume fail with errors such as \"No space left on device\", which can fail the job."
msgstr "Este trabalho usou %{used} da capacidade %{capacity} do volume. As escritas num volume cheio falham com erros como \"Sem espaço disponível no dispositivo\", o que pode falhar o trabalho."

#: lib/tuist_web/live/runner_volumes_live.html.heex:305
#, elixir-autogen, elixir-format
msgid "This volume is almost full"
msgstr "Este volume está quase cheio"

#: lib/tuist_web/live/runner_volumes_live.ex:492
#, elixir-autogen, elixir-format
msgid "The saved snapshot uses %{used} of %{capacity}. If a job runs out of space on it, the next job starts from an empty volume and saves a new snapshot."
msgstr "O snapshot guardado usa %{used} de %{capacity}. Se um trabalho ficar sem espaço nele, o próximo trabalho começa a partir de um volume vazio e guarda um novo snapshot."

