<.link_frame
  title={dgettext("dashboard_auth", "Save your recovery codes")}
  subtitle={
    dgettext(
      "dashboard_auth",
      "These codes are shown only once. Each code replaces your authenticator code for one sign-in."
    )
  }
>
  <ul id="mfa-recovery-codes">
    <li :for={code <- @codes}><code>{code}</code></li>
  </ul>
  <p data-part="security-note">
    {dgettext(
      "dashboard_auth",
      "Store these codes securely, separate from your authenticator. Losing both can lock you out of your account. Regenerating codes invalidates all previous codes."
    )}
  </p>
  <.button
    type="button"
    variant="secondary"
    size="large"
    data-copy-recovery-codes
    data-copy-success={dgettext("dashboard_auth", "Recovery codes copied")}
    data-copy-failure={
      dgettext(
        "dashboard_auth",
        "Could not copy automatically. Select and copy your recovery codes."
      )
    }
    label={dgettext("dashboard_auth", "Copy recovery codes")}
  />
  <span data-copy-status role="status" class="auth-copy-status"></span>
  <.button
    variant="primary"
    size="large"
    href={~p"/users/settings/mfa"}
    label={dgettext("dashboard_auth", "I saved my recovery codes")}
  />
</.link_frame>
