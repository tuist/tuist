<.link_frame
  title={dgettext("dashboard_auth", "Two-factor authentication")}
  subtitle={
    dgettext(
      "dashboard_auth",
      "Protect your account with an authenticator app and recovery codes."
    )
  }
>
  <.alert :if={@error} type="secondary" status="error" size="small" title={@error} />
  <%= if @enabled do %>
    <p>
      {dgettext(
        "dashboard_auth",
        "Two-factor authentication is enabled for all new browser sign-ins, including single sign-on."
      )}
    </p>
    <div data-part="recovery-settings">
      <p id="mfa-recovery-count">
        {dngettext(
          "dashboard_auth",
          "%{count} recovery code remaining.",
          "%{count} recovery codes remaining.",
          @recovery_code_count
        )}
      </p>
      <details id="mfa-recovery-settings">
        <summary>{dgettext("dashboard_auth", "Regenerate recovery codes")}</summary>
        <p>
          {dgettext(
            "dashboard_auth",
            "All previous recovery codes will stop working and other browsers will be signed out. Save the new codes somewhere secure, separate from your authenticator."
          )}
        </p>
        <form
          id="mfa-regenerate"
          method="post"
          action={~p"/users/settings/mfa/recovery"}
          data-part="form"
        >
          <input type="hidden" name="_csrf_token" value={Phoenix.Controller.get_csrf_token()} />
          <.text_input
            id="mfa-recovery-code"
            name="mfa_code"
            value=""
            label={dgettext("dashboard_auth", "Authentication or recovery code")}
            show_prefix={false}
            autocomplete="one-time-code"
            required
          />
          <.button
            variant="secondary"
            size="large"
            type="submit"
            label={dgettext("dashboard_auth", "Generate new recovery codes")}
          />
        </form>
      </details>
    </div>
    <form id="mfa-disable" method="post" action={~p"/users/settings/mfa/disable"} data-part="form">
      <input type="hidden" name="_csrf_token" value={Phoenix.Controller.get_csrf_token()} />
      <.text_input
        id="mfa-code"
        name="mfa_code"
        value=""
        label={dgettext("dashboard_auth", "Authentication or recovery code")}
        show_prefix={false}
        autocomplete="one-time-code"
        required
      />
      <.button
        variant="secondary"
        size="large"
        type="submit"
        label={dgettext("dashboard_auth", "Disable two-factor authentication")}
      />
    </form>
  <% else %>
    <%= if @secret do %>
      <div data-part="authenticator-setup">
        <p>
          {dgettext(
            "dashboard_auth",
            "Scan this QR code with your authenticator app, then enter its six-digit code. Complete setup within five minutes."
          )}
        </p>
        <img
          id="mfa-setup-qr"
          src={enrollment_qr(@secret, @current_user.email)}
          width="240"
          height="240"
          alt={dgettext("dashboard_auth", "Authenticator setup QR code")}
        />
        <p>
          {dgettext(
            "dashboard_auth",
            "Using 1Password? Open the browser extension, select your Tuist login, then choose Scan 2FA QR code from the three-dot menu. Save it, then use the generated code below."
          )}
        </p>
        <details id="mfa-manual-setup">
          <summary>{dgettext("dashboard_auth", "Can't scan the QR code?")}</summary>
          <p>{dgettext("dashboard_auth", "Enter this setup key in your authenticator app.")}</p>
          <p>
            {dgettext(
              "dashboard_auth",
              "In the 1Password app or 1Password.com, edit your Tuist login, add a One-Time Password field, paste this key, and save."
            )}
          </p>
          <.text_input
            id="mfa-setup-key"
            name="setup_key"
            value={Base.encode32(@secret, padding: false)}
            label={dgettext("dashboard_auth", "Setup key")}
            readonly
            autocomplete="off"
            data-1p-ignore
            dir="ltr"
            show_prefix={false}
          >
            <:suffix>
              <.button
                type="button"
                variant="secondary"
                size="small"
                icon_only
                data-copy-setup-key
                data-copy-success={dgettext("dashboard_auth", "Setup key copied")}
                data-copy-failure={
                  dgettext(
                    "dashboard_auth",
                    "Could not copy automatically. Select and copy the setup key."
                  )
                }
                aria-label={dgettext("dashboard_auth", "Copy setup key")}
              >
                <.copy />
              </.button>
            </:suffix>
          </.text_input>
          <span data-copy-status role="status" class="auth-copy-status"></span>
        </details>
      </div>
      <form
        id="mfa-enrollment"
        method="post"
        action={~p"/users/settings/mfa/confirm"}
        data-part="form"
      >
        <input type="hidden" name="_csrf_token" value={Phoenix.Controller.get_csrf_token()} />
        <.text_input
          id="mfa-code"
          name="mfa_code"
          value=""
          label={dgettext("dashboard_auth", "Authentication code")}
          show_prefix={false}
          autocomplete="one-time-code"
          inputmode="numeric"
          required
        />
        <.button
          variant="primary"
          size="large"
          type="submit"
          label={dgettext("dashboard_auth", "Enable two-factor authentication")}
        />
      </form>
      <form
        id="mfa-cancel"
        method="post"
        action={~p"/users/settings/mfa/cancel"}
        data-part="form"
      >
        <input type="hidden" name="_csrf_token" value={Phoenix.Controller.get_csrf_token()} />
        <.button
          variant="secondary"
          size="large"
          type="submit"
          label={dgettext("dashboard_auth", "Cancel setup")}
        />
      </form>
    <% else %>
      <form id="mfa-setup" method="post" action={~p"/users/settings/mfa/enroll"} data-part="form">
        <input type="hidden" name="_csrf_token" value={Phoenix.Controller.get_csrf_token()} />
        <.button
          variant="primary"
          size="large"
          type="submit"
          label={dgettext("dashboard_auth", "Set up authenticator app")}
        />
      </form>
    <% end %>
  <% end %>
  <p>
    {dgettext(
      "dashboard_auth",
      "Changing your authenticator app requires signing in within the last five minutes. Password resets do not remove it. Keep recovery codes somewhere safe."
    )}
  </p>
  <.link_button
    href={TuistWeb.Authentication.signed_in_path(@current_user)}
    variant="primary"
    size="large"
    label={dgettext("dashboard_auth", "Back to dashboard")}
  />
</.link_frame>
