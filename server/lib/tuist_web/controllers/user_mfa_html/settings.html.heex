<.auth_page
  id="mfa"
  title={dgettext("dashboard_auth", "Two-factor authentication")}
  subtitle={
    if @passkeys_enabled?,
      do:
        dgettext(
          "dashboard_auth",
          "Protect your account with an authenticator app, passkeys, and recovery codes."
        ),
      else:
        dgettext(
          "dashboard_auth",
          "Protect your account with an authenticator app and recovery codes."
        )
  }
>
  <.alert :if={@error} type="secondary" status="error" size="small" title={@error} />
  <%= if @enabled do %>
    <p data-part="security-note">
      {dgettext(
        "dashboard_auth",
        "Two-factor authentication is enabled for all new browser sign-ins, including single sign-on."
      )}
    </p>
    <form id="mfa-disable" method="post" action={~p"/users/settings/mfa/disable"} data-part="form">
      <input type="hidden" name="_csrf_token" value={Phoenix.Controller.get_csrf_token()} />
      <.text_input
        id="mfa-code"
        name="mfa_code"
        value=""
        label={dgettext("dashboard_auth", "Authentication or recovery code")}
        show_prefix={false}
        autocomplete="one-time-code"
        autocapitalize="none"
        spellcheck="false"
        required
      />
      <.button
        variant="secondary"
        size="large"
        type="submit"
        label={dgettext("dashboard_auth", "Disable two-factor authentication")}
      />
    </form>
  <% else %>
    <%= if @secret do %>
      <p data-part="security-note">
        {dgettext(
          "dashboard_auth",
          "Scan this QR code with 1Password or your authenticator app, then enter its six-digit code. Setup expires in five minutes."
        )}
      </p>
      <img
        id="mfa-setup-qr"
        src={setup_qr(@secret, @current_user.email)}
        alt={dgettext("dashboard_auth", "Authenticator setup QR code")}
        width="200"
        height="200"
      />
      <div data-part="setup-key">
        <span>{dgettext("dashboard_auth", "Or enter this setup key manually")}</span>
        <code id="mfa-setup-key">{Base.encode32(@secret, padding: false)}</code>
        <.button
          id="mfa-copy-key"
          type="button"
          variant="secondary"
          data-mfa-copy="#mfa-setup-key"
          data-copied={dgettext("dashboard_auth", "Setup key copied")}
          data-copy-error={
            dgettext("dashboard_auth", "Could not copy. Select and copy the text instead.")
          }
          label={dgettext("dashboard_auth", "Copy setup key")}
        />
        <span id="mfa-copy-status" role="status"></span>
      </div>
      <form
        id="mfa-enrollment"
        method="post"
        action={~p"/users/settings/mfa/confirm"}
        data-part="form"
      >
        <input type="hidden" name="_csrf_token" value={Phoenix.Controller.get_csrf_token()} />
        <input
          id="mfa-username"
          type="text"
          name="username"
          value={@current_user.email}
          autocomplete="username"
          hidden
          readonly
        />
        <.text_input
          id="mfa-code"
          name="mfa_code"
          value=""
          label={dgettext("dashboard_auth", "Authentication code")}
          show_prefix={false}
          autocomplete="one-time-code"
          inputmode="numeric"
          pattern="[0-9]{6}"
          maxlength="6"
          autocapitalize="none"
          spellcheck="false"
          required
          autofocus
        />
        <.button
          variant="primary"
          size="large"
          type="submit"
          label={dgettext("dashboard_auth", "Enable two-factor authentication")}
        />
      </form>
      <form method="post" action={~p"/users/settings/mfa/cancel"} data-part="form">
        <input type="hidden" name="_csrf_token" value={Phoenix.Controller.get_csrf_token()} />
        <.button
          variant="secondary"
          size="large"
          type="submit"
          label={dgettext("dashboard_auth", "Cancel setup")}
        />
      </form>
    <% else %>
      <form method="post" action={~p"/users/settings/mfa/enroll"} data-part="form">
        <input type="hidden" name="_csrf_token" value={Phoenix.Controller.get_csrf_token()} />
        <.button
          variant="primary"
          size="large"
          type="submit"
          label={dgettext("dashboard_auth", "Set up authenticator app")}
        />
      </form>
    <% end %>
  <% end %>
  <section :if={@passkeys_enabled?} id="passkeys" data-part="passkeys">
    <h2 data-part="section-title">{dgettext("dashboard_auth", "Passkeys")}</h2>
    <p data-part="security-note">
      {dgettext(
        "dashboard_auth",
        "Sign in with your fingerprint, face, or device PIN instead of a password. A passkey also completes two-factor authentication."
      )}
    </p>
    <.alert
      :if={Phoenix.Flash.get(@flash, :info)}
      type="secondary"
      status="success"
      size="small"
      title={Phoenix.Flash.get(@flash, :info)}
    />
    <.alert
      :if={Phoenix.Flash.get(@flash, :error)}
      type="secondary"
      status="error"
      size="small"
      title={Phoenix.Flash.get(@flash, :error)}
    />
    <ul :if={@passkeys != []} id="passkey-list" data-part="passkey-list">
      <li :for={passkey <- @passkeys} data-part="passkey-item">
        <div data-part="passkey-details">
          <span data-part="passkey-name">{passkey.name}</span>
          <span data-part="passkey-meta">
            {passkey_details(passkey)}
          </span>
        </div>
        <form
          method="post"
          action={~p"/users/settings/passkeys/#{passkey.id}/delete"}
          data-part="passkey-remove"
        >
          <input type="hidden" name="_csrf_token" value={Phoenix.Controller.get_csrf_token()} />
          <.button
            variant="secondary"
            size="small"
            type="submit"
            label={dgettext("dashboard_auth", "Remove")}
            aria-label={dgettext("dashboard_auth", "Remove %{name}", name: passkey.name)}
          />
        </form>
      </li>
    </ul>
    <div data-part="form">
      <.text_input
        id="passkey-name"
        name="name"
        value=""
        label={dgettext("dashboard_auth", "Passkey name")}
        placeholder={dgettext("dashboard_auth", "For example, MacBook Touch ID")}
        show_prefix={false}
        maxlength="64"
        autocomplete="off"
      />
      <.button
        id="passkey-add"
        type="button"
        variant="primary"
        size="large"
        label={dgettext("dashboard_auth", "Add a passkey")}
        data-passkey-ceremony="register"
        data-options-url={~p"/users/settings/passkeys/options"}
        data-action-url={~p"/users/settings/passkeys"}
        data-name-input="passkey-name"
        data-status="passkey-status"
      >
        <:icon_left>
          <.lock_password />
        </:icon_left>
      </.button>
      <span
        id="passkey-status"
        data-part="passkey-status"
        role="status"
        data-cancelled={dgettext("dashboard_auth", "Adding the passkey was cancelled.")}
        data-failed={dgettext("dashboard_auth", "The passkey could not be added. Try again.")}
        data-already-registered={
          dgettext("dashboard_auth", "This passkey is already registered.")
        }
        data-unsupported={dgettext("dashboard_auth", "This browser does not support passkeys.")}
      ></span>
    </div>
  </section>
  <p data-part="security-note">
    {dgettext(
      "dashboard_auth",
      "Changing your authenticator app or passkeys requires signing in within the last five minutes. Password resets do not remove them. Keep recovery codes somewhere safe."
    )}
  </p>
  <:footer>
    <.link_button
      variant="primary"
      href={~p"/#{@current_user.account.name}/settings/authentication"}
      label={dgettext("dashboard_auth", "Back to authentication settings")}
    />
  </:footer>
</.auth_page>
