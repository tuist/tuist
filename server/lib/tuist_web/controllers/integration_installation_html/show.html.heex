<div id="integration-installation">
  <div data-part="frame">
    <div data-part="content">
      <.tuist_mark data-part="logo" aria-label={dgettext("dashboard_auth", "Tuist Logo")} />
      <div data-part="dots">
        <.dots_light />
        <.dots_dark />
      </div>
      <div data-part="header">
        <h1 data-part="title">{dgettext("dashboard_auth", "Choose an organization")}</h1>
        <span data-part="subtitle">
          <%= if match?(%{type: :organization}, @github_account) do %>
            {dgettext(
              "dashboard_auth",
              "Select the Tuist organization to connect to the %{github_organization} GitHub organization.",
              github_organization: @github_account.login
            )}
          <% else %>
            {dgettext(
              "dashboard_auth",
              "Select the Tuist organization to connect to %{provider}.",
              provider: @provider
            )}
          <% end %>
        </span>
      </div>
      {live_render(@conn, TuistWeb.IntegrationInstallationAccountsLive,
        id: "integration-installation-accounts",
        container: {:div, "data-part": "accounts"}
      )}
      <form method="post" action={~p"/integrations/installation"} data-part="form">
        <input type="hidden" name="_csrf_token" value={Phoenix.Controller.get_csrf_token()} />
        <input type="hidden" name="_method" value="delete" />
        <.button
          variant="secondary"
          size="large"
          type="submit"
          label={dgettext("dashboard_auth", "Cancel")}
        />
      </form>
    </div>
    <div data-part="bottom-link">
      <span data-part="bottom-link-title">
        {dgettext("dashboard_auth", "Don't see your organization?")}
      </span>
      <span data-part="bottom-link-description">
        {dgettext(
          "dashboard_auth",
          "Only organizations you administer are listed. Create one, or ask an admin to promote you."
        )}
      </span>
      <.link_button
        href={~p"/organizations/new?#{%{return_to: "integration_installation"}}"}
        variant="primary"
        size="large"
        label={dgettext("dashboard_auth", "Create an organization")}
      />
    </div>
  </div>
  <div data-part="background">
    <div data-part="top-right-gradient"></div>
    <div data-part="bottom-left-gradient"></div>
    <div data-part="shell"><.shell /></div>
  </div>
  <.terms_and_privacy />
</div>
