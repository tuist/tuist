<div id="runner-docker-cache">
  <.button
    :if={@selected}
    navigate={~p"/#{@selected_account.name}/runners/docker-cache"}
    variant="secondary"
    size="medium"
    label={dgettext("dashboard_runners", "Docker cache")}
    data-part="back-button"
  >
    <:icon_left><.arrow_left /></:icon_left>
  </.button>
  <div :if={@selected} data-part="header">
    <div data-part="title">
      <div data-part="volume-icon"><.brand_docker /></div>
      <h1>{@selected.repository}</h1>
    </div>
    <div data-part="actions">
      <.button
        variant="secondary"
        size="medium"
        label={dgettext("dashboard_runners", "Volume")}
        navigate={~p"/#{@selected_account.name}/runners/volumes/#{@selected.id}"}
      >
        <:icon_left><.database /></:icon_left>
      </.button>
    </div>
  </div>
  <.alert
    :if={!@enabled and is_nil(@selected)}
    id="docker-cache-not-enabled"
    status="information"
    type="secondary"
    size="large"
    title={dgettext("dashboard_runners", "The Docker cache is not enabled for this account")}
    description={
      dgettext(
        "dashboard_runners",
        "Linux jobs pull every image and layer in each job until it is enabled."
      )
    }
  />
  <.card
    :if={@selected}
    title={dgettext("dashboard_runners", "Docker cache details")}
    icon="database"
  >
    <.card_section>
      <div data-part="metadata-grid">
        <div data-part="metadata">
          <div data-part="title">{dgettext("dashboard_runners", "Repository")}</div>
          <span data-part="label">
            <.brand_github :if={@selected.provider in [nil, "github"]} />
            <.brand_gitlab :if={@selected.provider == "gitlab"} />
            {@selected.repository}
          </span>
        </div>
        <div data-part="metadata">
          <div data-part="title">{dgettext("dashboard_runners", "Status")}</div><.badge
            label={status_label(@selected.status)}
            color={status_color(@selected.status)}
            style="light-fill"
            size="large"
          />
        </div>
        <div data-part="metadata">
          <div data-part="title">{dgettext("dashboard_runners", "Platform")}</div><.badge
            label={"#{TuistWeb.RunnersLive.platform_label(@selected.platform)} · #{@selected.architecture}"}
            color="neutral"
            style="light-fill"
            size="large"
          />
        </div>
        <div data-part="metadata">
          <div data-part="title">{dgettext("dashboard_runners", "Last used")}</div><span
            data-part="label"
            title={RunnerVolumesLive.time(@selected.last_used_at)}
          ><.history />{RunnerVolumesLive.relative_time(@selected.last_used_at)}</span>
        </div>
        <div data-part="metadata">
          <div data-part="title">{dgettext("dashboard_runners", "Saved size")}</div>
          <span data-part="label">{RunnerVolumesLive.bytes(@selected.saved_bytes)}</span>
        </div>
        <div data-part="metadata">
          <div data-part="title">{dgettext("dashboard_runners", "Build cache")}</div>
          <span data-part="label">{RunnerVolumesLive.bytes(@selected.build_cache_bytes)}</span>
        </div>
        <div data-part="metadata">
          <div data-part="title">{dgettext("dashboard_runners", "Images")}</div>
          <span data-part="label">{RunnerVolumesLive.count(@selected.image_count)}</span>
        </div>
        <div data-part="metadata">
          <div data-part="title">{dgettext("dashboard_runners", "Last saved")}</div><span
            data-part="label"
            title={RunnerVolumesLive.time(@selected.last_saved_at)}
          ><.history />{RunnerVolumesLive.relative_time(@selected.last_saved_at)}</span>
        </div>
      </div>
    </.card_section>
  </.card>
  <.async_result :let={data} assign={@data}>
    <:loading>
      <.card
        title={
          if @selected,
            do: dgettext("dashboard_runners", "Analytics"),
            else: dgettext("dashboard_runners", "Docker cache")
        }
        icon={if @selected, do: "chart_arcs", else: "brand_docker"}
      >
        <div data-part="widgets">
          <.widget
            :for={n <- 1..3}
            id={"docker-loading-#{n}"}
            title={dgettext("dashboard_runners", "Loading")}
            loading={true}
          />
        </div>
      </.card>
    </:loading>
    <:failed>
      <.card title={dgettext("dashboard_runners", "Docker cache")} icon="brand_docker">
        <.card_section>
          <p role="alert" data-part="note">
            {dgettext(
              "dashboard_runners",
              "Could not load the Docker cache. Retrying automatically."
            )}
          </p>
        </.card_section>
      </.card>
    </:failed>
    <.card
      title={
        if @selected,
          do: dgettext("dashboard_runners", "Analytics"),
          else: dgettext("dashboard_runners", "Docker cache")
      }
      icon={if @selected, do: "chart_arcs", else: "brand_docker"}
      id="docker-cache-analytics"
    >
      <:actions>
        <.docker_date_picker
          id="docker-cache-date-range-picker"
          preset={@analytics_preset}
          period={@analytics_period}
        />
      </:actions>
      <.analytics_widgets
        id="docker-cache"
        data={data}
        metric={@metric}
        period={@analytics_period}
      />
    </.card>
    <.card :if={@selected} title={dgettext("dashboard_runners", "Images")} icon="stack_2">
      <.card_section data-part="table-section">
        <.table id="docker-images-table" rows={@selected.images}>
          <:col :let={image} label={dgettext("dashboard_runners", "Image")}>
            <.text_cell label={image.reference} title={image.id} />
          </:col>
          <:col :let={image} label={dgettext("dashboard_runners", "Other references")}>
            <.text_cell label={
              if image.other_references == [],
                do: "—",
                else: Enum.join(image.other_references, ", ")
            } />
          </:col>
          <:col :let={image} label={dgettext("dashboard_runners", "Size")}>
            <.text_cell label={RunnerVolumesLive.bytes(image.size_bytes)} />
          </:col>
          <:col :let={image} label={dgettext("dashboard_runners", "Last used")}>
            <.text_cell
              label={RunnerVolumesLive.relative_time(image.last_used_at)}
              title={RunnerVolumesLive.time(image.last_used_at)}
            />
          </:col>
          <:empty_state>
            <.table_empty_state
              title={dgettext("dashboard_runners", "No images saved yet")}
              subtitle={
                dgettext(
                  "dashboard_runners",
                  "Images appear after a job that may save this repository's caches finishes and its data root is saved."
                )
              }
            />
          </:empty_state>
        </.table>
      </.card_section>
    </.card>
    <.card
      :if={is_nil(@selected)}
      title={dgettext("dashboard_runners", "Repositories")}
      icon="stack_2"
    >
      <% {repositories, more?} = repositories_page(data.repositories, assigns) %>
      <.card_section data-part="table-section">
        <div data-part="table-toolbar">
          <.form for={%{}} phx-change="search" data-part="filters">
            <.text_input
              type="search"
              id="docker-repository-search"
              name="search"
              value={@search}
              phx-debounce="200"
              placeholder={dgettext("dashboard_runners", "Search repositories")}
              show_suffix={false}
              data-part="search"
            />
          </.form>
          <.dropdown
            id="docker-repositories-sort-by-dropdown"
            label={sort_label(@sort_by)}
            secondary_text={dgettext("dashboard_runners", "Sort by:")}
          >
            <.dropdown_item
              :for={{column, label} <- sort_options()}
              value={column}
              label={label}
              patch={sort_patch(assigns, column)}
              data-selected={@sort_by == column}
            >
              <:right_icon :if={@sort_by == column}><.check /></:right_icon>
            </.dropdown_item>
          </.dropdown>
        </div>
        <.table
          id="docker-repositories-table"
          rows={repositories}
          row_navigate={
            fn repository ->
              ~p"/#{@selected_account.name}/runners/docker-cache/#{repository.id}"
            end
          }
        >
          <:col
            :let={repository}
            label={dgettext("dashboard_runners", "Repository")}
            patch={sort_patch(assigns, "repository")}
            sort_order={@sort_by == "repository" && @sort_order}
          >
            <.text_cell label={repository.repository} />
          </:col>
          <:col :let={repository} label={dgettext("dashboard_runners", "Status")}>
            <.badge_cell
              label={status_label(repository.status)}
              color={status_color(repository.status)}
              style="light-fill"
            />
          </:col>
          <:col
            :let={repository}
            label={dgettext("dashboard_runners", "Images")}
            patch={sort_patch(assigns, "images")}
            sort_order={@sort_by == "images" && @sort_order}
          >
            <.text_cell label={RunnerVolumesLive.count(repository.image_count)} />
          </:col>
          <:col
            :let={repository}
            label={dgettext("dashboard_runners", "Saved size")}
            patch={sort_patch(assigns, "saved_size")}
            sort_order={@sort_by == "saved_size" && @sort_order}
          >
            <.text_cell label={RunnerVolumesLive.bytes(repository.saved_bytes)} />
          </:col>
          <:col
            :let={repository}
            label={dgettext("dashboard_runners", "Hit rate")}
            patch={sort_patch(assigns, "hit_rate")}
            sort_order={@sort_by == "hit_rate" && @sort_order}
          >
            <.text_cell
              label={RunnerVolumesLive.percentage(repository.hit_rate)}
              title={
                dngettext(
                  "dashboard_runners",
                  "%{count} job in the selected period",
                  "%{count} jobs in the selected period",
                  repository.uses
                )
              }
            />
          </:col>
          <:col
            :let={repository}
            label={dgettext("dashboard_runners", "Last used")}
            patch={sort_patch(assigns, "last_used")}
            sort_order={@sort_by == "last_used" && @sort_order}
          >
            <.text_cell
              label={RunnerVolumesLive.relative_time(repository.last_used_at)}
              title={RunnerVolumesLive.time(repository.last_used_at)}
            />
          </:col>
          <:empty_state>
            <.table_empty_state
              title={dgettext("dashboard_runners", "No repositories found")}
              subtitle={
                dgettext(
                  "dashboard_runners",
                  "A repository appears here after one of its Linux jobs uses Docker, or try a different search."
                )
              }
            />
          </:empty_state>
        </.table>
        <nav
          :if={@page > 1 or more?}
          data-part="pagination"
          aria-label={dgettext("dashboard_runners", "Repository pages")}
        >
          <.button
            disabled={@page <= 1}
            variant="secondary"
            label={dgettext("dashboard_runners", "Prev")}
            patch={page_path(assigns, Map.put(@params, "page", max(1, @page - 1)))}
          >
            <:icon_left><.chevron_left /></:icon_left>
          </.button>
          <.button
            disabled={!more?}
            variant="secondary"
            label={dgettext("dashboard_runners", "Next")}
            patch={page_path(assigns, Map.put(@params, "page", @page + 1))}
          >
            <:icon_right><.chevron_right /></:icon_right>
          </.button>
        </nav>
      </.card_section>
    </.card>
  </.async_result>
</div>
