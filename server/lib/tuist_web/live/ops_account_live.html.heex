<div id="ops-account">
  <div data-part="header">
    <h1 data-part="title">{@account.name}</h1>
    <p data-part="subtitle">
      {account_type(@account)} · {dgettext("dashboard", "Account ID")} {@account.id}
    </p>
  </div>

  <.alert
    :if={@kura_notice}
    id="kura-notice"
    status={elem(@kura_notice, 0)}
    type="secondary"
    size="small"
    title={elem(@kura_notice, 1)}
    dismissible
  />

  <.card title={dgettext("dashboard", "Kura placement")} icon="world">
    <.card_section>
      <.table id="account-kura-placement-table" rows={[@account]}>
        <:col label={dgettext("dashboard", "Resolved region")}>
          <.text_cell label={resolved_service_region(@kura_resolution)} />
        </:col>
        <:col :let={account} label={dgettext("dashboard", "Plan")}>
          <.text_cell label={effective_plan_label(account)} />
        </:col>
        <:col :let={account} label={dgettext("dashboard", "Storage region")}>
          <.text_cell label={storage_region_label(account.region)} />
        </:col>
        <:col label={dgettext("dashboard", "Explicit assignment")}>
          <%= case @kura_assignment do %>
            <% nil -> %>
              <.text_cell label={dgettext("dashboard", "None")} />
            <% assignment -> %>
              <.text_cell
                label={region_label(assignment.service_region)}
                sublabel={
                  dgettext("dashboard", "Version %{version}",
                    version: to_string(assignment.version)
                  )
                }
              />
          <% end %>
        </:col>
      </.table>
    </.card_section>

    <.card_section>
      <p data-part="kura-placement-description">
        {dgettext(
          "dashboard",
          "An assignment is the only way to place a paid account that allows every storage region, and the only route to a region no storage preference derives to. It does not move anything on its own: the lifecycle provisions an instance in the new region on the next cache demand, and the old region's instance keeps serving until it is destroyed. Destroy it only once the new one exists — a destroy is honoured only while it is newer than the account's last recorded cache demand, so demand recorded after it re-provisions the instance in the region you just cleared."
        )}
      </p>

      <%= if @kura_assignment_refusal do %>
        <p data-part="kura-placement-refusal">
          {assignment_refusal_message(@kura_assignment_refusal, @account)}
        </p>
      <% else %>
        <.form
          for={@kura_assignment_form}
          id="kura-assignment-form"
          phx-submit="assign_kura_service_region"
        >
          <div class="select-field">
            <.label label={dgettext("dashboard", "Service region")} required />
            <select id="kura-assignment-region" name="assignment[service_region]" required>
              <option
                :for={service_region <- AccountRegionPolicy.service_regions()}
                value={service_region}
                selected={service_region == @kura_assignment_form[:service_region].value}
              >
                {region_label(service_region)}
              </option>
            </select>
          </div>
          <.text_input
            field={@kura_assignment_form[:reason]}
            label={dgettext("dashboard", "Reason")}
            hint={
              dgettext(
                "dashboard",
                "Kept on the assignment and shown in the history below. Write what a reviewer would need months from now."
              )
            }
            required
            show_required
          />
          <div data-part="actions">
            <.button
              type="submit"
              variant="primary"
              label={dgettext("dashboard", "Assign region")}
            />
          </div>
        </.form>
      <% end %>
    </.card_section>

    <.card_section>
      <.table id="kura-assignment-history-table" rows={@kura_assignment_history}>
        <:col :let={assignment} label={dgettext("dashboard", "Version")}>
          <.text_cell label={to_string(assignment.version)} />
        </:col>
        <:col :let={assignment} label={dgettext("dashboard", "Region")}>
          <.text_cell label={assignment.service_region} />
        </:col>
        <:col :let={assignment} label={dgettext("dashboard", "Reason")}>
          <.text_cell label={assignment.reason} />
        </:col>
        <:col :let={assignment} label={dgettext("dashboard", "Assigned by")}>
          <.text_cell label={assignment_actor(assignment)} />
        </:col>
        <:col :let={assignment} label={dgettext("dashboard", "Assigned at")}>
          <.text_cell label={assignment_timestamp(assignment.inserted_at)} />
        </:col>
        <:col :let={assignment} label={dgettext("dashboard", "Superseded at")}>
          <.text_cell label={assignment_timestamp(assignment.superseded_at)} />
        </:col>
        <:col :let={assignment} label={dgettext("dashboard", "Actions")}>
          <div data-part="actions">
            <.button
              :if={assignment.superseded_at && is_nil(@kura_assignment_refusal)}
              variant="secondary"
              label={dgettext("dashboard", "Restore")}
              phx-click="open_restore_kura_assignment"
              phx-value-version={assignment.version}
            />
          </div>
        </:col>
        <:empty_state>
          <.table_empty_state
            icon="history"
            title={dgettext("dashboard", "No explicit assignment")}
            subtitle={
              dgettext(
                "dashboard",
                "This account resolves from its plan, its storage region, and where it already runs."
              )
            }
          />
        </:empty_state>
      </.table>
    </.card_section>
  </.card>

  <.card title={dgettext("dashboard", "Kura instances")} icon="server">
    <.card_section>
      <.table id="account-kura-table" rows={@kura_servers}>
        <:col :let={server} label={dgettext("dashboard", "Region")}>
          <.text_cell label={server.region} />
        </:col>
        <:col :let={server} label={dgettext("dashboard", "Status")}>
          <.badge_cell
            label={server.status |> Atom.to_string() |> String.replace("_", " ")}
            color="neutral"
            style="light-fill"
          />
        </:col>
        <:col :let={server} label={dgettext("dashboard", "Claim")}>
          <.text_cell label={
            Kura.instance_storage_claim(server, @kura_account_claim) ||
              dgettext("dashboard", "None")
          } />
        </:col>
        <:col :let={server} label={dgettext("dashboard", "URL")}>
          <.text_cell label={server.url || dgettext("dashboard", "None")} />
        </:col>
        <:col :let={server} label={dgettext("dashboard", "Current version")}>
          <.text_cell label={
            Tuist.Kura.version_label(server.current_image_tag) || dgettext("dashboard", "None")
          } />
        </:col>
        <:col :let={server} label={dgettext("dashboard", "Latest deployment")}>
          <%= case List.first(server.deployments) do %>
            <% nil -> %>
              <.text_cell label={dgettext("dashboard", "None")} />
            <% deployment -> %>
              <.link navigate={~p"/ops/accounts/#{@account.id}/kura/deployments/#{deployment.id}"}>
                {Tuist.Kura.version_label(deployment.image_tag)}
              </.link>
          <% end %>
        </:col>
        <:col :let={server} label={dgettext("dashboard", "Actions")}>
          <div data-part="actions">
            <.button
              :if={server.status != :destroying}
              variant="secondary"
              label={dgettext("dashboard", "Destroy")}
              phx-click="destroy_kura_instance"
              phx-value-id={server.id}
              data-confirm={
                dgettext(
                  "dashboard",
                  "Destroy the %{status} Kura instance in %{region}? This tears down the backing resource and removes its URL from the account's cache endpoints. Assign the replacement region first: cache demand recorded after this destroy re-provisions the instance right here.",
                  region: server.region,
                  status: instance_status_label(server.status)
                )
              }
            />
          </div>
        </:col>
        <:empty_state>
          <.table_empty_state
            icon="server"
            title={dgettext("dashboard", "No Kura instances")}
            subtitle={
              dgettext(
                "dashboard",
                "The lifecycle provisions one in the account's resolved region on its next cache demand, or add one below."
              )
            }
          />
        </:empty_state>
      </.table>
    </.card_section>

    <.card_section>
      <p data-part="kura-provision-description">
        {dgettext(
          "dashboard",
          "Provisioning by hand is the same thing the demand-driven lifecycle does on its own, brought forward. Assign the service region first: an instance in a region the account no longer resolves to keeps running and holding its allocation until it is destroyed."
        )}
      </p>

      <%= if @kura_provision_regions == [] do %>
        <p data-part="kura-provision-refusal">
          {dgettext(
            "dashboard",
            "This account already holds an instance in every region it can be provisioned in. Destroy one to free its region."
          )}
        </p>
      <% else %>
        <.form
          for={@kura_provision_form}
          id="kura-provision-form"
          phx-submit="provision_kura_instance"
        >
          <div class="select-field">
            <.label label={dgettext("dashboard", "Region")} required />
            <select id="kura-provision-region" name="instance[region]" required>
              <option
                :for={region <- @kura_provision_regions}
                value={region.id}
                selected={region.id == @kura_provision_form[:region].value}
              >
                {region.display_name}
              </option>
            </select>
          </div>
          <p data-part="hint">
            <%= case @kura_latest_version do %>
              <% nil -> %>
                {dgettext(
                  "dashboard",
                  "No Kura runtime image is configured right now, so nothing can be provisioned until the next server deploy."
                )}
              <% version -> %>
                {dgettext("dashboard", "New instances start on Kura %{version}.",
                  version: version.version
                )}
            <% end %>
          </p>
          <div data-part="actions">
            <.button
              type="submit"
              variant="primary"
              label={dgettext("dashboard", "Provision instance")}
              disabled={is_nil(@kura_latest_version)}
            />
          </div>
        </.form>
      <% end %>
    </.card_section>
    <.card_section>
      <p data-part="kura-storage-claim-description">
        {dgettext(
          "dashboard",
          "Each replica reserves this much disk. Leave it empty to size the account from its plan. Raising it replaces volumes one replica at a time, so the standby keeps serving and the rebuilt replica refills from it; lowering it keeps the cache and evicts down."
        )}
      </p>
      <.form
        for={@kura_storage_claim_form}
        id="kura-storage-claim-form"
        phx-submit="update_kura_storage_claim"
      >
        <.text_input
          field={@kura_storage_claim_form[:kura_storage_claim_size]}
          label={dgettext("dashboard", "Disk claim override")}
          placeholder={@kura_plan_claim}
          hint={
            dgettext("dashboard", "A Kubernetes storage quantity of at least %{minimum}.",
              minimum: @kura_minimum_claim
            )
          }
        />
        <div data-part="actions">
          <.button
            type="submit"
            variant="primary"
            label={dgettext("dashboard", "Save disk claim")}
          />
        </div>
      </.form>
    </.card_section>
  </.card>

  <.card title={dgettext("dashboard", "Runner concurrency")} icon="server">
    <.card_section>
      <p data-part="runner-concurrency-description">
        {dgettext(
          "dashboard",
          "Limits apply independently to Linux and macOS. A new runner starts only when both its vCPU and memory fit within that platform's remaining capacity."
        )}
      </p>
      <.form
        for={@runner_concurrency_form}
        id="runner-concurrency-form"
        phx-submit="update_runner_concurrency_limits"
      >
        <div data-part="runner-concurrency-platforms">
          <fieldset>
            <legend>{dgettext("dashboard", "Linux")}</legend>
            <.text_input
              field={@runner_concurrency_form[:runner_linux_vcpus_limit]}
              input_type="number"
              min={1}
              label={dgettext("dashboard", "vCPU limit")}
              required
              show_required
            />
            <.text_input
              field={@runner_concurrency_form[:runner_linux_memory_gb_limit]}
              input_type="number"
              min={1}
              label={dgettext("dashboard", "Memory limit (GB)")}
              required
              show_required
            />
          </fieldset>
          <fieldset>
            <legend>{dgettext("dashboard", "macOS")}</legend>
            <.text_input
              field={@runner_concurrency_form[:runner_macos_vcpus_limit]}
              input_type="number"
              min={1}
              label={dgettext("dashboard", "vCPU limit")}
              required
              show_required
            />
            <.text_input
              field={@runner_concurrency_form[:runner_macos_memory_gb_limit]}
              input_type="number"
              min={1}
              label={dgettext("dashboard", "Memory limit (GB)")}
              required
              show_required
            />
          </fieldset>
        </div>
        <div data-part="actions">
          <.button
            type="submit"
            variant="primary"
            label={dgettext("dashboard", "Save runner limits")}
          />
        </div>
      </.form>
    </.card_section>
  </.card>

  <.card title={dgettext("dashboard", "Visibility")} icon="eye">
    <.card_section>
      <.table id="account-visibility-table" rows={[@account]}>
        <:col :let={account} label={dgettext("dashboard", "Dashboards")}>
          <.text_cell label={
            if account.visibility == :public,
              do: dgettext("dashboard", "Public"),
              else: dgettext("dashboard", "Private")
          } />
        </:col>
        <:col :let={account} label={dgettext("dashboard", "Signed-out visitors see")}>
          <.text_cell label={
            if account.visibility == :public,
              do:
                dgettext(
                  "dashboard",
                  "Public projects, runners, and usage. Members, webhooks, cache, billing, and settings stay private."
                ),
              else: dgettext("dashboard", "Nothing.")
          } />
        </:col>
        <:col label={dgettext("dashboard", "Actions")}>
          <div data-part="actions">
            <.button
              variant="secondary"
              label={
                if @account.visibility == :public,
                  do: dgettext("dashboard", "Make private"),
                  else: dgettext("dashboard", "Make public")
              }
              phx-click="toggle_visibility"
            />
          </div>
        </:col>
      </.table>
    </.card_section>
  </.card>

  <.card title={dgettext("dashboard", "Plan & billing")} icon="credit_card">
    <.card_section>
      <.table id="account-plan-table" rows={[@account]}>
        <:col :let={account} label={dgettext("dashboard", "Plan")}>
          <.badge_cell
            label={plan_label(current_plan(account))}
            color={plan_color(current_plan(account))}
            style="light-fill"
          />
        </:col>
        <:col :let={account} label={dgettext("dashboard", "Status")}>
          <.badge_cell
            label={status_label(subscription_status(account))}
            color={status_color(subscription_status(account))}
            style="light-fill"
          />
        </:col>
        <:col :let={account} label={dgettext("dashboard", "Billing email")}>
          <.text_cell label={account.billing_email || dgettext("dashboard", "None")} />
        </:col>
        <:col :let={account} label={dgettext("dashboard", "Stripe customer")}>
          <.text_cell label={account.customer_id || dgettext("dashboard", "Not created")} />
        </:col>
      </.table>
    </.card_section>

    <.card_section>
      <div data-part="actions">
        <.button
          variant="secondary"
          label={dgettext("dashboard", "Manage on Stripe")}
          href={~p"/ops/accounts/#{@account.id}/stripe-customer"}
          target="_blank"
          rel="noopener noreferrer"
        />
        <.button
          :if={current_plan(@account) != :enterprise}
          variant="primary"
          label={dgettext("dashboard", "Upgrade to Enterprise")}
          phx-click="initiate_enterprise_upgrade"
        />
        <.button
          :if={
            current_plan(@account) in [:pro, :enterprise] and
              subscription_status(@account) != :cancelled
          }
          variant="secondary"
          label={dgettext("dashboard", "Cancel plan")}
          phx-click="cancel_plan"
          data-confirm={
            dgettext(
              "dashboard",
              "Cancel %{account}'s subscription at the end of the current billing period? Access is kept until then.",
              account: @account.name
            )
          }
        />
      </div>
    </.card_section>
  </.card>

  <.modal
    :if={@restore_target}
    id="restore-assignment-modal"
    title={
      dgettext("dashboard", "Restore version %{version}",
        version: to_string(@restore_target.version)
      )
    }
    description={
      dgettext(
        "dashboard",
        "Re-applies %{region} as a new current version. Nothing in the history is rewritten, and the running instances are left where they are.",
        region: @restore_target.service_region
      )
    }
    header_type="icon"
    header_size="small"
    on_dismiss="close_restore_kura_assignment"
  >
    <:header_icon><.history /></:header_icon>
    <:trigger :let={modal_attrs}>
      <button id="restore-assignment-trigger" type="button" style="display: none;" {modal_attrs}>
      </button>
    </:trigger>

    <form
      id="restore-assignment-form"
      phx-submit="restore_kura_assignment"
      class="restore-assignment-form"
    >
      <input type="hidden" name="assignment[version]" value={@restore_target.version} />
      <.text_input
        id="restore-assignment-reason"
        name="assignment[reason]"
        label={dgettext("dashboard", "Reason")}
        placeholder={
          dgettext("dashboard", "Why this account goes back to %{region}",
            region: @restore_target.service_region
          )
        }
        required
        show_required
      />
    </form>

    <:footer>
      <.modal_footer>
        <:action>
          <.button
            label={dgettext("dashboard", "Cancel")}
            variant="secondary"
            type="button"
            phx-click="close_restore_kura_assignment"
          />
        </:action>
        <:action>
          <.button
            label={dgettext("dashboard", "Restore region")}
            variant="primary"
            type="submit"
            form="restore-assignment-form"
          />
        </:action>
      </.modal_footer>
    </:footer>
  </.modal>

  <.modal
    :if={@upgrade_target_account}
    id="enterprise-modal"
    title={
      dgettext("dashboard", "Upgrade %{account} to Enterprise",
        account: @upgrade_target_account.name
      )
    }
    description={
      dgettext(
        "dashboard",
        "Creates a Stripe customer (if missing), sets the billing address, and starts an invoice-billed Enterprise subscription. The customer receives an invoice by email; no card is collected here."
      )
    }
    header_type="icon"
    header_size="small"
    on_dismiss="close_enterprise_modal"
  >
    <:header_icon><.building /></:header_icon>
    <:trigger :let={modal_attrs}>
      <button id="enterprise-trigger" type="button" style="display: none;" {modal_attrs}></button>
    </:trigger>

    <form
      id="enterprise-form"
      phx-submit="submit_enterprise_upgrade"
      class="enterprise-upgrade-form"
    >
      <.text_input
        id="enterprise-name"
        name="name"
        label={dgettext("dashboard", "Name on invoice")}
        value={prefill(@upgrade_target_customer, :name, @upgrade_target_account.name)}
        required
        show_required
      />
      <.text_input
        id="enterprise-billing-email"
        name="billing_email"
        label={dgettext("dashboard", "Billing email")}
        value={prefill(@upgrade_target_customer, :email, @upgrade_target_account.billing_email)}
        required
        show_required
      />
      <.text_input
        id="enterprise-address-line1"
        name="address_line1"
        label={dgettext("dashboard", "Address line 1")}
        value={prefill_address(@upgrade_target_customer, :line1)}
        required
        show_required
      />
      <.text_input
        id="enterprise-address-line2"
        name="address_line2"
        label={dgettext("dashboard", "Address line 2 (optional)")}
        value={prefill_address(@upgrade_target_customer, :line2)}
      />
      <.text_input
        id="enterprise-address-city"
        name="address_city"
        label={dgettext("dashboard", "City")}
        value={prefill_address(@upgrade_target_customer, :city)}
        required
        show_required
      />
      <.text_input
        id="enterprise-address-state"
        name="address_state"
        label={dgettext("dashboard", "State / region (optional)")}
        value={prefill_address(@upgrade_target_customer, :state)}
      />
      <.text_input
        id="enterprise-address-postal-code"
        name="address_postal_code"
        label={dgettext("dashboard", "Postal code")}
        value={prefill_address(@upgrade_target_customer, :postal_code)}
        required
        show_required
      />
      <div class="select-field">
        <.label label={dgettext("dashboard", "Country")} required />
        <.select
          id="enterprise-address-country"
          label={dgettext("dashboard", "Select a country")}
          name="address_country"
          value={prefill_address(@upgrade_target_customer, :country)}
        >
          <:item :for={{code, name} <- countries()} value={code} label={name} />
        </.select>
      </div>

      <div class="select-field">
        <.label label={dgettext("dashboard", "Billing cadence")} />
        <.select
          id="enterprise-cadence"
          label={dgettext("dashboard", "Monthly")}
          name="cadence"
          value="monthly"
        >
          <:item value="monthly" label={dgettext("dashboard", "Monthly")} />
          <:item value="yearly" label={dgettext("dashboard", "Yearly")} />
        </.select>
      </div>
    </form>

    <:footer>
      <.modal_footer>
        <:action>
          <.button
            label={dgettext("dashboard", "Cancel")}
            variant="secondary"
            type="button"
            phx-click="close_enterprise_modal"
          />
        </:action>
        <:action>
          <.button
            label={dgettext("dashboard", "Upgrade to Enterprise")}
            variant="primary"
            type="submit"
            form="enterprise-form"
          />
        </:action>
      </.modal_footer>
    </:footer>
  </.modal>
</div>
