<div id="ops-account">
  <.alert
    :if={Phoenix.Flash.get(@flash, :error)}
    id="ops-account-flash-error"
    type="secondary"
    status="error"
    size="small"
    title={Phoenix.Flash.get(@flash, :error)}
  />
  <.alert
    :if={Phoenix.Flash.get(@flash, :info)}
    id="ops-account-flash-info"
    type="secondary"
    status="success"
    size="small"
    title={Phoenix.Flash.get(@flash, :info)}
  />
  <div data-part="header">
    <h1 data-part="title">{@account.name}</h1>
    <p data-part="subtitle">
      {account_type(@account)} · {dgettext("dashboard", "Account ID")} {@account.id}
    </p>
  </div>

  <.card title={dgettext("dashboard", "Kura")} icon="server">
    <.card_section>
      <.table id="account-kura-table" rows={@kura_servers}>
        <:col :let={server} label={dgettext("dashboard", "Region")}>
          <.text_cell label={server.region} />
        </:col>
        <:col :let={server} label={dgettext("dashboard", "Status")}>
          <.badge_cell
            label={server.status |> Atom.to_string() |> String.replace("_", " ")}
            color="neutral"
            style="light-fill"
          />
        </:col>
        <:col :let={server} label={dgettext("dashboard", "Claim")}>
          <.text_cell label={
            Kura.instance_storage_claim(server, @kura_account_claim) ||
              dgettext("dashboard", "None")
          } />
        </:col>
        <:col :let={server} label={dgettext("dashboard", "URL")}>
          <.text_cell label={server.url || dgettext("dashboard", "None")} />
        </:col>
        <:col :let={server} label={dgettext("dashboard", "Current version")}>
          <.text_cell label={
            Tuist.Kura.version_label(server.current_image_tag) || dgettext("dashboard", "None")
          } />
        </:col>
        <:col :let={server} label={dgettext("dashboard", "Latest deployment")}>
          <%= case List.first(server.deployments) do %>
            <% nil -> %>
              <.text_cell label={dgettext("dashboard", "None")} />
            <% deployment -> %>
              <.link navigate={~p"/ops/accounts/#{@account.id}/kura/deployments/#{deployment.id}"}>
                {Tuist.Kura.version_label(deployment.image_tag)}
              </.link>
          <% end %>
        </:col>
      </.table>
    </.card_section>
    <.card_section>
      <p data-part="kura-storage-claim-description">
        {dgettext(
          "dashboard",
          "Each replica reserves this much disk. Leave it empty to size the account from its plan. Raising it replaces volumes one replica at a time, so the standby keeps serving and the rebuilt replica refills from it; lowering it keeps the cache and evicts down."
        )}
      </p>
      <.form
        for={@kura_storage_claim_form}
        id="kura-storage-claim-form"
        phx-submit="update_kura_storage_claim"
      >
        <.text_input
          field={@kura_storage_claim_form[:kura_storage_claim_size]}
          label={dgettext("dashboard", "Disk claim override")}
          placeholder={@kura_plan_claim}
          hint={
            dgettext("dashboard", "A Kubernetes storage quantity of at least %{minimum}.",
              minimum: @kura_minimum_claim
            )
          }
        />
        <div data-part="actions">
          <.button
            type="submit"
            variant="primary"
            label={dgettext("dashboard", "Save disk claim")}
          />
        </div>
      </.form>
    </.card_section>
  </.card>

  <.card title={dgettext("dashboard", "Runner concurrency")} icon="server">
    <.card_section>
      <p data-part="runner-concurrency-description">
        {dgettext(
          "dashboard",
          "Limits apply independently to Linux and macOS. A new runner starts only when both its vCPU and memory fit within that platform's remaining capacity."
        )}
      </p>
      <.form
        for={@runner_concurrency_form}
        id="runner-concurrency-form"
        phx-submit="update_runner_concurrency_limits"
      >
        <div data-part="runner-concurrency-platforms">
          <fieldset>
            <legend>{dgettext("dashboard", "Linux")}</legend>
            <.text_input
              field={@runner_concurrency_form[:runner_linux_vcpus_limit]}
              input_type="number"
              min={1}
              label={dgettext("dashboard", "vCPU limit")}
              required
              show_required
            />
            <.text_input
              field={@runner_concurrency_form[:runner_linux_memory_gb_limit]}
              input_type="number"
              min={1}
              label={dgettext("dashboard", "Memory limit (GB)")}
              required
              show_required
            />
          </fieldset>
          <fieldset>
            <legend>{dgettext("dashboard", "macOS")}</legend>
            <.text_input
              field={@runner_concurrency_form[:runner_macos_vcpus_limit]}
              input_type="number"
              min={1}
              label={dgettext("dashboard", "vCPU limit")}
              required
              show_required
            />
            <.text_input
              field={@runner_concurrency_form[:runner_macos_memory_gb_limit]}
              input_type="number"
              min={1}
              label={dgettext("dashboard", "Memory limit (GB)")}
              required
              show_required
            />
          </fieldset>
        </div>
        <div data-part="actions">
          <.button
            type="submit"
            variant="primary"
            label={dgettext("dashboard", "Save runner limits")}
          />
        </div>
      </.form>
    </.card_section>
  </.card>

  <.card title={dgettext("dashboard", "Runner trial")} icon="hourglass">
    <.card_section>
      <p data-part="runner-trial-description">
        {dgettext(
          "dashboard",
          "An account on a runner trial is not billed for runner usage. Usage is still metered and still reported, but the subscription carries no runner item for Stripe to invoice it against. The trial runs until it is cancelled here."
        )}
      </p>
      <.alert
        :if={@on_runner_trial}
        id="runner-trial-active-alert"
        size="large"
        status="information"
        title={dgettext("dashboard", "On a runner trial")}
        description={
          dgettext(
            "dashboard",
            "Cancelling adds the runner items to this account's subscription, which makes its runner usage billable. Prefer cancelling at the end of a billing period: usage already recorded in the current one may become billable when the item is added."
          )
        }
      />
      <div data-part="actions">
        <.button
          :if={not @on_runner_trial}
          phx-click="start_runner_trial"
          variant="primary"
          label={dgettext("dashboard", "Start runner trial")}
        />
        <.button
          :if={@on_runner_trial}
          phx-click="cancel_runner_trial"
          variant="destructive"
          label={dgettext("dashboard", "Cancel runner trial")}
        />
      </div>
    </.card_section>
  </.card>

  <.card title={dgettext("dashboard", "Prepaid runner credit")} icon="asset">
    <.card_section>
      <p data-part="prepaid-description">
        {dgettext(
          "dashboard",
          "Prepaid minutes are added to the account's next invoice alongside the rest of the bill. The credit is granted once that invoice is paid, and is spent as money: the minutes below are what it buys on the macOS 6 vCPU / 14 GB baseline, and a larger machine draws it down faster."
        )}
      </p>
      <.alert
        :if={not @has_subscription}
        id="prepaid-no-subscription-alert"
        size="large"
        status="warning"
        title={dgettext("dashboard", "No active subscription")}
        description={
          dgettext(
            "dashboard",
            "This account has no subscription, so Stripe never generates an invoice for it. A prepaid charge added now would sit unbilled until one exists."
          )
        }
      />
      <.table
        :if={@prepaid_balance}
        id="prepaid-balance-table"
        rows={@prepaid_balance.grants}
      >
        <:col :let={grant} label={dgettext("dashboard", "Credit")}>
          <.text_cell label={prepaid_grant_kind_label(grant.kind)} />
        </:col>
        <:col :let={grant} label={dgettext("dashboard", "Remaining")}>
          <.text_cell label={format_money(grant.available)} />
        </:col>
        <:col :let={grant} label={dgettext("dashboard", "Expires")}>
          <.text_cell label={prepaid_expiry_label(grant.expires_at)} />
        </:col>
      </.table>
      <p :if={is_nil(@prepaid_balance)} data-part="prepaid-empty">
        {dgettext("dashboard", "This account holds no runner credit.")}
      </p>
      <.form
        for={%{}}
        id="prepaid-minutes-form"
        phx-change="quote_prepaid_minutes"
        phx-submit="bill_prepaid_minutes"
      >
        <.text_input
          id="prepaid-minutes-input"
          name="minutes"
          value=""
          input_type="number"
          min={1}
          label={dgettext("dashboard", "Prepaid minutes (macOS 6 vCPU / 14 GB)")}
        />
        <dl :if={@prepaid_quote} data-part="prepaid-quote">
          <div>
            <dt>{dgettext("dashboard", "Added to next invoice")}</dt>
            <dd data-part="prepaid-quote-invoiced">{format_money(@prepaid_quote.invoiced)}</dd>
          </div>
          <div>
            <dt>{dgettext("dashboard", "Credit granted once paid")}</dt>
            <dd data-part="prepaid-quote-granted">{format_money(@prepaid_quote.granted)}</dd>
          </div>
        </dl>
        <div data-part="actions">
          <.button
            type="submit"
            variant="primary"
            label={dgettext("dashboard", "Add to next invoice")}
          />
        </div>
      </.form>
    </.card_section>
  </.card>

  <.card title={dgettext("dashboard", "Visibility")} icon="eye">
    <.card_section>
      <.table id="account-visibility-table" rows={[@account]}>
        <:col :let={account} label={dgettext("dashboard", "Dashboards")}>
          <.text_cell label={
            if account.visibility == :public,
              do: dgettext("dashboard", "Public"),
              else: dgettext("dashboard", "Private")
          } />
        </:col>
        <:col :let={account} label={dgettext("dashboard", "Signed-out visitors see")}>
          <.text_cell label={
            if account.visibility == :public,
              do:
                dgettext(
                  "dashboard",
                  "Public projects, runners, and usage. Members, webhooks, cache, billing, and settings stay private."
                ),
              else: dgettext("dashboard", "Nothing.")
          } />
        </:col>
        <:col label={dgettext("dashboard", "Actions")}>
          <div data-part="actions">
            <.button
              variant="secondary"
              label={
                if @account.visibility == :public,
                  do: dgettext("dashboard", "Make private"),
                  else: dgettext("dashboard", "Make public")
              }
              phx-click="toggle_visibility"
            />
          </div>
        </:col>
      </.table>
    </.card_section>
  </.card>

  <.card title={dgettext("dashboard", "Plan & billing")} icon="credit_card">
    <.card_section>
      <.table id="account-plan-table" rows={[@account]}>
        <:col :let={account} label={dgettext("dashboard", "Plan")}>
          <.badge_cell
            label={plan_label(current_plan(account))}
            color={plan_color(current_plan(account))}
            style="light-fill"
          />
        </:col>
        <:col :let={account} label={dgettext("dashboard", "Status")}>
          <.badge_cell
            label={status_label(subscription_status(account))}
            color={status_color(subscription_status(account))}
            style="light-fill"
          />
        </:col>
        <:col :let={account} label={dgettext("dashboard", "Billing email")}>
          <.text_cell label={account.billing_email || dgettext("dashboard", "None")} />
        </:col>
        <:col :let={account} label={dgettext("dashboard", "Stripe customer")}>
          <.text_cell label={account.customer_id || dgettext("dashboard", "Not created")} />
        </:col>
      </.table>
    </.card_section>

    <.card_section>
      <div data-part="actions">
        <.button
          variant="secondary"
          label={dgettext("dashboard", "Manage on Stripe")}
          href={~p"/ops/accounts/#{@account.id}/stripe-customer"}
          target="_blank"
          rel="noopener noreferrer"
        />
        <.button
          :if={current_plan(@account) != :enterprise}
          variant="primary"
          label={dgettext("dashboard", "Upgrade to Enterprise")}
          phx-click="initiate_enterprise_upgrade"
        />
        <.button
          :if={
            current_plan(@account) in [:pro, :enterprise] and
              subscription_status(@account) != :cancelled
          }
          variant="secondary"
          label={dgettext("dashboard", "Cancel plan")}
          phx-click="cancel_plan"
          data-confirm={
            dgettext(
              "dashboard",
              "Cancel %{account}'s subscription at the end of the current billing period? Access is kept until then.",
              account: @account.name
            )
          }
        />
      </div>
    </.card_section>
  </.card>

  <.modal
    :if={@upgrade_target_account}
    id="enterprise-modal"
    title={
      dgettext("dashboard", "Upgrade %{account} to Enterprise",
        account: @upgrade_target_account.name
      )
    }
    description={
      dgettext(
        "dashboard",
        "Creates a Stripe customer (if missing), sets the billing address, and starts an invoice-billed Enterprise subscription. The customer receives an invoice by email; no card is collected here."
      )
    }
    header_type="icon"
    header_size="small"
    on_dismiss="close_enterprise_modal"
  >
    <:header_icon><.building /></:header_icon>
    <:trigger :let={modal_attrs}>
      <button id="enterprise-trigger" type="button" style="display: none;" {modal_attrs}></button>
    </:trigger>

    <form
      id="enterprise-form"
      phx-submit="submit_enterprise_upgrade"
      class="enterprise-upgrade-form"
    >
      <.text_input
        id="enterprise-name"
        name="name"
        label={dgettext("dashboard", "Name on invoice")}
        value={prefill(@upgrade_target_customer, :name, @upgrade_target_account.name)}
        required
        show_required
      />
      <.text_input
        id="enterprise-billing-email"
        name="billing_email"
        label={dgettext("dashboard", "Billing email")}
        value={prefill(@upgrade_target_customer, :email, @upgrade_target_account.billing_email)}
        required
        show_required
      />
      <.text_input
        id="enterprise-address-line1"
        name="address_line1"
        label={dgettext("dashboard", "Address line 1")}
        value={prefill_address(@upgrade_target_customer, :line1)}
        required
        show_required
      />
      <.text_input
        id="enterprise-address-line2"
        name="address_line2"
        label={dgettext("dashboard", "Address line 2 (optional)")}
        value={prefill_address(@upgrade_target_customer, :line2)}
      />
      <.text_input
        id="enterprise-address-city"
        name="address_city"
        label={dgettext("dashboard", "City")}
        value={prefill_address(@upgrade_target_customer, :city)}
        required
        show_required
      />
      <.text_input
        id="enterprise-address-state"
        name="address_state"
        label={dgettext("dashboard", "State / region (optional)")}
        value={prefill_address(@upgrade_target_customer, :state)}
      />
      <.text_input
        id="enterprise-address-postal-code"
        name="address_postal_code"
        label={dgettext("dashboard", "Postal code")}
        value={prefill_address(@upgrade_target_customer, :postal_code)}
        required
        show_required
      />
      <div class="select-field">
        <.label label={dgettext("dashboard", "Country")} required />
        <.select
          id="enterprise-address-country"
          label={dgettext("dashboard", "Select a country")}
          name="address_country"
          value={prefill_address(@upgrade_target_customer, :country)}
        >
          <:item :for={{code, name} <- countries()} value={code} label={name} />
        </.select>
      </div>

      <div class="select-field">
        <.label label={dgettext("dashboard", "Billing cadence")} />
        <.select
          id="enterprise-cadence"
          label={dgettext("dashboard", "Monthly")}
          name="cadence"
          value="monthly"
        >
          <:item value="monthly" label={dgettext("dashboard", "Monthly")} />
          <:item value="yearly" label={dgettext("dashboard", "Yearly")} />
        </.select>
      </div>
    </form>

    <:footer>
      <.modal_footer>
        <:action>
          <.button
            label={dgettext("dashboard", "Cancel")}
            variant="secondary"
            type="button"
            phx-click="close_enterprise_modal"
          />
        </:action>
        <:action>
          <.button
            label={dgettext("dashboard", "Upgrade to Enterprise")}
            variant="primary"
            type="submit"
            form="enterprise-form"
          />
        </:action>
      </.modal_footer>
    </:footer>
  </.modal>
</div>
