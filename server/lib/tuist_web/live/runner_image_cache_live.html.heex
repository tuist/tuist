<div id="runner-image-cache">
  <.alert
    :if={!@enabled}
    id="image-cache-not-enabled"
    status="information"
    type="secondary"
    size="large"
    title={dgettext("dashboard_runners", "The image cache is not enabled for this account")}
    description={
      dgettext(
        "dashboard_runners",
        "Linux jobs pull every image and layer in each job until it is enabled."
      )
    }
  />
  <.async_result :let={data} assign={@data}>
    <:loading>
      <.card
        title={dgettext("dashboard_runners", "Image cache")}
        icon="package"
      >
        <div data-part="widgets">
          <.widget
            :for={n <- 1..3}
            id={"image-cache-loading-#{n}"}
            title={dgettext("dashboard_runners", "Loading")}
            loading={true}
          />
        </div>
      </.card>
    </:loading>
    <:failed>
      <.card title={dgettext("dashboard_runners", "Image cache")} icon="package">
        <.card_section>
          <p role="alert" data-part="note">
            {dgettext(
              "dashboard_runners",
              "Could not load the image cache. Retrying automatically."
            )}
          </p>
        </.card_section>
      </.card>
    </:failed>
    <.card
      title={dgettext("dashboard_runners", "Image cache")}
      icon="package"
      id="image-cache-analytics"
    >
      <:actions>
        <.image_date_picker
          id="image-cache-date-range-picker"
          preset={@analytics_preset}
          period={@analytics_period}
        />
      </:actions>
      <.analytics_widgets
        id="image-cache"
        data={data}
        metric={@metric}
        percentile={@initialize_percentile}
        period={@analytics_period}
      />
    </.card>
    <.card
      title={dgettext("dashboard_runners", "Repositories")}
      icon="stack_2"
    >
      <% {repositories, more?} = repositories_page(data.repositories, assigns) %>
      <.card_section data-part="table-section">
        <div data-part="table-toolbar">
          <.form for={%{}} phx-change="search" data-part="filters">
            <.text_input
              type="search"
              id="image-repository-search"
              name="search"
              value={@search}
              phx-debounce="200"
              placeholder={dgettext("dashboard_runners", "Search repositories")}
              show_suffix={false}
              data-part="search"
            />
          </.form>
          <.dropdown
            id="image-repositories-sort-by-dropdown"
            label={sort_label(@sort_by)}
            secondary_text={dgettext("dashboard_runners", "Sort by:")}
          >
            <.dropdown_item
              :for={{column, label} <- sort_options()}
              value={column}
              label={label}
              patch={sort_patch(assigns, column)}
              data-selected={@sort_by == column}
            >
              <:right_icon :if={@sort_by == column}><.check /></:right_icon>
            </.dropdown_item>
          </.dropdown>
        </div>
        <.table
          id="image-repositories-table"
          rows={repositories}
          row_navigate={
            fn repository ->
              ~p"/#{@selected_account.name}/runners/volumes/#{repository.id}?#{period_params(@params, @analytics_preset)}"
            end
          }
        >
          <:col
            :let={repository}
            label={dgettext("dashboard_runners", "Repository")}
            patch={sort_patch(assigns, "repository")}
            sort_order={@sort_by == "repository" && @sort_order}
          >
            <.text_cell label={repository.repository} />
          </:col>
          <:col
            :let={repository}
            label={dgettext("dashboard_runners", "Images")}
            patch={sort_patch(assigns, "images")}
            sort_order={@sort_by == "images" && @sort_order}
          >
            <.text_cell label={RunnerVolumesLive.count(repository.image_count)} />
          </:col>
          <:col
            :let={repository}
            label={dgettext("dashboard_runners", "Saved size")}
            patch={sort_patch(assigns, "saved_size")}
            sort_order={@sort_by == "saved_size" && @sort_order}
          >
            <.text_cell label={RunnerVolumesLive.bytes(repository.saved_bytes)} />
          </:col>
          <:col
            :let={repository}
            label={dgettext("dashboard_runners", "Hit rate")}
            patch={sort_patch(assigns, "hit_rate")}
            sort_order={@sort_by == "hit_rate" && @sort_order}
          >
            <.text_cell
              label={RunnerVolumesLive.percentage(repository.hit_rate)}
              title={
                dngettext(
                  "dashboard_runners",
                  "%{count} job in the selected period",
                  "%{count} jobs in the selected period",
                  repository.uses
                )
              }
            />
          </:col>
          <:col
            :let={repository}
            label={dgettext("dashboard_runners", "Last used")}
            patch={sort_patch(assigns, "last_used")}
            sort_order={@sort_by == "last_used" && @sort_order}
          >
            <.text_cell
              label={RunnerVolumesLive.relative_time(repository.last_used_at)}
              title={RunnerVolumesLive.time(repository.last_used_at)}
            />
          </:col>
          <:empty_state>
            <.table_empty_state
              title={dgettext("dashboard_runners", "No repositories found")}
              subtitle={
                dgettext(
                  "dashboard_runners",
                  "A repository appears here after one of its Linux jobs uses containers or Docker, or try a different search."
                )
              }
            />
          </:empty_state>
        </.table>
        <nav
          :if={@page > 1 or more?}
          data-part="pagination"
          aria-label={dgettext("dashboard_runners", "Repository pages")}
        >
          <.button
            disabled={@page <= 1}
            variant="secondary"
            label={dgettext("dashboard_runners", "Prev")}
            patch={page_path(assigns, Map.put(@params, "page", max(1, @page - 1)))}
          >
            <:icon_left><.chevron_left /></:icon_left>
          </.button>
          <.button
            disabled={!more?}
            variant="secondary"
            label={dgettext("dashboard_runners", "Next")}
            patch={page_path(assigns, Map.put(@params, "page", @page + 1))}
          >
            <:icon_right><.chevron_right /></:icon_right>
          </.button>
        </nav>
      </.card_section>
    </.card>
  </.async_result>
</div>
