<div id="account-settings" data-page="organization-ai">
  <h1 data-part="title">{dgettext("dashboard_account", "Settings")}</h1>
  <TuistWeb.AppLayoutComponents.settings_tab_menu
    selected_account={@selected_account}
    current_path={@current_path}
    current_user={@current_user}
  />

  <.card_section id="organization-ai-connections" data-part="ai-configuration-card-section">
    <div data-part="header">
      <span data-part="title">{dgettext("dashboard_account", "Providers")}</span>
      <span data-part="subtitle">{dgettext(
        "dashboard_account",
        "Connect AI providers using your organization's API keys, or link your Claude organization so Anthropic bills it directly. Each provider can be used by multiple models."
      )}</span>
    </div>
    <div data-part="button-container">
      <.dropdown
        :if={@claude_linking_available and not claude_linked?(@configuration)}
        id="add-ai-provider-dropdown"
        label={dgettext("dashboard_account", "Add provider")}
      >
        <.dropdown_item
          id="link-claude-organization"
          value="claude"
          size="large"
          href={~p"/integrations/claude/start?#{[account_id: @selected_account.id]}"}
          label={dgettext("dashboard_account", "Claude organization")}
          description={
            dgettext("dashboard_account", "Anthropic bills your Claude organization directly")
          }
        />
        <.dropdown_item
          id="add-ai-connection"
          value="api_key"
          size="large"
          on_click="add-connection"
          label={dgettext("dashboard_account", "API key")}
          description={
            dgettext("dashboard_account", "Use your organization's key for any provider")
          }
        />
      </.dropdown>
      <.button
        :if={not @claude_linking_available or claude_linked?(@configuration)}
        id="add-ai-connection"
        label={dgettext("dashboard_account", "Add provider")}
        variant="secondary"
        phx-click="add-connection"
      />
    </div>
    <div data-part="content">
      <.alert
        :if={Phoenix.Flash.get(@flash, :info)}
        id="claude-link-info"
        status="success"
        type="secondary"
        size="small"
        title={Phoenix.Flash.get(@flash, :info)}
      />
      <.alert
        :if={Phoenix.Flash.get(@flash, :error)}
        id="claude-link-error"
        status="error"
        type="secondary"
        size="small"
        title={Phoenix.Flash.get(@flash, :error)}
      />
      <.table
        id="ai-connections-table"
        rows={@configuration.connections}
        row_key={fn connection -> "ai-connection-#{connection.id}" end}
      >
        <:col :let={connection} label={dgettext("dashboard_account", "Name")}>
          <.text_cell label={connection.name} />
        </:col>
        <:col :let={connection} label={dgettext("dashboard_account", "API base URL")}>
          <.text_cell
            :if={connection.kind == "claude_linked_billing"}
            label={dgettext("dashboard_account", "Linked Claude organization")}
          />
          <.text_cell
            :if={connection.kind != "claude_linked_billing"}
            label={connection.base_url}
          />
        </:col>
        <:col :let={connection} label="">
          <.button_cell>
            <:button>
              <.dropdown id={"ai-connection-actions-#{connection.id}"} icon_only>
                <:icon><.dots_vertical /></:icon>
                <.dropdown_item
                  :if={connection.kind != "claude_linked_billing"}
                  label={dgettext("dashboard_account", "Edit provider")}
                  value="edit"
                  phx-click="edit-connection"
                  phx-value-id={connection.id}
                >
                  <:left_icon><.pencil /></:left_icon>
                </.dropdown_item>
                <.dropdown_item
                  :if={connection.kind == "claude_linked_billing"}
                  label={dgettext("dashboard_account", "Manage spend limit")}
                  value="spend-limit"
                  href={ClaudeLinkedBilling.linked_platforms_url()}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <:left_icon><.external_link /></:left_icon>
                </.dropdown_item>
                <.dropdown_item
                  label={
                    if connection.kind == "claude_linked_billing",
                      do: dgettext("dashboard_account", "Unlink"),
                      else: dgettext("dashboard_account", "Remove provider")
                  }
                  value="remove"
                  phx-click="remove-connection"
                  phx-value-id={connection.id}
                >
                  <:left_icon><.trash /></:left_icon>
                </.dropdown_item>
              </.dropdown>
            </:button>
          </.button_cell>
        </:col>
        <:empty_state>
          <.table_empty_state
            title={dgettext("dashboard_account", "No providers yet")}
            subtitle={dgettext("dashboard_account", "Add a provider to get started.")}
          />
        </:empty_state>
      </.table>
    </div>
  </.card_section>

  <.card_section id="organization-ai-models" data-part="ai-configuration-card-section">
    <div data-part="header">
      <span data-part="title">{dgettext("dashboard_account", "Models")}</span>
      <span data-part="subtitle">{dgettext(
        "dashboard_account",
        "Add the models your organization can use, then choose a default model below."
      )}</span>
    </div>
    <div data-part="button-container">
      <.button
        id="add-ai-model"
        label={dgettext("dashboard_account", "Add model")}
        variant="secondary"
        phx-click="add-model"
        disabled={@configuration.connections == []}
      />
    </div>
    <div data-part="content">
      <.table
        id="ai-models-table"
        rows={@configuration.models}
        row_key={fn model -> "ai-model-#{model.id}" end}
      >
        <:col :let={model} label={dgettext("dashboard_account", "Name")}>
          <.text_cell label={model.name} />
        </:col>
        <:col :let={model} label={dgettext("dashboard_account", "Provider")}>
          <.text_cell label={connection_name(@configuration, model.connection_id)} />
        </:col>
        <:col :let={model} label={dgettext("dashboard_account", "Model ID")}>
          <.text_cell label={model.model_id} />
        </:col>
        <:col :let={model} label="">
          <.button_cell>
            <:button>
              <.dropdown id={"ai-model-actions-#{model.id}"} icon_only>
                <:icon><.dots_vertical /></:icon>
                <.dropdown_item
                  label={dgettext("dashboard_account", "Edit model")}
                  value="edit"
                  phx-click="edit-model"
                  phx-value-id={model.id}
                >
                  <:left_icon><.pencil /></:left_icon>
                </.dropdown_item>
                <.dropdown_item
                  label={dgettext("dashboard_account", "Remove model")}
                  value="remove"
                  phx-click="remove-model"
                  phx-value-id={model.id}
                >
                  <:left_icon><.trash /></:left_icon>
                </.dropdown_item>
              </.dropdown>
            </:button>
          </.button_cell>
        </:col>
        <:empty_state>
          <.table_empty_state
            title={dgettext("dashboard_account", "No models yet")}
            subtitle={
              if @configuration.connections == [],
                do:
                  dgettext(
                    "dashboard_account",
                    "Add a provider before adding a model."
                  ),
                else:
                  dgettext(
                    "dashboard_account",
                    "Add a model to make it available to organization workflows."
                  )
            }
          />
        </:empty_state>
      </.table>
    </div>
  </.card_section>

  <.card_section id="organization-ai-default" data-part="ai-default-card-section">
    <div data-part="header">
      <span data-part="title">{dgettext("dashboard_account", "Default model")}</span>
      <span data-part="subtitle">{dgettext(
        "dashboard_account",
        "Choose the model for organization AI tasks without a task route. Without a default, only routed tasks send requests. Personal AI subscriptions are not affected."
      )}</span>
    </div>
    <div data-part="content">
      <.form for={@default_form} id="organization-ai-default-form" phx-submit="save-default">
        <.alert
          :if={@default_error}
          status="error"
          type="secondary"
          size="small"
          title={@default_error}
        />
        <div data-part="ai-field">
          <.label
            label={dgettext("dashboard_account", "Model")}
            for="select:ai-default-model:trigger"
          />
          <.select
            id="ai-default-model"
            field={@default_form[:model_id]}
            label={dgettext("dashboard_account", "Default model")}
          >
            <:item value="none" label={dgettext("dashboard_account", "No default model")} />
            <:item
              :for={model <- @configuration.models}
              value={to_string(model.id)}
              label={"#{model.name} · #{connection_name(@configuration, model.connection_id)}"}
            />
          </.select>
        </div>
        <.button
          type="submit"
          variant="primary"
          label={dgettext("dashboard_account", "Save")}
        />
      </.form>
    </div>
  </.card_section>

  <.card_section id="organization-ai-routes" data-part="ai-configuration-card-section">
    <div data-part="header">
      <span data-part="title">{dgettext("dashboard_account", "Task routing")}</span>
      <span data-part="subtitle">{dgettext(
        "dashboard_account",
        "Send a specific task to a different model. Tasks without a route use the default model."
      )}</span>
    </div>
    <div data-part="button-container">
      <.button
        id="add-ai-route"
        label={dgettext("dashboard_account", "Add route")}
        variant="secondary"
        phx-click="add-route"
        disabled={@configuration.models == [] or not unrouted_tasks?(@configuration)}
      />
    </div>
    <div data-part="content">
      <.alert
        :if={is_nil(@configuration.default_model_id) and unrouted_tasks?(@configuration)}
        id="ai-routes-no-default"
        status="information"
        type="secondary"
        size="small"
        title={
          dgettext(
            "dashboard_account",
            "No default model is selected, so tasks without a route don't send requests."
          )
        }
      />
      <.table
        id="ai-routes-table"
        rows={@configuration.routes}
        row_key={fn route -> "ai-route-#{route.id}" end}
      >
        <:col :let={route} label={dgettext("dashboard_account", "Category")}>
          <.text_cell label={category_label(category_of(route.task))} />
        </:col>
        <:col :let={route} label={dgettext("dashboard_account", "Task")}>
          <.text_cell label={task_label(route.task)} />
        </:col>
        <:col :let={route} label={dgettext("dashboard_account", "Model")}>
          <.text_cell
            label={model(@configuration, route.model_id).name}
            sublabel={
              connection_name(@configuration, model(@configuration, route.model_id).connection_id)
            }
          />
        </:col>
        <:col :let={route} label="">
          <.button_cell>
            <:button>
              <.dropdown id={"ai-route-actions-#{route.id}"} icon_only>
                <:icon><.dots_vertical /></:icon>
                <.dropdown_item
                  label={dgettext("dashboard_account", "Edit route")}
                  value="edit"
                  phx-click="edit-route"
                  phx-value-id={route.id}
                >
                  <:left_icon><.pencil /></:left_icon>
                </.dropdown_item>
                <.dropdown_item
                  label={dgettext("dashboard_account", "Remove route")}
                  value="remove"
                  phx-click="remove-route"
                  phx-value-id={route.id}
                >
                  <:left_icon><.trash /></:left_icon>
                </.dropdown_item>
              </.dropdown>
            </:button>
          </.button_cell>
        </:col>
        <:empty_state>
          <.table_empty_state
            title={dgettext("dashboard_account", "No task routes yet")}
            subtitle={
              cond do
                @configuration.models == [] ->
                  dgettext("dashboard_account", "Add a model before adding a route.")

                is_nil(@configuration.default_model_id) ->
                  dgettext(
                    "dashboard_account",
                    "Add a route or select a default model to send requests."
                  )

                true ->
                  dgettext("dashboard_account", "Every task uses the default model.")
              end
            }
          />
        </:empty_state>
      </.table>
    </div>
  </.card_section>

  <.form
    for={@connection_form}
    id="organization-ai-connection-form"
    phx-submit="save-connection"
    phx-change="change-connection"
    autocomplete="off"
  >
    <.modal
      id="organization-ai-connection-modal"
      title={
        if @connection_form[:_id].value == "",
          do: dgettext("dashboard_account", "Add provider"),
          else: dgettext("dashboard_account", "Edit provider")
      }
      header_size="large"
      on_dismiss="cancel-connection"
    >
      <:trigger :let={attrs}>
        <button type="button" hidden aria-hidden="true" tabindex="-1" {attrs} />
      </:trigger>
      <.content_divider />
      <%!-- Replace browser-owned input state, including submitted secrets. --%>
      <div id={"ai-connection-fields-#{@connection_form_version}"} data-part="ai-modal-content">
        <input
          type="hidden"
          name={@connection_form[:_id].name}
          value={@connection_form[:_id].value}
        />
        <.alert
          :if={@connection_error}
          status="error"
          type="secondary"
          size="small"
          title={@connection_error}
        />
        <div data-part="ai-field">
          <.label
            label={dgettext("dashboard_account", "Provider")}
            for={"select:ai-connection-provider-#{@connection_form_version}:trigger"}
          />
          <.select
            id={"ai-connection-provider-#{@connection_form_version}"}
            field={@connection_form[:provider]}
            label={dgettext("dashboard_account", "Provider")}
          >
            <:item
              :for={template <- @provider_templates}
              value={template.id}
              label={template.name}
            />
            <:item
              value="custom"
              label={dgettext("dashboard_account", "Custom")}
            />
          </.select>
        </div>
        <input
          :for={field <- [:name, :base_url]}
          :if={@connection_form[:provider].value != "custom"}
          type="hidden"
          name={@connection_form[field].name}
          value={@connection_form[field].value}
        />
        <.text_input
          :if={@connection_form[:provider].value == "custom"}
          field={@connection_form[:name]}
          id={"ai-connection-name-#{@connection_form_version}"}
          type="basic"
          label={dgettext("dashboard_account", "Name")}
          required
          show_required
        />
        <.text_input
          :if={@connection_form[:provider].value == "custom"}
          field={@connection_form[:base_url]}
          id={"ai-connection-url-#{@connection_form_version}"}
          type="basic"
          label={dgettext("dashboard_account", "API base URL")}
          hint={
            dgettext(
              "dashboard_account",
              "Public HTTPS endpoint for an OpenAI-compatible API. Include any /v1 prefix; requests append /chat/completions."
            )
          }
          required
          show_required
        />
        <.text_input
          field={@connection_form[:api_key]}
          id={"ai-connection-key-#{@connection_form_version}"}
          type="password"
          input_type="password"
          label={dgettext("dashboard_account", "API key")}
          hint={
            dgettext(
              "dashboard_account",
              "Stored encrypted. Leave blank to keep the current key, unless changing the provider or API base URL. Changes affect all models using this provider."
            )
          }
        />
      </div>
      <.content_divider />
      <:footer>
        <.modal_footer>
          <:action>
            <.button
              type="button"
              variant="secondary"
              label={dgettext("dashboard_account", "Cancel")}
              phx-click="cancel-connection"
            />
          </:action>
          <:action>
            <.button
              type="submit"
              variant="primary"
              label={
                if @connection_form[:_id].value == "",
                  do: dgettext("dashboard_account", "Add provider"),
                  else: dgettext("dashboard_account", "Save")
              }
            />
          </:action>
        </.modal_footer>
      </:footer>
    </.modal>
  </.form>

  <.form
    :if={@configuration.connections != []}
    for={@model_form}
    id="organization-ai-model-form"
    phx-submit="save-model"
  >
    <.modal
      id="organization-ai-model-modal"
      title={
        if @model_form[:_id].value == "",
          do: dgettext("dashboard_account", "Add model"),
          else: dgettext("dashboard_account", "Edit model")
      }
      header_size="large"
      on_dismiss="cancel-model"
    >
      <:trigger :let={attrs}>
        <button type="button" hidden aria-hidden="true" tabindex="-1" {attrs} />
      </:trigger>
      <.content_divider />
      <div id={"ai-model-fields-#{@model_form_version}"} data-part="ai-modal-content">
        <input type="hidden" name={@model_form[:_id].name} value={@model_form[:_id].value} />
        <.alert
          :if={@model_error}
          status="error"
          type="secondary"
          size="small"
          title={@model_error}
        />
        <.text_input
          field={@model_form[:name]}
          id={"ai-model-name-#{@model_form_version}"}
          type="basic"
          label={dgettext("dashboard_account", "Name")}
          required
          show_required
        />
        <div data-part="ai-field">
          <.label
            label={dgettext("dashboard_account", "Provider")}
            for={"select:ai-model-connection-#{@model_form_version}:trigger"}
            required
          />
          <.select
            id={"ai-model-connection-#{@model_form_version}"}
            field={@model_form[:connection_id]}
            label={dgettext("dashboard_account", "Provider")}
          >
            <:item value="none" label={dgettext("dashboard_account", "Choose a provider")} />
            <:item
              :for={connection <- @configuration.connections}
              value={to_string(connection.id)}
              label={connection.name}
            />
          </.select>
        </div>
        <.text_input
          field={@model_form[:model_id]}
          id={"ai-model-upstream-id-#{@model_form_version}"}
          type="basic"
          label={dgettext("dashboard_account", "Model ID")}
          hint={
            dgettext(
              "dashboard_account",
              "The model ID from your provider, including any account or model prefix."
            )
          }
          required
          show_required
        />
      </div>
      <.content_divider />
      <:footer>
        <.modal_footer>
          <:action>
            <.button
              type="button"
              variant="secondary"
              label={dgettext("dashboard_account", "Cancel")}
              phx-click="cancel-model"
            />
          </:action>
          <:action>
            <.button
              type="submit"
              variant="primary"
              label={
                if @model_form[:_id].value == "",
                  do: dgettext("dashboard_account", "Add model"),
                  else: dgettext("dashboard_account", "Save")
              }
            />
          </:action>
        </.modal_footer>
      </:footer>
    </.modal>
  </.form>

  <.form
    :if={@configuration.models != []}
    for={@route_form}
    id="organization-ai-route-form"
    phx-submit="save-route"
    phx-change="change-route"
  >
    <.modal
      id="organization-ai-route-modal"
      title={
        if @route_form[:_id].value == "",
          do: dgettext("dashboard_account", "Add route"),
          else: dgettext("dashboard_account", "Edit route")
      }
      header_size="large"
      on_dismiss="cancel-route"
    >
      <:trigger :let={attrs}>
        <button type="button" hidden aria-hidden="true" tabindex="-1" {attrs} />
      </:trigger>
      <.content_divider />
      <div id={"ai-route-fields-#{@route_form_version}"} data-part="ai-modal-content">
        <input type="hidden" name={@route_form[:_id].name} value={@route_form[:_id].value} />
        <.alert
          :if={@route_error}
          status="error"
          type="secondary"
          size="small"
          title={@route_error}
        />
        <div data-part="ai-field">
          <.label
            label={dgettext("dashboard_account", "Category")}
            for={"select:ai-route-category-#{@route_form_version}:trigger"}
            required
          />
          <.select
            id={"ai-route-category-#{@route_form_version}"}
            field={@route_form[:category]}
            label={dgettext("dashboard_account", "Category")}
          >
            <:item
              :for={category <- categories()}
              value={to_string(category)}
              label={category_label(category)}
            />
          </.select>
        </div>
        <div data-part="ai-field">
          <.label
            label={dgettext("dashboard_account", "Task")}
            for={"select:ai-route-task-#{@route_form_version}:trigger"}
            required
          />
          <.select
            id={"ai-route-task-#{@route_form_version}"}
            field={@route_form[:task]}
            label={dgettext("dashboard_account", "Task")}
          >
            <:item value="none" label={dgettext("dashboard_account", "Choose a task")} />
            <:item
              :for={task <- route_task_options(@configuration, @route_form)}
              value={to_string(task)}
              label={task_label(task)}
            />
          </.select>
        </div>
        <div data-part="ai-field">
          <.label
            label={dgettext("dashboard_account", "Model")}
            for={"select:ai-route-model-#{@route_form_version}:trigger"}
            required
          />
          <.select
            id={"ai-route-model-#{@route_form_version}"}
            field={@route_form[:model_id]}
            label={dgettext("dashboard_account", "Model")}
          >
            <:item value="none" label={dgettext("dashboard_account", "Choose a model")} />
            <:item
              :for={model <- @configuration.models}
              value={to_string(model.id)}
              label={model_label(@configuration, model)}
            />
          </.select>
        </div>
      </div>
      <.content_divider />
      <:footer>
        <.modal_footer>
          <:action>
            <.button
              type="button"
              variant="secondary"
              label={dgettext("dashboard_account", "Cancel")}
              phx-click="cancel-route"
            />
          </:action>
          <:action>
            <.button
              type="submit"
              variant="primary"
              label={
                if @route_form[:_id].value == "",
                  do: dgettext("dashboard_account", "Add route"),
                  else: dgettext("dashboard_account", "Save")
              }
            />
          </:action>
        </.modal_footer>
      </:footer>
    </.modal>
  </.form>

  <.modal
    id="organization-ai-removal"
    title={
      cond do
        @pending_removal && @pending_removal.linked? ->
          dgettext("dashboard_account", "Unlink your Claude organization?")

        @pending_removal && @pending_removal.kind == :routes ->
          dgettext("dashboard_account", "Remove the route for %{name}?",
            name: @pending_removal.name
          )

        @pending_removal ->
          dgettext("dashboard_account", "Remove %{name}?", name: @pending_removal.name)

        true ->
          dgettext("dashboard_account", "Remove")
      end
    }
    header_size="large"
    on_dismiss="cancel-removal"
  >
    <:trigger :let={attrs}>
      <button type="button" hidden aria-hidden="true" tabindex="-1" {attrs} />
    </:trigger>
    <.content_divider />
    <div :if={@pending_removal} data-part="ai-modal-content">
      <.alert
        :if={@removal_error}
        status="error"
        type="secondary"
        size="small"
        title={@removal_error}
      />
      <%!-- Unlinking is reversible, so it needs no warning; the only alert is a failure. --%>
      <p :if={@pending_removal.linked?}>
        {dgettext(
          "dashboard_account",
          "Anthropic stops billing your Claude organization for Tuist, and models using it are removed, along with their task routes. If one is the default, tasks without a route stop sending requests until you select another."
        )}
      </p>
      <.alert
        :if={not @pending_removal.linked?}
        status="warning"
        type="secondary"
        size="small"
        title={
          cond do
            @pending_removal.kind == :connections ->
              dgettext(
                "dashboard_account",
                "This deletes the stored key, all models using this provider and their task routes. Those tasks fall back to the default model, and if no default remains, they and other tasks without a route stop sending requests until you select one. Revoke the key at the provider to revoke access there."
              )

            @pending_removal.kind == :routes and is_nil(@configuration.default_model_id) ->
              dgettext(
                "dashboard_account",
                "No default model is selected, so this task stops sending requests until you add a route or select a default."
              )

            @pending_removal.kind == :routes ->
              dgettext(
                "dashboard_account",
                "This task uses the default model instead."
              )

            true ->
              dgettext(
                "dashboard_account",
                "This removes the configured model, not its provider, and its task routes. Those tasks fall back to the default model, and if no default remains, they and other tasks without a route stop sending requests until you select one."
              )
          end
        }
      />
      <p :if={not @pending_removal.linked?}>
        {dgettext("dashboard_account", "Requests already sent may finish.")}
      </p>
    </div>
    <.content_divider />
    <:footer>
      <.modal_footer>
        <:action>
          <.button
            type="button"
            variant="secondary"
            label={dgettext("dashboard_account", "Cancel")}
            phx-click="cancel-removal"
          />
        </:action>
        <:action>
          <.button
            id="confirm-ai-removal"
            type="button"
            variant="destructive"
            label={
              if @pending_removal && @pending_removal.linked?,
                do: dgettext("dashboard_account", "Unlink"),
                else: dgettext("dashboard_account", "Remove")
            }
            phx-click="confirm-removal"
          />
        </:action>
      </.modal_footer>
    </:footer>
  </.modal>
</div>
