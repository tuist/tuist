<div id="coverage">
  <div data-part="filters">
    <.date_picker
      id="coverage-date-range-picker"
      name="coverage-date-range"
      presets={[
        %{
          id: "last-7-days",
          label: dgettext("dashboard_tests", "Last 7 days"),
          period: {7, :day}
        },
        %{
          id: "last-30-days",
          label: dgettext("dashboard_tests", "Last 30 days"),
          period: {30, :day}
        },
        %{
          id: "last-12-months",
          label: dgettext("dashboard_tests", "Last 12 months"),
          period: {12, :month}
        },
        %{id: "custom", label: dgettext("dashboard_tests", "Custom")}
      ]}
      selected_preset={@coverage_preset}
      period={@coverage_period}
      on_period_change="coverage_period_changed"
      max={Date.utc_today()}
    >
      <:actions>
        <.button
          label={dgettext("dashboard_tests", "Cancel")}
          variant="secondary"
          phx-click={
            JS.dispatch("phx:date-picker-cancel", detail: %{id: "coverage-date-range-picker"})
          }
        />
        <.button
          label={dgettext("dashboard_tests", "Apply")}
          phx-click={
            JS.dispatch("phx:date-picker-apply", detail: %{id: "coverage-date-range-picker"})
          }
        />
      </:actions>
    </.date_picker>
  </div>

  <div :if={@loading} data-part="loading">
    <.skeleton_box width="100%" height="320px" />
    <.skeleton_box width="100%" height="240px" />
  </div>

  <%= if not @loading do %>
    <%!-- Analytics --%>
    <.coverage_analytics_card
      branch={@branch}
      latest={@latest}
      trends={@trends}
      points={@points}
      selected_widget={@selected_widget}
    >
      <:actions>
        <.button
          variant="secondary"
          label={dgettext("dashboard_tests", "View more")}
          size="medium"
          navigate={
            ~p"/#{@selected_account.name}/#{@selected_project.name}/tests/coverage/branches/#{@branch}?#{period_query(@current_params)}"
          }
          disabled={is_nil(@latest)}
          data-part="view-more"
        />
      </:actions>
    </.coverage_analytics_card>

    <%!-- Branches --%>
    <.card
      title={dgettext("dashboard_tests", "Branches")}
      icon="git_branch"
      data-part="branches"
    >
      <.card_section data-part="branches-section">
        <div data-part="filters">
          <.form
            for={%{}}
            id="coverage-branches-filter-form"
            phx-change="search-branches"
            phx-debounce="200"
          >
            <.text_input
              type="search"
              id="search-coverage-branches"
              name="search"
              placeholder={dgettext("dashboard_tests", "Search...")}
              show_suffix={false}
              data-part="search"
              value={@branches_search}
            />
          </.form>
        </div>
        <div :if={@branch_rows != []} data-part="branches-table">
          <.table
            id="coverage-branches-table"
            rows={@branch_rows}
            row_navigate={
              fn branch ->
                if branch.pull_request_number > 0,
                  do:
                    url(
                      ~p"/#{@selected_account.name}/#{@selected_project.name}/tests/coverage/pull-requests/#{branch.pull_request_number}"
                    ),
                  else:
                    url(
                      ~p"/#{@selected_account.name}/#{@selected_project.name}/tests/coverage/branches/#{branch.git_branch}"
                    )
              end
            }
          >
            <:col :let={branch} label={dgettext("dashboard_tests", "Branch")}>
              <.text_cell label={branch.name} />
            </:col>
            <:col :let={branch} label={dgettext("dashboard_tests", "Pull request")}>
              <.badge_cell
                :if={branch.pull_request_number > 0}
                style="light-fill"
                color="information"
                label={"##{branch.pull_request_number}"}
              />
              <.text_cell :if={branch.pull_request_number == 0} label="—" />
            </:col>
            <:col :let={branch} label={dgettext("dashboard_tests", "Coverage")}>
              <.coverage_cell covered={branch.covered_lines} executable={branch.executable_lines} />
            </:col>
            <:col :let={branch} label={dgettext("dashboard_tests", "Status")}>
              <.badge_cell
                style="light-fill"
                color={ref_status_color(branch)}
                label={ref_status_label(branch)}
                title={head_status_title(branch)}
              />
            </:col>
            <:col :let={branch} label={dgettext("dashboard_tests", "Measured")}>
              <.text_cell sublabel={Tuist.Utilities.DateFormatter.from_now(branch.ran_at)} />
            </:col>
          </.table>
          <.pagination_group
            :if={@branches_meta.total_pages > 1}
            current_page={@branches_meta.current_page}
            number_of_pages={@branches_meta.total_pages}
            page_patch={fn page -> "?#{Query.put(@uri.query, "branches-page", page)}" end}
          />
        </div>
        <.coverage_empty
          :if={@branch_rows == [] and @branches_search != ""}
          title={
            dgettext("dashboard_tests", "No branch matches %{search}", search: @branches_search)
          }
          image="table"
          data-part="empty-branches"
        />
        <.coverage_empty
          :if={@branch_rows == [] and @branches_search == ""}
          title={dgettext("dashboard_tests", "No branch gathered coverage in this period")}
          get_started_href="https://docs.tuist.dev/en/guides/features/tests"
          image="table"
          data-part="empty-branches"
        />
      </.card_section>
    </.card>
  <% end %>
</div>
