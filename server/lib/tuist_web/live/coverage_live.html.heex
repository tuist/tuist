<div id="coverage">
  <div data-part="filters">
    <.button
      label={dgettext("dashboard_tests", "Other branches")}
      variant="secondary"
      size="medium"
      navigate={~p"/#{@selected_account.name}/#{@selected_project.name}/tests/coverage/branches"}
    >
      <:icon_right><.icon name="arrow_right" /></:icon_right>
    </.button>
    <.date_picker
      id="coverage-date-range-picker"
      name="coverage-date-range"
      presets={[
        %{
          id: "last-7-days",
          label: dgettext("dashboard_tests", "Last 7 days"),
          period: {7, :day}
        },
        %{
          id: "last-30-days",
          label: dgettext("dashboard_tests", "Last 30 days"),
          period: {30, :day}
        },
        %{
          id: "last-12-months",
          label: dgettext("dashboard_tests", "Last 12 months"),
          period: {12, :month}
        },
        %{id: "custom", label: dgettext("dashboard_tests", "Custom")}
      ]}
      selected_preset={@coverage_preset}
      period={@coverage_period}
      on_period_change="coverage_period_changed"
      max={Date.utc_today()}
    >
      <:actions>
        <.button
          label={dgettext("dashboard_tests", "Cancel")}
          variant="secondary"
          phx-click={
            JS.dispatch("phx:date-picker-cancel", detail: %{id: "coverage-date-range-picker"})
          }
        />
        <.button
          label={dgettext("dashboard_tests", "Apply")}
          phx-click={
            JS.dispatch("phx:date-picker-apply", detail: %{id: "coverage-date-range-picker"})
          }
        />
      </:actions>
    </.date_picker>
  </div>

  <%!-- Analytics --%>
  <.card
    title={dgettext("dashboard_tests", "Analytics")}
    icon="chart_arcs"
    data-part="analytics"
  >
    <:actions>
      <.button
        label={dgettext("dashboard_tests", "View more")}
        variant="secondary"
        size="medium"
        navigate={
          ~p"/#{@selected_account.name}/#{@selected_project.name}/tests/coverage/branches/#{@branch}"
        }
      />
    </:actions>
    <div data-part="analytics-content">
      <div :if={@latest} data-part="widgets">
        <.widget
          id="widget-coverage"
          title={dgettext("dashboard_tests", "Code coverage")}
          description={
            dgettext(
              "dashboard_tests",
              "Share of executable lines covered at the latest measured commit of %{branch}, %{sha}, pooled over the schemes that measured it.",
              branch: @branch,
              sha: short_sha(@latest.git_commit_sha)
            )
          }
          value={"#{@latest.coverage}%"}
          legend_color="primary"
          trend_value={@trend}
          trend_type={:neutral}
          trend_label={dgettext("dashboard_tests", "over the period")}
        />
        <.widget
          id="widget-coverage-covered-lines"
          title={dgettext("dashboard_tests", "Covered lines")}
          description={
            dgettext(
              "dashboard_tests",
              "Lines that commit's tests ran at least once."
            )
          }
          value={format_number(@latest.covered_lines)}
        />
        <.widget
          id="widget-coverage-executable-lines"
          title={dgettext("dashboard_tests", "Executable lines")}
          description={
            dgettext(
              "dashboard_tests",
              "Lines the compiler instrumented for coverage at that commit."
            )
          }
          value={format_number(@latest.executable_lines)}
        />
        <.widget
          id="widget-coverage-unmeasured-files"
          title={dgettext("dashboard_tests", "Unmeasured files")}
          description={
            dgettext(
              "dashboard_tests",
              "Files Git knows at that commit that no scheme compiled, so nothing measured them."
            )
          }
          value={format_number(Map.get(@latest, :unmeasured_files_count) || 0)}
        />
      </div>
      <.card_section :if={@latest}>
        <div data-part="analytics-chart">
          <.chart
            id="coverage-chart"
            type="line"
            extra_options={
              %{
                grid: %{width: "97%", left: "0.4%", height: "88%", top: "5%"},
                xAxis: %{
                  boundaryGap: false,
                  type: "category",
                  axisLabel: %{
                    color: "var:noora-surface-label-secondary",
                    formatter: "fn:toLocaleDate",
                    customValues: [
                      @points
                      |> List.first()
                      |> Map.get(:inserted_at)
                      |> NaiveDateTime.to_iso8601(),
                      @points
                      |> List.last()
                      |> Map.get(:inserted_at)
                      |> NaiveDateTime.to_iso8601()
                    ],
                    padding: [10, 0, 0, 0]
                  }
                },
                yAxis: %{
                  splitNumber: 4,
                  splitLine: %{lineStyle: %{color: "var:noora-chart-lines"}},
                  axisLabel: %{
                    color: "var:noora-surface-label-secondary",
                    formatter: "{value}%"
                  }
                },
                legend: %{show: false},
                tooltip: %{valueFormat: "{value}%"}
              }
            }
            series={[
              %{
                color: "var:noora-chart-primary",
                data: Enum.map(@points, &[NaiveDateTime.to_iso8601(&1.inserted_at), &1.coverage]),
                name: dgettext("dashboard_tests", "Code coverage"),
                type: "line",
                smooth: 0.1,
                symbol: "circle",
                symbolSize: 4
              }
            ]}
            y_axis_min={0}
            y_axis_max={100}
          />
        </div>
      </.card_section>
      <.coverage_empty
        :if={is_nil(@latest)}
        title={
          dgettext("dashboard_tests", "No measured commit on %{branch} in this period",
            branch: @branch
          )
        }
        get_started_href="https://docs.tuist.dev/en/guides/features/tests"
        data-part="empty-analytics"
      />
    </div>
  </.card>

  <%!-- Commits --%>
  <.card
    title={
      if @branch == @selected_project.default_branch,
        do: dgettext("dashboard_tests", "Recent commits"),
        else:
          dgettext("dashboard_tests", "Recent commits since %{branch}",
            branch: @selected_project.default_branch
          )
    }
    icon="git_commit"
    data-part="commits"
  >
    <:actions>
      <.button
        label={dgettext("dashboard_tests", "View more")}
        variant="secondary"
        size="medium"
        navigate={
          ~p"/#{@selected_account.name}/#{@selected_project.name}/tests/coverage/branches/#{@branch}?tab=commits"
        }
      />
    </:actions>
    <.card_section :if={@commit_rows != []} data-part="commits-section">
      <.alert
        :if={@commits_ordered_by == :time}
        id="coverage-commits-time-order"
        status="information"
        type="secondary"
        size="small"
        title={
          dgettext(
            "dashboard_tests",
            "The branch's head is not in the repository's Git history, so its commits are listed in the order they were measured."
          )
        }
      />
      <div data-part="commits-table">
        <.table
          id="coverage-commits-table"
          rows={@commit_rows}
          row_navigate={
            fn row ->
              if row.measured,
                do:
                  url(
                    ~p"/#{@selected_account.name}/#{@selected_project.name}/tests/coverage/commits/#{row.git_commit_sha}"
                  )
            end
          }
        >
          <:col :let={row} label={dgettext("dashboard_tests", "Commit")}>
            <.text_cell label={short_sha(row.git_commit_sha)} />
          </:col>
          <:col :let={row} label={dgettext("dashboard_tests", "Coverage")}>
            <.coverage_cell
              :if={row.measured}
              covered={row.covered_lines}
              executable={row.executable_lines}
            />
            <.text_cell :if={not row.measured} label="—" />
          </:col>
          <:col :let={row} label={dgettext("dashboard_tests", "Change")}>
            <.change_cell delta={row.change} />
          </:col>
          <:col :let={row} label={"#{scheme_label(@selected_project)}s"}>
            <.measured_by_cell :if={row.measured} commit={row} />
            <.text_cell :if={not row.measured} label="—" />
          </:col>
          <:col :let={row} label={dgettext("dashboard_tests", "Status")}>
            <.badge_cell
              style="light-fill"
              color={completeness_color(row)}
              label={completeness_label(row)}
            />
          </:col>
          <:col :let={row} label={dgettext("dashboard_tests", "Committed")}>
            <.text_cell sublabel={
              if row.committed_at,
                do: Tuist.Utilities.DateFormatter.from_now(row.committed_at),
                else: "—"
            } />
          </:col>
        </.table>
        <.pagination_group
          :if={@commits_meta.total_pages > 1}
          current_page={@commits_meta.current_page}
          number_of_pages={@commits_meta.total_pages}
          page_patch={fn page -> "?#{Query.put(@uri.query, "commits-page", page)}" end}
        />
      </div>
    </.card_section>
    <.coverage_empty
      :if={@commit_rows == []}
      title={
        dgettext("dashboard_tests", "No commit of %{branch} in this period", branch: @branch)
      }
      get_started_href="https://docs.tuist.dev/en/guides/features/tests"
      image="table"
      data-part="empty-commits"
    />
  </.card>

  <%!-- Coverage gaps --%>
  <.card
    :if={@latest}
    title={dgettext("dashboard_tests", "Coverage gaps")}
    icon="chart_dots"
    data-part="gaps"
  >
    <:actions>
      <.button
        label={dgettext("dashboard_tests", "View more")}
        variant="secondary"
        size="medium"
        navigate={
          ~p"/#{@selected_account.name}/#{@selected_project.name}/tests/coverage/branches/#{@branch}?tab=files"
        }
      />
    </:actions>
    <div data-part="gaps-sections">
      <.card_section data-part="gaps-section">
        <div data-part="header">
          <span data-part="title">
            {dgettext("dashboard_tests", "Least covered files")}
          </span>
          <.link
            data-part="link"
            navigate={
              ~p"/#{@selected_account.name}/#{@selected_project.name}/tests/coverage/commits/#{@latest.git_commit_sha}"
            }
          >
            {dgettext("dashboard_tests", "View all")}
          </.link>
        </div>
        <.table id="coverage-gap-files-table" rows={@gap_files}>
          <:col :let={file} label={dgettext("dashboard_tests", "File")}>
            <.text_cell label={Path.basename(file.path)} sublabel={parent_dir(file.path)} />
          </:col>
          <:col :let={file} label={dgettext("dashboard_tests", "Coverage")}>
            <.coverage_cell covered={file.covered_lines} executable={file.executable_lines} />
          </:col>
        </.table>
        <div :if={@gap_files == []} data-part="empty">
          {dgettext("dashboard_tests", "No file was measured at this commit.")}
        </div>
      </.card_section>
      <.card_section data-part="gaps-section">
        <div data-part="header">
          <span data-part="title">
            {dgettext("dashboard_tests", "Files nothing measured")}
          </span>
          <span data-part="count">
            {dgettext("dashboard_tests", "%{count} in total",
              count: format_number(Map.get(@latest, :unmeasured_files_count) || 0)
            )}
          </span>
        </div>
        <.table id="coverage-unmeasured-files-table" rows={@unmeasured_files}>
          <:col :let={file} label={dgettext("dashboard_tests", "File")}>
            <.text_cell label={Path.basename(file.path)} sublabel={parent_dir(file.path)} />
          </:col>
        </.table>
        <div :if={@unmeasured_files == []} data-part="empty">
          {dgettext("dashboard_tests", "Every file Git knows at this commit was measured.")}
        </div>
      </.card_section>
    </div>
  </.card>
</div>
