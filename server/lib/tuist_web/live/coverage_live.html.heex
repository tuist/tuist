<div id="coverage">
  <.coverage_filters
    branch={@branch}
    branches={@branches}
    uri={@uri}
    preset={@coverage_preset}
    period={@coverage_period}
  />

  <div :if={@loading} data-part="loading">
    <.skeleton_box width="100%" height="320px" />
    <.skeleton_box width="100%" height="240px" />
  </div>

  <%= if not @loading do %>
    <%!-- Analytics --%>
    <.coverage_analytics_card
      branch={@branch}
      latest={@latest}
      trends={@trends}
      points={@points}
      grouping={@grouping}
      selected_widget={@selected_widget}
    />

    <%!-- Files coverage --%>
    <.card
      title={dgettext("dashboard_tests", "Files")}
      icon="file"
      data-part="files-coverage"
    >
      <div
        :if={@files.highest != [] or @files.lowest != []}
        data-part="files-coverage-sections"
      >
        <.card_section
          :for={
            {side, title, files} <- [
              {"highest", dgettext("dashboard_tests", "Highest coverage"), @files.highest},
              {"lowest", dgettext("dashboard_tests", "Lowest coverage"), @files.lowest}
            ]
          }
          data-part="files-coverage-section"
          data-side={side}
        >
          <div data-part="header">
            <span data-part="title">{title}</span>
          </div>
          <div data-part="files-list">
            <div :for={file <- Enum.take(files, 4)} class="coverage-file-card" data-side={side}>
              <div data-part="header">
                <div data-part="icon">
                  <.file />
                </div>
                <div data-part="title-and-subtitle">
                  <h3 data-part="title">{Path.basename(file.path)}</h3>
                  <span :if={parent_dir(file.path)} data-part="subtitle">{parent_dir(file.path)}</span>
                </div>
                <span data-part="coverage">
                  {Tuist.Tests.Coverage.percentage(file.covered_lines, file.executable_lines)}%
                </span>
              </div>
            </div>
            <div :if={length(files) > 4} data-part="more-card" data-index="two"></div>
            <div :if={length(files) > 4} data-part="more-card" data-index="one"></div>
          </div>
        </.card_section>
      </div>
      <.coverage_empty
        :if={@files.highest == [] and @files.lowest == []}
        title={
          dgettext("dashboard_tests", "No complete commit on %{branch} in this period",
            branch: @branch
          )
        }
        image="table"
        data-part="empty-files"
      />
    </.card>

    <%!-- Recent commits --%>
    <.card
      title={dgettext("dashboard_tests", "Recent commits")}
      icon="git_commit"
      data-part="recent-commits"
    >
      <:actions>
        <.button
          variant="secondary"
          label={dgettext("dashboard_tests", "View more")}
          size="medium"
          navigate={
            with_shared_query(
              "/#{@selected_account.name}/#{@selected_project.name}/tests/coverage/commits",
              @current_params
            )
          }
          data-part="view-more"
        />
      </:actions>
      <.card_section data-part="commits-section">
        <div :if={@commit_rows != []} data-part="commits-table">
          <.table
            id="coverage-recent-commits-table"
            rows={@commit_rows}
          >
            <:col :let={row} label={dgettext("dashboard_tests", "Commit")}>
              <.text_cell label={short_sha(row.git_commit_sha)} />
            </:col>
            <:col :let={row} label={dgettext("dashboard_tests", "Coverage")}>
              <.coverage_cell covered={row.covered_lines} executable={row.executable_lines} />
            </:col>
            <:col :let={row} label={dgettext("dashboard_tests", "Change")}>
              <.change_cell delta={row.change} />
            </:col>
            <:col :let={row} label={dgettext("dashboard_tests", "Committed")}>
              <.text_cell sublabel={
                Tuist.Utilities.DateFormatter.from_now(Map.get(row, :committed_at) || row.ran_at)
              } />
            </:col>
          </.table>
        </div>
        <.coverage_empty
          :if={@commit_rows == []}
          title={
            dgettext("dashboard_tests", "No complete commits on %{branch} in this period",
              branch: @branch
            )
          }
          image="table"
          data-part="empty-commits"
        />
      </.card_section>
    </.card>
  <% end %>
</div>
