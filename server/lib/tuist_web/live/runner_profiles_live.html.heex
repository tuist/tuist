<div id="account-runner-profiles">
  <div data-part="page-header">
    <div data-part="heading">
      <h1 data-part="title">{dgettext("dashboard_runners", "Profiles")}</h1>
      <span data-part="subtitle">
        {dgettext(
          "dashboard_runners",
          "Named bundles of vCPU and RAM. Reference them from your workflows as runs-on: %{prefix}<name>.",
          prefix: Profile.prefix()
        )}
      </span>
    </div>
    <div data-part="actions">
      <%!-- Single modal shared by create + edit. The trigger opens it in
            create mode; row-level Edit dropdowns push-open it after
            populating the form. --%>
      <.modal
        id={@modal_id}
        title={
          case @form_mode do
            :new -> dgettext("dashboard_runners", "New profile")
            {:edit, _} -> dgettext("dashboard_runners", "Edit profile")
          end
        }
        on_dismiss="dismiss_modal"
        on_open_change="modal_open_changed"
      >
        <:trigger :let={attrs}>
          <.button
            label={dgettext("dashboard_runners", "New profile")}
            variant="secondary"
            size="medium"
            disabled={@max_profiles_reached?}
            phx-click="open_create_modal"
            {attrs}
          />
        </:trigger>

        <div data-part="modal-content-wrapper">
          <.line_divider />

          <div data-part="modal-body">
            <.alert
              :if={@form_error}
              status="error"
              type="secondary"
              size="small"
              title={@form_error}
            />

            <div data-part="field">
              <span data-part="field-label">{dgettext("dashboard_runners", "Name")}</span>
              <div data-part="prefixed-input" data-disabled={match?({:edit, _}, @form_mode)}>
                <span data-part="prefix">{Profile.prefix()}</span>
                <input
                  id="runner-profile-name"
                  name="name"
                  type="text"
                  value={@form_name}
                  placeholder={dgettext("dashboard_runners", ~s(e.g. "default", "large", "ci"))}
                  disabled={match?({:edit, _}, @form_mode)}
                  autocomplete="off"
                  phx-keyup="update_form_name"
                  phx-debounce="200"
                />
              </div>
              <span :if={@form_mode == :new} data-part="hint">
                {dgettext(
                  "dashboard_runners",
                  "Becomes part of your runs-on label, so it can't be renamed later."
                )}
              </span>
            </div>

            <div data-part="field">
              <span data-part="field-label">{dgettext("dashboard_runners", "Platform")}</span>
              <.dropdown
                id="runner-profile-platform-dropdown"
                label={platform_label_for_value(@form_platform)}
              >
                <.dropdown_item
                  :for={platform <- platforms()}
                  value={platform.value}
                  label={platform.label}
                  on_click="select_platform"
                  phx-value-data={platform.value}
                >
                  <:right_icon :if={platform.value == @form_platform}><.check /></:right_icon>
                </.dropdown_item>
              </.dropdown>
            </div>

            <div data-part="field">
              <span data-part="field-label">
                {dgettext("dashboard_runners", "Operating system")}
              </span>
              <%!--
                Single-option dropdown today — the OS pins to whatever
                the runner image's base layer ships (Dockerfile / Packer
                template). When the catalog grows per-shape OS diversity
                this becomes a real selector driven by the platform's
                catalog; for now Noora's dropdown component keeps the
                form's visual language consistent and the single item
                already carries the check mark so the selection is
                explicit.
              --%>
              <.dropdown
                id="runner-profile-os-dropdown"
                label={os_label_for_form(@form_platform)}
              >
                <.dropdown_item
                  value={os_label_for_form(@form_platform)}
                  label={os_label_for_form(@form_platform)}
                >
                  <:right_icon><.check /></:right_icon>
                </.dropdown_item>
              </.dropdown>
            </div>

            <div :if={@form_platform == "macos"} data-part="field">
              <span data-part="field-label">
                {dgettext("dashboard_runners", "Xcode version")}
              </span>
              <.dropdown
                :if={not Enum.empty?(@xcode_catalog)}
                id="runner-profile-xcode-version-dropdown"
                label={xcode_version_label_for_value(@form_xcode_version)}
              >
                <.dropdown_item
                  :for={xcode <- @xcode_catalog}
                  value={xcode.xcode_version}
                  label={xcode_version_label_for_value(xcode.xcode_version)}
                  on_click="select_xcode_version"
                  phx-value-data={xcode.xcode_version}
                >
                  <:right_icon :if={xcode.xcode_version == @form_xcode_version}>
                    <.check />
                  </:right_icon>
                </.dropdown_item>
              </.dropdown>

              <span :if={Enum.empty?(@xcode_catalog)} data-part="empty-catalog">
                {dgettext(
                  "dashboard_runners",
                  "No Xcode versions are configured yet. Contact support."
                )}
              </span>
            </div>

            <div data-part="field">
              <span data-part="field-label">{dgettext("dashboard_runners", "Resources")}</span>
              <% shape_catalog = shape_catalog_for(@catalog, @macos_catalog, @form_platform) %>
              <.dropdown
                :if={not Enum.empty?(shape_catalog)}
                id="runner-profile-shape-dropdown"
                label={
                  if is_integer(@form_vcpus) and is_integer(@form_memory_gb),
                    do: shape_label(@form_vcpus, @form_memory_gb),
                    else: dgettext("dashboard_runners", "Select resources")
                }
              >
                <.dropdown_item
                  :for={shape <- shape_catalog}
                  value={shape_key(shape.vcpus, shape.memory_gb)}
                  label={shape_label(shape.vcpus, shape.memory_gb)}
                  on_click="select_shape"
                  phx-value-data={shape_key(shape.vcpus, shape.memory_gb)}
                >
                  <:right_icon :if={
                    shape.vcpus == @form_vcpus and shape.memory_gb == @form_memory_gb
                  }>
                    <.check />
                  </:right_icon>
                </.dropdown_item>
              </.dropdown>

              <span :if={Enum.empty?(shape_catalog)} data-part="empty-catalog">
                {dgettext(
                  "dashboard_runners",
                  "No resource catalog is configured yet. Contact support."
                )}
              </span>
            </div>

            <.line_divider />

            <section data-part="cache-saving-section">
              <button
                id="runner-profile-cache-saving-toggle"
                type="button"
                data-part="section-toggle"
                aria-expanded={to_string(@form_cache_saving_expanded)}
                aria-controls="runner-profile-cache-saving-panel"
                phx-click="toggle_cache_saving_section"
              >
                <span data-part="section-heading">
                  <span data-part="title">{dgettext("dashboard_runners", "Save cache from")}</span>
                  <span data-part="summary">
                    {cache_saving_summary(
                      @form_cache_any_branch_writes,
                      @form_cache_writer_branches
                    )}
                  </span>
                </span>
                <span data-part="section-chevron"><.chevron_down /></span>
              </button>
              <div
                id="runner-profile-cache-saving-panel"
                data-part="section-panel"
                role="region"
                aria-labelledby="runner-profile-cache-saving-toggle"
                hidden={not @form_cache_saving_expanded}
              >
                <div data-part="toggle-label">
                  <.toggle
                    id={"runner-profile-cache-any-branch-#{@form_cache_any_branch_writes}"}
                    checked={@form_cache_any_branch_writes}
                    phx-click="toggle_cache_any_branch_writes"
                  />
                  <div data-part="label-text">
                    <span data-part="title">
                      {dgettext("dashboard_runners", "Save from any branch")}
                    </span>
                    <span data-part="description">
                      {dgettext(
                        "dashboard_runners",
                        "Successful jobs from any branch in the repository save. Forks never do."
                      )}
                    </span>
                  </div>
                </div>
                <.form
                  :if={not @form_cache_any_branch_writes}
                  for={%{}}
                  id="runner-profile-cache-writer-branches-form"
                  phx-change="update_cache_writer_branches"
                >
                  <.text_area
                    id="runner-profile-cache-writer-branches"
                    name="cache_writer_branches"
                    label={dgettext("dashboard_runners", "Additional branches")}
                    value={@form_cache_writer_branches}
                    rows={3}
                    max_length={4200}
                    show_character_count={false}
                    placeholder={dgettext("dashboard_runners", "One exact branch name per line")}
                    hint={
                      dgettext(
                        "dashboard_runners",
                        "Pull requests from these branches also save."
                      )
                    }
                    phx-debounce="200"
                  />
                </.form>
              </div>
            </section>
          </div>

          <.line_divider />
        </div>

        <:footer>
          <.modal_footer>
            <:action>
              <.button
                label={dgettext("dashboard_runners", "Cancel")}
                variant="secondary"
                phx-click="dismiss_modal"
              />
            </:action>
            <:action>
              <.button
                label={
                  case @form_mode do
                    :new -> dgettext("dashboard_runners", "Create profile")
                    {:edit, _} -> dgettext("dashboard_runners", "Save changes")
                  end
                }
                variant="primary"
                phx-click="save_profile"
                disabled={Enum.empty?(@catalog)}
              />
            </:action>
          </.modal_footer>
        </:footer>
      </.modal>
    </div>
  </div>

  <.table id="runner-profiles-table" rows={@profiles}>
    <:col :let={profile} label={dgettext("dashboard_runners", "Label")}>
      <.text_cell data-part="dispatch-label-cell" label={dispatch_snippet(profile)} />
    </:col>
    <:col :let={profile} label={dgettext("dashboard_runners", "Platform")}>
      <.badge_cell
        label={platform_label(profile)}
        color={platform_badge_color(profile)}
        style="light-fill"
      />
    </:col>
    <:col :let={profile} label={dgettext("dashboard_runners", "Operating system")}>
      <.text_cell label={os_label(profile)} />
    </:col>
    <:col :let={profile} label={dgettext("dashboard_runners", "vCPU")}>
      <.text_cell label={Integer.to_string(profile.vcpus)} />
    </:col>
    <:col :let={profile} label={dgettext("dashboard_runners", "RAM")}>
      <.text_cell label={"#{profile.memory_gb} GB"} />
    </:col>
    <:col :let={profile} label={dgettext("dashboard_runners", "Last used")}>
      <.text_cell label={last_used_label(@last_used, profile)} />
    </:col>
    <:col :let={profile} label="">
      <.button_cell>
        <:button>
          <div
            id={"runner-profile-row-actions-#{profile.id}"}
            phx-hook="StopRowNavigate"
          >
            <.dropdown id={"runner-profile-actions-#{profile.id}"} icon_only>
              <:icon><.dots_vertical /></:icon>

              <.dropdown_item
                label={dgettext("dashboard_runners", "Edit")}
                value="edit"
                on_click="open_edit_modal"
                phx-value-id={profile.id}
              >
                <:left_icon><.pencil /></:left_icon>
              </.dropdown_item>
              <%!-- Protected (auto-bootstrapped) profiles aren't
                      deletable — every account always has its `linux`
                      default so the `<prefix>linux` label keeps
                      resolving. Shape stays editable. --%>
              <.dropdown_item
                :if={not profile.protected}
                label={dgettext("dashboard_runners", "Delete")}
                value="delete"
                on_click="request_delete_profile"
                phx-value-id={profile.id}
              >
                <:left_icon><.trash /></:left_icon>
              </.dropdown_item>
            </.dropdown>
          </div>
        </:button>
      </.button_cell>
    </:col>
    <:empty_state>
      <.table_empty_state
        title={dgettext("dashboard_runners", "No profiles yet")}
        subtitle={
          dgettext(
            "dashboard_runners",
            "Create one to let your workflows reference Tuist runners by name."
          )
        }
      />
    </:empty_state>
  </.table>

  <%!-- Delete confirmation. One page-level modal opened by a row's
        Delete action via push_event (the table can't host a per-row
        trigger). The required trigger slot is an empty placeholder. --%>
  <.modal
    id={@delete_modal_id}
    title={dgettext("dashboard_runners", "Delete profile")}
    header_size="large"
    on_dismiss="cancel_delete_profile"
  >
    <:trigger><span hidden></span></:trigger>
    <.line_divider />
    <div data-part="delete-modal-body">
      <.alert
        :if={@deleting_profile}
        status="warning"
        type="secondary"
        size="small"
        title={
          dgettext(
            "dashboard_runners",
            "Workflows using runs-on: %{label} will fail to dispatch until they're updated.",
            label: dispatch_snippet(@deleting_profile)
          )
        }
      />
      <p data-part="delete-modal-message">
        {dgettext(
          "dashboard_runners",
          "Delete profile %{name}? This can't be undone.",
          name: (@deleting_profile && @deleting_profile.name) || ""
        )}
      </p>
    </div>
    <.line_divider />
    <:footer>
      <.modal_footer>
        <:action>
          <.button
            label={dgettext("dashboard_runners", "Cancel")}
            variant="secondary"
            phx-click="cancel_delete_profile"
          />
        </:action>
        <:action>
          <.button
            label={dgettext("dashboard_runners", "Delete profile")}
            variant="destructive"
            phx-click="confirm_delete_profile"
          />
        </:action>
      </.modal_footer>
    </:footer>
  </.modal>
</div>
