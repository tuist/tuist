<div id="account-notifications">
  <h1 data-part="title">
    {dgettext("dashboard_account", "Settings")}
  </h1>
  <TuistWeb.AppLayoutComponents.settings_tab_menu
    selected_account={@selected_account}
    current_path={@current_path}
    current_user={@current_user}
  />
  <.card_section data-part="new-previews-card-section">
    <div data-part="header">
      <span data-part="title">{dgettext("dashboard_account", "New previews")}</span>
      <span data-part="subtitle">
        {dgettext(
          "dashboard_account",
          "Get a push notification on your devices when a new preview is published. Only you see these settings."
        )}
      </span>
    </div>
    <div data-part="content">
      <.alert
        :if={@preferences == []}
        status="information"
        type="secondary"
        size="small"
        title={
          dgettext(
            "dashboard_account",
            "You'll be able to choose notifications once you have a project."
          )
        }
      />
      <%!-- Most people belong to one account with projects, so its projects are shown right here, as in the apps. --%>
      <.account_projects
        :if={match?([_], @preferences)}
        preference={hd(@preferences)}
        all_label={
          dgettext("dashboard_account", "All projects in %{account}",
            account: hd(@preferences).account.name
          )
        }
      />
      <div :if={length(@preferences) > 1} data-part="accounts">
        <div
          :for={%{account: account} = preference <- @preferences}
          id={"new-previews-account-#{account.id}"}
          data-part="account"
          data-open={@open_account_id == account.id}
        >
          <div data-part="account-row">
            <div data-part="account-label">
              <span data-part="account-name">{account.name}</span>
              <span data-part="account-kind">{account_kind(account)}</span>
            </div>
            <span id={"new-previews-account-summary-#{account.id}"} data-part="account-summary">
              {account_summary(preference)}
            </span>
            <.button
              id={"new-previews-account-edit-#{account.id}"}
              type="button"
              label={
                if @open_account_id == account.id,
                  do: dgettext("dashboard_account", "Done"),
                  else: dgettext("dashboard_account", "Edit")
              }
              variant="secondary"
              size="small"
              phx-click="toggle_open_account"
              phx-value-id={account.id}
              aria-expanded={to_string(@open_account_id == account.id)}
            />
          </div>
          <.account_projects
            :if={@open_account_id == account.id}
            preference={preference}
            all_label={dgettext("dashboard_account", "All projects")}
          />
        </div>
      </div>
    </div>
  </.card_section>
  <.card_section data-part="devices-card-section">
    <div data-part="header">
      <span data-part="title">{dgettext("dashboard_account", "Devices")}</span>
      <span data-part="subtitle">
        {dgettext(
          "dashboard_account",
          "Devices where you signed in to the Tuist app and allowed notifications. Removing a device stops notifications to it until you turn them back on in the app."
        )}
      </span>
    </div>
    <div data-part="content">
      <.table id="devices-table" rows={@devices}>
        <:col :let={device} label={dgettext("dashboard_account", "Device")}>
          <.text_cell label={device_name(device)} sublabel={platform_label(device.platform)} />
        </:col>
        <:col :let={device} label={dgettext("dashboard_account", "Last active")}>
          <.time_cell time={device.last_registered_at} relative />
        </:col>
        <:col :let={device} label={dgettext("dashboard_account", "Added")}>
          <.time_cell time={device.inserted_at} />
        </:col>
        <:col :let={device} label="">
          <.button
            id={"remove-device-#{device.id}"}
            type="button"
            label={dgettext("dashboard_account", "Remove")}
            variant="secondary"
            size="small"
            phx-click="remove_device"
            phx-value-id={device.id}
          />
        </:col>
        <:empty_state>
          <.table_empty_state
            icon="device_mobile"
            title={dgettext("dashboard_account", "No devices yet")}
            subtitle={
              dgettext(
                "dashboard_account",
                "Sign in to the Tuist app on iOS or Android and allow notifications."
              )
            }
          />
        </:empty_state>
      </.table>
    </div>
  </.card_section>
</div>
