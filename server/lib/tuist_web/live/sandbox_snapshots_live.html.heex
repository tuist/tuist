<div id="sandbox-snapshots">
  <div data-part="page-header">
    <h1 data-part="title">{dgettext("dashboard_sandboxes", "Snapshots")}</h1>
    <span data-part="subtitle">
      {dgettext(
        "dashboard_sandboxes",
        "Saved project disks. New sandboxes of the same project start from them, so agents skip the project's setup. Snapshots unused for %{hours} hours are deleted.",
        hours: @retention_hours
      )}
    </span>
  </div>

  <.card title={dgettext("dashboard_sandboxes", "Project snapshots")} icon="photo">
    <.card_section>
      <.table
        id="snapshots-table"
        rows={@snapshots}
        row_key={fn snapshot -> "snapshot-#{snapshot.id}" end}
      >
        <:col :let={snapshot} label={dgettext("dashboard_sandboxes", "Snapshot")}>
          <.text_cell label={snapshot.amp_snapshot_id} sublabel={short_id(snapshot.id)} />
        </:col>
        <:col :let={snapshot} label={dgettext("dashboard_sandboxes", "Status")}>
          <% status = snapshot_status(snapshot) %>
          <.status_badge_cell label={status.label} status={status.status} />
        </:col>
        <:col :let={snapshot} label={dgettext("dashboard_sandboxes", "Template")}>
          <.text_cell label={snapshot.template} />
        </:col>
        <:col :let={snapshot} label={dgettext("dashboard_sandboxes", "Disk")}>
          <.text_cell label={gigabytes(snapshot.workspace_gb)} />
        </:col>
        <:col :let={snapshot} label={dgettext("dashboard_sandboxes", "Last used")}>
          <.text_cell
            label={relative_time(snapshot.last_used_at || snapshot.inserted_at)}
            title={time(snapshot.last_used_at || snapshot.inserted_at)}
          />
        </:col>
        <:col :let={snapshot} label={dgettext("dashboard_sandboxes", "Expires")}>
          <.text_cell label={expires(snapshot)} />
        </:col>
        <:col :let={snapshot} :if={@can_manage} label="">
          <.button
            id={"delete-snapshot-#{snapshot.id}"}
            variant="secondary"
            size="small"
            icon_only
            disabled={@deleting}
            aria-label={dgettext("dashboard_sandboxes", "Delete snapshot")}
            phx-click="request_delete"
            phx-value-id={snapshot.id}
          >
            <.trash />
          </.button>
        </:col>
        <:empty_state>
          <.table_empty_state
            icon="photo"
            title={dgettext("dashboard_sandboxes", "No snapshots yet")}
            subtitle={
              dgettext(
                "dashboard_sandboxes",
                "Amp saves a snapshot when an Orb finishes setting up a project."
              )
            }
          />
        </:empty_state>
      </.table>
    </.card_section>
  </.card>

  <.modal
    id="snapshot-confirm-delete"
    title={dgettext("dashboard_sandboxes", "Delete snapshot")}
    description={
      dgettext(
        "dashboard_sandboxes",
        "New sandboxes of this project run the project's setup again until a new snapshot is saved."
      )
    }
    on_dismiss="cancel_delete"
  >
    <:trigger><span hidden></span></:trigger>
    <.line_divider />
    <:footer>
      <.modal_footer>
        <:action>
          <.button
            label={dgettext("dashboard_sandboxes", "Cancel")}
            variant="secondary"
            phx-click="cancel_delete"
          />
        </:action>
        <:action>
          <.button
            id="snapshot-confirm-delete-button"
            label={dgettext("dashboard_sandboxes", "Delete snapshot")}
            variant="destructive"
            phx-click="delete"
          />
        </:action>
      </.modal_footer>
    </:footer>
  </.modal>
</div>
