<div id="coverage-detail">
  <.button
    label={dgettext("dashboard_tests", "Code coverage")}
    data-part="back-button"
    variant="secondary"
    size="medium"
    navigate={~p"/#{@selected_account.name}/#{@selected_project.name}/tests/coverage"}
  >
    <:icon_left><.icon name="arrow_left" /></:icon_left>
  </.button>

  <div data-part="header">
    <div data-part="title-group">
      <h1 data-part="title">{subject_title(@subject)}</h1>
      <div data-part="badges">
        <.badge
          label={if @subject.kind == :commit, do: @subject.sha, else: short_sha(@subject.sha)}
          color="neutral"
          style="light-fill"
          size="large"
        />
        <span :if={@subject.kind == :pull_request and @subject.branch != ""} data-part="branches">
          <.badge label={@subject.branch} color="neutral" style="light-fill" size="large" />
          <.icon name="arrow_right" />
          <.badge
            label={
              if @subject.base_branch == "",
                do: @selected_project.default_branch,
                else: @subject.base_branch
            }
            color="information"
            style="light-fill"
            size="large"
          />
        </span>
        <.badge
          label={ref_status_label(@comparison.commit)}
          color={ref_status_color(@comparison.commit)}
          style="light-fill"
          size="large"
        />
      </div>
    </div>
    <div :if={@subject.kind == :pull_request and length(@commits) > 1} data-part="actions">
      <.dropdown
        id="coverage-commit-dropdown"
        label={short_sha(@subject.sha)}
        secondary_text={dgettext("dashboard_tests", "Commit:")}
      >
        <.dropdown_item
          :for={commit <- @commits}
          value={commit.git_commit_sha}
          label={
            "#{short_sha(commit.git_commit_sha)} · #{Tuist.Utilities.DateFormatter.from_now(commit.ran_at)}"
          }
          patch={"?#{@uri.query |> Query.put("commit", commit.git_commit_sha) |> Query.drop("page")}"}
          data-selected={@subject.sha == commit.git_commit_sha}
        >
          <:right_icon :if={@subject.sha == commit.git_commit_sha}><.check /></:right_icon>
        </.dropdown_item>
      </.dropdown>
    </div>
  </div>

  <.tab_menu_horizontal>
    <.tab_menu_horizontal_item
      :for={tab <- tabs(@subject)}
      selected={@tab == tab}
      label={tab_label(tab)}
      patch={"?#{@uri.query |> Query.put("tab", tab) |> Query.drop("page")}"}
    />
  </.tab_menu_horizontal>

  <%!-- Overview --%>
  <.card
    :if={@tab == "overview"}
    title={dgettext("dashboard_tests", "Analytics")}
    icon="chart_arcs"
    data-part="comparison-card"
  >
    <:actions>
      <.date_picker
        :if={@subject.kind == :branch}
        id="coverage-date-range-picker"
        name="coverage-date-range"
        presets={[
          %{
            id: "last-7-days",
            label: dgettext("dashboard_tests", "Last 7 days"),
            period: {7, :day}
          },
          %{
            id: "last-30-days",
            label: dgettext("dashboard_tests", "Last 30 days"),
            period: {30, :day}
          },
          %{
            id: "last-12-months",
            label: dgettext("dashboard_tests", "Last 12 months"),
            period: {12, :month}
          },
          %{id: "custom", label: dgettext("dashboard_tests", "Custom")}
        ]}
        selected_preset={@coverage_preset}
        period={@coverage_period}
        on_period_change="coverage_period_changed"
        max={Date.utc_today()}
      >
        <:actions>
          <.button
            label={dgettext("dashboard_tests", "Cancel")}
            variant="secondary"
            phx-click={
              JS.dispatch("phx:date-picker-cancel", detail: %{id: "coverage-date-range-picker"})
            }
          />
          <.button
            label={dgettext("dashboard_tests", "Apply")}
            phx-click={
              JS.dispatch("phx:date-picker-apply", detail: %{id: "coverage-date-range-picker"})
            }
          />
        </:actions>
      </.date_picker>
    </:actions>
    <.card_section data-part="comparison-section">
      <.alert
        :if={is_nil(@comparison.baseline)}
        id="coverage-no-baseline"
        status="warning"
        type="secondary"
        size="small"
        title={
          dgettext("dashboard_tests", "No baseline: %{reason}.",
            reason: reason_label(@comparison.baseline_reason)
          )
        }
      />
      <.alert
        :if={@comparison.commit.partial}
        id="coverage-partial-run"
        status="information"
        type="secondary"
        size="small"
        title={partial_run_title(@comparison.commit)}
      />
      <.alert
        :if={not Map.get(@comparison.commit, :complete, false)}
        id="coverage-incomplete"
        status="information"
        type="secondary"
        size="small"
        title={
          dgettext(
            "dashboard_tests",
            "The coverage pipeline has not signalled completion for this commit; more runs may still land."
          )
        }
      />
      <div data-part="widgets">
        <.widget
          id="widget-coverage"
          title={dgettext("dashboard_tests", "Code coverage")}
          legend_color="primary"
          description={
            dgettext(
              "dashboard_tests",
              "Share of executable lines some run's tests ran at least once, across %{schemes}.",
              schemes: Enum.join(@comparison.commit.schemes, ", ")
            )
          }
          value={"#{displayed_coverage(@comparison.commit)}%"}
          trend_value={period_trend(@series)}
          trend_label={dgettext("dashboard_tests", "over the period")}
        />
        <.widget
          id="widget-change"
          title={dgettext("dashboard_tests", "Change")}
          description={change_description(@subject, @selected_project, @comparison)}
          value={
            cond do
              @comparison.total_delta -> "#{signed(@comparison.total_delta)}%"
              @comparison.commit.partial -> dgettext("dashboard_tests", "Not compared")
              true -> dgettext("dashboard_tests", "No baseline")
            end
          }
        />
        <.widget
          :if={@subject.kind == :branch and @subject.branch != @selected_project.default_branch}
          id="widget-against-default"
          title={
            dgettext("dashboard_tests", "Against %{branch}",
              branch: @selected_project.default_branch
            )
          }
          description={
            if @against_default,
              do:
                dgettext("dashboard_tests", "%{branch} is at %{coverage}% at %{sha}.",
                  branch: @against_default.branch,
                  coverage: @against_default.coverage,
                  sha: short_sha(@against_default.commit)
                ),
              else:
                dgettext(
                  "dashboard_tests",
                  "Compared only when both measured the same schemes, each as fully."
                )
          }
          value={
            if @against_default,
              do: "#{signed(@against_default.delta)}%",
              else: dgettext("dashboard_tests", "Not compared")
          }
        />
        <.widget
          :if={diff?(@comparison)}
          id="widget-patch"
          title={dgettext("dashboard_tests", "Patch coverage")}
          description={
            case @comparison.patch do
              %{status: :available} = patch ->
                dgettext(
                  "dashboard_tests",
                  "%{covered} of %{executable} changed executable lines ran.",
                  covered: format_number(patch.covered_lines),
                  executable: format_number(patch.executable_lines)
                )

              patch ->
                dgettext("dashboard_tests", "Unavailable: %{reason}.",
                  reason: reason_label(patch)
                )
            end
          }
          value={
            case @comparison.patch do
              %{status: :available, executable_lines: 0} ->
                dgettext("dashboard_tests", "No changed lines")

              %{status: :available} = patch ->
                "#{patch.coverage}%"

              _ ->
                dgettext("dashboard_tests", "Unavailable")
            end
          }
        />
        <.widget
          :if={diff?(@comparison)}
          id="widget-gaps"
          title={dgettext("dashboard_tests", "Untested changed files")}
          description={
            dgettext(
              "dashboard_tests",
              "Changed files where no test ran any of the changed lines."
            )
          }
          value={format_number(length(@comparison.gaps))}
        />
        <.widget
          :if={not diff?(@comparison)}
          id="widget-covered-lines"
          title={dgettext("dashboard_tests", "Covered lines")}
          description={
            dgettext(
              "dashboard_tests",
              "%{covered} of %{executable} executable lines ran at least once.",
              covered: format_number(displayed_lines(@summary).covered_lines),
              executable: format_number(displayed_lines(@summary).executable_lines)
            )
          }
          value={format_number(displayed_lines(@summary).covered_lines)}
        />
        <.widget
          :if={not diff?(@comparison)}
          id="widget-files-without-data"
          title={dgettext("dashboard_tests", "Files without coverage data")}
          description={
            dgettext(
              "dashboard_tests",
              "Source files Git tracks at that commit that no scheme compiled, so they are missing from the total."
            )
          }
          value={format_number((@summary && @summary.unmeasured_files_count) || 0)}
        />
      </div>
    </.card_section>
    <.card_section :if={length(@series) > 1} data-part="analytics-section">
      <div data-part="analytics-chart">
        <.chart
          id="coverage-detail-chart"
          type="line"
          extra_options={
            %{
              grid: %{width: "97%", left: "0.4%", height: "88%", top: "5%"},
              xAxis: %{
                boundaryGap: false,
                type: "category",
                axisLabel: %{
                  color: "var:noora-surface-label-secondary",
                  formatter: "fn:toLocaleDate",
                  customValues: [
                    @series |> List.first() |> point_time(),
                    @series |> List.last() |> point_time()
                  ],
                  padding: [10, 0, 0, 0]
                }
              },
              yAxis: %{
                splitNumber: 4,
                splitLine: %{lineStyle: %{color: "var:noora-chart-lines"}},
                axisLabel: %{color: "var:noora-surface-label-secondary", formatter: "{value}%"}
              },
              legend: %{show: false},
              tooltip: %{valueFormat: "{value}%"}
            }
          }
          series={[
            %{
              color: "var:noora-chart-primary",
              data: Enum.map(@series, &[point_time(&1), &1.coverage]),
              name: dgettext("dashboard_tests", "Code coverage"),
              type: "line",
              smooth: 0.1,
              symbol: "circle",
              symbolSize: 4
            }
          ]}
          y_axis_min={0}
          y_axis_max={100}
        />
      </div>
    </.card_section>
  </.card>

  <%!-- Schemes --%>
  <.card
    :if={@tab == "overview" and length(@scheme_rows) > 1}
    title={"#{scheme_label(@selected_project)}s"}
    icon="stack_2"
    data-part="schemes-card"
  >
    <.card_section data-part="schemes-section">
      <.table id="coverage-schemes-table" rows={@scheme_rows}>
        <:col :let={row} label={scheme_label(@selected_project)}>
          <.text_cell label={row.scheme} />
        </:col>
        <:col :let={row} label={dgettext("dashboard_tests", "Coverage")}>
          <.coverage_change_cell coverage={row.coverage} delta={row.delta} />
        </:col>
        <:col :let={row} label={dgettext("dashboard_tests", "Run")}>
          <.run_kind_cell partial={if row.coverage, do: row.partial} />
        </:col>
      </.table>
    </.card_section>
  </.card>

  <%!-- Where coverage stands and moved --%>
  <.targets_coverage_card
    :if={@tab == "overview"}
    rises={@target_rises}
    falls={@target_falls}
    baseline={@comparison.baseline}
    baseline_reason={@comparison.baseline_reason}
    href={"?#{@uri.query |> Query.put("tab", "targets") |> Query.drop("page")}"}
  />
  <.files_coverage_card
    :if={@tab == "overview"}
    rises={@file_rises}
    falls={@file_falls}
    least_covered={@least_covered_files}
    file_href={fn path -> file_href(assigns, path) end}
    unmeasured={@unmeasured_files}
    unmeasured_count={(@summary && @summary.unmeasured_files_count) || 0}
    baseline={@comparison.baseline}
    baseline_reason={@comparison.baseline_reason}
    href={"?#{@uri.query |> Query.put("tab", "files") |> Query.drop("page")}"}
  />

  <%!-- A file of the head commit --%>
  <.card
    :if={@coverage_file}
    title={@coverage_file.path}
    icon="file"
    data-part="coverage-file-card"
    id="coverage-file"
  >
    <:actions>
      <.button
        label={dgettext("dashboard_tests", "Close")}
        variant="secondary"
        size="medium"
        patch={"?#{Query.drop(@uri.query, "coverage-file")}"}
      />
    </:actions>
    <.card_section data-part="coverage-file-section">
      <div data-part="widgets">
        <.widget
          id="widget-coverage-file-percentage"
          title={dgettext("dashboard_tests", "Line coverage")}
          description={
            dgettext(
              "dashboard_tests",
              "Share of the file's executable lines the tests ran at least once."
            )
          }
          value={"#{Tuist.Tests.Coverage.percentage(@coverage_file.covered_lines, @coverage_file.executable_lines)}%"}
        />
        <.widget
          id="widget-coverage-file-lines"
          title={dgettext("dashboard_tests", "Covered lines")}
          description={
            dgettext("dashboard_tests", "Executable lines the tests ran at least once.")
          }
          value={"#{format_number(@coverage_file.covered_lines)} / #{format_number(@coverage_file.executable_lines)}"}
        />
      </div>
      <dl data-part="coverage-file-details">
        <div :if={@coverage_file.targets != []}>
          <dt>{dgettext("dashboard_tests", "Targets")}</dt>
          <dd>{Enum.join(@coverage_file.targets, ", ")}</dd>
        </div>
        <div>
          <dt>{dgettext("dashboard_tests", "Uncovered lines")}</dt>
          <dd id="coverage-file-uncovered-lines">
            {case @coverage_file.uncovered_ranges do
              nil -> dgettext("dashboard_tests", "Unavailable")
              [] -> dgettext("dashboard_tests", "None")
              ranges -> line_ranges_label(ranges)
            end}
          </dd>
        </div>
        <div :if={Map.get(@coverage_file, :carried_lines, []) != []}>
          <dt>{dgettext("dashboard_tests", "Covered by skipped tests, carried forward")}</dt>
          <dd id="coverage-file-carried-lines">
            {@coverage_file.carried_lines
            |> Tuist.Tests.Coverage.Evidence.line_ranges()
            |> line_ranges_label()}
          </dd>
        </div>
      </dl>
    </.card_section>
    <.card_section :if={@coverage_file_tests} data-part="coverage-file-tests-section">
      <.table
        :if={@coverage_file_tests.tests != []}
        id="coverage-file-tests-table"
        rows={Enum.map(@coverage_file_tests.tests, &Map.put(&1, :id, &1.test_case_id))}
        row_navigate={
          fn test ->
            url(
              ~p"/#{@selected_account.name}/#{@selected_project.name}/tests/test-cases/#{test.test_case_id}"
            )
          end
        }
      >
        <:col :let={test} label={dgettext("dashboard_tests", "Test executing this file")}>
          <.text_and_description_cell
            label={test.name}
            description={"#{test.module_name} · #{test.suite_name}"}
          />
        </:col>
        <:col :let={test} label={dgettext("dashboard_tests", "Lines it ran")}>
          <.text_cell label={line_ranges_label(test.lines)} />
        </:col>
      </.table>
      <dl data-part="coverage-file-details">
        <div :if={@coverage_file_tests.tests == []}>
          <dt>{dgettext("dashboard_tests", "Tests executing this file")}</dt>
          <dd id="coverage-file-no-tests">
            {dgettext("dashboard_tests", "None by their own evidence at this commit")}
          </dd>
        </div>
        <div :if={@coverage_file_tests.suites != []}>
          <dt>{dgettext("dashboard_tests", "Suites running it around their tests")}</dt>
          <dd>{Enum.join(@coverage_file_tests.suites, ", ")}</dd>
        </div>
        <div :if={@coverage_file_tests.targets != []}>
          <dt>{dgettext("dashboard_tests", "Test targets executing it")}</dt>
          <dd>{Enum.join(@coverage_file_tests.targets, ", ")}</dd>
        </div>
      </dl>
    </.card_section>
  </.card>

  <%!-- Coverage gates --%>
  <.card
    :if={@tab == "overview" and @gate_verdict}
    title={dgettext("dashboard_tests", "Coverage gates")}
    icon="circle_check"
    data-part="gates-card"
  >
    <.card_section data-part="gates-section">
      <div data-part="verdict">
        <.badge
          label={verdict_label(@gate_verdict, @comparison.commit.complete)}
          color={verdict_color(@gate_verdict, @comparison.commit.complete)}
          style="light-fill"
          size="large"
        />
        <span data-part="description">
          {if @comparison.commit.complete,
            do:
              dgettext(
                "dashboard_tests",
                "Reported to the pull request as the %{check} check. A run landing later joins the commit's coverage and leaves the verdict as it is.",
                check: Tuist.Tests.Coverage.Gates.check_name()
              ),
            else:
              dgettext(
                "dashboard_tests",
                "The %{check} check stays pending until this commit's coverage pipeline signals completion with `tuist coverage complete`.",
                check: Tuist.Tests.Coverage.Gates.check_name()
              )}
        </span>
      </div>
      <.table
        :if={@gate_verdict.checks != []}
        id="coverage-gates-table"
        rows={gate_rows(@gate_verdict)}
      >
        <:col :let={check} label={dgettext("dashboard_tests", "Gate")}>
          <.text_cell label={gate_label(check.gate)} sublabel={gate_threshold(check)} />
        </:col>
        <:col :let={check} label={dgettext("dashboard_tests", "This commit")}>
          <.text_cell label={gate_value(check)} />
        </:col>
        <:col :let={check} label={dgettext("dashboard_tests", "Result")}>
          <div data-part="cell" data-type="badge">
            <.badge
              style="light-fill"
              size="large"
              color={gate_status_color(check.status)}
              label={gate_status_label(check.status)}
            />
            <span :if={Map.get(check, :reason)} data-part="sublabel">
              {reason_label(check.reason)}
            </span>
          </div>
        </:col>
      </.table>
      <div :if={@gate_verdict.checks == []} data-part="empty">
        {dgettext(
          "dashboard_tests",
          "Gates are enabled but no threshold is set, so nothing is held to anything."
        )}
      </div>
    </.card_section>
  </.card>

  <%!-- Changed files --%>
  <.card
    :if={
      @tab == "overview" and @comparison.patch.status == :available and
        (@patch_rows != [] or @skipped_rows != [])
    }
    title={dgettext("dashboard_tests", "Changed files")}
    icon="file"
    data-part="patch-card"
  >
    <.card_section :if={@patch_rows != []} data-part="patch-section">
      <.table id="coverage-patch-table" rows={@patch_rows}>
        <:col :let={file} label={dgettext("dashboard_tests", "File")}>
          <.text_and_description_cell
            label={Path.basename(file.path)}
            description={parent_dir(file.path)}
          />
        </:col>
        <:col :let={file} label={dgettext("dashboard_tests", "Changed lines")}>
          <.text_cell label={"#{format_number(file.covered_lines)} / #{format_number(file.executable_lines)}"} />
        </:col>
        <:col :let={file} label={dgettext("dashboard_tests", "Patch coverage")}>
          <.coverage_cell covered={file.covered_lines} executable={file.executable_lines} />
        </:col>
        <:col :let={file} label={dgettext("dashboard_tests", "Uncovered lines")}>
          <.text_cell label={line_ranges(file.uncovered_ranges)} />
        </:col>
      </.table>
    </.card_section>
    <.card_section :if={@skipped_rows != []} data-part="skipped-section">
      <h3 data-part="section-title">{dgettext("dashboard_tests", "Not counted")}</h3>
      <.table id="coverage-skipped-table" rows={@skipped_rows}>
        <:col :let={file} label={dgettext("dashboard_tests", "File")}>
          <.text_and_description_cell
            label={Path.basename(file.path)}
            description={parent_dir(file.path)}
          />
        </:col>
        <:col :let={file} label={dgettext("dashboard_tests", "Why")}>
          <.text_cell label={skipped_reason_label(file.reason)} />
        </:col>
      </.table>
    </.card_section>
  </.card>

  <%!-- Commits --%>
  <.card
    :if={@tab == "commits"}
    title={dgettext("dashboard_tests", "Commits")}
    icon="git_commit"
    data-part="commits"
  >
    <.card_section :if={@commit_rows != []} data-part="commits-section">
      <.alert
        :if={@commits_ordered_by == :time}
        id="coverage-commits-time-order"
        status="information"
        type="secondary"
        size="small"
        title={
          dgettext(
            "dashboard_tests",
            "These commits are listed in the order they were measured, not the order the repository's history puts them in."
          )
        }
      />
      <div data-part="commits-table">
        <.table
          id="coverage-commits-table"
          rows={@commit_rows}
          row_navigate={
            fn row ->
              if row.measured,
                do:
                  url(
                    ~p"/#{@selected_account.name}/#{@selected_project.name}/tests/coverage/commits/#{row.git_commit_sha}"
                  )
            end
          }
        >
          <:col :let={row} label={dgettext("dashboard_tests", "Commit")}>
            <.text_cell label={short_sha(row.git_commit_sha)} />
          </:col>
          <:col :let={row} label={dgettext("dashboard_tests", "Coverage")}>
            <.coverage_cell
              :if={row.measured}
              covered={row.covered_lines}
              executable={row.executable_lines}
            />
            <.text_cell :if={not row.measured} label="—" />
          </:col>
          <:col :let={row} label={dgettext("dashboard_tests", "Change")}>
            <.change_cell delta={row.change} />
          </:col>
          <:col :let={row} label={"#{scheme_label(@selected_project)}s"}>
            <.measured_by_cell :if={row.measured} commit={row} />
            <.text_cell :if={not row.measured} label="—" />
          </:col>
          <:col :let={row} label={dgettext("dashboard_tests", "Status")}>
            <.badge_cell
              style="light-fill"
              color={completeness_color(row)}
              label={completeness_label(row)}
            />
          </:col>
          <:col :let={row} label={dgettext("dashboard_tests", "Committed")}>
            <.text_cell sublabel={
              if Map.get(row, :committed_at),
                do: Tuist.Utilities.DateFormatter.from_now(row.committed_at),
                else: "—"
            } />
          </:col>
        </.table>
        <.pagination_group
          :if={@commits_meta.total_pages > 1}
          current_page={@commits_meta.current_page}
          number_of_pages={@commits_meta.total_pages}
          page_patch={fn page -> "?#{Query.put(@uri.query, "page", page)}" end}
        />
      </div>
    </.card_section>
    <.coverage_empty
      :if={@commit_rows == []}
      title={dgettext("dashboard_tests", "No commit gathered coverage here")}
      image="table"
      data-part="empty-commits"
    />
  </.card>

  <%!-- Test Runs --%>
  <.card
    :if={@tab == "runs"}
    title={dgettext("dashboard_tests", "Test Runs")}
    icon="dashboard"
    data-part="runs-card"
  >
    <.card_section :if={@run_rows != []} data-part="runs-section">
      <.table
        id="coverage-runs-table"
        rows={@run_rows}
        row_navigate={
          fn run ->
            url(
              ~p"/#{@selected_account.name}/#{@selected_project.name}/tests/test-runs/#{run.test_run_id}?tab=coverage"
            )
          end
        }
      >
        <:col :let={run} label={scheme_label(@selected_project)}>
          <.text_cell label={run.scheme} />
        </:col>
        <:col :let={run} label={dgettext("dashboard_tests", "Coverage")}>
          <.coverage_cell covered={run.covered_lines} executable={run.executable_lines} />
        </:col>
        <:col :let={run} label={dgettext("dashboard_tests", "Run")}>
          <.run_kind_cell partial={run.partial} />
        </:col>
        <:col :let={run} label={dgettext("dashboard_tests", "Commit")}>
          <.text_cell label={short_sha(run.git_commit_sha)} />
        </:col>
        <:col :let={run} label={dgettext("dashboard_tests", "Ran at")}>
          <.text_cell sublabel={Tuist.Utilities.DateFormatter.from_now(run.ran_at)} />
        </:col>
      </.table>
    </.card_section>
    <.coverage_empty
      :if={@run_rows == []}
      title={dgettext("dashboard_tests", "No run gathered coverage here")}
      image="table"
      data-part="empty-runs"
    />
  </.card>

  <%!-- Targets --%>
  <.card
    :if={@tab == "targets"}
    title={dgettext("dashboard_tests", "Targets")}
    icon="stack_2"
    data-part="targets-card"
  >
    <.card_section :if={@target_rows != []} data-part="targets-section">
      <.table id="coverage-targets-table" rows={@target_rows}>
        <:col :let={target} label={dgettext("dashboard_tests", "Target")}>
          <.text_cell label={target.name} />
        </:col>
        <:col :let={target} label={dgettext("dashboard_tests", "Coverage")}>
          <.coverage_cell covered={target.covered_lines} executable={target.executable_lines} />
        </:col>
        <:col :let={target} label={dgettext("dashboard_tests", "Change")}>
          <.change_cell delta={target.delta} />
        </:col>
      </.table>
    </.card_section>
    <.coverage_empty
      :if={@target_rows == []}
      title={dgettext("dashboard_tests", "No target was measured at this commit")}
      image="table"
      data-part="empty-targets"
    />
  </.card>

  <%!-- Files --%>
  <div :if={@tab == "files"} data-part="files">
    <.card
      title={dgettext("dashboard_tests", "Files")}
      icon="file"
      data-part="files-card"
    >
      <.card_section :if={@file_rows != []} data-part="files-section">
        <div data-part="files-table">
          <.table
            id="coverage-files-table"
            rows={@file_rows}
            row_navigate={fn file -> file_href(assigns, file.path) end}
          >
            <:col :let={file} label={dgettext("dashboard_tests", "File")}>
              <.text_and_description_cell
                label={Path.basename(file.path)}
                description={parent_dir(file.path)}
              />
            </:col>
            <:col :let={file} label={dgettext("dashboard_tests", "Coverage")}>
              <.coverage_change_cell
                coverage={file.coverage}
                delta={file.delta}
                placeholder={dgettext("dashboard_tests", "Removed")}
                new={is_nil(file.baseline_coverage)}
              />
            </:col>
          </.table>
          <.pagination_group
            :if={@files_meta.total_pages > 1}
            current_page={@files_meta.current_page}
            number_of_pages={@files_meta.total_pages}
            page_patch={fn page -> "?#{Query.put(@uri.query, "page", page)}" end}
          />
        </div>
      </.card_section>
      <.coverage_empty
        :if={@file_rows == []}
        title={dgettext("dashboard_tests", "No file's coverage changed at this commit")}
        image="table"
        data-part="empty-files"
      />
    </.card>
    <.card
      title={dgettext("dashboard_tests", "Files without coverage data")}
      icon="file"
      data-part="unmeasured-card"
    >
      <.card_section :if={@unmeasured_files != []} data-part="files-section">
        <div data-part="files-table">
          <.table id="coverage-unmeasured-files-table" rows={@unmeasured_files}>
            <:col :let={file} label={dgettext("dashboard_tests", "File")}>
              <.text_and_description_cell
                label={Path.basename(file.path)}
                description={parent_dir(file.path)}
              />
            </:col>
          </.table>
          <.pagination_group
            :if={@unmeasured_meta.total_pages > 1}
            current_page={@unmeasured_meta.current_page}
            number_of_pages={@unmeasured_meta.total_pages}
            page_patch={fn page -> "?#{Query.put(@uri.query, "unmeasured-page", page)}" end}
          />
        </div>
      </.card_section>
      <.coverage_empty
        :if={@unmeasured_files == []}
        title={
          dgettext("dashboard_tests", "Every file Git tracks at this commit has coverage data")
        }
        image="table"
        data-part="empty-unmeasured"
      />
    </.card>
  </div>
</div>
