<div id={@id} class="gradle-execution">
  <.card title={dgettext("dashboard_gradle", "Longest dependency chain")} icon="subtask">
    <.card_section>
      <p class="graph-note">
        {dgettext(
          "dashboard_gradle",
          "Observed durations along dependencies and hard ordering. This model excludes worker scheduling and resource contention; it is not the build's actual critical path."
        )}
      </p>
      <%= if @model.status == "available" do %>
        <div class="graph-summary">
          <strong>{duration(@model.duration_ms)}</strong><span>{dgettext(
            "dashboard_gradle",
            "%{count} operations on the chain",
            count: @chain.total
          )}</span>
        </div>
        <div class="graph-chain">
          <.link
            :for={node <- @chain.rows}
            patch={patch(assigns, %{"node" => node.id})}
            class="graph-node"
            data-selected={@selected && @selected.id == node.id}
          >
            <span>{node.label}</span><strong>{duration(node.duration_ms)}</strong>
          </.link>
        </div>
        <.graph_pages pagination={@chain} param="chain-page" context={assigns} />
      <% else %>
        <div class="graph-empty">
          <.subtask /><h3>
            {dgettext("dashboard_gradle", "A complete duration model is unavailable")}
          </h3>
          <p>
            {dgettext(
              "dashboard_gradle",
              "This build has an incomplete graph, missing timings, or no execution telemetry. Available operations are shown below."
            )}
          </p>
        </div>
      <% end %>
    </.card_section>
  </.card>

  <.card
    :if={@selected}
    title={dgettext("dashboard_gradle", "Explore dependencies")}
    icon="stack_2"
  >
    <.card_section>
      <p class="graph-note">
        {dgettext(
          "dashboard_gradle",
          "Select an operation to follow its inputs and downstream consumers. Dependencies indicate potential impact, not guaranteed cache invalidation."
        )}
      </p>
      <div class="graph-neighborhood">
        <div>
          <h3>
            {dgettext("dashboard_gradle", "Depends on")} <span>{@dependencies.total}</span>
          </h3>
          <p :if={@dependencies.total == 0} class="graph-note">
            {dgettext("dashboard_gradle", "No captured dependencies")}
          </p>
          <.link
            :for={node <- @dependencies.rows}
            patch={patch(assigns, %{"node" => node.id})}
            class="graph-node"
          ><span>{node.label}</span><small>{node.build_path} · {duration(node.duration_ms)}</small></.link>
          <.graph_pages pagination={@dependencies} param="dependencies-page" context={assigns} />
        </div>
        <div class="graph-focus">
          <h3>{dgettext("dashboard_gradle", "Selected operation")}</h3>
          <div class="graph-node" data-selected="true">
            <span>{@selected.label}</span><strong>{duration(@selected.duration_ms)}</strong><small>{@selected.kind} · {@selected.build_path} · {@selected.project_path}</small>
          </div>
          <.link
            :if={@task}
            navigate={"/#{@account.name}/#{@project.name}/builds/tasks/#{URI.encode(@task.task_path, &URI.char_unreserved?/1)}?#{URI.encode_query(%{build_path: @task.build_path, root_project_name: @build.root_project_name, task_type: @task.task_type})}"}
            class="graph-history-link"
          >{dgettext("dashboard_gradle", "View task history")} →</.link>
          <dl :if={@task} class="graph-metadata">
            <dt>{dgettext("dashboard_gradle", "Outcome")}</dt><dd>{@task.outcome}</dd>
            <dt>{dgettext("dashboard_gradle", "Cacheability")}</dt><dd>{@task.cacheability}</dd>
            <dt>{dgettext("dashboard_gradle", "Incremental")}</dt><dd>
              {if is_nil(@task.incremental), do: "—", else: to_string(@task.incremental)}
            </dd>
            <dt>{dgettext("dashboard_gradle", "Remote lookup")}</dt><dd>
              {@task.remote_cache_lookup_outcome} · {duration(
                @task.remote_cache_lookup_duration_ms
              )}
            </dd>
            <dt>{dgettext("dashboard_gradle", "Download")}</dt><dd>
              {duration(@task.remote_cache_download_duration_ms)}
            </dd>
            <dt>{dgettext("dashboard_gradle", "Upload")}</dt><dd>
              {duration(@task.remote_cache_upload_duration_ms)}
            </dd>
          </dl>
        </div>
        <div>
          <h3>{dgettext("dashboard_gradle", "Used by")} <span>{@dependents.total}</span></h3>
          <p :if={@dependents.total == 0} class="graph-note">
            {dgettext("dashboard_gradle", "No captured consumers")}
          </p>
          <.link
            :for={node <- @dependents.rows}
            patch={patch(assigns, %{"node" => node.id})}
            class="graph-node"
          ><span>{node.label}</span><small>{node.build_path} · {duration(node.duration_ms)}</small></.link>
          <.graph_pages pagination={@dependents} param="dependents-page" context={assigns} />
        </div>
      </div>
      <div
        :if={@task && (@task.caching_disabled_reason != "" || @task.execution_reasons != [])}
        class="graph-reasons"
      >
        <h3>{dgettext("dashboard_gradle", "Gradle execution reasons")}</h3>
        <p :if={@task.caching_disabled_reason != ""}>{@task.caching_disabled_reason}</p>
        <ul :if={@task.execution_reasons != []}>
          <li :for={reason <- @task.execution_reasons}>{reason}</li>
        </ul>
      </div>
      <div :if={@ordering.total > 0} class="graph-ordering">
        <h3>{dgettext("dashboard_gradle", "Ordering constraints")}</h3>
        <div :for={edge <- @ordering.rows}>
          <span>{edge.label}</span><.link patch={patch(assigns, %{"node" => edge.node.id})}>{edge.node.label}</.link>
        </div>
        <.graph_pages pagination={@ordering} param="ordering-page" context={assigns} />
      </div>
    </.card_section>
  </.card>

  <.card
    :if={@graph.nodes != []}
    title={dgettext("dashboard_gradle", "Execution timeline")}
    icon="history"
  >
    <.card_section>
      <form id="graph-search-form" phx-change="search" phx-target={@myself}>
        <.text_input
          id="graph-search"
          name="search"
          value={@search}
          show_suffix={false}
          placeholder={dgettext("dashboard_gradle", "Search operations")}
          phx-debounce="200"
        />
      </form>
      <p class="graph-note">
        {dgettext(
          "dashboard_gradle",
          "Bars show observed start and end times. Highlighted operations belong to the longest dependency chain."
        )}
      </p>
      <div class="graph-timeline">
        <div class="graph-timeline-scale">
          <span>{dgettext("dashboard_gradle", "Operation")}</span><span>0 — {duration(@span)}</span>
        </div>
        <.link
          :for={node <- @rows}
          patch={patch(assigns, %{"node" => node.id})}
          class="graph-timeline-row"
          data-selected={@selected && @selected.id == node.id}
        >
          <span class="graph-timeline-label" title={node.label}>{node.label}<small>{node.build_path} · {node.kind}</small></span>
          <span class="graph-timeline-track"><span
            :if={node.started_at && node.duration_ms}
            class="graph-timeline-bar"
            data-chain={node.id in @model.node_ids}
            style={bar(node, @start_at, @span)}
          ></span></span>
          <span>{duration(node.duration_ms)}</span>
        </.link>
      </div>
      <p :if={@rows == []} class="graph-note">
        {dgettext("dashboard_gradle", "No matching operations")}
      </p>
      <div class="graph-pages">
        <.button
          :if={@page > 1}
          label={dgettext("dashboard_gradle", "Previous")}
          variant="secondary"
          patch={patch(assigns, %{"graph-page" => to_string(@page - 1)})}
        /><span>{dgettext("dashboard_gradle", "Page %{page} of %{count}",
          page: @page,
          count: @page_count
        )}</span><.button
          :if={@page < @page_count}
          label={dgettext("dashboard_gradle", "Next")}
          variant="secondary"
          patch={patch(assigns, %{"graph-page" => to_string(@page + 1)})}
        />
      </div>
    </.card_section>
  </.card>
</div>
