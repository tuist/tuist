<div id="ops-account-kura-sizing">
  <div data-part="header">
    <h1 data-part="title">{dgettext("dashboard", "Sizing decisions")}</h1>
    <p data-part="subtitle">
      <.link navigate={~p"/ops/accounts/#{@account.id}"}>{@account.name}</.link>
      · {dngettext("dashboard", "%{count} decision", "%{count} decisions", @meta.total_count)}
    </p>
  </div>

  <.card title={dgettext("dashboard", "History")} icon="server">
    <.card_section>
      <.table id="kura-sizing-history-table" rows={@decisions}>
        <:col :let={decision} label={dgettext("dashboard", "When")}>
          <.text_cell label={Timex.from_now(decision.inserted_at)} />
        </:col>
        <:col :let={decision} label={dgettext("dashboard", "Change")}>
          <.text_cell label={"#{decision.current_claim_size} → #{decision.recommended_claim_size}"} />
        </:col>
        <:col :let={decision} label={dgettext("dashboard", "Outcome")}>
          <% {label, color} = TuistWeb.OpsAccountLive.claim_history_outcome(decision) %>
          <.badge_cell label={label} color={color} style="light-fill" />
        </:col>
        <:col :let={decision} label={dgettext("dashboard", "By")}>
          <.text_cell label={TuistWeb.OpsAccountLive.claim_history_actor(decision)} />
        </:col>
        <:col :let={decision} label={dgettext("dashboard", "Region")}>
          <.text_cell label={decision.region} />
        </:col>
        <:col :let={decision} label={dgettext("dashboard", "Why")}>
          <.text_cell label={TuistWeb.OpsAccountLive.claim_history_reason(decision)} />
        </:col>
        <:empty_state>
          <.table_empty_state
            icon="server"
            title={dgettext("dashboard", "No sizing decisions")}
            subtitle={
              dgettext("dashboard", "Sizing has not decided anything for this account yet.")
            }
          />
        </:empty_state>
      </.table>
      <.pagination_group
        :if={@meta.total_pages > 1}
        current_page={@current_page}
        number_of_pages={@meta.total_pages}
        page_patch={
          fn page ->
            ~p"/ops/accounts/#{@account.id}/kura/sizing?#{Map.put(@query_params, "page", page)}"
          end
        }
      />
    </.card_section>
  </.card>
</div>
