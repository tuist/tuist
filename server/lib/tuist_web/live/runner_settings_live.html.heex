<div id="runner-settings">
  <h1 data-part="title">{dgettext("dashboard_account", "Settings")}</h1>
  <TuistWeb.AppLayoutComponents.settings_tab_menu
    selected_account={@selected_account}
    current_path={@current_path}
    current_user={@current_user}
  />

  <%!-- One card per CI provider, each behind its own switch. Adding a
        provider means adding a card here, not restructuring the page. --%>
  <.card_section data-part="github-actions-card-section" data-enabled={@github_actions_enabled?}>
    <div data-part="header">
      <div data-part="heading">
        <span data-part="title">{dgettext("dashboard_runners", "GitHub Actions")}</span>
        <span data-part="subtitle">
          {dgettext(
            "dashboard_runners",
            "Jobs reach the fleet through the GitHub App. Target a runner profile with runs-on in your workflow."
          )}
        </span>
      </div>
      <%!-- The state is part of the id so the toggle remounts on change:
            its control lives under `phx-update="ignore"`. --%>
      <.toggle
        id={"github-actions-toggle-#{@github_actions_enabled?}"}
        checked={@github_actions_enabled?}
        phx-click="toggle_github_actions"
      />
    </div>
    <div :if={@github_actions_enabled?} data-part="content">
      <div data-part="connection">
        <span
          data-part="connection-status"
          data-status={if @github_actions_connected?, do: "connected", else: "disconnected"}
        >
          {if @github_actions_connected?,
            do: dgettext("dashboard_runners", "Connected"),
            else: dgettext("dashboard_runners", "Not connected")}
        </span>
        <.button
          label={dgettext("dashboard_runners", "Manage in Integrations")}
          variant="secondary"
          size="medium"
          navigate={~p"/#{@selected_account.name}/settings/integrations"}
        />
      </div>
    </div>
  </.card_section>

  <.card_section data-part="buildkite-card-section" data-enabled={@buildkite_enabled?}>
    <div data-part="header">
      <div data-part="heading">
        <span data-part="title">{dgettext("dashboard_runners", "Buildkite")}</span>
        <span data-part="subtitle">
          {dgettext(
            "dashboard_runners",
            "Tuist watches the self-hosted queues in your cluster and runs what it finds there."
          )}
        </span>
      </div>
      <.toggle
        id={"buildkite-toggle-#{@buildkite_enabled?}"}
        checked={@buildkite_enabled?}
        phx-click="toggle_buildkite"
      />
    </div>
    <div :if={@buildkite_enabled?} data-part="content">
      <form phx-submit="connect" data-part="buildkite-form">
        <.alert
          :if={@form_error}
          status="error"
          type="secondary"
          size="small"
          title={@form_error}
        />

        <.alert
          :if={@installation && @installation.last_error}
          status="error"
          type="secondary"
          size="small"
          title={@installation.last_error}
        />

        <div data-part="fields">
          <.text_input
            id="buildkite-organization-slug"
            name="organization_slug"
            label={dgettext("dashboard_runners", "Organization slug")}
            value={(@installation && @installation.organization_slug) || ""}
            placeholder={dgettext("dashboard_runners", ~s(e.g. "acme"))}
            error={@field_errors["organization_slug"]}
            required
            show_required
          />

          <.text_input
            id="buildkite-cluster-name"
            name="cluster_name"
            label={dgettext("dashboard_runners", "Cluster name")}
            value={(@installation && @installation.cluster_name) || ""}
            placeholder={dgettext("dashboard_runners", ~s(e.g. "macOS"))}
            hint={
              dgettext(
                "dashboard_runners",
                "Optional. Only used to label this connection in the dashboard."
              )
            }
            error={@field_errors["cluster_name"]}
          />

          <.text_input
            id="buildkite-agent-token"
            name="agent_token"
            type="password"
            input_type="password"
            label={dgettext("dashboard_runners", "Cluster agent token")}
            placeholder="bkct_..."
            hint={
              dgettext(
                "dashboard_runners",
                "Create it under your cluster's Agent Tokens in Buildkite. It is stored encrypted and never shown again."
              )
            }
            error={@field_errors["agent_token"]}
            required
            show_required
          />
        </div>

        <.button
          label={
            if @installation,
              do: dgettext("dashboard_runners", "Update connection"),
              else: dgettext("dashboard_runners", "Connect")
          }
          variant="primary"
          size="medium"
          type="submit"
        />
      </form>

      <div :if={@installation} data-part="status">
        <div data-part="status-row">
          <span data-part="status-label">{dgettext("dashboard_runners", "Last checked")}</span>
          <span data-part="status-value">
            {if @installation.last_polled_at,
              do: Tuist.Utilities.DateFormatter.from_now(@installation.last_polled_at),
              else: dgettext("dashboard_runners", "Not yet")}
          </span>
        </div>

        <.button
          label={dgettext("dashboard_runners", "Disconnect")}
          variant="destructive"
          size="medium"
          phx-click="disconnect"
        />
      </div>

      <div data-part="queues">
        <span data-part="queues-hint">
          {dgettext(
            "dashboard_runners",
            "Tuist runs a Buildkite job when its queue key matches one of your runner profiles. Create a self-hosted queue in your cluster with one of these keys, then target it with agents: { queue: ... } in your pipeline."
          )}
        </span>

        <ul data-part="buildkite-queue-list">
          <li :for={queue_key <- @queue_keys}>
            <code>{queue_key}</code>
          </li>
        </ul>
      </div>
    </div>
  </.card_section>
</div>
