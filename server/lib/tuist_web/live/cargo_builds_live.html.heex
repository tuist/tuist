<div id="builds" data-build-system="cargo">
  <div data-part="filters">
    <.build_filter
      id="cargo-builds-rust-version"
      label={dgettext("dashboard_builds", "Rust version:")}
      key="analytics-rust-version"
      choices={
        if @cargo_build_options.ok?, do: @cargo_build_options.result.rust_version, else: []
      }
      uri={@uri}
      value={@current_params["analytics-rust-version"] || "any"}
    />
    <.dropdown
      id="cargo-builds-environment"
      label={environment_label(@analytics_environment)}
      secondary_text={dgettext("dashboard_builds", "Environment:")}
    >
      <.dropdown_item
        :for={value <- ["any", "ci", "local"]}
        value={value}
        label={environment_label(value)}
        patch={"?#{Query.put(@uri.query, "analytics-environment", value)}"}
        data-selected={@analytics_environment == value}
      >
        <:right_icon :if={@analytics_environment == value}><.check /></:right_icon>
      </.dropdown_item>
    </.dropdown>
    <.date_picker
      id="cargo-builds-date-range-picker"
      name="analytics-date-range"
      selected_preset={@analytics_preset}
      period={@analytics_period}
      on_period_change="analytics_period_changed"
      max={Date.utc_today()}
      presets={[
        %{
          id: "last-24-hours",
          label: dgettext("dashboard_builds", "Last 24 hours"),
          period: {24, :hour}
        },
        %{
          id: "last-7-days",
          label: dgettext("dashboard_builds", "Last 7 days"),
          period: {7, :day}
        },
        %{
          id: "last-30-days",
          label: dgettext("dashboard_builds", "Last 30 days"),
          period: {30, :day}
        },
        %{
          id: "last-12-months",
          label: dgettext("dashboard_builds", "Last 12 months"),
          period: {12, :month}
        },
        %{id: "custom", label: dgettext("dashboard_builds", "Custom")}
      ]}
    >
      <:actions>
        <.button
          label={dgettext("dashboard_builds", "Cancel")}
          variant="secondary"
          phx-click={
            JS.dispatch("phx:date-picker-cancel", detail: %{id: "cargo-builds-date-range-picker"})
          }
        />
        <.button
          label={dgettext("dashboard_builds", "Apply")}
          phx-click={
            JS.dispatch("phx:date-picker-apply", detail: %{id: "cargo-builds-date-range-picker"})
          }
        />
      </:actions>
    </.date_picker>
  </div>
  <.async_card
    :let={ready?}
    results={[@cargo_build_analytics]}
    title={dgettext("dashboard_builds", "Builds")}
    icon="chart_arcs"
    data-part="analytics-card"
  >
    <div data-part="widgets">
      <.widget
        id="widget-total-builds"
        title={dgettext("dashboard_builds", "Total builds")}
        legend_color="primary"
        description={dgettext("dashboard_builds", "The total number of builds.")}
        loading={!ready?}
        value={if ready?, do: format_number(@cargo_build_analytics.result.total.count)}
        phx_click="select_widget"
        phx_value_widget="total-builds"
        selected={@analytics_selected_widget == "total-builds"}
        trend_value={if ready?, do: @cargo_build_analytics.result.total.trend}
        trend_type={:neutral}
        trend_label={@analytics_trend_label}
        empty={ready? && @cargo_build_analytics.result.total.count == 0}
      />
      <.widget
        id="widget-build-success-rate"
        title={dgettext("dashboard_builds", "Build success rate")}
        legend_color="primary"
        description={dgettext("dashboard_builds", "The percentage of builds that succeeded.")}
        loading={!ready?}
        value={
          if ready?,
            do: "#{Float.round(@cargo_build_analytics.result.success.success_rate * 100, 1)}%"
        }
        phx_click="select_widget"
        phx_value_widget="build-success-rate"
        selected={@analytics_selected_widget == "build-success-rate"}
        trend_value={if ready?, do: @cargo_build_analytics.result.success.trend}
        trend_label={@analytics_trend_label}
        empty={ready? && @cargo_build_analytics.result.total.count == 0}
      />
      <.widget
        id="widget-failed-builds"
        title={dgettext("dashboard_builds", "Failed builds")}
        legend_color="destructive"
        description={dgettext("dashboard_builds", "The number of builds that failed.")}
        loading={!ready?}
        value={if ready?, do: format_number(@cargo_build_analytics.result.failed.count)}
        phx_click="select_widget"
        phx_value_widget="failed-builds"
        selected={@analytics_selected_widget == "failed-builds"}
        trend_value={if ready?, do: @cargo_build_analytics.result.failed.trend}
        trend_type={:inverse}
        trend_label={@analytics_trend_label}
        empty={ready? && @cargo_build_analytics.result.failed.count == 0}
      />
      <.percentile_dropdown_widget
        id="widget-build-duration"
        title={
          case @selected_build_duration_type do
            "p50" -> dgettext("dashboard_builds", "p50 build duration")
            "p90" -> dgettext("dashboard_builds", "p90 build duration")
            "p99" -> dgettext("dashboard_builds", "p99 build duration")
            _ -> dgettext("dashboard_builds", "Avg. build duration")
          end
        }
        legend_color={
          if @selected_build_duration_type == "avg",
            do: "secondary",
            else: @selected_build_duration_type
        }
        description={
          dgettext(
            "dashboard_builds",
            "The average build duration with individual percentile intervals."
          )
        }
        loading={!ready?}
        value={
          if ready?,
            do:
              DateFormatter.format_duration_from_milliseconds(
                duration_metric(@cargo_build_analytics.result, @selected_build_duration_type).value
              )
        }
        metrics={
          if ready?,
            do:
              Map.new(
                [:avg, :p50, :p90, :p99],
                &{&1,
                 DateFormatter.format_duration_from_milliseconds(
                   duration_metric(@cargo_build_analytics.result, to_string(&1)).value
                 )}
              )
        }
        selected_type={@selected_build_duration_type}
        event_name="select_build_duration_type"
        phx_click="select_widget"
        phx_value_widget="build-duration"
        selected={@analytics_selected_widget == "build-duration"}
        trend_value={
          if ready?,
            do:
              duration_metric(@cargo_build_analytics.result, @selected_build_duration_type).trend
        }
        trend_type={:inverse}
        trend_label={@analytics_trend_label}
        empty={ready? && @cargo_build_analytics.result.total.count == 0}
      />
    </div>
    <.card_section :if={!ready?} data-chart-frame="standard"><.skeleton_chart /></.card_section>
    <.card_section
      :if={ready? && @cargo_build_analytics.result.total.count > 0}
      data-part="analytics-card-chart-section"
      data-chart-frame="standard"
    >
      <%= if @analytics_selected_widget == "build-duration" do %>
        <.chart_type_toggle
          id="cargo-build-duration"
          chart_type={@build_duration_chart_type}
          chart_type_event="select_build_duration_chart_type"
          group_by_options={[
            %{value: "environment", label: dgettext("dashboard_builds", "Environment")},
            %{value: "rust-version", label: dgettext("dashboard_builds", "Rust version")}
          ]}
          selected_group_by={@build_duration_scatter_group_by}
          group_by_query_param="build-duration-scatter-group-by"
          uri={@uri}
        />
        <.chart
          :if={@build_duration_chart_type == "line"}
          id="cargo-average-build-time-chart"
          type="line"
          extra_options={
            chart_options(@cargo_build_analytics.result.duration.dates, "fn:formatSeconds", true)
          }
          series={duration_series(@cargo_build_analytics.result)}
          y_axis_min={0}
        />
        <.skeleton_chart :if={
          @build_duration_chart_type == "scatter" && !@cargo_build_scatter.ok? &&
            !@cargo_build_scatter.failed
        } />
        <.scatter_chart
          :if={@build_duration_chart_type == "scatter"}
          id="cargo-build-duration-scatter-chart"
          chart={@cargo_build_scatter}
          period={@analytics_period}
          value_format="fn:formatSeconds"
          url_fn={
            fn point ->
              ~p"/#{@selected_account.name}/#{@selected_project.name}/builds/cargo-builds/#{point.id}"
            end
          }
          truncation_title={
            dgettext(
              "dashboard_builds",
              "Only the 10,000 most recent builds are shown. Narrow the date range or filters to see the full dataset."
            )
          }
        />
      <% else %>
        <% chart = count_chart(@cargo_build_analytics.result, @analytics_selected_widget) %>
        <.chart
          id="cargo-builds-analytics-chart"
          type="line"
          extra_options={
            chart_options(@cargo_build_analytics.result.total.dates, chart.formatter)
          }
          series={[
            %{
              name: chart.name,
              data: Enum.map(chart.data, &Tuple.to_list/1),
              type: "line",
              color: "var:noora-chart-#{chart.color}",
              smooth: 0.1,
              symbol: "none"
            }
          ]}
          y_axis_min={0}
          y_axis_max={if @analytics_selected_widget == "build-success-rate", do: 100}
        />
      <% end %>
    </.card_section>
    <.empty_card_section
      :if={ready? && @cargo_build_analytics.result.total.count == 0}
      title={dgettext("dashboard_builds", "No data yet")}
      get_started_href="https://tuist.dev/en/docs/guides/get-started/rust-project"
    >
      <:image>
        <img src={~p"/images/empty_line_chart_light.png"} data-theme="light" /><img
          src={~p"/images/empty_line_chart_dark.png"}
          data-theme="dark"
        />
      </:image>
    </.empty_card_section>
  </.async_card>
  <.async_card
    :let={ready?}
    results={[@cargo_build_configuration]}
    title={dgettext("dashboard_builds", "Configuration Insights")}
    icon="device_laptop"
    data-part="configuration-insights-card"
  >
    <:actions>
      <.dropdown
        id="cargo-configuration-insights-type-dropdown"
        label={
          case @configuration_insights_type do
            "environment" -> dgettext("dashboard_builds", "Environment")
            _ -> dgettext("dashboard_builds", "Rust version")
          end
        }
        secondary_text={dgettext("dashboard_builds", "Type:")}
      >
        <.dropdown_item
          :for={
            {value, label} <- [
              {"rust-version", dgettext("dashboard_builds", "Rust version")},
              {"environment", dgettext("dashboard_builds", "Environment")}
            ]
          }
          value={value}
          label={label}
          patch={"?#{Query.put(@uri.query, "configuration-insights-type", value)}"}
          data-selected={@configuration_insights_type == value}
        >
          <:right_icon :if={@configuration_insights_type == value}><.check /></:right_icon>
        </.dropdown_item>
      </.dropdown>
    </:actions>
    <.card_section :if={!ready?}><.skeleton_legend /><.skeleton_chart /></.card_section>
    <.card_section
      :if={ready? && @cargo_build_configuration.result != []}
      data-part="configuration-insights-card-chart-section"
    >
      <.legend title={dgettext("dashboard_builds", "Build duration")} style="secondary" />
      <.chart
        id="cargo-configuration-insights-chart"
        type="bar"
        style={"height: #{max(60, length(@cargo_build_configuration.result) * 28)}px"}
        extra_options={
          %{
            legend: %{show: false},
            grid: %{left: 0, right: 20, top: 0, bottom: 25, containLabel: true},
            xAxis: %{type: "value", axisLabel: %{formatter: "fn:formatMilliseconds"}},
            yAxis: %{
              type: "category",
              data: Enum.map(@cargo_build_configuration.result, &category_label(&1.category))
            },
            tooltip: %{valueFormat: "fn:formatMilliseconds"}
          }
        }
        series={[
          %{
            data: Enum.map(@cargo_build_configuration.result, & &1.value),
            name: dgettext("dashboard_builds", "Build duration"),
            type: "bar",
            color: "var:noora-chart-secondary"
          }
        ]}
        bar_width={8}
        bar_radius={2}
        x_axis_min={0}
      />
    </.card_section>
    <.empty_card_section
      :if={ready? && @cargo_build_configuration.result == []}
      title={dgettext("dashboard_builds", "No data yet")}
    >
      <:image>
        <img src={~p"/images/empty_horizontal_bar_chart_light.png"} data-theme="light" />
        <img src={~p"/images/empty_horizontal_bar_chart_dark.png"} data-theme="dark" />
      </:image>
    </.empty_card_section>
  </.async_card>
  <.async_card
    :let={ready?}
    results={[@cargo_recent_builds]}
    title={dgettext("dashboard_builds", "Recent Builds")}
    icon="dashboard"
    data-part="recent-builds-card"
  >
    <:actions>
      <.button
        variant="secondary"
        label={dgettext("dashboard_builds", "View more")}
        size="medium"
        navigate={~p"/#{@selected_account.name}/#{@selected_project.name}/builds/build-runs"}
      />
    </:actions>
    <.card_section :if={!ready?}><.skeleton_chart /></.card_section>
    <.card_section
      :if={ready? && @cargo_recent_builds.result != []}
      data-part="recent-builds-card-section"
    >
      <div data-part="builds-chart">
        <div data-part="legends">
          <.legend
            title={dgettext("dashboard_builds", "Successful builds")}
            value={Enum.count(@cargo_recent_builds.result, &(&1.status == "success"))}
            style="primary"
          />
          <.legend
            title={dgettext("dashboard_builds", "Failed builds")}
            value={Enum.count(@cargo_recent_builds.result, &(&1.status == "failure"))}
            style="destructive"
          />
        </div>
        <.chart
          id="cargo-recent-builds-chart"
          type="bar"
          extra_options={
            %{
              legend: %{show: false},
              grid: %{left: "0.4%", right: "7%", height: "88%", top: "5%"},
              tooltip: %{valueFormat: "fn:formatMilliseconds", dateFormat: "minute"},
              xAxis: %{
                axisLabel: %{show: false},
                data: @cargo_recent_builds.result |> Enum.reverse() |> Enum.map(& &1.inserted_at)
              },
              yAxis: %{axisLabel: %{formatter: "fn:formatMilliseconds"}}
            }
          }
          series={[
            %{
              data:
                recent_points(@cargo_recent_builds.result, @selected_account, @selected_project),
              name: dgettext("dashboard_builds", "Build"),
              type: "bar"
            }
          ]}
          y_axis_min={0}
          bar_width={8}
          bar_radius={2}
        />
      </div>
      <.table
        id="cargo-recent-builds-table"
        rows={Enum.take(@cargo_recent_builds.result, 7)}
        row_navigate={
          fn build ->
            url(
              ~p"/#{@selected_account.name}/#{@selected_project.name}/builds/cargo-builds/#{build.id}"
            )
          end
        }
      >
        <:col :let={build} label={dgettext("dashboard_builds", "Command")}>
          <.text_cell label={"cargo #{build.command}"} />
        </:col>
        <:col :let={build} label={dgettext("dashboard_builds", "Status")}>
          <.status_badge_cell
            label={
              if build.status == "success",
                do: dgettext("dashboard_builds", "Passed"),
                else: dgettext("dashboard_builds", "Failed")
            }
            status={if build.status == "success", do: "success", else: "error"}
          />
        </:col>
        <:col :let={build} label={dgettext("dashboard_builds", "Ran by")}>
          <.run_ran_by_badge_cell
            run={build}
            ran_by_name={build.ran_by_account && build.ran_by_account.name}
          />
        </:col>
        <:col :let={build} label={dgettext("dashboard_builds", "Duration")}>
          <.text_cell
            label={DateFormatter.format_duration_from_milliseconds(build.duration_ms)}
            icon="history"
          />
        </:col>
        <:col :let={build} label={dgettext("dashboard_builds", "Ran at")}>
          <.text_cell sublabel={DateFormatter.from_now(build.inserted_at)} />
        </:col>
      </.table>
    </.card_section>
    <.empty_card_section
      :if={ready? && @cargo_recent_builds.result == []}
      title={dgettext("dashboard_builds", "No data yet")}
      get_started_href="https://tuist.dev/en/docs/guides/get-started/rust-project"
    >
      <:image>
        <img src={~p"/images/empty_bar_chart_light.png"} data-theme="light" />
        <img src={~p"/images/empty_bar_chart_dark.png"} data-theme="dark" />
      </:image>
    </.empty_card_section>
  </.async_card>
</div>
