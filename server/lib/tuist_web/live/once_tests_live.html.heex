<div id="tests">
  <div data-part="filters">
    <.date_picker
      id="tests-analytics-date-range-picker"
      name="analytics-date-range"
      presets={[
        %{
          id: "last-24-hours",
          label: dgettext("dashboard_tests", "Last 24 hours"),
          period: {24, :hour}
        },
        %{
          id: "last-7-days",
          label: dgettext("dashboard_tests", "Last 7 days"),
          period: {7, :day}
        },
        %{
          id: "last-30-days",
          label: dgettext("dashboard_tests", "Last 30 days"),
          period: {30, :day}
        },
        %{
          id: "last-12-months",
          label: dgettext("dashboard_tests", "Last 12 months"),
          period: {12, :month}
        },
        %{id: "custom", label: dgettext("dashboard_tests", "Custom")}
      ]}
      selected_preset={@analytics_preset}
      period={@analytics_period}
      on_period_change="analytics_period_changed"
      max={Date.utc_today()}
    >
      <:actions>
        <.button
          label={dgettext("dashboard_tests", "Cancel")}
          variant="secondary"
          phx-click={
            JS.dispatch("phx:date-picker-cancel",
              detail: %{id: "tests-analytics-date-range-picker"}
            )
          }
        />
        <.button
          label={dgettext("dashboard_tests", "Apply")}
          phx-click={
            JS.dispatch("phx:date-picker-apply",
              detail: %{id: "tests-analytics-date-range-picker"}
            )
          }
        />
      </:actions>
    </.date_picker>
  </div>

  <.card title={dgettext("dashboard_tests", "Analytics")} icon="chart_arcs" data-part="analytics">
    <div data-part="widgets">
      <.widget
        title={dgettext("dashboard_tests", "Test runs")}
        legend_color="primary"
        description={dgettext("dashboard_tests", "The total number of test runs.")}
        value={if @test_runs_analytics.ok?, do: @test_runs_analytics.result.count}
        loading={!@test_runs_analytics.ok?}
        id="widget-test-runs"
        phx_click="select_widget"
        phx_value_widget="test_run_count"
        selected={@analytics_selected_widget == "test_run_count"}
        trend_value={if @test_runs_analytics.ok?, do: @test_runs_analytics.result.trend}
        trend_type={:neutral}
        trend_label={@analytics_trend_label}
        empty={@test_runs_analytics.ok? && @test_runs_analytics.result.count == 0}
      />
      <.widget
        title={dgettext("dashboard_tests", "Flaky test runs")}
        legend_color="flaky"
        description={dgettext("dashboard_tests", "The number of test runs with flaky tests.")}
        value={if @flaky_test_runs_analytics.ok?, do: @flaky_test_runs_analytics.result.count}
        loading={!@flaky_test_runs_analytics.ok?}
        id="widget-flaky-test-runs"
        phx_click="select_widget"
        phx_value_widget="flaky_test_run_count"
        selected={@analytics_selected_widget == "flaky_test_run_count"}
        trend_value={
          if @flaky_test_runs_analytics.ok?, do: @flaky_test_runs_analytics.result.trend
        }
        trend_type={:inverse}
        trend_label={@analytics_trend_label}
        empty={@flaky_test_runs_analytics.ok? && @flaky_test_runs_analytics.result.count == 0}
      />
      <.widget
        title={dgettext("dashboard_tests", "Failed test runs")}
        legend_color="destructive"
        description={dgettext("dashboard_tests", "The number of test runs that failed.")}
        value={if @failed_test_runs_analytics.ok?, do: @failed_test_runs_analytics.result.count}
        loading={!@failed_test_runs_analytics.ok?}
        id="widget-failed-test-runs"
        phx_click="select_widget"
        phx_value_widget="failed_test_run_count"
        selected={@analytics_selected_widget == "failed_test_run_count"}
        trend_value={
          if @failed_test_runs_analytics.ok?, do: @failed_test_runs_analytics.result.trend
        }
        trend_type={:inverse}
        trend_label={@analytics_trend_label}
        empty={@failed_test_runs_analytics.ok? && @failed_test_runs_analytics.result.count == 0}
      />
      <.percentile_dropdown_widget
        loading={!@test_runs_duration_analytics.ok?}
        id="widget-test-run-duration"
        title={duration_title(@selected_duration_type)}
        legend_color={duration_legend_color(@selected_duration_type)}
        description={
          dgettext(
            "dashboard_tests",
            "The average test run duration with individual percentile intervals."
          )
        }
        value={
          if @test_runs_duration_analytics.ok? do
            Tuist.Utilities.DateFormatter.format_duration_from_milliseconds(
              duration_value(@test_runs_duration_analytics.result, @selected_duration_type)
            )
          end
        }
        metrics={
          if @test_runs_duration_analytics.ok?,
            do: duration_metrics(@test_runs_duration_analytics.result)
        }
        selected_type={@selected_duration_type}
        event_name="select_duration_type"
        phx_click="select_widget"
        phx_value_widget="test_run_duration"
        selected={@analytics_selected_widget == "test_run_duration"}
        trend_value={
          if @test_runs_duration_analytics.ok?, do: @test_runs_duration_analytics.result.trend
        }
        trend_type={:inverse}
        trend_label={@analytics_trend_label}
        empty={
          @test_runs_duration_analytics.ok? &&
            @test_runs_duration_analytics.result.total_average_duration == 0
        }
      />
    </div>
    <.card_section :if={!@test_runs_analytics.ok?} data-part="analytics-card-chart-section">
      <.skeleton_chart />
    </.card_section>
    <.card_section
      :if={
        @test_runs_analytics.ok? and
          ((@analytics_selected_widget == "test_run_duration" and
              @test_runs_duration_analytics.result.total_average_duration != 0) or
             (@analytics_selected_widget == "test_run_count" and
                @test_runs_analytics.result.count != 0) or
             (@analytics_selected_widget == "failed_test_run_count" and
                @failed_test_runs_analytics.result.count != 0))
      }
      data-part="analytics-card-chart-section"
    >
      <.chart
        :if={@analytics_selected_widget == "test_run_duration"}
        id="test-run-duration-chart"
        type="line"
        extra_options={
          %{
            legend: %{
              left: "left",
              top: "bottom",
              orient: "horizontal",
              textStyle: %{
                color: "var:noora-surface-label-secondary",
                fontFamily: "monospace",
                fontWeight: 400,
                fontSize: 10,
                lineHeight: 12
              },
              icon:
                "path://M0 6C0 4.89543 0.895431 4 2 4H6C7.10457 4 8 4.89543 8 6C8 7.10457 7.10457 8 6 8H2C0.895431 8 0 7.10457 0 6Z",
              itemWidth: 8,
              itemHeight: 4
            },
            grid: %{width: "97%", left: "0.4%", height: "60%", top: "10%"},
            xAxis: %{
              boundaryGap: false,
              type: "category",
              axisLabel: %{
                color: "var:noora-surface-label-secondary",
                formatter: "fn:toLocaleDate",
                customValues: [
                  @analytics_chart_data.result.dates |> List.first(),
                  @analytics_chart_data.result.dates |> List.last()
                ],
                padding: [10, 0, 0, 0]
              }
            },
            yAxis: %{
              splitNumber: 4,
              splitLine: %{lineStyle: %{color: "var:noora-chart-lines"}},
              axisLabel: %{
                color: "var:noora-surface-label-secondary",
                formatter: "fn:formatMilliseconds"
              }
            },
            tooltip:
              if @analytics_preset == "last-24-hours" do
                %{valueFormat: "fn:formatMilliseconds", dateFormat: "hour"}
              else
                %{valueFormat: "fn:formatMilliseconds"}
              end
          }
        }
        series={[
          %{
            color: "var:noora-chart-secondary",
            data:
              Enum.zip(
                @test_runs_duration_analytics.result.dates,
                @test_runs_duration_analytics.result.values
              )
              |> Enum.map(&Tuple.to_list/1),
            name: dgettext("dashboard_tests", "Average"),
            type: "line",
            smooth: 0.1,
            symbol: "none"
          },
          %{
            color: "var:noora-chart-p99",
            data:
              Enum.zip(
                @test_runs_duration_analytics.result.dates,
                @test_runs_duration_analytics.result.p99_values
              )
              |> Enum.map(&Tuple.to_list/1),
            name: dgettext("dashboard_tests", "p99"),
            type: "line",
            smooth: 0.1,
            symbol: "none"
          },
          %{
            color: "var:noora-chart-p90",
            data:
              Enum.zip(
                @test_runs_duration_analytics.result.dates,
                @test_runs_duration_analytics.result.p90_values
              )
              |> Enum.map(&Tuple.to_list/1),
            name: dgettext("dashboard_tests", "p90"),
            type: "line",
            smooth: 0.1,
            symbol: "none"
          },
          %{
            color: "var:noora-chart-p50",
            data:
              Enum.zip(
                @test_runs_duration_analytics.result.dates,
                @test_runs_duration_analytics.result.p50_values
              )
              |> Enum.map(&Tuple.to_list/1),
            name: dgettext("dashboard_tests", "p50"),
            type: "line",
            smooth: 0.1,
            symbol: "none"
          }
        ]}
        y_axis_min={0}
      />
      <.chart
        :if={@analytics_selected_widget == "test_run_count"}
        id="test-run-count-chart"
        type="line"
        extra_options={
          %{
            grid: %{width: "97%", left: "0.4%", height: "88%", top: "5%"},
            xAxis: %{
              boundaryGap: false,
              type: "category",
              axisLabel: %{
                color: "var:noora-surface-label-secondary",
                formatter: "fn:toLocaleDate",
                customValues: [
                  @analytics_chart_data.result.dates |> List.first(),
                  @analytics_chart_data.result.dates |> List.last()
                ],
                padding: [10, 0, 0, 0]
              }
            },
            yAxis: %{
              splitNumber: 4,
              splitLine: %{lineStyle: %{color: "var:noora-chart-lines"}},
              axisLabel: %{color: "var:noora-surface-label-secondary"}
            },
            legend: %{show: false},
            tooltip:
              if @analytics_preset == "last-24-hours" do
                %{dateFormat: "hour"}
              else
                %{}
              end
          }
        }
        series={[
          %{
            color: "var:noora-chart-primary",
            data:
              Enum.zip(
                @analytics_chart_data.result.dates,
                @analytics_chart_data.result.values
              )
              |> Enum.map(&Tuple.to_list/1),
            name: dgettext("dashboard_tests", "Test runs"),
            type: "line",
            smooth: 0.1,
            symbol: "none"
          }
        ]}
        y_axis_min={0}
      />
      <.chart
        :if={@analytics_selected_widget == "failed_test_run_count"}
        id="failed-test-run-count-chart"
        type="line"
        extra_options={
          %{
            grid: %{width: "97%", left: "0.4%", height: "88%", top: "5%"},
            xAxis: %{
              boundaryGap: false,
              type: "category",
              axisLabel: %{
                color: "var:noora-surface-label-secondary",
                formatter: "fn:toLocaleDate",
                customValues: [
                  @analytics_chart_data.result.dates |> List.first(),
                  @analytics_chart_data.result.dates |> List.last()
                ],
                padding: [10, 0, 0, 0]
              }
            },
            yAxis: %{
              splitNumber: 4,
              splitLine: %{lineStyle: %{color: "var:noora-chart-lines"}},
              axisLabel: %{color: "var:noora-surface-label-secondary"}
            },
            legend: %{show: false},
            tooltip:
              if @analytics_preset == "last-24-hours" do
                %{dateFormat: "hour"}
              else
                %{}
              end
          }
        }
        series={[
          %{
            color: "var:noora-chart-destructive",
            data:
              Enum.zip(
                @analytics_chart_data.result.dates,
                @analytics_chart_data.result.values
              )
              |> Enum.map(&Tuple.to_list/1),
            name: dgettext("dashboard_tests", "Failed test runs"),
            type: "line",
            smooth: 0.1,
            symbol: "none"
          }
        ]}
        y_axis_min={0}
      />
    </.card_section>
    <.empty_card_section
      :if={
        @test_runs_analytics.ok? &&
          @test_runs_analytics.result.count == 0
      }
      title={dgettext("dashboard_tests", "No data yet")}
    >
      <:image>
        <img
          src={~p"/images/empty_line_chart_light.png"}
          data-theme="light"
          loading="lazy"
          decoding="async"
        />
        <img
          src={~p"/images/empty_line_chart_dark.png"}
          data-theme="dark"
          loading="lazy"
          decoding="async"
        />
      </:image>
    </.empty_card_section>
  </.card>

  <.card
    title={dgettext("dashboard_tests", "Recent Test Runs")}
    icon="dashboard"
    data-part="recent-test-runs"
  >
    <:actions>
      <.button
        variant="secondary"
        label={dgettext("dashboard_tests", "View more")}
        size="medium"
        navigate={test_runs_list_path(assigns)}
        disabled={!@recent_test_runs.ok? || Enum.empty?(@recent_test_runs.result)}
      />
    </:actions>
    <.card_section :if={!@recent_test_runs.ok?} data-part="recent-test-runs-section">
      <div data-part="test-runs-chart">
        <div data-part="legends">
          <.skeleton_legend />
          <.skeleton_legend />
        </div>
        <.skeleton_chart />
      </div>
    </.card_section>
    <.card_section
      :if={@recent_test_runs.ok? && not Enum.empty?(@recent_test_runs.result)}
      data-part="recent-test-runs-section"
    >
      <div data-part="test-runs-chart">
        <div data-part="legends">
          <.legend
            title={dgettext("dashboard_tests", "Passed runs")}
            value={@passed_test_runs_count.result}
            style="primary"
          />
          <.legend
            title={dgettext("dashboard_tests", "Failed runs")}
            value={@failed_test_runs_count.result}
            style="destructive"
          />
        </div>
        <.chart
          id="recent-test-runs-chart"
          type="bar"
          extra_options={
            %{
              grid: %{width: "98%", left: "0.4%", right: "7%", height: "88%", top: "5%"},
              tooltip: %{valueFormat: "fn:formatSeconds", dateFormat: "minute"},
              xAxis: %{
                axisLabel: %{show: false},
                data: @recent_test_runs_chart_data.result |> Enum.map(& &1.date)
              },
              yAxis: %{
                splitLine: %{lineStyle: %{color: "var:noora-chart-lines"}},
                axisLabel: %{
                  color: "var:noora-surface-label-secondary",
                  formatter: "fn:formatSeconds"
                }
              },
              legend: %{show: false}
            }
          }
          series={[
            %{
              data: @recent_test_runs_chart_data.result,
              name: "Test Run",
              type: "bar"
            }
          ]}
          y_axis_min={0}
          grid_lines
          bar_width={8}
          bar_radius={2}
        />
      </div>
      <.table
        id="recent-test-runs-table"
        rows={@recent_test_runs.result |> Enum.reverse() |> Enum.take(7)}
        row_navigate={fn run -> run_detail_path(assigns, run) end}
      >
        <:col :let={run} label={dgettext("dashboard_tests", "Run")}>
          <.text_and_description_cell label={run.command || run.invocation_id} />
        </:col>
        <:col :let={run} label={dgettext("dashboard_tests", "Status")}>
          <.status_badge_cell
            :if={run.status == "success"}
            label={dgettext("dashboard_tests", "Passed")}
            status="success"
          />
          <.status_badge_cell
            :if={run.status == "failure"}
            label={dgettext("dashboard_tests", "Failed")}
            status="error"
          />
          <.status_badge_cell
            :if={run.status not in ["success", "failure"]}
            label={dgettext("dashboard_tests", "Running")}
            status="in_progress"
          />
        </:col>
        <:col :let={run} label={dgettext("dashboard_tests", "Duration")}>
          <.text_cell
            icon="history"
            label={
              Tuist.Utilities.DateFormatter.format_duration_from_milliseconds(
                run.duration_ms || 0
              )
            }
          />
        </:col>
        <:col :let={run} label={dgettext("dashboard_tests", "Ran at")}>
          <.text_cell sublabel={
            if run.finished_at,
              do: Tuist.Utilities.DateFormatter.from_now(run.finished_at),
              else: "—"
          } />
        </:col>
      </.table>
    </.card_section>
    <.empty_card_section
      :if={@recent_test_runs.ok? && Enum.empty?(@recent_test_runs.result)}
      title={dgettext("dashboard_tests", "No data yet")}
    >
      <:image>
        <img
          src={~p"/images/empty_bar_chart_light.png"}
          data-theme="light"
          loading="lazy"
          decoding="async"
        />
        <img
          src={~p"/images/empty_bar_chart_dark.png"}
          data-theme="dark"
          loading="lazy"
          decoding="async"
        />
      </:image>
    </.empty_card_section>
  </.card>
</div>
