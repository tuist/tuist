<div id="test-case">
  <.button
    label={dgettext("dashboard_tests", "Test Cases")}
    data-part="back-button"
    variant="secondary"
    size="medium"
    navigate={~p"/#{@selected_project.account.name}/#{@selected_project.name}/tests/test-cases"}
  >
    <:icon_left>
      <.icon name="arrow_left" />
    </:icon_left>
  </.button>

  <div data-part="header">
    <div data-part="title-group">
      <div data-part="title">
        <div :if={@test_case_detail.last_status == "success"} data-part="badge-success">
          <div data-part="icon">
            <.circle_check />
          </div>
        </div>
        <div :if={@test_case_detail.last_status == "failure"} data-part="badge-failure">
          <div data-part="icon">
            <.alert_circle />
          </div>
        </div>
        <div :if={@test_case_detail.last_status == "skipped"} data-part="badge-skipped">
          <div data-part="icon">
            <.alert_circle />
          </div>
        </div>
        <h1 data-part="label">
          {@test_case_detail.name}
        </h1>
      </div>
      <div
        :if={@test_case_detail.module_name != "" or @test_case_detail.suite_name != ""}
        data-part="badges"
      >
        <.badge
          :if={@test_case_detail.module_name != ""}
          label={"#{module_label(@selected_project)}: #{@test_case_detail.module_name}"}
          color="primary"
          style="light-fill"
          size="large"
        />
        <.badge
          :if={@test_case_detail.suite_name != ""}
          label={"#{suite_label(@selected_project)}: #{@test_case_detail.suite_name}"}
          color="primary"
          style="light-fill"
          size="large"
        />
      </div>
    </div>
    <div data-part="actions">
      <.dropdown
        id="test-case-state-dropdown"
        label={state_label(@test_case_detail.state || "enabled")}
      >
        <:icon>
          <.icon name={state_icon(@test_case_detail.state || "enabled")} />
        </:icon>
        <.dropdown_item
          value="enabled"
          label={dgettext("dashboard_tests", "Enabled")}
          on_click="set-state"
          data-selected={(@test_case_detail.state || "enabled") == "enabled"}
        >
          <:left_icon><.icon name="player_play" /></:left_icon>
          <:right_icon><.check /></:right_icon>
        </.dropdown_item>
        <.dropdown_item
          value="muted"
          label={dgettext("dashboard_tests", "Muted")}
          on_click="set-state"
          data-selected={(@test_case_detail.state || "enabled") == "muted"}
        >
          <:left_icon><.icon name="volume_3" /></:left_icon>
          <:right_icon><.check /></:right_icon>
        </.dropdown_item>
        <.dropdown_item
          value="skipped"
          label={dgettext("dashboard_tests", "Skipped")}
          on_click="set-state"
          data-selected={(@test_case_detail.state || "enabled") == "skipped"}
        >
          <:left_icon><.icon name="player_track_next" /></:left_icon>
          <:right_icon><.check /></:right_icon>
        </.dropdown_item>
      </.dropdown>
      <.button
        :if={@test_case_detail.is_flaky}
        label={dgettext("dashboard_tests", "Unmark as flaky")}
        variant="secondary"
        size="medium"
        phx-click="unmark-as-flaky"
      >
        <:icon_left>
          <.icon name="alert_triangle_off" />
        </:icon_left>
      </.button>
      <.button
        :if={!@test_case_detail.is_flaky}
        label={dgettext("dashboard_tests", "Mark as flaky")}
        variant="secondary"
        size="medium"
        phx-click="mark-as-flaky"
      >
        <:icon_left>
          <.icon name="alert_triangle" />
        </:icon_left>
      </.button>
    </div>
  </div>

  <.tab_menu_horizontal>
    <.tab_menu_horizontal_item
      label={dgettext("dashboard_tests", "Overview")}
      selected={@selected_tab == "overview"}
      patch={"?#{Query.put(@uri.query, "tab", "overview")}"}
      replace={true}
    />
    <.tab_menu_horizontal_item
      :if={
        @test_case_detail.is_flaky or
          (@flaky_runs_grouped.ok? and Enum.any?(@flaky_runs_grouped.result))
      }
      label={dgettext("dashboard_tests", "Flaky Runs")}
      selected={@selected_tab == "flaky-runs"}
      patch={"?#{Query.put(@uri.query, "tab", "flaky-runs")}"}
      replace={true}
    />
    <.tab_menu_horizontal_item
      label={dgettext("dashboard_tests", "Test History")}
      selected={@selected_tab == "history"}
      patch={"?#{Query.put(@uri.query, "tab", "history")}"}
      replace={true}
    />
  </.tab_menu_horizontal>

  <.card
    :if={@selected_tab == "overview"}
    title={dgettext("dashboard_tests", "Analytics")}
    icon="chart_arcs"
    data-part="analytics"
  >
    <:actions>
      <.date_picker
        id="test-case-date-range-picker"
        name="analytics-date-range"
        presets={[
          %{
            id: "last-24-hours",
            label: dgettext("dashboard_tests", "Last 24 hours"),
            period: {24, :hour}
          },
          %{
            id: "last-7-days",
            label: dgettext("dashboard_tests", "Last 7 days"),
            period: {7, :day}
          },
          %{
            id: "last-30-days",
            label: dgettext("dashboard_tests", "Last 30 days"),
            period: {30, :day}
          },
          %{
            id: "last-12-months",
            label: dgettext("dashboard_tests", "Last 12 months"),
            period: {12, :month}
          },
          %{id: "custom", label: dgettext("dashboard_tests", "Custom")}
        ]}
        selected_preset={@analytics_preset}
        period={@analytics_period}
        on_period_change="analytics_period_changed"
        max={Date.utc_today()}
      >
        <:actions>
          <.button
            label={dgettext("dashboard_tests", "Cancel")}
            variant="secondary"
            phx-click={
              JS.dispatch("phx:date-picker-cancel", detail: %{id: "test-case-date-range-picker"})
            }
          />
          <.button
            label={dgettext("dashboard_tests", "Apply")}
            phx-click={
              JS.dispatch("phx:date-picker-apply", detail: %{id: "test-case-date-range-picker"})
            }
          />
        </:actions>
      </.date_picker>
    </:actions>
    <.card_section data-part="analytics-body">
      <div data-part="analytics-main">
        <div data-part="widgets">
          <.widget
            loading={!@analytics.ok?}
            title={
              case @selected_runs_type do
                "failed" -> dgettext("dashboard_tests", "Failed test case runs")
                "flaky" -> dgettext("dashboard_tests", "Flaky test case runs")
                _ -> dgettext("dashboard_tests", "Test case runs")
              end
            }
            legend_color={
              case @selected_runs_type do
                "failed" -> "destructive"
                "flaky" -> "flaky"
                _ -> "primary"
              end
            }
            description={
              dgettext(
                "dashboard_tests",
                "Number of times this test case has been executed in the selected period."
              )
            }
            value={
              if @analytics.ok? do
                format_number(
                  case @selected_runs_type do
                    "failed" -> @analytics.result.outcome_counts.failed
                    "flaky" -> @analytics.result.outcome_counts.flaky
                    _ -> @analytics.result.total_count
                  end
                )
              end
            }
            id="widget-test-case-runs"
            phx_click="select_widget"
            phx_value_widget="test_case_runs"
            selected={@analytics_selected_widget == "test_case_runs"}
            trend_value={
              if @analytics.ok? and @previous_analytics.ok? do
                trend(
                  @previous_analytics.result,
                  runs_count(@previous_analytics.result, @selected_runs_type),
                  runs_count(@analytics.result, @selected_runs_type)
                )
              end
            }
            trend_type={if @selected_runs_type == "total", do: :neutral, else: :inverse}
            trend_label={@analytics_trend_label}
            empty={@analytics.ok? && @analytics.result.total_count == 0}
          >
            <:select>
              <.dropdown_item
                value="total"
                phx-click="select_runs_type"
                phx-value-type="total"
                data-selected={@selected_runs_type == "total"}
              >
                <div data-part="breakdown-item">
                  <div data-part="dot" data-color="primary"></div>
                  <span data-part="label">{dgettext("dashboard_tests", "All")}</span>
                  <span data-part="separator">-</span>
                  <span data-part="value">
                    {if @analytics.ok?,
                      do: format_number(@analytics.result.total_count),
                      else: dgettext("dashboard_tests", "N/A")}
                  </span>
                </div>
              </.dropdown_item>
              <.dropdown_item
                value="failed"
                phx-click="select_runs_type"
                phx-value-type="failed"
                data-selected={@selected_runs_type == "failed"}
              >
                <div data-part="breakdown-item">
                  <div data-part="dot" data-color="destructive"></div>
                  <span data-part="label">{dgettext("dashboard_tests", "Failed")}</span>
                  <span data-part="separator">-</span>
                  <span data-part="value">
                    {if @analytics.ok?,
                      do: format_number(@analytics.result.outcome_counts.failed),
                      else: dgettext("dashboard_tests", "N/A")}
                  </span>
                </div>
              </.dropdown_item>
              <.dropdown_item
                value="flaky"
                phx-click="select_runs_type"
                phx-value-type="flaky"
                data-selected={@selected_runs_type == "flaky"}
              >
                <div data-part="breakdown-item">
                  <div data-part="dot" data-color="flaky"></div>
                  <span data-part="label">{dgettext("dashboard_tests", "Flaky")}</span>
                  <span data-part="separator">-</span>
                  <span data-part="value">
                    {if @analytics.ok?,
                      do: format_number(@analytics.result.outcome_counts.flaky),
                      else: dgettext("dashboard_tests", "N/A")}
                  </span>
                </div>
              </.dropdown_item>
            </:select>
          </.widget>
          <.widget
            loading={!@analytics.ok?}
            title={dgettext("dashboard_tests", "Flakiness rate")}
            legend_color="flaky"
            description={
              dgettext(
                "dashboard_tests",
                "Percentage of test runs that were flaky in the selected period."
              )
            }
            value={if @analytics.ok?, do: "#{flakiness_rate(@analytics.result)}%"}
            id="widget-flakiness-rate"
            phx_click="select_widget"
            phx_value_widget="flakiness_rate"
            selected={@analytics_selected_widget == "flakiness_rate"}
            trend_value={
              if @analytics.ok? and @previous_analytics.ok? do
                trend(
                  @previous_analytics.result,
                  flakiness_rate(@previous_analytics.result),
                  flakiness_rate(@analytics.result)
                )
              end
            }
            trend_type={:inverse}
            trend_label={@analytics_trend_label}
            empty={@analytics.ok? && @analytics.result.total_count == 0}
            empty_label={dgettext("dashboard_tests", "No data")}
          />
          <.widget
            loading={!@reliability.ok?}
            title={dgettext("dashboard_tests", "Test reliability")}
            legend_color="tertiary"
            description={
              dgettext(
                "dashboard_tests",
                "Success rate in the selected period, based on runs from the %{branch} branch. Falls back to all branches if no runs exist on %{branch}.",
                branch: @selected_project.default_branch
              )
            }
            value={
              if @reliability.ok? && @reliability.result, do: format_percent(@reliability.result)
            }
            id="widget-test-reliability"
            phx_click="select_widget"
            phx_value_widget="reliability"
            selected={@analytics_selected_widget == "reliability"}
            trend_value={
              if @reliability.ok? and @previous_reliability.ok? and
                   not is_nil(@reliability.result) and not is_nil(@previous_reliability.result) do
                Analytics.trend(
                  previous_value: @previous_reliability.result,
                  current_value: @reliability.result
                )
              end
            }
            trend_type={:regular}
            trend_label={@analytics_trend_label}
            empty={@reliability.ok? && is_nil(@reliability.result)}
            empty_label={dgettext("dashboard_tests", "No data")}
          />
          <.percentile_dropdown_widget
            loading={!@analytics.ok?}
            title={
              case @selected_duration_type do
                "p99" -> dgettext("dashboard_tests", "p99 test case run duration")
                "p90" -> dgettext("dashboard_tests", "p90 test case run duration")
                "p50" -> dgettext("dashboard_tests", "p50 test case run duration")
                _ -> dgettext("dashboard_tests", "Avg. test case run duration")
              end
            }
            legend_color={
              case @selected_duration_type do
                "p99" -> "p99"
                "p90" -> "p90"
                "p50" -> "p50"
                _ -> "secondary"
              end
            }
            description={
              dgettext(
                "dashboard_tests",
                "Duration of this test case across the runs in the selected period."
              )
            }
            value={
              if @analytics.ok?,
                do:
                  Tuist.Utilities.DateFormatter.format_duration_from_milliseconds(
                    case @selected_duration_type do
                      "p99" -> @analytics.result.p99_duration
                      "p90" -> @analytics.result.p90_duration
                      "p50" -> @analytics.result.p50_duration
                      _ -> @analytics.result.avg_duration
                    end
                  )
            }
            metrics={
              if @analytics.ok? do
                %{
                  avg:
                    Tuist.Utilities.DateFormatter.format_duration_from_milliseconds(
                      @analytics.result.avg_duration
                    ),
                  p99:
                    Tuist.Utilities.DateFormatter.format_duration_from_milliseconds(
                      @analytics.result.p99_duration
                    ),
                  p90:
                    Tuist.Utilities.DateFormatter.format_duration_from_milliseconds(
                      @analytics.result.p90_duration
                    ),
                  p50:
                    Tuist.Utilities.DateFormatter.format_duration_from_milliseconds(
                      @analytics.result.p50_duration
                    )
                }
              end
            }
            selected_type={@selected_duration_type}
            event_name="select_duration_type"
            id="widget-avg-duration"
            phx_click="select_widget"
            phx_value_widget="duration"
            selected={@analytics_selected_widget == "duration"}
            trend_value={
              if @analytics.ok? and @previous_analytics.ok? do
                trend(
                  @previous_analytics.result,
                  duration(@previous_analytics.result, @selected_duration_type),
                  duration(@analytics.result, @selected_duration_type)
                )
              end
            }
            trend_type={:inverse}
            trend_label={@analytics_trend_label}
            empty={@analytics.ok? && @analytics.result.total_count == 0}
            empty_label={dgettext("dashboard_tests", "No data")}
          />
        </div>
        <div :if={!@series.ok?} data-part="analytics-chart">
          <.skeleton_chart />
        </div>
        <div :if={@series.ok? and charted?(@series.result)} data-part="analytics-chart">
          <.chart
            :if={@analytics_selected_widget == "test_case_runs"}
            id="test-case-runs-chart"
            type="bar"
            stacked
            extra_options={
              %{
                legend: %{
                  left: "left",
                  top: "bottom",
                  orient: "horizontal",
                  textStyle: %{
                    color: "var:noora-surface-label-secondary",
                    fontFamily: "monospace",
                    fontWeight: 400,
                    fontSize: 10,
                    lineHeight: 12
                  },
                  icon:
                    "path://M0 6C0 4.89543 0.895431 4 2 4H6C7.10457 4 8 4.89543 8 6C8 7.10457 7.10457 8 6 8H2C0.895431 8 0 7.10457 0 6Z",
                  itemWidth: 8,
                  itemHeight: 4
                },
                grid: %{
                  width: "93%",
                  left: "0.4%",
                  right: "7%",
                  height: "60%",
                  top: "10%"
                },
                xAxis: %{
                  type: "category",
                  data: @series.result.dates,
                  axisLabel: %{
                    color: "var:noora-surface-label-secondary",
                    formatter: "fn:toLocaleDate",
                    customValues: [
                      List.first(@series.result.dates),
                      List.last(@series.result.dates)
                    ],
                    padding: [10, 0, 0, 0]
                  }
                },
                yAxis: %{
                  splitLine: %{lineStyle: %{color: "var:noora-chart-lines"}},
                  axisLabel: %{
                    color: "var:noora-surface-label-secondary",
                    formatter: "{value}"
                  }
                },
                tooltip:
                  if @analytics_preset == "last-24-hours" do
                    %{valueFormat: "{value}", dateFormat: "hour"}
                  else
                    %{valueFormat: "{value}"}
                  end
              }
            }
            series={
              for segment <- run_segments(@series.result) do
                %{
                  color: segment.color,
                  data: segment.data,
                  name: segment.name,
                  type: "bar"
                }
              end
            }
            y_axis_min={0}
          />
          <.chart
            :if={@analytics_selected_widget not in ["test_case_runs", "duration"]}
            id="test-case-analytics-chart"
            type="line"
            extra_options={
              %{
                legend: %{show: false},
                grid: %{
                  width: "93%",
                  left: "0.4%",
                  right: "7%",
                  height: "88%",
                  top: "5%"
                },
                xAxis: %{
                  boundaryGap: false,
                  type: "category",
                  axisLabel: %{
                    color: "var:noora-surface-label-secondary",
                    formatter: "fn:toLocaleDate",
                    customValues: [
                      List.first(@series.result.dates),
                      List.last(@series.result.dates)
                    ],
                    padding: [10, 0, 0, 0]
                  }
                },
                yAxis:
                  Map.merge(
                    %{
                      splitLine: %{lineStyle: %{color: "var:noora-chart-lines"}},
                      axisLabel: %{
                        color: "var:noora-surface-label-secondary",
                        formatter:
                          selected_chart(@analytics_selected_widget, @series.result).formatter
                      }
                    },
                    selected_chart(@analytics_selected_widget, @series.result).y_axis
                  ),
                tooltip:
                  if @analytics_preset == "last-24-hours" do
                    %{
                      valueFormat:
                        selected_chart(@analytics_selected_widget, @series.result).formatter,
                      dateFormat: "hour"
                    }
                  else
                    %{
                      valueFormat:
                        selected_chart(@analytics_selected_widget, @series.result).formatter
                    }
                  end
              }
            }
            series={[
              %{
                color: selected_chart(@analytics_selected_widget, @series.result).color,
                data:
                  chart_points(
                    @series.result.dates,
                    selected_chart(@analytics_selected_widget, @series.result).values
                  ),
                name: selected_chart(@analytics_selected_widget, @series.result).name,
                type: "line",
                smooth: 0.1,
                symbol: "none"
              }
            ]}
            y_axis_min={0}
          />
          <.chart
            :if={@analytics_selected_widget == "duration"}
            id="test-case-duration-chart"
            type="line"
            extra_options={
              %{
                legend: %{
                  left: "left",
                  top: "bottom",
                  orient: "horizontal",
                  textStyle: %{
                    color: "var:noora-surface-label-secondary",
                    fontFamily: "monospace",
                    fontWeight: 400,
                    fontSize: 10,
                    lineHeight: 12
                  },
                  icon:
                    "path://M0 6C0 4.89543 0.895431 4 2 4H6C7.10457 4 8 4.89543 8 6C8 7.10457 7.10457 8 6 8H2C0.895431 8 0 7.10457 0 6Z",
                  itemWidth: 8,
                  itemHeight: 4
                },
                grid: %{
                  width: "93%",
                  left: "0.4%",
                  right: "7%",
                  height: "60%",
                  top: "10%"
                },
                xAxis: %{
                  boundaryGap: false,
                  type: "category",
                  axisLabel: %{
                    color: "var:noora-surface-label-secondary",
                    formatter: "fn:toLocaleDate",
                    customValues: [
                      List.first(@series.result.dates),
                      List.last(@series.result.dates)
                    ],
                    padding: [10, 0, 0, 0]
                  }
                },
                yAxis: %{
                  splitNumber: 4,
                  splitLine: %{
                    lineStyle: %{
                      color: "var:noora-chart-lines"
                    }
                  },
                  axisLabel: %{
                    color: "var:noora-surface-label-secondary",
                    formatter: "fn:formatMilliseconds"
                  }
                },
                tooltip:
                  if @analytics_preset == "last-24-hours" do
                    %{valueFormat: "fn:formatMilliseconds", dateFormat: "hour"}
                  else
                    %{valueFormat: "fn:formatMilliseconds"}
                  end
              }
            }
            series={[
              %{
                color: "var:noora-chart-secondary",
                data: chart_points(@series.result.dates, @series.result.duration.values),
                name: dgettext("dashboard_tests", "Average"),
                type: "line",
                smooth: 0.1,
                symbol: "none"
              },
              %{
                color: "var:noora-chart-p99",
                data: chart_points(@series.result.dates, @series.result.duration.p99_values),
                name: dgettext("dashboard_tests", "p99"),
                type: "line",
                smooth: 0.1,
                symbol: "none"
              },
              %{
                color: "var:noora-chart-p90",
                data: chart_points(@series.result.dates, @series.result.duration.p90_values),
                name: dgettext("dashboard_tests", "p90"),
                type: "line",
                smooth: 0.1,
                symbol: "none"
              },
              %{
                color: "var:noora-chart-p50",
                data: chart_points(@series.result.dates, @series.result.duration.p50_values),
                name: dgettext("dashboard_tests", "p50"),
                type: "line",
                smooth: 0.1,
                symbol: "none"
              }
            ]}
            y_axis_min={0}
          />
        </div>
        <div
          :if={@series.ok? and not charted?(@series.result)}
          data-part="analytics-chart-empty"
        >
          <img
            src={~p"/images/empty_line_chart_light.png"}
            data-theme="light"
            loading="lazy"
            decoding="async"
          />
          <img
            src={~p"/images/empty_line_chart_dark.png"}
            data-theme="dark"
            loading="lazy"
            decoding="async"
          />
          <span data-part="title">
            {dgettext("dashboard_tests", "No runs in this period")}
          </span>
        </div>
      </div>
      <div :if={Enum.any?(@overview_history_events)} data-part="analytics-history">
        <div data-part="title">{dgettext("dashboard_tests", "Test history")}</div>
        <div data-part="timeline">
          <div :for={event <- @overview_history_events} data-part="timeline-item">
            <div data-part="marker">
              <div data-part="icon" data-color={event_color(event.event_type)}>
                <.icon name={event_icon(event.event_type)} />
              </div>
            </div>
            <div data-part="content">
              <div data-part="headline">
                <span data-part="item-title">{event_title(event.event_type)}</span>
                <.relative_time_with_tooltip
                  id={"overview-history-event-#{event.id}-time-tooltip"}
                  part="item-time"
                  time={event.inserted_at}
                  timezone={@user_timezone}
                />
              </div>
              <span :if={format_event_subtitle(event)} data-part="item-subtitle">
                {format_event_subtitle(event)}
              </span>
            </div>
          </div>
        </div>
        <.button
          :if={@overview_history_has_more}
          label={dgettext("dashboard_tests", "View more")}
          variant="secondary"
          size="small"
          patch={"?#{Query.put(@uri.query, "tab", "history")}"}
        />
      </div>
    </.card_section>
  </.card>

  <.card
    :if={
      @selected_tab == "flaky-runs" and @flaky_runs_grouped.ok? and
        Enum.any?(@flaky_runs_grouped.result)
    }
    title={dgettext("dashboard_tests", "Flaky Runs")}
    icon="alert_triangle"
    data-part="flaky-runs-card"
  >
    <.card_section data-part="flaky-runs-section">
      <div
        :for={group <- @flaky_runs_grouped.result}
        id={"flaky-group-#{group.scheme}-#{group.git_commit_sha}"}
        phx-hook="NooraCollapsible"
        data-part="collapsible"
        data-state="closed"
      >
        <div data-part="root">
          <div data-part="header-row">
            <div data-part="title-and-subtitle">
              <h3 data-part="title">
                <.commit_link
                  project={@selected_project}
                  commit_sha={group.git_commit_sha}
                  data-part="commit-sha"
                />
              </h3>
            </div>
            <div data-part="stats">
              <span data-part="time-ago">
                {Timex.from_now(group.latest_ran_at)}
              </span>
              <div data-part="passed-count">
                <.circle_check />
                <span data-part="label">{group.passed_count}</span>
              </div>
              <div data-part="failed-count">
                <.circle_x />
                <span data-part="label">{group.failed_count}</span>
              </div>
            </div>
            <.neutral_button data-part="trigger" variant="secondary" size="medium">
              <span data-part="icon-closed"><.chevron_down /></span>
              <span data-part="icon-open"><.chevron_up /></span>
            </.neutral_button>
          </div>
          <div data-part="content" data-state="closed">
            <div
              :for={{run, index} <- Enum.with_index(group.runs)}
              data-part="flaky-run-item-wrapper"
            >
              <div data-part="flaky-run-item">
                <div data-part="run-header">
                  <.badge
                    :if={run.status == "success"}
                    label={dgettext("dashboard_tests", "Passed")}
                    color="success"
                    style="light-fill"
                    size="small"
                  />
                  <.badge
                    :if={run.status == "failure"}
                    label={dgettext("dashboard_tests", "Failed")}
                    color="destructive"
                    style="light-fill"
                    size="small"
                  />
                  <span data-part="run-date">
                    {Tuist.Utilities.DateFormatter.format_with_timezone_short(
                      run.ran_at,
                      @user_timezone
                    )}
                  </span>
                  <div data-part="run-metadata">
                    <.branch_link
                      project={@selected_project}
                      branch={run.git_branch}
                      show_icon
                      data-part="branch-info"
                    />
                    <.link
                      navigate={
                        ~p"/#{@selected_project.account.name}/#{@selected_project.name}/tests/test-runs/#{run.test_run_id}"
                      }
                      data-part="test-run-link"
                    >
                      {run.scheme}
                      <.link_icon />
                    </.link>
                  </div>
                </div>
                <div :if={Enum.any?(run.repetitions)} data-part="repetitions">
                  <div
                    :for={{repetition, rep_index} <- Enum.with_index(run.repetitions)}
                    data-part="repetition-wrapper"
                  >
                    <div data-part="repetition-item">
                      <.badge
                        :if={repetition.status == "success"}
                        label={dgettext("dashboard_tests", "Passed")}
                        color="success"
                        style="light-fill"
                        size="small"
                      />
                      <.badge
                        :if={repetition.status == "failure"}
                        label={dgettext("dashboard_tests", "Failed")}
                        color="destructive"
                        style="light-fill"
                        size="small"
                      />
                      <span data-part="repetition-name">{repetition.name}</span>
                    </div>
                    <.failure_message_span
                      :if={
                        repetition.status == "failure" and Enum.any?(run.failures) and
                          Enum.at(run.failures, rep_index)
                      }
                      failure={Enum.at(run.failures, rep_index)}
                      context={%{project: @selected_project, git_commit_sha: run.git_commit_sha}}
                    />
                  </div>
                </div>
                <.failure_message_span
                  :for={failure <- run.failures}
                  :if={!Enum.any?(run.repetitions) and run.status == "failure"}
                  failure={failure}
                  context={%{project: @selected_project, git_commit_sha: run.git_commit_sha}}
                />
              </div>
              <.line_divider :if={index < length(group.runs) - 1} />
            </div>
          </div>
        </div>
      </div>
    </.card_section>
  </.card>

  <.card
    :if={@selected_tab == "overview"}
    title={dgettext("dashboard_tests", "Test Case Runs")}
    icon="exchange"
    data-part="test-case-runs-card"
  >
    <.card_section data-part="test-case-runs-section">
      <div data-part="filters">
        <.form for={%{}} phx-change="search-test-case-runs" phx-debounce="200">
          <.text_input
            type="search"
            id="search-test-case-runs"
            name="search"
            placeholder={dgettext("dashboard_tests", "Search...")}
            show_suffix={false}
            data-part="search"
            value={@test_case_runs_search}
          />
        </.form>
        <.dropdown
          id="test-case-runs-sort-by"
          label={
            case @test_case_runs_sort_by do
              "duration" -> dgettext("dashboard_tests", "Duration")
              _ -> dgettext("dashboard_tests", "Ran at")
            end
          }
          secondary_text={dgettext("dashboard_tests", "Sort by:")}
        >
          <.dropdown_item
            value="ran_at"
            label={dgettext("dashboard_tests", "Ran at")}
            patch={sort_by_patch(@uri, "ran_at")}
            data-selected={@test_case_runs_sort_by == "ran_at"}
          >
            <:right_icon><.check /></:right_icon>
          </.dropdown_item>
          <.dropdown_item
            value="duration"
            label={dgettext("dashboard_tests", "Duration")}
            patch={sort_by_patch(@uri, "duration")}
            data-selected={@test_case_runs_sort_by == "duration"}
          >
            <:right_icon><.check /></:right_icon>
          </.dropdown_item>
        </.dropdown>
        <.filter_dropdown
          id="test-case-runs-filter-dropdown"
          label={dgettext("dashboard_tests", "Filter")}
          available_filters={@available_filters}
          active_filters={@active_filters}
        />
      </div>
      <div :if={Enum.any?(@active_filters)} data-part="active-filters">
        <.active_filter :for={filter <- @active_filters} filter={filter} />
      </div>
      <.table
        id="test-case-runs-table"
        rows={@test_case_runs}
        row_navigate={
          fn test_case_run ->
            url(
              ~p"/#{@selected_project.account.name}/#{@selected_project.name}/tests/test-cases/runs/#{test_case_run.id}"
            )
          end
        }
      >
        <:col :let={test_case_run} label={scheme_label(@selected_project)}>
          <div data-part="cell" data-type="text_and_description">
            <div data-part="column">
              <span data-part="label">
                {test_case_run.scheme || dgettext("dashboard_tests", "Unknown")}
                <.badge
                  :if={test_case_run.is_flaky}
                  label={dgettext("dashboard_tests", "Flaky")}
                  color="attention"
                  style="light-fill"
                  size="large"
                />
              </span>
            </div>
          </div>
        </:col>
        <:col :let={test_case_run} label={dgettext("dashboard_tests", "Status")}>
          <.status_badge_cell
            :if={test_case_run.status == "success"}
            label={dgettext("dashboard_tests", "Passed")}
            status="success"
          />
          <.status_badge_cell
            :if={test_case_run.status == "failure"}
            label={dgettext("dashboard_tests", "Failed")}
            status="error"
          />
          <.status_badge_cell
            :if={test_case_run.status == "skipped"}
            label={dgettext("dashboard_tests", "Skipped")}
            status="warning"
          />
        </:col>
        <:col :let={test_case_run} label={dgettext("dashboard_tests", "Branch")}>
          <.text_cell
            icon="git_branch"
            label={
              if test_case_run.git_branch == "",
                do: dgettext("dashboard_tests", "Unknown"),
                else: test_case_run.git_branch
            }
          />
        </:col>
        <:col :let={test_case_run} label={dgettext("dashboard_tests", "Ran by")}>
          <.test_ran_by_badge_cell test={test_case_run} />
        </:col>
        <:col
          :let={test_case_run}
          label={dgettext("dashboard_tests", "Duration")}
          patch={
            @test_case_runs_sort_by == "duration" &&
              column_sort_patch(assigns, "duration")
          }
          sort_order={@test_case_runs_sort_by == "duration" && @test_case_runs_sort_order}
        >
          <.text_cell
            label={
              Tuist.Utilities.DateFormatter.format_duration_from_milliseconds(
                test_case_run.duration
              )
            }
            icon="history"
          />
        </:col>
        <:col
          :let={test_case_run}
          label={dgettext("dashboard_tests", "Ran at")}
          patch={
            @test_case_runs_sort_by == "ran_at" &&
              column_sort_patch(assigns, "ran_at")
          }
          sort_order={@test_case_runs_sort_by == "ran_at" && @test_case_runs_sort_order}
        >
          <.text_cell sublabel={Tuist.Utilities.DateFormatter.from_now(test_case_run.ran_at)} />
        </:col>
        <:empty_state>
          <.table_empty_state
            icon="subtask"
            title={dgettext("dashboard_tests", "No test case runs found")}
            subtitle={dgettext("dashboard_tests", "Try updating your search")}
          />
        </:empty_state>
      </.table>
      <.pagination_group
        :if={@test_case_runs_meta.total_pages > 1}
        current_page={@test_case_runs_page}
        number_of_pages={@test_case_runs_meta.total_pages}
        page_patch={
          fn page ->
            "?#{Query.put(@uri.query, "page", page)}"
          end
        }
      />
    </.card_section>
  </.card>

  <.card
    :if={@selected_tab == "history"}
    title={dgettext("dashboard_tests", "Test History")}
    icon="timeline_event"
    data-part="test-history-card"
  >
    <.card_section data-part="test-history-section">
      <div data-part="timeline">
        <div
          :for={event <- @history_events}
          data-part="timeline-item"
        >
          <div data-part="timeline-icon" data-color={event_color(event.event_type)}>
            <.icon name={event_icon(event.event_type)} />
          </div>
          <div data-part="timeline-content">
            <span data-part="timeline-title">
              {event_title(event.event_type)}
            </span>
            <span :if={format_event_subtitle(event)} data-part="timeline-subtitle">
              {format_event_subtitle(event)}
            </span>
          </div>
          <.relative_time_with_tooltip
            id={"test-history-event-#{event.id}-time-tooltip"}
            part="timeline-time"
            time={event.inserted_at}
            timezone={@user_timezone}
          />
        </div>

        <div
          :if={Enum.empty?(@history_events)}
          data-part="timeline-empty"
        >
          <span data-part="title">{dgettext("dashboard_tests", "No history available")}</span>
          <span data-part="subtitle">
            {dgettext(
              "dashboard_tests",
              "Events will appear here when the test case status changes."
            )}
          </span>
        </div>
      </div>

      <.button
        :if={@history_page < @history_meta.total_pages}
        label={dgettext("dashboard_tests", "Load more")}
        variant="secondary"
        size="medium"
        phx-click="load-more-history"
        data-part="load-more-button"
      />
    </.card_section>
  </.card>
</div>
