<div id="project-authentication">
  <h1 data-part="title">
    {@selected_project.name}
  </h1>

  <.tab_menu_horizontal>
    <.tab_menu_horizontal_item
      label={dgettext("dashboard_projects", "General")}
      selected={false}
      navigate={~p"/#{@selected_account.name}/#{@selected_project.name}/settings"}
    />
    <.tab_menu_horizontal_item
      label={dgettext("dashboard_projects", "Authentication")}
      selected={true}
      navigate={~p"/#{@selected_account.name}/#{@selected_project.name}/settings/authentication"}
    />
    <.tab_menu_horizontal_item
      :if={Tuist.Projects.Project.xcode_project?(@selected_project)}
      label={dgettext("dashboard_projects", "Notifications")}
      selected={false}
      navigate={~p"/#{@selected_account.name}/#{@selected_project.name}/settings/notifications"}
    />
    <.tab_menu_horizontal_item
      :if={
        Tuist.Projects.Project.xcode_project?(@selected_project) or
          Tuist.Projects.Project.bazel_project?(@selected_project)
      }
      label={dgettext("dashboard_projects", "Automations")}
      selected={false}
      navigate={~p"/#{@selected_account.name}/#{@selected_project.name}/settings/automations"}
    />
    <.tab_menu_horizontal_item
      :if={Tuist.Projects.Project.supports_bundles?(@selected_project)}
      label={dgettext("dashboard_projects", "Bundles")}
      selected={false}
      navigate={~p"/#{@selected_account.name}/#{@selected_project.name}/settings/bundles"}
    />
  </.tab_menu_horizontal>

  <h2 data-part="subtitle">
    {dgettext("dashboard_projects", "Workload identities")}
  </h2>

  <.card_section id="oidc-trust-policies" data-part="oidc-card-section">
    <div data-part="header">
      <span data-part="title">{dgettext("dashboard_projects", "OpenID Connect trust policies")}</span>
      <span data-part="subtitle">
        {dgettext(
          "dashboard_projects",
          "Allow trusted workloads to access this project without long-lived tokens."
        )}
      </span>
      <.link
        href="/en/docs/guides/server/authentication#workload-identity-trust-policies"
        data-part="documentation"
      >
        {dgettext("dashboard_projects", "Learn about workload identities")}
      </.link>
    </div>
    <div data-part="content">
      <div
        :for={policy <- @oidc_trust_policies}
        id={"oidc-trust-policy-#{policy.id}"}
        data-part="policy"
      >
        <div data-part="identity">
          <span data-part="name">{policy.name}</span>
          <span data-part="issuer">{policy.issuer}</span>
          <span data-part="details">
            {dgettext("dashboard_projects", "JWKS: %{url}", url: policy.jwks_url)}
          </span>
          <span data-part="details">
            {dgettext("dashboard_projects", "Audience: %{audience}", audience: policy.audience)}
          </span>
          <span data-part="details">
            {dgettext("dashboard_projects", "Claims: %{claims}",
              claims: format_claims(policy.claims)
            )}
          </span>
        </div>
        <.button
          variant="secondary"
          label={dgettext("dashboard_projects", "Remove")}
          phx-click="delete_oidc_trust_policy"
          phx-value-policy-id={policy.id}
        />
      </div>
      <.alert
        :if={@oidc_trust_policies != []}
        id="oidc-workload-setup"
        status="information"
        type="secondary"
        size="large"
        title={dgettext("dashboard_projects", "Authenticate your workload")}
      >
        <p>
          {dgettext(
            "dashboard_projects",
            "Provide a fresh provider token as TUIST_OIDC_TOKEN, then run:"
          )}
        </p>
        <pre><code>{~s(export TUIST_OIDC_ACCOUNT="#{@selected_account.name}") <> "\n" <> if(@selected_project.build_system == :mix, do: "mix tuist.login", else: "tuist auth login")}</code></pre>
      </.alert>
      <.form
        for={@oidc_trust_policy_form}
        id="oidc-trust-policy-form"
        data-part="form"
        phx-change="change_oidc_trust_policy"
        phx-submit="create_oidc_trust_policy"
      >
        <.alert
          :for={error <- @form_errors}
          status="error"
          type="secondary"
          size="small"
          title={error}
        />
        <div id="oidc-template" data-part="template-picker">
          <span data-part="template-label">{dgettext("dashboard_projects", "Template")}</span>
          <.select
            id={"oidc-template-select-#{@oidc_template}"}
            name="oidc_template"
            label={dgettext("dashboard_projects", "Template")}
            value={@oidc_template}
            on_value_change="select_oidc_template"
          >
            <:item value="custom" label={dgettext("dashboard_projects", "Custom provider")} />
            <:item value="fly" label="Fly.io Machines" />
          </.select>
        </div>
        <.text_input
          label={dgettext("dashboard_projects", "Name")}
          field={@oidc_trust_policy_form[:name]}
          error={field_error(@oidc_trust_policy_form[:name])}
          type="basic"
          placeholder={dgettext("dashboard_projects", "Production service")}
        />
        <div :if={@oidc_template == "fly"} id="oidc-fly-template" data-part="template-fields">
          <.text_input
            id="oidc-fly-organization-slug"
            label={dgettext("dashboard_projects", "Organization slug")}
            name="fly_template[organization_slug]"
            value={@fly_template["organization_slug"]}
            type="basic"
            placeholder="my-organization"
            required
          />
          <div data-part="template-ids">
            <.text_input
              id="oidc-fly-organization-id"
              label={dgettext("dashboard_projects", "Organization ID")}
              name="fly_template[organization_id]"
              value={@fly_template["organization_id"]}
              type="basic"
              placeholder="123"
              inputmode="numeric"
              required
            />
            <.text_input
              id="oidc-fly-application-id"
              label={dgettext("dashboard_projects", "Application ID")}
              name="fly_template[application_id]"
              value={@fly_template["application_id"]}
              type="basic"
              placeholder="456"
              inputmode="numeric"
              required
            />
          </div>
        </div>
        <.text_input
          label={dgettext("dashboard_projects", "Audience")}
          field={@oidc_trust_policy_form[:audience]}
          error={field_error(@oidc_trust_policy_form[:audience])}
          type="basic"
          placeholder="tuist"
        />
        <.alert
          :if={@oidc_template == "fly" and @identity_overridden?}
          id="oidc-template-overrides"
          status="warning"
          type="secondary"
          size="small"
          title={
            dgettext(
              "dashboard_projects",
              "Your manual changes override this template. Review the advanced configuration."
            )
          }
        />
        <.identity_fields
          :if={@oidc_template == "custom"}
          form={@oidc_trust_policy_form}
          claims_input={@claims_input}
        />
        <details
          :if={@oidc_template == "fly"}
          data-part="advanced"
          open={identity_errors?(@oidc_trust_policy_form) or @identity_overridden?}
        >
          <summary>{dgettext("dashboard_projects", "Advanced configuration")}</summary>
          <.identity_fields form={@oidc_trust_policy_form} claims_input={@claims_input} />
        </details>
        <.button
          type="submit"
          variant="primary"
          label={dgettext("dashboard_projects", "Add trust policy")}
        />
      </.form>
    </div>
  </.card_section>
</div>
