<div id="authentication-settings">
  <h1 data-part="title">
    {dgettext("dashboard_account", "Settings")}
  </h1>
  <TuistWeb.AppLayoutComponents.settings_tab_menu
    selected_account={@selected_account}
    current_path={@current_path}
    current_user={@current_user}
  />

  <.alert
    :if={@flash_message}
    status={elem(@flash_message, 0)}
    type="secondary"
    size="small"
    title={elem(@flash_message, 1)}
  />

  <.alert
    :for={kind <- [:info, :error]}
    :if={Phoenix.Flash.get(@flash, kind)}
    status={if kind == :error, do: "error", else: "information"}
    type="secondary"
    size="small"
    title={Phoenix.Flash.get(@flash, kind)}
  />

  <.card_section
    :if={
      is_nil(@organization) and @selected_account.user_id == @current_user.id and
        @passkeys_enabled?
    }
    id="passkeys-settings"
    data-part="security-card-section"
  >
    <div data-part="header">
      <span data-part="title">{dgettext("dashboard_account", "Passkeys")}</span>
      <span data-part="subtitle">{dgettext(
        "dashboard_account",
        "Sign in without a password using a passkey saved in your password manager or on a security key."
      )}</span>
      <span data-part="status">{dngettext(
        "dashboard_account",
        "%{count} passkey added",
        "%{count} passkeys added",
        length(@passkeys)
      )}</span>
    </div>
    <div data-part="content">
      <TuistWeb.SSOLinkHTML.reauthentication_notice
        :if={!@fresh_session?}
        return_to={~p"/#{@selected_account.name}/settings/authentication"}
      />
      <.button
        :if={@fresh_session?}
        id="passkey-add"
        type="button"
        variant="secondary"
        size="medium"
        label={dgettext("dashboard_auth", "Create a passkey")}
        data-passkey-ceremony="register"
        data-options-url={~p"/users/settings/passkeys/options"}
        data-action-url={~p"/users/settings/passkeys"}
        data-status="passkey-status"
      />
      <span
        id="passkey-status"
        role="status"
        data-part="passkey-status"
        data-cancelled={dgettext("dashboard_auth", "Adding the passkey was cancelled.")}
        data-failed={dgettext("dashboard_auth", "The passkey could not be added. Try again.")}
        data-already-registered={
          dgettext("dashboard_auth", "This passkey is already registered.")
        }
        data-unsupported={dgettext("dashboard_auth", "This browser does not support passkeys.")}
      ></span>
      <noscript>{dgettext("dashboard_auth", "JavaScript is required to use passkeys.")}</noscript>
    </div>
    <div :if={@passkeys != []} data-part="security-details">
      <TuistWeb.Components.UserSecurity.passkeys passkeys={@passkeys} editable={@fresh_session?} />
    </div>
  </.card_section>
  <.card_section
    :if={is_nil(@organization) and @selected_account.user_id == @current_user.id}
    id="two-factor-settings"
    data-part="security-card-section"
  >
    <div data-part="header">
      <span data-part="title">{dgettext("dashboard_account", "Two-factor authentication")}</span>
      <span data-part="subtitle">{dgettext(
        "dashboard_account",
        "Add an authenticator code to your password or SSO sign-in. Keep recovery codes as a backup."
      )}</span>
      <span data-part="status">{if @mfa_enabled?,
        do: dgettext("dashboard_account", "Enabled"),
        else: dgettext("dashboard_account", "Not enabled")}</span>
    </div>
    <div data-part="content">
      <TuistWeb.Components.UserSecurity.mfa_controls
        :if={@mfa_enabled? and @fresh_session?}
        recovery_code_count={@recovery_code_count}
        recovery_modal="mfa-recovery-modal"
      />
      <TuistWeb.SSOLinkHTML.reauthentication_notice
        :if={@mfa_enabled? and !@fresh_session?}
        return_to={~p"/#{@selected_account.name}/settings/authentication"}
      />
      <.modal
        :if={!@mfa_enabled?}
        id="setup-authenticator-modal"
        on_dismiss="close_authenticator_modal"
        on_open_change="authenticator_modal_change"
        title={dgettext("dashboard_auth", "Set up authenticator app")}
        description={
          dgettext("dashboard_auth", "Scan the QR code, then enter the six-digit code.")
        }
      >
        <:trigger :let={attrs}>
          <.button
            variant="secondary"
            size="medium"
            label={dgettext("dashboard_auth", "Set up authenticator app")}
            phx-click="setup_authenticator"
            {attrs}
          />
        </:trigger>
        <div data-part="security-modal-body">
          <TuistWeb.SSOLinkHTML.reauthentication_notice
            :if={!@fresh_session?}
            return_to={~p"/#{@selected_account.name}/settings/authentication"}
          />
          <div :if={@fresh_session? and @mfa_secret} data-part="authenticator-setup">
            <img
              id="mfa-setup-qr"
              src={TuistWeb.UserMFAHTML.enrollment_qr(@mfa_secret, @current_user.email)}
              width="200"
              height="200"
              alt={dgettext("dashboard_auth", "Authenticator setup QR code")}
            />
            <details id="mfa-manual-setup">
              <summary>{dgettext("dashboard_auth", "Can't scan the QR code?")}</summary>
              <.text_input
                id="mfa-setup-key"
                name="setup_key"
                value={Base.encode32(@mfa_secret, padding: false)}
                label={dgettext("dashboard_auth", "Setup key")}
                readonly
                autocomplete="off"
                data-1p-ignore
                dir="ltr"
                show_prefix={false}
              />
            </details>
            <form
              id="mfa-enrollment"
              method="post"
              action={~p"/users/settings/mfa/confirm"}
              data-recovery-modal="mfa-recovery-modal"
              data-source-modal="setup-authenticator-modal"
              data-error={dgettext("dashboard_auth", "Something went wrong. Please try again.")}
            >
              <input type="hidden" name="_csrf_token" value={Phoenix.Controller.get_csrf_token()} />
              <.text_input
                id="mfa-code"
                name="mfa_code"
                value=""
                label={dgettext("dashboard_auth", "Authentication code")}
                show_prefix={false}
                autocomplete="one-time-code"
                inputmode="numeric"
                required
              />
              <span data-enrollment-status role="alert"></span>
            </form>
          </div>
        </div>
        <:footer>
          <.modal_footer>
            <:action>
              <.button
                variant="secondary"
                label={dgettext("dashboard_auth", "Cancel")}
                phx-click="close_authenticator_modal"
              />
              <.button
                :if={@fresh_session? and @mfa_secret}
                type="submit"
                form="mfa-enrollment"
                variant="primary"
                label={dgettext("dashboard_auth", "Enable two-factor authentication")}
              />
            </:action>
          </.modal_footer>
        </:footer>
      </.modal>
      <dialog id="mfa-recovery-modal" aria-labelledby="mfa-recovery-title" phx-update="ignore">
        <h2 id="mfa-recovery-title">{dgettext("dashboard_auth", "Save your recovery codes")}</h2>
        <p>
          {dgettext(
            "dashboard_auth",
            "Save these codes somewhere safe. You won't see them again."
          )}
        </p>
        <div data-recovery-content></div>
      </dialog>
    </div>
  </.card_section>

  <%!-- ============================================================ --%>
  <%!-- Single Sign-On                                                --%>
  <%!-- ============================================================ --%>
  <.form
    :if={@organization}
    for={@form}
    id="sso-form"
    phx-submit="save_sso"
    phx-change="validate_sso"
  >
    <.card_section data-part="sso-card">
      <div data-part="header">
        <span data-part="title">
          {dgettext("dashboard_account", "Single Sign-On")}
        </span>
        <span data-part="subtitle">
          {dgettext(
            "dashboard_account",
            "Allow members to sign in to Tuist through your identity provider."
          )}
        </span>
      </div>
      <div data-part="section">
        <div data-part="toggle-label">
          <.toggle
            id="sso-enabled-toggle"
            checked={@sso_enabled}
            phx-click="toggle_sso"
          />
          <div data-part="label-text">
            <span data-part="title">
              {dgettext("dashboard_account", "Enable Single Sign-On")}
            </span>
            <span data-part="description">
              {dgettext("dashboard_account", "Enable and configure SSO for your organization.")}
            </span>
          </div>
        </div>
      </div>

      <div :if={@sso_enabled} data-part="section">
        <div data-part="label">
          <span data-part="title">
            {dgettext("dashboard_account", "SSO provider")}
          </span>
          <span data-part="description">
            {dgettext(
              "dashboard_account",
              "Select the identity provider that authenticates your organization members."
            )}
          </span>
        </div>
        <div data-part="field">
          <.select
            id="sso-provider-select"
            field={@form[:provider]}
            label={dgettext("dashboard_account", "Provider")}
            on_value_change="select_provider"
          >
            <:item value="google" label="Google" />
            <:item value="okta" label="Okta" />
            <:item value="entra" label="Microsoft Entra ID" />
            <:item value="oauth2" label={dgettext("dashboard_account", "OAuth2")} />
          </.select>
        </div>
      </div>

      <div :if={@sso_enabled and @selected_provider == "google"} data-part="section">
        <div data-part="label">
          <span data-part="title">
            {dgettext("dashboard_account", "Google Workspace domain")}
          </span>
          <span data-part="description">
            {dgettext(
              "dashboard_account",
              "Users signing in with a Google account from this domain will be automatically added to this organization."
            )}
          </span>
        </div>
        <div data-part="field">
          <.text_input field={@form[:google_domain]} type="basic" placeholder="example.com" />
        </div>
      </div>

      <%!-- Okta setup instructions --%>
      <div :if={@sso_enabled and @selected_provider == "okta"} data-part="section">
        <div data-part="label">
          <span data-part="title">
            {dgettext("dashboard_account", "Setup instructions")}
          </span>
          <span data-part="description">
            {dgettext(
              "dashboard_account",
              "Create an OIDC Web Application in your Okta admin dashboard before configuring the fields below."
            )}
          </span>
        </div>
        <div data-part="field">
          <div data-part="setup-steps">
            <ol>
              <li>
                {dgettext(
                  "dashboard_account",
                  "Go to Applications > Applications > Create App Integration"
                )}
              </li>
              <li>
                {dgettext(
                  "dashboard_account",
                  "Select \"OIDC - OpenID Connect\" and \"Web Application\""
                )}
              </li>
              <li>
                {dgettext("dashboard_account", "Set the sign-in redirect URI to:")}
                <.copyable_value
                  id="okta-redirect-uri"
                  value={Tuist.Environment.app_url(path: "/users/auth/okta/callback")}
                  copy_label={dgettext("dashboard_account", "Copy redirect URI")}
                />
              </li>
              <li>
                {dgettext(
                  "dashboard_account",
                  "Copy the Client ID and Client Secret from the application settings"
                )}
              </li>
              <li>
                {dgettext("dashboard_account", "Set the initiate login URI to:")}
                <.copyable_value
                  id="okta-initiate-login-uri"
                  value={
                    Tuist.Environment.app_url(
                      path: "/users/auth/okta?organization_id=#{@organization.id}"
                    )
                  }
                  copy_label={dgettext("dashboard_account", "Copy initiate login URI")}
                />
              </li>
            </ol>
          </div>
        </div>
      </div>

      <%!-- Microsoft Entra ID setup instructions --%>
      <div :if={@sso_enabled and @selected_provider == "entra"} data-part="section">
        <div data-part="label">
          <span data-part="title">
            {dgettext("dashboard_account", "Setup instructions")}
          </span>
          <span data-part="description">
            {dgettext(
              "dashboard_account",
              "Register an application in your Microsoft Entra admin center before configuring the fields below."
            )}
          </span>
        </div>
        <div data-part="field">
          <div data-part="setup-steps">
            <ol>
              <li>
                {dgettext(
                  "dashboard_account",
                  "Go to Identity > Applications > App registrations > New registration"
                )}
              </li>
              <li>
                {dgettext(
                  "dashboard_account",
                  "Select the \"Web\" platform and set the redirect URI to:"
                )}
                <.copyable_value
                  id="entra-redirect-uri"
                  value={Tuist.Environment.app_url(path: "/users/auth/oauth2/callback")}
                  copy_label={dgettext("dashboard_account", "Copy redirect URI")}
                />
              </li>
              <li>
                {dgettext(
                  "dashboard_account",
                  "Copy the Directory (tenant) ID and Application (client) ID from the application overview"
                )}
              </li>
              <li>
                {dgettext(
                  "dashboard_account",
                  "Create a client secret under Certificates & secrets and copy its value"
                )}
              </li>
              <li>
                {dgettext(
                  "dashboard_account",
                  "Under API permissions, grant the delegated openid, profile, and email permissions"
                )}
              </li>
              <li>
                {dgettext("dashboard_account", "Set the home page URL to:")}
                <.copyable_value
                  id="entra-home-page-url"
                  value={
                    Tuist.Environment.app_url(
                      path: "/users/auth/oauth2?organization_id=#{@organization.id}"
                    )
                  }
                  copy_label={dgettext("dashboard_account", "Copy home page URL")}
                />
              </li>
            </ol>
          </div>
        </div>
      </div>

      <%!-- Custom OAuth2 setup instructions --%>
      <div :if={@sso_enabled and @selected_provider == "oauth2"} data-part="section">
        <div data-part="label">
          <span data-part="title">
            {dgettext("dashboard_account", "Setup instructions")}
          </span>
          <span data-part="description">
            {dgettext(
              "dashboard_account",
              "Configure your OAuth2 provider to redirect users back to Tuist after authentication."
            )}
          </span>
        </div>
        <div data-part="field">
          <div data-part="setup-steps">
            <ol>
              <li>
                {dgettext(
                  "dashboard_account",
                  "Create an OAuth2 application in your identity provider."
                )}
              </li>
              <li>
                {dgettext("dashboard_account", "Set the sign-in redirect URI to:")}
                <.copyable_value
                  id="oauth2-redirect-uri"
                  value={Tuist.Environment.app_url(path: "/users/auth/oauth2/callback")}
                  copy_label={dgettext("dashboard_account", "Copy redirect URI")}
                />
              </li>
              <li>
                {dgettext(
                  "dashboard_account",
                  "Copy the provider URL, authorize URL, token URL, user info URL, client ID, and client secret into the fields below."
                )}
              </li>
              <li>
                {dgettext("dashboard_account", "Set the initiate login URI to:")}
                <.copyable_value
                  id="oauth2-initiate-login-uri"
                  value={
                    Tuist.Environment.app_url(
                      path: "/users/auth/oauth2?organization_id=#{@organization.id}"
                    )
                  }
                  copy_label={dgettext("dashboard_account", "Copy initiate login URI")}
                />
              </li>
            </ol>
          </div>
        </div>
      </div>

      <div
        :if={@sso_enabled and oauth2_form_provider?(@selected_provider)}
        data-part="section"
        data-section="login-domain"
      >
        <div data-part="label">
          <div data-part="title-row">
            <span data-part="title">
              {dgettext("dashboard_account", "Login email domain")}
            </span>
            <%= if domain_verification_shown?(@organization, @form) do %>
              <%= cond do %>
                <% @login_domain_trust == :instance -> %>
                  <span data-part="domain-verification-status" data-status="instance">
                    {dgettext("dashboard_account", "Trusted by instance configuration")}
                  </span>
                <% Accounts.sso_login_domain_expiring?(@organization) -> %>
                  <span data-part="domain-verification-status" data-status="expiring">
                    {dngettext(
                      "dashboard_account",
                      "Expires in %{count} day",
                      "Expires in %{count} days",
                      Accounts.sso_login_domain_days_until_expiry(@organization)
                    )}
                  </span>
                <% @organization.sso_login_domain_verified_at -> %>
                  <span data-part="domain-verification-status" data-status="verified">
                    {dgettext("dashboard_account", "Verified")}
                  </span>
                <% true -> %>
                  <span data-part="domain-verification-status" data-status="pending">
                    {dgettext("dashboard_account", "Pending verification")}
                  </span>
              <% end %>
            <% end %>
          </div>
          <span data-part="description">
            <%= if @login_domain_trust in [:instance, :dns_verified] do %>
              {dgettext(
                "dashboard_account",
                "Used to find your provider and to decide which email addresses to trust."
              )}
            <% else %>
              {dgettext(
                "dashboard_account",
                "Once verified, used to find your provider and to decide which email addresses to trust."
              )}
            <% end %>
            <%= if @login_domain_trust != :instance or @login_domain_shared do %>
              {domain_record_instruction(@organization, @form)}
            <% end %>
          </span>
        </div>
        <div data-part="field">
          <.text_input
            field={@form[:sso_login_domain]}
            type="basic"
            placeholder="example.com"
            error={@field_errors["sso_login_domain"]}
          />
          <.button
            :if={
              (@login_domain_trust != :instance or @login_domain_shared) and
                domain_verification_shown?(@organization, @form) and
                Accounts.sso_login_domain_awaiting_record?(@organization)
            }
            id="verify-sso-login-domain-button"
            type="button"
            label={dgettext("dashboard_account", "Verify domain")}
            variant="secondary"
            size="medium"
            phx-click={
              JS.push("verify_sso_login_domain",
                loading: "#sso-login-domain-verification-error"
              )
            }
          />
        </div>
        <div
          :if={
            (@login_domain_trust != :instance or @login_domain_shared) and
              domain_verification_shown?(@organization, @form) and
              (Accounts.sso_login_domain_awaiting_record?(@organization) or
                 not is_nil(@domain_verification_error))
          }
          id="sso-login-domain-verification"
          data-part="domain-verification"
        >
          <.alert
            :if={@domain_verification_error}
            id="sso-login-domain-verification-error"
            data-part="domain-verification-error"
            status="error"
            type="secondary"
            size="small"
            title={@domain_verification_error}
          />
          <div
            :if={Accounts.sso_login_domain_awaiting_record?(@organization)}
            data-part="domain-records"
          >
            <div data-part="domain-record">
              <span data-part="domain-record-label">
                {dgettext("dashboard_account", "Record type")}
              </span>
              <div data-part="read-only-value">
                <code>TXT</code>
              </div>
            </div>
            <div data-part="domain-record">
              <span data-part="domain-record-label">
                {dgettext("dashboard_account", "Record name")}
              </span>
              <.copyable_value
                id="sso-login-domain-record-name"
                value={Accounts.sso_login_domain_record_name(@organization)}
                copy_label={dgettext("dashboard_account", "Copy record name")}
              />
            </div>
            <div data-part="domain-record">
              <span data-part="domain-record-label">
                {dgettext("dashboard_account", "Record value")}
              </span>
              <.copyable_value
                id="sso-login-domain-record-value"
                value={Accounts.sso_login_domain_record_value(@organization)}
                copy_label={dgettext("dashboard_account", "Copy record value")}
              />
            </div>
          </div>
        </div>
      </div>

      <.alert
        :if={@login_domain_shared}
        id="sso-shared-login-domain"
        status="warning"
        type="secondary"
        size="small"
        title={
          dgettext(
            "dashboard_account",
            "Another organization uses this login domain. Email lookup prefers a DNS-verified organization; otherwise, use your organization's SSO sign-in link."
          )
        }
      />

      <%!-- Okta domain field --%>
      <div :if={@sso_enabled and @selected_provider == "okta"} data-part="section">
        <div data-part="label">
          <span data-part="title">
            {dgettext("dashboard_account", "Okta domain")}
          </span>
          <span data-part="description">
            {dgettext(
              "dashboard_account",
              "Your Okta organization URL without the https:// prefix."
            )}
          </span>
        </div>
        <div data-part="field">
          <.text_input
            field={@form[:okta_domain]}
            type="basic"
            placeholder="your-company.okta.com"
            error={@field_errors["okta_domain"]}
          />
        </div>
      </div>

      <%!-- Microsoft Entra ID directory (tenant) ID --%>
      <div :if={@sso_enabled and @selected_provider == "entra"} data-part="section">
        <div data-part="label">
          <span data-part="title">
            {dgettext("dashboard_account", "Directory (tenant) ID")}
          </span>
          <span data-part="description">
            {dgettext(
              "dashboard_account",
              "The directory (tenant) ID of your Entra application. Tuist derives the authorize, token, and user info endpoints from it."
            )}
          </span>
        </div>
        <div data-part="field">
          <.text_input
            field={@form[:entra_tenant_id]}
            type="basic"
            placeholder="00000000-0000-0000-0000-000000000000"
            error={@field_errors["entra_tenant_id"]}
          />
        </div>
      </div>

      <%!-- Custom OAuth2 provider URL --%>
      <div :if={@sso_enabled and @selected_provider == "oauth2"} data-part="section">
        <div data-part="label">
          <span data-part="title">
            {dgettext("dashboard_account", "Provider URL")}
          </span>
          <span data-part="description">
            {dgettext(
              "dashboard_account",
              "The base URL of your identity provider, for example https://auth.example.com."
            )}
          </span>
        </div>
        <div data-part="field">
          <.text_input
            field={@form[:oauth2_site]}
            type="basic"
            placeholder="https://auth.example.com"
            error={@field_errors["oauth2_site"]}
          />
        </div>
      </div>

      <div :if={@sso_enabled and @selected_provider == "oauth2"} data-part="section">
        <div data-part="label">
          <span data-part="title">
            {dgettext("dashboard_account", "Authorize URL")}
          </span>
          <span data-part="description">
            {dgettext(
              "dashboard_account",
              "The full authorization endpoint URL used to start the OAuth2 flow."
            )}
          </span>
        </div>
        <div data-part="field">
          <.text_input
            field={@form[:oauth2_authorize_url]}
            type="basic"
            placeholder="https://auth.example.com/oauth2/authorize"
            error={@field_errors["oauth2_authorize_url"]}
          />
        </div>
      </div>

      <div :if={@sso_enabled and @selected_provider == "oauth2"} data-part="section">
        <div data-part="label">
          <span data-part="title">
            {dgettext("dashboard_account", "Token URL")}
          </span>
          <span data-part="description">
            {dgettext(
              "dashboard_account",
              "The full token endpoint URL used to exchange the authorization code."
            )}
          </span>
        </div>
        <div data-part="field">
          <.text_input
            field={@form[:oauth2_token_url]}
            type="basic"
            placeholder="https://auth.example.com/oauth2/token"
            error={@field_errors["oauth2_token_url"]}
          />
        </div>
      </div>

      <div :if={@sso_enabled and @selected_provider == "oauth2"} data-part="section">
        <div data-part="label">
          <span data-part="title">
            {dgettext("dashboard_account", "User info URL")}
          </span>
          <span data-part="description">
            {dgettext(
              "dashboard_account",
              "The full user info endpoint URL that returns the authenticated user profile."
            )}
          </span>
        </div>
        <div data-part="field">
          <.text_input
            field={@form[:oauth2_user_info_url]}
            type="basic"
            placeholder="https://auth.example.com/oauth2/userinfo"
            error={@field_errors["oauth2_user_info_url"]}
          />
        </div>
      </div>

      <div :if={@sso_enabled and oauth2_form_provider?(@selected_provider)} data-part="section">
        <div data-part="label">
          <span data-part="title">
            {dgettext("dashboard_account", "Client ID")}
          </span>
          <span data-part="description">
            {dgettext("dashboard_account", "The client ID from your OAuth2 application.")}
          </span>
        </div>
        <div data-part="field">
          <.text_input
            field={@form[:oauth2_client_id]}
            type="basic"
            placeholder={dgettext("dashboard_account", "OAuth2 application client ID")}
            error={@field_errors["oauth2_client_id"]}
          />
        </div>
      </div>

      <div :if={@sso_enabled and oauth2_form_provider?(@selected_provider)} data-part="section">
        <div data-part="label">
          <span data-part="title">
            {dgettext("dashboard_account", "Client secret")}
          </span>
          <span data-part="description">
            {dgettext("dashboard_account", "The client secret from your OAuth2 application.")}
          </span>
        </div>
        <div data-part="field">
          <.text_input
            field={@form[:oauth2_client_secret]}
            type="password"
            input_type="password"
            placeholder={
              if @organization.sso_provider in [:okta, :oauth2] and
                   @organization.oauth2_encrypted_client_secret,
                 do: "••••••••••••",
                 else: nil
            }
            error={@field_errors["oauth2_client_secret"]}
          />
        </div>
      </div>

      <div :if={@sso_enabled} data-part="section">
        <div data-part="toggle-label">
          <.toggle
            id={
              "sso-automatic-enrollment-toggle-#{@selected_provider}-#{@sso_automatic_enrollment}-#{automatic_enrollment_toggle_disabled?(@selected_provider, @organization, @login_domain_trust, @sso_automatic_enrollment)}"
            }
            data-testid="sso-automatic-enrollment-toggle"
            checked={@sso_automatic_enrollment}
            disabled={
              automatic_enrollment_toggle_disabled?(
                @selected_provider,
                @organization,
                @login_domain_trust,
                @sso_automatic_enrollment
              )
            }
            phx-click="toggle_sso_automatic_enrollment"
          />
          <div data-part="label-text">
            <span data-part="title">
              {dgettext("dashboard_account", "Automatic enrollment")}
            </span>
            <span data-part="description">
              <%= cond do %>
                <% @selected_provider == "google" -> %>
                  {dgettext(
                    "dashboard_account",
                    "When enabled, users whose Google Workspace domain matches can join this organization automatically. Other users need an invitation."
                  )}
                <% @login_domain_trust == :instance -> %>
                  {dgettext(
                    "dashboard_account",
                    "When enabled, users from the login email domain trusted by this instance can join this organization automatically. Other users need an invitation."
                  )}
                <% @login_domain_trust == :dns_verified -> %>
                  {dgettext(
                    "dashboard_account",
                    "When enabled, users from the verified login email domain can join this organization automatically. Other users need an invitation."
                  )}
                <% @sso_automatic_enrollment -> %>
                  {dgettext(
                    "dashboard_account",
                    "Automatic enrollment is paused until the login email domain is verified. Existing linked users can continue signing in."
                  )}
                <% true -> %>
                  {dgettext(
                    "dashboard_account",
                    "Add and verify a login email domain before enabling automatic enrollment. Until then, the provider cannot create accounts, and members link their existing account after logging in. Existing linked users can continue signing in."
                  )}
              <% end %>
            </span>
          </div>
        </div>
      </div>

      <div :if={@sso_enabled and @sso_automatic_enrollment} data-part="section">
        <div data-part="label">
          <span data-part="title">
            {dgettext("dashboard_account", "Role for enrolled members")}
          </span>
          <span data-part="description">
            {dgettext(
              "dashboard_account",
              "The role members get when they join through automatic enrollment."
            )}
          </span>
        </div>
        <div data-part="field">
          <.select
            id="sso-default-role-select"
            name="sso_default_role"
            value={@sso_default_role}
            label={dgettext("dashboard_account", "Role")}
            on_value_change="select_sso_default_role"
          >
            <:item value="user" label={dgettext("dashboard_account", "User")} />
            <:item value="viewer" label={dgettext("dashboard_account", "Viewer")} />
          </.select>
        </div>
      </div>

      <div :if={@sso_enabled} data-part="section">
        <div data-part="toggle-label">
          <.toggle
            id={
              "sso-enforced-toggle-#{@selected_provider}-#{@sso_enforced}-#{sso_enforcement_toggle_disabled?(@selected_provider, @organization, @login_domain_trust, @sso_enforced)}"
            }
            data-testid="sso-enforced-toggle"
            checked={@sso_enforced}
            disabled={
              sso_enforcement_toggle_disabled?(
                @selected_provider,
                @organization,
                @login_domain_trust,
                @sso_enforced
              )
            }
            phx-click="toggle_sso_enforced"
          />
          <div data-part="label-text">
            <span data-part="title">
              {dgettext("dashboard_account", "Enforce SSO")}
            </span>
            <span data-part="description">
              <%= if oauth2_form_provider?(@selected_provider) and
                       @login_domain_trust not in [:instance, :dns_verified] and
                       not @sso_enforced do %>
                {dgettext(
                  "dashboard_account",
                  "Verify a login email domain before enforcing single sign-on for this provider."
                )}
              <% else %>
                {dgettext(
                  "dashboard_account",
                  "When enabled, organization members will not be able to log in with email and password. They must use SSO instead."
                )}
              <% end %>
            </span>
          </div>
        </div>
      </div>

      <div data-part="footer">
        <.button
          type="submit"
          label={dgettext("dashboard_account", "Save changes")}
          variant="primary"
          size="medium"
          disabled={not @has_changes or not @form_valid}
        />
      </div>
    </.card_section>
  </.form>

  <%!-- ============================================================ --%>
  <%!-- SCIM provisioning                                             --%>
  <%!-- ============================================================ --%>
  <.card_section :if={@organization} data-part="scim-card">
    <div data-part="header">
      <span data-part="title">
        {dgettext("dashboard_account", "SCIM provisioning")}
      </span>
      <span data-part="subtitle">
        {dgettext(
          "dashboard_account",
          "Let your IdP (Okta, Azure AD/Entra, JumpCloud, etc.) provision users into this organization at the SCIM endpoint URL below using a bearer token."
        )}
      </span>
    </div>
    <div data-part="content">
      <div data-part="section" data-section="base-url">
        <div data-part="label">
          <span data-part="title">
            {dgettext("dashboard_account", "SCIM endpoint URL")}
          </span>
        </div>
        <div data-part="field">
          <.copyable_value
            id="scim-base-url"
            value={@scim_base_url}
            copy_label={dgettext("dashboard_account", "Copy SCIM endpoint URL")}
          />
        </div>
      </div>

      <div data-part="section" data-section="tokens">
        <div data-part="label">
          <span data-part="title">
            {dgettext("dashboard_account", "Tokens")}
          </span>
          <span data-part="description">
            {dgettext(
              "dashboard_account",
              "Issue one bearer token per IdP. Revoke a token if it leaks or is no longer needed."
            )}
          </span>
        </div>
        <div data-part="field">
          <.modal
            id="generate-scim-token-modal"
            title={dgettext("dashboard_account", "Generate SCIM token")}
            on_dismiss="dismiss_scim_token"
            on_open_change="scim_modal_open_change"
          >
            <:trigger :let={attrs}>
              <.button
                label={dgettext("dashboard_account", "Generate token")}
                variant="secondary"
                size="medium"
                {attrs}
              />
            </:trigger>

            <div data-part="modal-content-wrapper">
              <.line_divider />

              <%= if @new_scim_token_plaintext do %>
                <div data-part="modal-body">
                  <div data-part="modal-message">
                    <span data-part="title">
                      {dgettext("dashboard_account", "Token created")}
                    </span>
                    <span data-part="subtitle">
                      {dgettext(
                        "dashboard_account",
                        "Copy it now — it will not be shown again after you close this dialog."
                      )}
                    </span>
                  </div>
                  <div data-part="read-only-value">
                    <code id="new-scim-token">{@new_scim_token_plaintext}</code>
                    <.button
                      id="copy-scim-token-button"
                      variant="secondary"
                      size="small"
                      icon_only
                      type="button"
                      phx-hook="Clipboard"
                      data-clipboard-value={@new_scim_token_plaintext}
                      aria-label={dgettext("dashboard_account", "Copy token")}
                    >
                      <.copy />
                    </.button>
                  </div>
                </div>
              <% else %>
                <.form
                  for={@new_scim_token_form}
                  id="generate-scim-token-form"
                  phx-submit="generate_scim_token"
                >
                  <div data-part="modal-body">
                    <.text_input
                      field={@new_scim_token_form[:name]}
                      type="basic"
                      label={dgettext("dashboard_account", "Token name")}
                      sublabel={
                        dgettext(
                          "dashboard_account",
                          "Name this token so you can identify it later (for example: \"Okta\")."
                        )
                      }
                      placeholder={dgettext("dashboard_account", "e.g. Okta")}
                      required
                    />
                  </div>
                </.form>
              <% end %>

              <.line_divider />
            </div>

            <:footer>
              <.modal_footer>
                <:action>
                  <%= if @new_scim_token_plaintext do %>
                    <.button
                      label={dgettext("dashboard_account", "Done")}
                      variant="primary"
                      phx-click="dismiss_scim_token"
                    />
                  <% else %>
                    <.button
                      label={dgettext("dashboard_account", "Cancel")}
                      variant="secondary"
                      phx-click="dismiss_scim_token"
                    />
                    <.button
                      label={dgettext("dashboard_account", "Generate")}
                      variant="primary"
                      type="submit"
                      form="generate-scim-token-form"
                    />
                  <% end %>
                </:action>
              </.modal_footer>
            </:footer>
          </.modal>
        </div>
      </div>

      <div data-part="tokens-table">
        <.table id="scim-tokens-table" rows={@scim_tokens}>
          <:col :let={token} label={dgettext("dashboard_account", "Name")}>
            <.text_cell label={token.name || dgettext("dashboard_account", "Unnamed")} />
          </:col>
          <:col :let={token} label={dgettext("dashboard_account", "Created")}>
            <.text_cell label={Tuist.Utilities.DateFormatter.from_now(token.inserted_at)} />
          </:col>
          <:col :let={token} label={dgettext("dashboard_account", "Last used")}>
            <.text_cell label={
              if token.last_used_at,
                do: Tuist.Utilities.DateFormatter.from_now(token.last_used_at),
                else: dgettext("dashboard_account", "Never")
            } />
          </:col>
          <:col :let={token} label="">
            <.button_cell>
              <:button>
                <.button
                  icon_only
                  variant="secondary"
                  size="small"
                  phx-click="revoke_scim_token"
                  phx-value-id={token.id}
                  aria-label={dgettext("dashboard_account", "Revoke token")}
                  data-confirm={
                    dgettext(
                      "dashboard_account",
                      "Revoke this token? This action cannot be undone."
                    )
                  }
                >
                  <.icon name="trash" />
                </.button>
              </:button>
            </.button_cell>
          </:col>
          <:empty_state>
            <.table_empty_state
              title={dgettext("dashboard_account", "No SCIM tokens yet")}
              subtitle={
                dgettext(
                  "dashboard_account",
                  "Generate one above to start provisioning from your IdP."
                )
              }
            />
          </:empty_state>
        </.table>
      </div>
    </div>
  </.card_section>

  <WorkloadIdentities.workload_identities {assigns} />
</div>
