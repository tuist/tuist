<div id="account-runner-buildkite">
  <div data-part="page-header">
    <div data-part="heading">
      <h1 data-part="title">{dgettext("dashboard_runners", "Buildkite")}</h1>
      <span data-part="subtitle">
        {dgettext(
          "dashboard_runners",
          "Run Buildkite jobs on Tuist runners. Tuist watches the self-hosted queues in your cluster and runs what it finds there."
        )}
      </span>
    </div>
  </div>

  <.card
    title={dgettext("dashboard_runners", "Cluster")}
    icon="server"
    data-part="buildkite-card"
  >
    <.card_section>
      <form phx-submit="connect" data-part="buildkite-form">
        <.alert
          :if={@form_error}
          status="error"
          type="secondary"
          size="small"
          title={@form_error}
        />

        <.alert
          :if={@installation && @installation.last_error}
          status="error"
          type="secondary"
          size="small"
          title={@installation.last_error}
        />

        <div data-part="fields">
          <.text_input
            id="buildkite-organization-slug"
            name="organization_slug"
            label={dgettext("dashboard_runners", "Organization slug")}
            value={(@installation && @installation.organization_slug) || ""}
            placeholder={dgettext("dashboard_runners", ~s(e.g. "acme"))}
            error={@field_errors["organization_slug"]}
            required
            show_required
          />

          <.text_input
            id="buildkite-cluster-name"
            name="cluster_name"
            label={dgettext("dashboard_runners", "Cluster name")}
            value={(@installation && @installation.cluster_name) || ""}
            placeholder={dgettext("dashboard_runners", ~s(e.g. "macOS"))}
            hint={
              dgettext(
                "dashboard_runners",
                "Optional. Only used to label this connection in the dashboard."
              )
            }
            error={@field_errors["cluster_name"]}
          />

          <.text_input
            id="buildkite-agent-token"
            name="agent_token"
            type="password"
            input_type="password"
            label={dgettext("dashboard_runners", "Cluster agent token")}
            placeholder="bkct_..."
            hint={
              dgettext(
                "dashboard_runners",
                "Create it under your cluster's Agent Tokens in Buildkite. It is stored encrypted and never shown again."
              )
            }
            error={@field_errors["agent_token"]}
            required
            show_required
          />
        </div>

        <.button
          label={
            if @installation,
              do: dgettext("dashboard_runners", "Update connection"),
              else: dgettext("dashboard_runners", "Connect")
          }
          variant="primary"
          size="medium"
          type="submit"
        />
      </form>
    </.card_section>

    <%!-- `card_section` takes no title, so a `title` attribute would land in
          the DOM as a hover tooltip instead of a heading. --%>
    <.card_section :if={@installation}>
      <div data-part="status">
        <div data-part="status-row">
          <span data-part="status-label">{dgettext("dashboard_runners", "Last checked")}</span>
          <span data-part="status-value">
            {if @installation.last_polled_at,
              do: Tuist.Utilities.DateFormatter.from_now(@installation.last_polled_at),
              else: dgettext("dashboard_runners", "Not yet")}
          </span>
        </div>

        <.button
          label={dgettext("dashboard_runners", "Disconnect")}
          variant="destructive"
          size="medium"
          phx-click="disconnect"
        />
      </div>
    </.card_section>
  </.card>

  <.card
    title={dgettext("dashboard_runners", "Queues")}
    icon="list_tree"
    data-part="buildkite-queues-card"
  >
    <.card_section>
      <div data-part="queues">
        <span data-part="queues-hint">
          {dgettext(
            "dashboard_runners",
            "Tuist runs a Buildkite job when its queue key matches one of your runner profiles. Create a self-hosted queue in your cluster with one of these keys, then target it with agents: { queue: ... } in your pipeline."
          )}
        </span>

        <ul data-part="buildkite-queue-list">
          <li :for={queue_key <- @queue_keys}>
            <code>{queue_key}</code>
          </li>
        </ul>
      </div>
    </.card_section>
  </.card>
</div>
