<div id="test-selection">
  <.button
    label={dgettext("dashboard_tests", "Test Selection")}
    data-part="back-button"
    variant="secondary"
    size="medium"
    navigate={~p"/#{@selected_account.name}/#{@selected_project.name}/tests/test-selection"}
  >
    <:icon_left><.icon name="arrow_left" /></:icon_left>
  </.button>

  <div data-part="header">
    <div data-part="title-group">
      <div data-part="title">
        <div data-part="kind">
          <div data-part="icon"><.git_commit /></div>
        </div>
        <h1 data-part="label">{short_sha(@sha)}</h1>
        <.button
          id="copy-commit-sha-button"
          variant="secondary"
          size="small"
          icon_only
          type="button"
          phx-hook="Clipboard"
          data-clipboard-value={@sha}
          aria-label={dgettext("dashboard_tests", "Copy commit SHA")}
        >
          <.copy />
        </.button>
      </div>
      <div data-part="badges">
        <.badge :if={@branch} label={@branch} color="neutral" style="light-fill" size="large">
          <:icon><.icon name="git_branch" /></:icon>
        </.badge>
      </div>
    </div>
    <div data-part="filters">
      <.dropdown
        :if={length(@impacts) > 1}
        id="test-selection-baseline-dropdown"
        label={short_sha(@impact.baseline_sha)}
        secondary_text={dgettext("dashboard_tests", "Baseline:")}
      >
        <.dropdown_item
          :for={impact <- @impacts}
          value={impact.baseline_sha}
          label={short_sha(impact.baseline_sha)}
          patch={"?#{@uri.query |> Query.put("baseline", impact.baseline_sha) |> Query.drop("page")}"}
          data-selected={@impact.baseline_sha == impact.baseline_sha}
        >
          <:right_icon :if={@impact.baseline_sha == impact.baseline_sha}><.check /></:right_icon>
        </.dropdown_item>
      </.dropdown>
      <.button
        :if={@coverage?}
        label={dgettext("dashboard_tests", "View coverage")}
        variant="secondary"
        size="medium"
        navigate={coverage_href(assigns, @sha)}
        data-part="coverage-link"
      >
        <:icon_left><.icon name="umbrella" /></:icon_left>
      </.button>
    </div>
  </div>

  <.card title={dgettext("dashboard_tests", "Impact")} icon="list_tree" data-part="plan-card">
    <.card_section data-part="file-summary-section">
      <.alert
        :if={is_nil(@impact)}
        id="test-selection-no-impact"
        type="secondary"
        status="warning"
        size="large"
        title={dgettext("dashboard_tests", "No impact computed")}
        description={
          dgettext(
            "dashboard_tests",
            "Every selection run on this commit fell back to running everything, so none diffed it against a baseline."
          )
        }
      />
      <dl :if={@impact} data-part="file-details">
        <div>
          <dt>{dgettext("dashboard_tests", "Baseline")}</dt>
          <dd>
            <.link_button
              :if={@baseline_coverage?}
              navigate={coverage_href(assigns, @impact.baseline_sha)}
              label={short_sha(@impact.baseline_sha)}
              variant="secondary"
              size="large"
              underline
            />
            <span :if={!@baseline_coverage?}>{short_sha(@impact.baseline_sha)}</span>
          </dd>
        </div>
        <div>
          <dt>{dgettext("dashboard_tests", "Changed files")}</dt>
          <dd>{format_number(@impact.changed_files_count)}</dd>
        </div>
        <div :for={reason <- impact_reasons()}>
          <dt>{reason_label(reason)}</dt>
          <dd>{format_number(Map.get(@impact_reasons, reason, 0))}</dd>
        </div>
        <div>
          <dt>{dgettext("dashboard_tests", "Computed")}</dt>
          <dd>{Tuist.Utilities.DateFormatter.from_now(@impact.inserted_at)}</dd>
        </div>
      </dl>
    </.card_section>
  </.card>

  <.tab_menu_horizontal>
    <.tab_menu_horizontal_item
      :for={tab <- tabs()}
      selected={@tab == tab}
      label={tab_label(tab, assigns)}
      patch={"?#{@uri.query |> Query.put("tab", tab) |> Query.drop("page")}"}
    />
  </.tab_menu_horizontal>

  <%!-- Selection runs --%>
  <.card
    :if={@tab == "runs"}
    title={dgettext("dashboard_tests", "Selection runs")}
    icon="filter"
    data-part="decisions-card"
  >
    <.card_section data-part="decisions-section">
      <div :if={@runs != []} data-part="decisions-table">
        <.table
          id="test-selection-commit-runs-table"
          rows={@runs}
          row_key={& &1.id}
          row_navigate={&run_href(assigns, &1)}
        >
          <:col :let={run} label={scheme_label(@selected_project)}>
            <.text_and_description_cell
              label={if run.test_plan != "", do: run.test_plan, else: run.scheme}
              description={run.destination}
            />
          </:col>
          <:col :let={run} label={dgettext("dashboard_tests", "Baseline")}>
            <.text_cell :if={run.baseline_sha != ""} label={short_sha(run.baseline_sha)} />
            <.badge_cell
              :if={run.fallback_reason != ""}
              label={fallback_label(run.fallback_reason)}
              color="warning"
              style="light-fill"
              icon="alert_triangle"
            />
          </:col>
          <:col :let={run} label={dgettext("dashboard_tests", "Mode")}>
            <.badge_cell
              label={mode_label(run.mode)}
              color={mode_color(run.mode)}
              style="light-fill"
            />
          </:col>
          <:col :let={run} label={dgettext("dashboard_tests", "Selected")}>
            <.text_cell label={"#{format_number(run.selected_count)} / #{format_number(run.requested_count)}"} />
          </:col>
          <:col :let={run} label={dgettext("dashboard_tests", "Misses")}>
            <.status_badge_cell
              :if={run.mode == "dry_run" and run.missed_count > 0}
              status="error"
              label={format_number(run.missed_count)}
            />
            <.text_cell :if={run.mode == "dry_run" and run.missed_count == 0} label="0" />
            <.text_cell :if={run.mode != "dry_run"} label="–" />
          </:col>
          <:col :let={run} label={dgettext("dashboard_tests", "Shards")}>
            <.text_cell label={format_number(run.shard_count)} />
          </:col>
          <:col :let={run} label={dgettext("dashboard_tests", "CI job")}>
            <.text_and_description_cell label={run.ci_job_id} description={run.ci_run_id} />
          </:col>
          <:col :let={run} label={dgettext("dashboard_tests", "Selected at")}>
            <.text_cell sublabel={Tuist.Utilities.DateFormatter.from_now(run.inserted_at)} />
          </:col>
        </.table>
      </div>
      <.coverage_empty
        :if={@runs == []}
        title={dgettext("dashboard_tests", "No invocation asked for a selection on this commit")}
        image="table"
        data-part="empty-runs"
      />
    </.card_section>
  </.card>

  <%!-- Changed files --%>
  <.card
    :if={@tab == "files"}
    title={dgettext("dashboard_tests", "Changed files")}
    icon="file"
    data-part="files-card"
  >
    <.card_section data-part="files-section">
      <div data-part="filters">
        <.form
          for={%{}}
          id="search-test-selection-files-form"
          phx-change="search-files"
          phx-debounce="200"
        >
          <.text_input
            type="search"
            id="search-test-selection-files"
            name="search"
            placeholder={dgettext("dashboard_tests", "Search by path...")}
            show_suffix={false}
            data-part="search"
            value={@files_search}
          />
        </.form>
        <.dropdown
          id="test-selection-kind-dropdown"
          label={kind_filter_label(@kind_filter)}
          secondary_text={dgettext("dashboard_tests", "Kind:")}
        >
          <.dropdown_item
            :for={kind <- ~w(any source test resource tracked ignored)}
            value={kind}
            label={kind_filter_label(kind)}
            patch={"?#{@uri.query |> Query.put("kind", kind) |> Query.drop("page")}"}
            data-selected={@kind_filter == kind}
          >
            <:right_icon :if={@kind_filter == kind}><.check /></:right_icon>
          </.dropdown_item>
        </.dropdown>
      </div>

      <div :if={@files != []} data-part="files-table">
        <.table id="test-selection-files-table" rows={@files} row_key={& &1.path}>
          <:col :let={file} label={dgettext("dashboard_tests", "File")}>
            <.text_and_description_cell
              label={Path.basename(file.path)}
              description={parent_dir(file.path)}
            />
          </:col>
          <:col :let={file} label={dgettext("dashboard_tests", "Change")}>
            <.status_badge_cell
              status={file_status(file.status)}
              label={file_status_label(file.status)}
            />
          </:col>
          <:col :let={file} label={dgettext("dashboard_tests", "Kind")}>
            <.badge_cell
              label={file_kind_label(file.kind)}
              color={file_kind_color(file.kind)}
              style="light-fill"
            />
          </:col>
          <:col :let={file} label={dgettext("dashboard_tests", "Tests it reaches")}>
            <.text_cell label={format_number(file.impacted_tests_count)} />
          </:col>
        </.table>
        <.pagination_group
          :if={@files_meta.total_pages > 1}
          current_page={@files_meta.current_page}
          number_of_pages={@files_meta.total_pages}
          page_patch={fn page -> "?#{Query.put(@uri.query, "page", page)}" end}
        />
      </div>

      <.coverage_empty
        :if={@files == []}
        title={
          if @impact,
            do: dgettext("dashboard_tests", "No file matches"),
            else: dgettext("dashboard_tests", "No baseline to diff against")
        }
        image="table"
        data-part="empty-files"
      />
    </.card_section>
  </.card>

  <%!-- Affected tests --%>
  <.card
    :if={@tab == "tests"}
    title={dgettext("dashboard_tests", "Affected tests")}
    icon="subtask"
    data-part="decisions-card"
  >
    <.card_section data-part="decisions-section">
      <div data-part="filters">
        <.form
          for={%{}}
          id="search-test-selection-affected-form"
          phx-change="search-tests"
          phx-debounce="200"
        >
          <.text_input
            type="search"
            id="search-test-selection-affected"
            name="search"
            placeholder={dgettext("dashboard_tests", "Search...")}
            show_suffix={false}
            data-part="search"
            value={@tests_search}
          />
        </.form>
        <.dropdown
          id="test-selection-reason-dropdown"
          label={reason_filter_label(@reason_filter)}
          secondary_text={dgettext("dashboard_tests", "Reason:")}
        >
          <.dropdown_item
            :for={reason <- ["any" | impact_reasons()]}
            value={reason}
            label={reason_filter_label(reason)}
            patch={"?#{@uri.query |> Query.put("reason", reason) |> Query.drop("page")}"}
            data-selected={@reason_filter == reason}
          >
            <:right_icon :if={@reason_filter == reason}><.check /></:right_icon>
          </.dropdown_item>
        </.dropdown>
      </div>

      <div :if={@tests != []} data-part="decisions-table">
        <.table
          id="test-selection-affected-table"
          rows={@tests}
          row_key={& &1.test_case_id}
          row_navigate={&test_case_href(assigns, &1)}
        >
          <:col :let={test} label={dgettext("dashboard_tests", "Test")}>
            <.text_and_description_cell label={test.name} description={test_location(test)} />
          </:col>
          <:col :let={test} label={dgettext("dashboard_tests", "Reason")}>
            <.text_cell label={reason_label(test.reason)} />
          </:col>
          <:col :let={test} label={dgettext("dashboard_tests", "Matched path")}>
            <.text_and_description_cell
              :if={test.matched_path != ""}
              label={Path.basename(test.matched_path)}
              description={parent_dir(test.matched_path)}
            />
            <.text_cell :if={test.matched_path == ""} label="–" />
          </:col>
        </.table>
        <.pagination_group
          :if={@tests_meta.total_pages > 1}
          current_page={@tests_meta.current_page}
          number_of_pages={@tests_meta.total_pages}
          page_patch={fn page -> "?#{Query.put(@uri.query, "page", page)}" end}
        />
      </div>

      <.coverage_empty
        :if={@tests == []}
        title={
          if @impact,
            do: dgettext("dashboard_tests", "No test matches"),
            else: dgettext("dashboard_tests", "No baseline to diff against")
        }
        image="table"
        data-part="empty-tests"
      />
    </.card_section>
  </.card>
</div>
