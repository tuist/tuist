<div id="gradle-build">
  <.button
    label={dgettext("dashboard_gradle", "Build Runs")}
    data-part="back-button"
    variant="secondary"
    size="medium"
    navigate={~p"/#{@selected_account.name}/#{@selected_project.name}/builds/build-runs"}
  >
    <:icon_left>
      <.icon name="arrow_left" />
    </:icon_left>
  </.button>
  <div data-part="header">
    <div data-part="title-group">
      <div data-part="title">
        <div :if={@build.status == "success"} data-part="badge-success">
          <div data-part="icon">
            <.circle_check />
          </div>
        </div>
        <div :if={@build.status == "failure"} data-part="badge-failure">
          <div data-part="icon">
            <.alert_circle />
          </div>
        </div>
        <div :if={@build.status == "cancelled"} data-part="badge-failure">
          <div data-part="icon">
            <.alert_circle />
          </div>
        </div>
        <h1 data-part="label">{@title}</h1>
        <.badge
          :if={Enum.any?(@build.custom_tags || [])}
          label={List.first(@build.custom_tags)}
          color="success"
          style="light-fill"
          size="large"
        />
        <.badge
          :for={tag <- Enum.slice(@build.custom_tags || [], 1..-1//1)}
          label={tag}
          color="information"
          style="light-fill"
          size="large"
        />
      </div>
      <.link_button
        :if={@test_run}
        navigate={
          ~p"/#{@selected_account.name}/#{@selected_project.name}/tests/test-runs/#{@test_run.id}"
        }
        label={
          dgettext("dashboard_gradle", "Test: %{scheme}",
            scheme:
              if(@test_run.scheme == "",
                do: dgettext("dashboard_gradle", "Unknown"),
                else: @test_run.scheme
              )
          )
        }
        size="large"
        underline
      >
        <:icon_left><.subtask /></:icon_left>
      </.link_button>
    </div>
  </div>
  <.tab_menu_horizontal>
    <.tab_menu_horizontal_item
      label={dgettext("dashboard_gradle", "Overview")}
      selected={@selected_tab == "overview"}
      patch={"?#{Query.put(@uri.query, "tab", "overview")}"}
    />
    <.tab_menu_horizontal_item
      :if={(@build.cacheable_tasks_count || 0) > 0}
      label={dgettext("dashboard_gradle", "Gradle Cache")}
      selected={@selected_tab == "gradle-cache"}
      patch={"?#{Query.put(@uri.query, "tab", "gradle-cache")}"}
    />
    <.tab_menu_horizontal_item
      :if={@has_build_setup_data}
      label={dgettext("dashboard_gradle", "Build Setup")}
      selected={@selected_tab == "build-setup"}
      patch={"?#{Query.put(@uri.query, "tab", "build-setup")}"}
    />
    <.tab_menu_horizontal_item
      :if={length(@machine_metrics) > 0}
      label={dgettext("dashboard_gradle", "Machine Metrics")}
      selected={@selected_tab == "machine-metrics"}
      patch={"?#{Query.put(@uri.query, "tab", "machine-metrics")}"}
    />
  </.tab_menu_horizontal>
  <%= if @selected_tab == "overview" do %>
    <.card
      title={dgettext("dashboard_gradle", "Build Details")}
      icon="chart_arcs"
      data-part="build-details"
    >
      <.card_section data-part="build-details-section">
        <div data-part="metadata-grid">
          <div data-part="metadata-row">
            <div data-part="metadata">
              <div data-part="title">{dgettext("dashboard_gradle", "Status")}</div>
              <.badge
                :if={@build.status == "success"}
                label={dgettext("dashboard_gradle", "Success")}
                color="success"
                style="fill"
                size="large"
              />
              <.badge
                :if={@build.status == "failure"}
                label={dgettext("dashboard_gradle", "Failure")}
                color="destructive"
                style="fill"
                size="large"
              />
              <.badge
                :if={@build.status == "cancelled"}
                label={dgettext("dashboard_gradle", "Cancelled")}
                color="warning"
                style="fill"
                size="large"
              />
            </div>
            <div data-part="metadata">
              <div data-part="title">{dgettext("dashboard_gradle", "Duration")}</div>
              <span data-part="label">
                <.history />
                {format_duration(@build.duration_ms)}
              </span>
            </div>
            <div data-part="metadata">
              <div data-part="title">{dgettext("dashboard_gradle", "Built at")}</div>
              <span data-part="label">
                {Tuist.Utilities.DateFormatter.from_now(@build.inserted_at)}
              </span>
            </div>
            <div data-part="metadata">
              <div data-part="title">{dgettext("dashboard_gradle", "Built by")}</div>
              <.gradle_build_ran_by_badge_cell build={@build} />
            </div>
          </div>
          <div data-part="metadata-row">
            <div :if={@build.gradle_version} data-part="metadata">
              <div data-part="title">{dgettext("dashboard_gradle", "Gradle Version")}</div>
              <span data-part="label">{@build.gradle_version}</span>
            </div>
            <div :if={@build.java_version} data-part="metadata">
              <div data-part="title">{dgettext("dashboard_gradle", "Java Version")}</div>
              <span data-part="label">{@build.java_version}</span>
            </div>
            <div :if={@build.git_branch} data-part="metadata">
              <div data-part="title">{dgettext("dashboard_gradle", "Branch")}</div>
              <span data-part="label">
                <.git_branch />
                {@build.git_branch}
              </span>
            </div>
            <div :if={@build.git_commit_sha} data-part="metadata">
              <div data-part="title">{dgettext("dashboard_gradle", "Commit")}</div>
              <span data-part="label">{String.slice(@build.git_commit_sha, 0, 8)}</span>
            </div>
          </div>
          <div :if={@build.requested_tasks != []} data-part="metadata-row">
            <div data-part="metadata">
              <div data-part="title">{dgettext("dashboard_gradle", "Requested tasks")}</div>
              <span data-part="label">{Enum.join(@build.requested_tasks, " ")}</span>
            </div>
          </div>
        </div>
        <div :if={map_size(@build.custom_values || %{}) > 0} data-part="custom-metadata-section">
          <span data-part="custom-metadata-label">
            {dgettext("dashboard_gradle", "Custom metadata")}
          </span>
          <.table
            id="custom-metadata-table"
            rows={Map.to_list(@build.custom_values)}
            row_key={fn {key, _value} -> key end}
          >
            <:col :let={{key, _value}} label={dgettext("dashboard_gradle", "Key")}>
              <.text_cell label={key} />
            </:col>
            <:col :let={{_key, value}} label={dgettext("dashboard_gradle", "Value")}>
              <a
                :if={url?(value)}
                href={value}
                target="_blank"
                rel="noopener noreferrer"
                data-part="custom-metadata-link"
              >
                {value}
              </a>
              <.text_cell :if={not url?(value)} label={value} />
            </:col>
          </.table>
        </div>
      </.card_section>
    </.card>
    <.card
      title={dgettext("dashboard_gradle", "Tasks")}
      icon="subtask"
      data-part="tasks-card"
    >
      <.card_section data-part="tasks-table-section">
        <div data-part="filters">
          <.form for={%{}} phx-change="search-tasks" phx-debounce="200">
            <.text_input
              type="search"
              id="search-tasks"
              name="search"
              placeholder={dgettext("dashboard_gradle", "Search...")}
              show_suffix={false}
              data-part="search"
              value={@tasks_filter}
            />
          </.form>
          <.dropdown
            id="tasks-sort-by"
            label={
              case @tasks_sort_by do
                "task_path" -> dgettext("dashboard_gradle", "Task")
                "duration_ms" -> dgettext("dashboard_gradle", "Duration")
                _ -> dgettext("dashboard_gradle", "Started after")
              end
            }
            secondary_text={dgettext("dashboard_gradle", "Sort by:")}
          >
            <.dropdown_item
              value="started_at"
              label={dgettext("dashboard_gradle", "Started after")}
              patch={
                "?#{@uri.query
                |> Query.put("tasks-sort-by", "started_at")
                |> Query.put("tasks-sort-order", "asc")
                |> Query.drop("tasks-page")}"
              }
              data-selected={@tasks_sort_by == "started_at"}
            >
              <:right_icon><.check /></:right_icon>
            </.dropdown_item>
            <.dropdown_item
              value="task_path"
              label={dgettext("dashboard_gradle", "Task")}
              patch={
                "?#{@uri.query
                |> Query.put("tasks-sort-by", "task_path")
                |> Query.put("tasks-sort-order", "asc")
                |> Query.drop("tasks-page")}"
              }
              data-selected={@tasks_sort_by == "task_path"}
            >
              <:right_icon><.check /></:right_icon>
            </.dropdown_item>
            <.dropdown_item
              value="duration_ms"
              label={dgettext("dashboard_gradle", "Duration")}
              patch={
                "?#{@uri.query
                |> Query.put("tasks-sort-by", "duration_ms")
                |> Query.put("tasks-sort-order", "asc")
                |> Query.drop("tasks-page")}"
              }
              data-selected={@tasks_sort_by == "duration_ms"}
            >
              <:right_icon><.check /></:right_icon>
            </.dropdown_item>
          </.dropdown>
          <.filter_dropdown
            id="tasks-filter-dropdown"
            label={dgettext("dashboard_gradle", "Filter")}
            available_filters={@available_filters}
            active_filters={@tasks_active_filters}
          />
        </div>
        <div
          :if={Enum.any?(@tasks_active_filters)}
          data-part="active-filters"
        >
          <.active_filter :for={filter <- @tasks_active_filters} filter={filter} />
        </div>
        <.table id="gradle-tasks-table" rows={@tasks}>
          <:col
            :let={task}
            label={dgettext("dashboard_gradle", "Task")}
            patch={
              @tasks_sort_by == "task_path" &&
                "?#{@uri.query |> Query.put("tasks-sort-by", "task_path") |> Query.put("tasks-sort-order", sort_order_patch_value("task_path", @tasks_sort_by, @tasks_sort_order)) |> Query.drop("tasks-page")}"
            }
            sort_order={@tasks_sort_by == "task_path" && @tasks_sort_order}
          >
            <.text_cell label={task.task_path} />
          </:col>
          <:col :let={task} label={dgettext("dashboard_gradle", "Outcome")}>
            <.badge_cell
              label={outcome_label(task.outcome)}
              color={outcome_color(task.outcome)}
              style="light-fill"
            />
          </:col>
          <:col
            :let={task}
            label={dgettext("dashboard_gradle", "Started after")}
            patch={
              @tasks_sort_by == "started_at" &&
                "?#{@uri.query |> Query.put("tasks-sort-by", "started_at") |> Query.put("tasks-sort-order", sort_order_patch_value("started_at", @tasks_sort_by, @tasks_sort_order)) |> Query.drop("tasks-page")}"
            }
            sort_order={@tasks_sort_by == "started_at" && @tasks_sort_order}
          >
            <.text_cell label={started_after(task, @build_started_at)} />
          </:col>
          <:col
            :let={task}
            label={dgettext("dashboard_gradle", "Duration")}
            patch={
              @tasks_sort_by == "duration_ms" &&
                "?#{@uri.query |> Query.put("tasks-sort-by", "duration_ms") |> Query.put("tasks-sort-order", sort_order_patch_value("duration_ms", @tasks_sort_by, @tasks_sort_order)) |> Query.drop("tasks-page")}"
            }
            sort_order={@tasks_sort_by == "duration_ms" && @tasks_sort_order}
          >
            <.text_cell label={format_duration(task.duration_ms)} icon="history" />
          </:col>
          <:empty_state>
            <.table_empty_state
              icon="subtask"
              title={dgettext("dashboard_gradle", "No tasks")}
              subtitle={dgettext("dashboard_gradle", "This build has no task data.")}
            />
          </:empty_state>
        </.table>
        <.pagination_group
          :if={@tasks_page_count > 1}
          current_page={@tasks_page}
          number_of_pages={@tasks_page_count}
          page_patch={
            fn page ->
              "?#{Query.put(@uri.query, "tasks-page", page)}"
            end
          }
        />
      </.card_section>
    </.card>
  <% end %>
  <%= if @selected_tab == "build-setup" do %>
    <div data-part="build-setup">
      <.card
        title={dgettext("dashboard_gradle", "Configuration")}
        icon="settings"
        data-part="configuration-card"
      >
        <.card_section data-part="configuration-summary">
          <.widget
            title={dgettext("dashboard_gradle", "Configuration time")}
            description={
              dgettext("dashboard_gradle", "Time Gradle spent configuring this build.")
            }
            value={format_duration(@configuration_duration_ms)}
            id="widget-configuration-time"
            empty={@configuration_duration_ms == 0}
            empty_label={dgettext("dashboard_gradle", "No data")}
          />
          <.widget
            title={dgettext("dashboard_gradle", "Configuration cache")}
            description={
              dgettext(
                "dashboard_gradle",
                "Status of Gradle's configuration cache for this build."
              )
            }
            value={configuration_cache_status_label(@build.configuration_cache_status)}
            id="widget-configuration-cache"
            empty={@build.configuration_cache_status == ""}
            empty_label={dgettext("dashboard_gradle", "Not requested")}
          />
          <.widget
            title={dgettext("dashboard_gradle", "Configuration cache load")}
            description={
              dgettext(
                "dashboard_gradle",
                "Time spent loading a reused configuration cache entry."
              )
            }
            value={
              if @build.configuration_cache_load_duration_ms,
                do: format_duration(@build.configuration_cache_load_duration_ms),
                else: dgettext("dashboard_gradle", "—")
            }
            id="widget-configuration-cache-load"
            empty={is_nil(@build.configuration_cache_load_duration_ms)}
            empty_label={dgettext("dashboard_gradle", "No data")}
          />
        </.card_section>
        <.card_section
          :if={@build.configuration_cache_invalidation_reasons != []}
          data-part="configuration-cache-invalidation-reasons"
        >
          <div data-part="title">
            <span data-part="label">{dgettext("dashboard_gradle", "Invalidation reasons")}</span>
          </div>
          <ul>
            <li :for={reason <- @build.configuration_cache_invalidation_reasons}>{reason}</li>
          </ul>
        </.card_section>
        <.card_section
          :if={@configuration_timeline_operations != []}
          data-part="configuration-timeline-section"
        >
          <div data-part="timeline-scale">
            <span></span>
            <div data-part="timeline-scale-labels">
              <span>0s</span>
              <span>{format_duration(@configuration_timeline_range.duration_ms)}</span>
            </div>
            <span></span>
          </div>
          <div data-part="timeline">
            <div
              :for={timeline_operation <- @configuration_timeline_operations}
              data-part="timeline-row"
            >
              <div data-part="timeline-label">
                <span data-part="timeline-phase">
                  {configuration_phase_label(timeline_operation.operation.phase)}
                </span>
                <span data-part="timeline-scope">
                  {configuration_operation_scope(timeline_operation.operation)}
                </span>
              </div>
              <div data-part="timeline-track">
                <div
                  data-part="timeline-bar"
                  data-phase={timeline_operation.operation.phase}
                  style={configuration_timeline_bar_style(timeline_operation)}
                  title={
                    "#{configuration_phase_label(timeline_operation.operation.phase)} · #{configuration_operation_scope(timeline_operation.operation)} · #{format_duration(timeline_operation.operation.duration_ms)}"
                  }
                >
                </div>
              </div>
              <span data-part="timeline-duration">
                {format_duration(timeline_operation.operation.duration_ms)}
              </span>
            </div>
          </div>
          <p data-part="timeline-note">
            {dgettext(
              "dashboard_gradle",
              "Operations can overlap. Build timing includes its settings and project configuration."
            )}
          </p>
        </.card_section>
        <.card_section
          :if={@configuration_operations != []}
          data-part="configuration-operations-table-section"
        >
          <div data-part="filters">
            <.form for={%{}} phx-change="search-configuration-operations" phx-debounce="200">
              <.text_input
                type="search"
                id="search-configuration-operations"
                name="search"
                placeholder={dgettext("dashboard_gradle", "Search...")}
                show_suffix={false}
                data-part="search"
                value={@configuration_operations_filter}
              />
            </.form>
            <.dropdown
              id="configuration-operations-sort-by"
              label={configuration_operations_sort_label(@configuration_operations_sort_by)}
              secondary_text={dgettext("dashboard_gradle", "Sort by:")}
            >
              <.dropdown_item
                value="started_at"
                label={dgettext("dashboard_gradle", "Started after")}
                patch={configuration_operations_sort_patch(@uri.query, "started_at", "asc")}
                data-selected={@configuration_operations_sort_by == "started_at"}
              >
                <:right_icon><.check /></:right_icon>
              </.dropdown_item>
              <.dropdown_item
                value="duration_ms"
                label={dgettext("dashboard_gradle", "Duration")}
                patch={configuration_operations_sort_patch(@uri.query, "duration_ms", "desc")}
                data-selected={@configuration_operations_sort_by == "duration_ms"}
              >
                <:right_icon><.check /></:right_icon>
              </.dropdown_item>
              <.dropdown_item
                value="phase"
                label={dgettext("dashboard_gradle", "Phase")}
                patch={configuration_operations_sort_patch(@uri.query, "phase", "asc")}
                data-selected={@configuration_operations_sort_by == "phase"}
              >
                <:right_icon><.check /></:right_icon>
              </.dropdown_item>
              <.dropdown_item
                value="scope"
                label={dgettext("dashboard_gradle", "Configured unit")}
                patch={configuration_operations_sort_patch(@uri.query, "scope", "asc")}
                data-selected={@configuration_operations_sort_by == "scope"}
              >
                <:right_icon><.check /></:right_icon>
              </.dropdown_item>
            </.dropdown>
            <.filter_dropdown
              id="configuration-operations-filter-dropdown"
              label={dgettext("dashboard_gradle", "Filter")}
              available_filters={@configuration_operations_available_filters}
              active_filters={@configuration_operations_active_filters}
            />
          </div>
          <div
            :if={Enum.any?(@configuration_operations_active_filters)}
            data-part="active-filters"
          >
            <.active_filter
              :for={filter <- @configuration_operations_active_filters}
              filter={filter}
            />
          </div>
          <.table
            id="gradle-configuration-operations-table"
            rows={@configuration_operations_table}
          >
            <:col
              :let={operation}
              label={dgettext("dashboard_gradle", "Phase")}
              patch={
                configuration_operations_column_sort_patch(
                  @uri.query,
                  "phase",
                  @configuration_operations_sort_by,
                  @configuration_operations_sort_order
                )
              }
              sort_order={
                @configuration_operations_sort_by == "phase" &&
                  @configuration_operations_sort_order
              }
            >
              <.text_cell label={configuration_phase_label(operation.phase)} />
            </:col>
            <:col
              :let={operation}
              label={dgettext("dashboard_gradle", "Configured unit")}
              patch={
                configuration_operations_column_sort_patch(
                  @uri.query,
                  "scope",
                  @configuration_operations_sort_by,
                  @configuration_operations_sort_order
                )
              }
              sort_order={
                @configuration_operations_sort_by == "scope" &&
                  @configuration_operations_sort_order
              }
            >
              <.badge_cell
                label={
                  if root_build_configuration_operation?(operation),
                    do: dgettext("dashboard_gradle", "Root build"),
                    else: configuration_operation_scope(operation)
                }
                color="neutral"
                style="light-fill"
              />
            </:col>
            <:col
              :let={operation}
              label={dgettext("dashboard_gradle", "Started after")}
              patch={
                configuration_operations_column_sort_patch(
                  @uri.query,
                  "started_at",
                  @configuration_operations_sort_by,
                  @configuration_operations_sort_order
                )
              }
              sort_order={
                @configuration_operations_sort_by == "started_at" &&
                  @configuration_operations_sort_order
              }
            >
              <.text_cell label={started_after(operation, @configuration_timeline_range.start_at)} />
            </:col>
            <:col
              :let={operation}
              label={dgettext("dashboard_gradle", "Duration")}
              patch={
                configuration_operations_column_sort_patch(
                  @uri.query,
                  "duration_ms",
                  @configuration_operations_sort_by,
                  @configuration_operations_sort_order
                )
              }
              sort_order={
                @configuration_operations_sort_by == "duration_ms" &&
                  @configuration_operations_sort_order
              }
            >
              <.text_cell label={format_duration(operation.duration_ms)} icon="history" />
            </:col>
            <:empty_state>
              <.table_empty_state
                icon="settings"
                title={dgettext("dashboard_gradle", "No configuration operations")}
                subtitle={dgettext("dashboard_gradle", "Try adjusting your search or filters.")}
              />
            </:empty_state>
          </.table>
          <.pagination_group
            :if={@configuration_operations_page_count > 1}
            current_page={@configuration_operations_page}
            number_of_pages={@configuration_operations_page_count}
            page_patch={
              fn page ->
                "?#{Query.put(@uri.query, "configuration-operations-page", page)}"
              end
            }
          />
        </.card_section>
      </.card>
      <.card
        :if={@artifact_transforms != []}
        title={dgettext("dashboard_gradle", "Artifact Transforms")}
        icon="subtask"
        data-part="artifact-transforms-card"
      >
        <.card_section data-part="artifact-transforms-summary">
          <.widget
            title={dgettext("dashboard_gradle", "Transforms")}
            description={
              dgettext("dashboard_gradle", "Artifact transforms recorded for this build.")
            }
            value={length(@artifact_transforms)}
            id="widget-artifact-transforms"
          />
          <.widget
            title={dgettext("dashboard_gradle", "Transform time")}
            description={
              dgettext("dashboard_gradle", "Total time spent in recorded artifact transforms.")
            }
            value={format_duration(@artifact_transform_duration_ms)}
            id="widget-artifact-transform-time"
          />
        </.card_section>
        <.card_section data-part="artifact-transforms-table-section">
          <div data-part="filters">
            <.form for={%{}} phx-change="search-artifact-transforms" phx-debounce="200">
              <.text_input
                type="search"
                id="search-artifact-transforms"
                name="search"
                placeholder={dgettext("dashboard_gradle", "Search...")}
                show_suffix={false}
                data-part="search"
                value={@artifact_transforms_filter}
              />
            </.form>
            <.dropdown
              id="artifact-transforms-sort-by"
              label={artifact_transforms_sort_label(@artifact_transforms_sort_by)}
              secondary_text={dgettext("dashboard_gradle", "Sort by:")}
            >
              <.dropdown_item
                value="transformer_name"
                label={dgettext("dashboard_gradle", "Transform")}
                patch={artifact_transforms_sort_patch(@uri.query, "transformer_name", "asc")}
                data-selected={@artifact_transforms_sort_by == "transformer_name"}
              >
                <:right_icon><.check /></:right_icon>
              </.dropdown_item>
              <.dropdown_item
                value="artifact_name"
                label={dgettext("dashboard_gradle", "Artifact")}
                patch={artifact_transforms_sort_patch(@uri.query, "artifact_name", "asc")}
                data-selected={@artifact_transforms_sort_by == "artifact_name"}
              >
                <:right_icon><.check /></:right_icon>
              </.dropdown_item>
              <.dropdown_item
                value="subject_name"
                label={dgettext("dashboard_gradle", "Subject")}
                patch={artifact_transforms_sort_patch(@uri.query, "subject_name", "asc")}
                data-selected={@artifact_transforms_sort_by == "subject_name"}
              >
                <:right_icon><.check /></:right_icon>
              </.dropdown_item>
              <.dropdown_item
                value="duration_ms"
                label={dgettext("dashboard_gradle", "Duration")}
                patch={artifact_transforms_sort_patch(@uri.query, "duration_ms", "desc")}
                data-selected={@artifact_transforms_sort_by == "duration_ms"}
              >
                <:right_icon><.check /></:right_icon>
              </.dropdown_item>
            </.dropdown>
            <.filter_dropdown
              id="artifact-transforms-filter-dropdown"
              label={dgettext("dashboard_gradle", "Filter")}
              available_filters={@artifact_transforms_available_filters}
              active_filters={@artifact_transforms_active_filters}
            />
          </div>
          <div :if={Enum.any?(@artifact_transforms_active_filters)} data-part="active-filters">
            <.active_filter :for={filter <- @artifact_transforms_active_filters} filter={filter} />
          </div>
          <.table id="gradle-artifact-transforms-table" rows={@artifact_transforms_table}>
            <:col
              :let={transform}
              label={dgettext("dashboard_gradle", "Transform")}
              patch={
                artifact_transforms_column_sort_patch(
                  @uri.query,
                  "transformer_name",
                  @artifact_transforms_sort_by,
                  @artifact_transforms_sort_order
                )
              }
              sort_order={
                @artifact_transforms_sort_by == "transformer_name" &&
                  @artifact_transforms_sort_order
              }
            >
              <.text_cell label={transform.transformer_name} />
            </:col>
            <:col
              :let={transform}
              label={dgettext("dashboard_gradle", "Artifact")}
              patch={
                artifact_transforms_column_sort_patch(
                  @uri.query,
                  "artifact_name",
                  @artifact_transforms_sort_by,
                  @artifact_transforms_sort_order
                )
              }
              sort_order={
                @artifact_transforms_sort_by == "artifact_name" && @artifact_transforms_sort_order
              }
            >
              <.text_cell label={transform.artifact_name} />
            </:col>
            <:col
              :let={transform}
              label={dgettext("dashboard_gradle", "Subject")}
              patch={
                artifact_transforms_column_sort_patch(
                  @uri.query,
                  "subject_name",
                  @artifact_transforms_sort_by,
                  @artifact_transforms_sort_order
                )
              }
              sort_order={
                @artifact_transforms_sort_by == "subject_name" && @artifact_transforms_sort_order
              }
            >
              <.text_cell label={transform.subject_name} />
            </:col>
            <:col
              :let={transform}
              label={dgettext("dashboard_gradle", "Duration")}
              patch={
                artifact_transforms_column_sort_patch(
                  @uri.query,
                  "duration_ms",
                  @artifact_transforms_sort_by,
                  @artifact_transforms_sort_order
                )
              }
              sort_order={
                @artifact_transforms_sort_by == "duration_ms" && @artifact_transforms_sort_order
              }
            >
              <.text_cell label={format_duration(transform.duration_ms)} icon="history" />
            </:col>
            <:empty_state>
              <.table_empty_state
                icon="subtask"
                title={dgettext("dashboard_gradle", "No artifact transforms")}
                subtitle={dgettext("dashboard_gradle", "Try adjusting your search or filters.")}
              />
            </:empty_state>
          </.table>
          <.pagination_group
            :if={@artifact_transforms_page_count > 1}
            current_page={@artifact_transforms_page}
            number_of_pages={@artifact_transforms_page_count}
            page_patch={
              fn page ->
                "?#{Query.put(@uri.query, "artifact-transforms-page", page)}"
              end
            }
          />
        </.card_section>
      </.card>
    </div>
  <% end %>
  <%= if @selected_tab == "machine-metrics" do %>
    <.machine_metrics_charts metrics={@machine_metrics} />
  <% end %>
  <%= if @selected_tab == "gradle-cache" do %>
    <div data-part="cache">
      <.card
        title={dgettext("dashboard_gradle", "Cache Summary")}
        icon="chart_arcs"
        data-part="cache-summary-card"
      >
        <.card_section data-part="widgets-card-section">
          <.widget
            title={dgettext("dashboard_gradle", "Task hits")}
            description={
              dgettext(
                "dashboard_gradle",
                "Cacheable tasks that were retrieved from cache (local + remote)."
              )
            }
            value={@from_cache}
            id="widget-task-hits"
          />
          <.widget
            title={dgettext("dashboard_gradle", "Task misses")}
            description={
              dgettext("dashboard_gradle", "Cacheable tasks that were not found in cache.")
            }
            value={@cache_misses}
            id="widget-task-misses"
          />
          <.widget
            title={dgettext("dashboard_gradle", "Hit rate")}
            description={
              dgettext(
                "dashboard_gradle",
                "The percentage of cacheable tasks that were cache hits (local + remote)."
              )
            }
            value={dgettext("dashboard_gradle", "%{hit_rate}%", hit_rate: @cache_hit_rate)}
            id="widget-hit-rate"
            empty={@cacheable_count == 0}
          />
          <.widget
            title={dgettext("dashboard_gradle", "Cache downloads")}
            description={
              dgettext(
                "dashboard_gradle",
                "Total size of cache artifacts downloaded from remote cache."
              )
            }
            value={ByteFormatter.format_bytes(@cache_download_bytes)}
            id="widget-cache-downloads"
          />
          <.widget
            title={dgettext("dashboard_gradle", "Cache uploads")}
            description={
              dgettext(
                "dashboard_gradle",
                "Total size of cache artifacts uploaded to remote cache."
              )
            }
            value={ByteFormatter.format_bytes(@cache_upload_bytes)}
            id="widget-cache-uploads"
          />
          <.widget
            title={dgettext("dashboard_gradle", "Confirmed remote misses")}
            description={
              dgettext(
                "dashboard_gradle",
                "Cacheable tasks for which Gradle checked the remote cache and found no entry."
              )
            }
            value={@confirmed_remote_cache_miss_count}
            id="widget-confirmed-remote-misses"
          />
          <.widget
            title={dgettext("dashboard_gradle", "Missed execution time")}
            description={
              dgettext(
                "dashboard_gradle",
                "Time spent executing tasks after a confirmed remote cache miss."
              )
            }
            value={format_duration(@confirmed_remote_cache_miss_duration_ms)}
            id="widget-missed-execution-time"
          />
          <.widget
            title={dgettext("dashboard_gradle", "Remote entries stored")}
            description={
              dgettext(
                "dashboard_gradle",
                "Task outputs this build successfully stored in the remote cache."
              )
            }
            value={@remote_cache_entries_stored_count}
            id="widget-remote-entries-stored"
          />
        </.card_section>
      </.card>
      <.card
        title={dgettext("dashboard_gradle", "Cacheable Tasks")}
        icon="database"
        data-part="cacheable-tasks-card"
      >
        <.card_section data-part="cacheable-tasks-outer-section">
          <.card_section
            :if={(@build.cacheable_tasks_count || 0) > 0}
            data-part="cacheable-tasks-card-section"
          >
            <div data-part="title">
              <span data-part="label">
                {dgettext("dashboard_gradle", "Cacheable tasks:")}
              </span>
              <span data-part="value">
                {@build.cacheable_tasks_count || 0}
              </span>
            </div>
            <.chart
              id="cacheable-tasks-breakdown-chart"
              type="bar"
              extra_options={
                %{
                  tooltip: %{
                    trigger: "axis",
                    axisPointer: %{
                      type: "none"
                    }
                  },
                  legend: %{
                    left: "-0.3%",
                    top: "bottom",
                    orient: "horizontal",
                    textStyle: %{
                      color: "var:noora-surface-label-primary",
                      fontFamily: "monospace",
                      fontWeight: 400,
                      fontSize: 10,
                      lineHeight: 12
                    },
                    icon:
                      "path://M0 6C0 4.89543 0.895431 4 2 4H6C7.10457 4 8 4.89543 8 6C8 7.10457 7.10457 8 6 8H2C0.895431 8 0 7.10457 0 6Z",
                    itemWidth: 8,
                    itemHeight: 4
                  },
                  grid: %{
                    width: "99%",
                    left: "0%",
                    height: "60%",
                    top: "0%"
                  },
                  xAxis: %{
                    type: "value",
                    axisLabel: %{
                      show: false
                    },
                    splitLine: %{show: false}
                  },
                  yAxis: %{
                    type: "category",
                    data: [dgettext("dashboard_gradle", "Cacheable tasks")],
                    axisLabel: %{
                      show: false
                    }
                  }
                }
              }
              series={
                local_hit = @build.tasks_local_hit_count || 0
                remote_hit = @build.tasks_remote_hit_count || 0
                from_cache = local_hit + remote_hit
                misses = (@build.cacheable_tasks_count || 0) - from_cache

                [
                  %{
                    name: dgettext("dashboard_gradle", "Local"),
                    type: "bar",
                    stack: "total",
                    emphasis: %{
                      focus: "series"
                    },
                    data: [local_hit],
                    color: "var:hits-chart-legend-local",
                    itemStyle: %{
                      borderRadius:
                        if(local_hit > 0 and remote_hit == 0 and misses == 0,
                          do: [8, 8, 8, 8],
                          else: if(local_hit > 0, do: [8, 0, 0, 8], else: [0, 0, 0, 0])
                        )
                    }
                  },
                  %{
                    name: dgettext("dashboard_gradle", "Remote"),
                    type: "bar",
                    stack: "total",
                    emphasis: %{
                      focus: "series"
                    },
                    data: [remote_hit],
                    color: "var:hits-chart-legend-remote",
                    itemStyle: %{
                      borderRadius:
                        if(remote_hit > 0 and misses == 0 and local_hit == 0,
                          do: [8, 8, 8, 8],
                          else:
                            if(remote_hit > 0 and misses == 0,
                              do: [0, 8, 8, 0],
                              else: [0, 0, 0, 0]
                            )
                        )
                    }
                  },
                  %{
                    name: dgettext("dashboard_gradle", "Missed"),
                    type: "bar",
                    stack: "total",
                    emphasis: %{
                      focus: "series"
                    },
                    data: [misses],
                    color: "var:hits-chart-legend-missed",
                    itemStyle: %{
                      borderRadius:
                        if(misses > 0 and from_cache == 0,
                          do: [8, 8, 8, 8],
                          else: if(misses > 0, do: [0, 8, 8, 0], else: [0, 0, 0, 0])
                        )
                    }
                  }
                ]
              }
              x_axis_min={0}
              x_axis_max={@build.cacheable_tasks_count || 0}
            />
          </.card_section>
          <div data-part="throughput-widgets">
            <.widget
              title={dgettext("dashboard_gradle", "Download throughput")}
              description={
                dgettext(
                  "dashboard_gradle",
                  "Average download throughput in megabits per second."
                )
              }
              value={ThroughputFormatter.format_throughput(@download_throughput)}
              id="widget-download-throughput"
              empty={@download_throughput == 0}
              empty_label={dgettext("dashboard_gradle", "No data")}
            />
            <.widget
              title={dgettext("dashboard_gradle", "Upload throughput")}
              description={
                dgettext(
                  "dashboard_gradle",
                  "Average upload throughput in megabits per second."
                )
              }
              value={ThroughputFormatter.format_throughput(@upload_throughput)}
              id="widget-upload-throughput"
              empty={@upload_throughput == 0}
              empty_label={dgettext("dashboard_gradle", "No data")}
            />
          </div>
          <div data-part="filters">
            <.form for={%{}} phx-change="search-cacheable-tasks" phx-debounce="200">
              <.text_input
                type="search"
                id="search-cacheable-tasks"
                name="search"
                placeholder={dgettext("dashboard_gradle", "Search...")}
                show_suffix={false}
                data-part="search"
                value={@cacheable_tasks_filter}
              />
            </.form>
            <.dropdown
              id="cacheable-tasks-sort-by"
              label={
                case @cacheable_tasks_sort_by do
                  "cache_artifact_size" -> dgettext("dashboard_gradle", "Size")
                  _ -> dgettext("dashboard_gradle", "Duration")
                end
              }
              secondary_text={dgettext("dashboard_gradle", "Sort by:")}
            >
              <.dropdown_item
                value="duration_ms"
                label={dgettext("dashboard_gradle", "Duration")}
                patch={
                  "?#{@uri.query
                  |> Query.put("cacheable-tasks-sort-by", "duration_ms")
                  |> Query.put("cacheable-tasks-sort-order", "desc")
                  |> Query.drop("cacheable-tasks-page")}"
                }
                data-selected={@cacheable_tasks_sort_by == "duration_ms"}
              >
                <:right_icon><.check /></:right_icon>
              </.dropdown_item>
              <.dropdown_item
                value="cache_artifact_size"
                label={dgettext("dashboard_gradle", "Size")}
                patch={
                  "?#{@uri.query
                  |> Query.put("cacheable-tasks-sort-by", "cache_artifact_size")
                  |> Query.put("cacheable-tasks-sort-order", "desc")
                  |> Query.drop("cacheable-tasks-page")}"
                }
                data-selected={@cacheable_tasks_sort_by == "cache_artifact_size"}
              >
                <:right_icon><.check /></:right_icon>
              </.dropdown_item>
            </.dropdown>
            <.filter_dropdown
              id="cacheable-tasks-filter-dropdown"
              label={dgettext("dashboard_gradle", "Filter")}
              available_filters={@available_filters}
              active_filters={@cacheable_tasks_active_filters}
            />
          </div>
          <div
            :if={Enum.any?(@cacheable_tasks_active_filters)}
            data-part="active-filters"
          >
            <.active_filter :for={filter <- @cacheable_tasks_active_filters} filter={filter} />
          </div>
          <.table id="gradle-cacheable-tasks-table" rows={@cacheable_tasks}>
            <:col :let={task} label={dgettext("dashboard_gradle", "Task")}>
              <.text_cell label={task.task_path} />
            </:col>
            <:col :let={task} label={dgettext("dashboard_gradle", "Status")}>
              <.badge_cell
                :if={task.outcome == "local_hit"}
                label={dgettext("dashboard_gradle", "Local")}
                color="secondary"
                style="light-fill"
              />
              <.badge_cell
                :if={task.outcome == "remote_hit"}
                label={dgettext("dashboard_gradle", "Remote")}
                color="focus"
                style="light-fill"
              />
              <.badge_cell
                :if={task.outcome not in ["remote_hit", "local_hit"]}
                label={dgettext("dashboard_gradle", "Missed")}
                color="warning"
                style="light-fill"
              />
            </:col>
            <:col
              :let={task}
              label={dgettext("dashboard_gradle", "Size")}
              patch={
                @cacheable_tasks_sort_by == "cache_artifact_size" &&
                  "?#{@uri.query |> Query.put("cacheable-tasks-sort-by", "cache_artifact_size") |> Query.put("cacheable-tasks-sort-order", sort_order_patch_value("cache_artifact_size", @cacheable_tasks_sort_by, @cacheable_tasks_sort_order)) |> Query.drop("cacheable-tasks-page")}"
              }
              sort_order={
                @cacheable_tasks_sort_by == "cache_artifact_size" && @cacheable_tasks_sort_order
              }
            >
              <.text_cell label={
                if task.cache_artifact_size,
                  do: ByteFormatter.format_bytes(task.cache_artifact_size),
                  else: dgettext("dashboard_gradle", "—")
              } />
            </:col>
            <:col
              :let={task}
              label={dgettext("dashboard_gradle", "Duration")}
              patch={
                @cacheable_tasks_sort_by == "duration_ms" &&
                  "?#{@uri.query |> Query.put("cacheable-tasks-sort-by", "duration_ms") |> Query.put("cacheable-tasks-sort-order", sort_order_patch_value("duration_ms", @cacheable_tasks_sort_by, @cacheable_tasks_sort_order)) |> Query.drop("cacheable-tasks-page")}"
              }
              sort_order={
                @cacheable_tasks_sort_by == "duration_ms" && @cacheable_tasks_sort_order
              }
            >
              <.text_cell label={format_duration(task.duration_ms)} icon="history" />
            </:col>
            <:col :let={task} label={dgettext("dashboard_gradle", "Why it missed")}>
              <.text_cell label={cache_miss_reason(task)} />
            </:col>
            <:col :let={task} label={dgettext("dashboard_gradle", "Cache key")}>
              <.text_cell label={task.cache_key || dgettext("dashboard_gradle", "—")} />
            </:col>
            <:empty_state>
              <.table_empty_state
                icon="subtask"
                title={dgettext("dashboard_gradle", "No cacheable tasks")}
                subtitle={dgettext("dashboard_gradle", "This build has no cacheable task data.")}
              />
            </:empty_state>
          </.table>
          <.pagination_group
            :if={@cacheable_tasks_page_count > 1}
            current_page={@cacheable_tasks_page}
            number_of_pages={@cacheable_tasks_page_count}
            page_patch={
              fn page ->
                "?#{Query.put(@uri.query, "cacheable-tasks-page", page)}"
              end
            }
          />
        </.card_section>
      </.card>
    </div>
  <% end %>
</div>
