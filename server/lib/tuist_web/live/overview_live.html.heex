<%= cond do %>
  <% Tuist.Projects.Project.gradle_project?(@selected_project) -> %>
    {TuistWeb.GradleOverviewLive.render(assigns)}
  <% Tuist.Projects.Project.bazel_project?(@selected_project) -> %>
    {TuistWeb.BazelOverviewLive.render(assigns)}
  <% Tuist.Projects.Project.mix_project?(@selected_project) -> %>
    {TuistWeb.MixOverviewLive.render(assigns)}
  <% true -> %>
    {TuistWeb.XcodeOverviewLive.render(assigns)}
<% end %>
