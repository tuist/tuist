<div id="sandbox-instances">
  <div data-part="page-header">
    <h1 data-part="title">{dgettext("dashboard_sandboxes", "Instances")}</h1>
    <span data-part="subtitle">
      {dgettext("dashboard_sandboxes", "Every sandbox in the account.")}
    </span>
  </div>

  <.flash_alerts flash={@flash} />

  <.card
    title={dgettext("dashboard_sandboxes", "Instances")}
    icon="stack_2"
    id="sandboxes-list"
  >
    <.card_section data-part="table-section">
      <div data-part="table-toolbar">
        <.form for={%{}} id="sandboxes-search-form" phx-change="search" phx-submit="search">
          <.text_input
            type="search"
            id="sandboxes-search"
            name="search"
            placeholder={dgettext("dashboard_sandboxes", "Search by name or ID...")}
            show_suffix={false}
            data-part="search"
            value={@search}
            phx-debounce="200"
          />
        </.form>
        <.filter_dropdown
          id="sandboxes-filter-dropdown"
          label={dgettext("dashboard_sandboxes", "Filter")}
          available_filters={@available_filters}
          active_filters={@active_filters}
        />
        <.dropdown
          id="sandboxes-sort-by-dropdown"
          label={sort_label(@sort_by)}
          secondary_text={dgettext("dashboard_sandboxes", "Sort by:")}
        >
          <.dropdown_item
            :for={{column, label} <- sort_options()}
            value={column}
            label={label}
            patch={sort_patch(assigns, column)}
            data-selected={@sort_by == column}
          >
            <:right_icon :if={@sort_by == column}><.check /></:right_icon>
          </.dropdown_item>
        </.dropdown>
      </div>
      <div :if={Enum.any?(@active_filters)} data-part="active-filters">
        <.active_filter :for={filter <- @active_filters} filter={filter} />
      </div>
      <.sandboxes_table
        id="sandboxes-table"
        sandboxes={@sandboxes}
        account={@selected_account}
        sort_patch={&sort_patch(assigns, &1)}
        sort_by={@sort_by}
        sort_order={@sort_order}
      />
      <div :if={@total_pages > 1} data-part="pagination">
        <.button
          variant="secondary"
          label={dgettext("dashboard_sandboxes", "Prev")}
          disabled={@page <= 1}
          patch={page_patch(@uri, @page - 1)}
        >
          <:icon_left><.chevron_left /></:icon_left>
        </.button>
        <span data-part="page-indicator">
          {dgettext("dashboard_sandboxes", "Page %{page} of %{total}",
            page: @page,
            total: @total_pages
          )}
        </span>
        <.button
          variant="secondary"
          label={dgettext("dashboard_sandboxes", "Next")}
          disabled={@page >= @total_pages}
          patch={page_patch(@uri, @page + 1)}
        >
          <:icon_right><.chevron_right /></:icon_right>
        </.button>
      </div>
    </.card_section>
  </.card>
</div>
