<div id="module-cache-module">
  <.button
    label={dgettext("dashboard_cache", "All modules")}
    data-part="back-button"
    variant="secondary"
    size="medium"
    navigate={~p"/#{@selected_project.account.name}/#{@selected_project.name}/module-cache/modules"}
  >
    <:icon_left>
      <.icon name="arrow_left" />
    </:icon_left>
  </.button>

  <div data-part="header">
    <div data-part="title-group">
      <div data-part="title">
        <h1 data-part="label">{@module_name}</h1>
      </div>
      <div :if={@module.ok? && @module.result.product != ""} data-part="badges">
        <.badge
          label={dgettext("dashboard_cache", "Product: %{product}", product: @module.result.product)}
          color="primary"
          style="light-fill"
          size="large"
        />
      </div>
    </div>
  </div>

  <div data-part="filters">
    <.dropdown
      id="module-detail-environment-dropdown"
      label={environment_label(@analytics_environment)}
      secondary_text={dgettext("dashboard_cache", "Environment:")}
    >
      <.dropdown_item
        :for={{value, label} <- [{"any", dgettext("dashboard_cache", "Any")}, {"local", dgettext("dashboard_cache", "Local")}, {"ci", dgettext("dashboard_cache", "CI")}]}
        value={value}
        label={label}
        patch={"?#{Query.put(@uri.query, "analytics-environment", value)}"}
        data-selected={@analytics_environment == value}
      >
        <:right_icon :if={@analytics_environment == value}><.check /></:right_icon>
      </.dropdown_item>
    </.dropdown>
    <.dropdown
      id="module-detail-branch-dropdown"
      label={branch_label(@analytics_branch)}
      secondary_text={dgettext("dashboard_cache", "Branch:")}
    >
      <.dropdown_item
        value="any"
        label={dgettext("dashboard_cache", "Any")}
        patch={"?#{Query.put(@uri.query, "analytics-branch", "any")}"}
        data-selected={@analytics_branch == "any"}
      >
        <:right_icon :if={@analytics_branch == "any"}><.check /></:right_icon>
      </.dropdown_item>
      <%= if @cache_branches.ok? do %>
        <.dropdown_item
          :for={branch <- @cache_branches.result}
          value={branch}
          label={branch}
          patch={"?#{Query.put(@uri.query, "analytics-branch", branch)}"}
          data-selected={@analytics_branch == branch}
        >
          <:right_icon :if={@analytics_branch == branch}><.check /></:right_icon>
        </.dropdown_item>
      <% end %>
    </.dropdown>
    <.date_picker
      id="module-detail-date-range-picker"
      name="analytics-date-range"
      presets={[
        %{id: "last-24-hours", label: dgettext("dashboard_cache", "Last 24 hours"), period: {24, :hour}},
        %{id: "last-7-days", label: dgettext("dashboard_cache", "Last 7 days"), period: {7, :day}},
        %{id: "last-30-days", label: dgettext("dashboard_cache", "Last 30 days"), period: {30, :day}},
        %{id: "last-12-months", label: dgettext("dashboard_cache", "Last 12 months"), period: {12, :month}},
        %{id: "custom", label: dgettext("dashboard_cache", "Custom")}
      ]}
      selected_preset={@analytics_preset}
      period={@analytics_period}
      on_period_change="analytics_period_changed"
      max={Date.utc_today()}
    >
      <:actions>
        <.button
          label={dgettext("dashboard_cache", "Cancel")}
          variant="secondary"
          phx-click={JS.dispatch("phx:date-picker-cancel", detail: %{id: "module-detail-date-range-picker"})}
        />
        <.button
          label={dgettext("dashboard_cache", "Apply")}
          phx-click={JS.dispatch("phx:date-picker-apply", detail: %{id: "module-detail-date-range-picker"})}
        />
      </:actions>
    </.date_picker>
  </div>

  <.card
    title={dgettext("dashboard_cache", "Analytics")}
    icon="chart_arcs"
    data-part="analytics"
  >
    <.card_section data-part="analytics-body">
      <div data-part="analytics-main">
        <div data-part="widgets">
          <.widget
            loading={!@module.ok?}
            id="widget-cache-activity"
            title={
              if @selected_cache_count == "misses",
                do: dgettext("dashboard_cache", "Misses"),
                else: dgettext("dashboard_cache", "Hits")
            }
            legend_color={if @selected_cache_count == "misses", do: "destructive", else: "primary"}
            description={
              dgettext(
                "dashboard_cache",
                "Builds where this module was served from cache, versus those where it was a cache miss and had to be rebuilt."
              )
            }
            value={
              if @module.ok? do
                format_number(
                  if @selected_cache_count == "misses",
                    do: @module.result.invalidations,
                    else: @module.result.reuses
                )
              end
            }
            phx_click="select_widget"
            phx_value_widget="cache_activity"
            selected={@analytics_selected_widget == "cache_activity"}
          >
            <:select>
              <.dropdown_item
                value="hits"
                phx-click="select_cache_count"
                phx-value-type="hits"
                data-selected={@selected_cache_count == "hits"}
              >
                <div data-part="breakdown-item">
                  <div data-part="dot" data-color="primary"></div>
                  <span data-part="label">{dgettext("dashboard_cache", "Hits")}</span>
                  <span data-part="separator">-</span>
                  <span data-part="value">
                    {if @module.ok?,
                      do: format_number(@module.result.reuses),
                      else: dgettext("dashboard_cache", "N/A")}
                  </span>
                </div>
              </.dropdown_item>
              <.dropdown_item
                value="misses"
                phx-click="select_cache_count"
                phx-value-type="misses"
                data-selected={@selected_cache_count == "misses"}
              >
                <div data-part="breakdown-item">
                  <div data-part="dot" data-color="destructive"></div>
                  <span data-part="label">{dgettext("dashboard_cache", "Misses")}</span>
                  <span data-part="separator">-</span>
                  <span data-part="value">
                    {if @module.ok?,
                      do: format_number(@module.result.invalidations),
                      else: dgettext("dashboard_cache", "N/A")}
                  </span>
                </div>
              </.dropdown_item>
            </:select>
          </.widget>
          <.widget
            loading={!@module.ok?}
            id="widget-hit-rate"
            title={dgettext("dashboard_cache", "Cache hit rate")}
            legend_color="primary"
            description={
              dgettext(
                "dashboard_cache",
                "Share of this module's builds that were served from cache instead of rebuilt."
              )
            }
            value={
              if @module.ok?,
                do: dgettext("dashboard_cache", "%{rate}%", rate: @module.result.hit_rate)
            }
            phx_click="select_widget"
            phx_value_widget="hit_rate"
            selected={@analytics_selected_widget == "hit_rate"}
          />
          <.widget
            loading={!@module.ok?}
            id="widget-blast-radius"
            title={dgettext("dashboard_cache", "Blast radius")}
            legend_color="secondary"
            description={
              dgettext(
                "dashboard_cache",
                "How many modules this one invalidates downstream when it changes."
              )
            }
            value={if @module.ok?, do: Integer.to_string(@module.result.blast_radius || 0)}
            phx_click="select_widget"
            phx_value_widget="blast_radius"
            selected={@analytics_selected_widget == "blast_radius"}
          />
        </div>

        <div :if={!@timeseries.ok?} data-part="analytics-chart">
          <.skeleton_chart />
        </div>

        <div
          :if={@timeseries.ok? && @analytics_selected_widget == "cache_activity"}
          data-part="analytics-chart"
        >
          <.chart
            id="module-cache-activity-chart"
            type="bar"
            extra_options={
              %{
                grid: %{width: "96%", left: "0.4%", right: "3%", height: "88%", top: "6%"},
                tooltip: %{},
                xAxis: %{
                  type: "category",
                  data: @timeseries.result.dates,
                  axisLabel: %{
                    color: "var:noora-surface-label-secondary",
                    formatter: "fn:toLocaleDate",
                    customValues: [
                      List.first(@timeseries.result.dates),
                      List.last(@timeseries.result.dates)
                    ]
                  }
                },
                yAxis: %{
                  splitLine: %{lineStyle: %{color: "var:noora-chart-lines"}},
                  axisLabel: %{color: "var:noora-surface-label-secondary"}
                },
                legend: %{show: false}
              }
            }
            series={[
              %{
                name: dgettext("dashboard_cache", "Hits"),
                data: @timeseries.result.reuses,
                type: "bar",
                stack: "total",
                color: "var:noora-chart-primary",
                barMaxWidth: 18
              },
              %{
                name: dgettext("dashboard_cache", "Misses"),
                data: @timeseries.result.invalidations,
                type: "bar",
                stack: "total",
                color: "var:noora-chart-destructive",
                barMaxWidth: 18
              }
            ]}
            y_axis_min={0}
            grid_lines
          />
        </div>

        <div
          :if={@timeseries.ok? && @analytics_selected_widget == "hit_rate"}
          data-part="analytics-chart"
        >
          <.chart
            id="module-hit-rate-chart"
            type="line"
            extra_options={
              %{
                grid: %{width: "93%", left: "0.4%", right: "7%", height: "88%", top: "6%"},
                tooltip: %{valueFormat: "{value}%"},
                xAxis: %{
                  boundaryGap: false,
                  type: "category",
                  data: @timeseries.result.dates,
                  axisLabel: %{
                    color: "var:noora-surface-label-secondary",
                    formatter: "fn:toLocaleDate",
                    customValues: [
                      List.first(@timeseries.result.dates),
                      List.last(@timeseries.result.dates)
                    ]
                  }
                },
                yAxis: %{
                  splitLine: %{lineStyle: %{color: "var:noora-chart-lines"}},
                  axisLabel: %{color: "var:noora-surface-label-secondary", formatter: "{value}%"}
                },
                legend: %{show: false}
              }
            }
            series={[
              %{
                name: dgettext("dashboard_cache", "Cache hit rate"),
                data: @timeseries.result.hit_rates,
                type: "line",
                smooth: 0.1,
                symbol: "none",
                color: "var:noora-chart-primary"
              }
            ]}
            y_axis_min={0}
            y_axis_max={100}
          />
        </div>

        <div
          :if={@dependents_series.ok? && @analytics_selected_widget == "blast_radius"}
          data-part="analytics-chart"
        >
          <.chart
            id="module-dependents-chart"
            type="line"
            extra_options={
              %{
                grid: %{width: "93%", left: "0.4%", right: "7%", height: "88%", top: "6%"},
                tooltip: %{},
                xAxis: %{
                  boundaryGap: false,
                  type: "category",
                  data: @dependents_series.result.dates,
                  axisLabel: %{
                    color: "var:noora-surface-label-secondary",
                    formatter: "fn:toLocaleDate",
                    customValues: [
                      List.first(@dependents_series.result.dates),
                      List.last(@dependents_series.result.dates)
                    ]
                  }
                },
                yAxis: %{
                  minInterval: 1,
                  splitLine: %{lineStyle: %{color: "var:noora-chart-lines"}},
                  axisLabel: %{color: "var:noora-surface-label-secondary"}
                },
                legend: %{show: false}
              }
            }
            series={[
              %{
                name: dgettext("dashboard_cache", "Modules downstream"),
                data: @dependents_series.result.counts,
                type: "line",
                step: "end",
                symbol: "none",
                color: "var:noora-chart-secondary"
              }
            ]}
            y_axis_min={0}
          />
        </div>
      </div>
    </.card_section>
  </.card>

  <div data-part="reasons-grid">
    <.card
      title={dgettext("dashboard_cache", "Why it misses")}
      icon="git_branch"
      data-part="reasons-card"
    >
      <.card_section :if={@module.ok?}>
        <.why_split module={@module.result} />
        <p data-part="reasons-note">
          {dgettext(
            "dashboard_cache",
            "%{self} misses from its own changes, %{deps} from an upstream dependency changing, %{other} cold or first-seen.",
            self: @module.result.self_changes,
            deps: @module.result.dependency_induced,
            other: @module.result.unclassified
          )}
        </p>
      </.card_section>
    </.card>

    <.card
      title={dgettext("dashboard_cache", "Invalidated by")}
      icon="square_rounded_arrow_down"
      data-part="invalidated-by-card"
    >
      <.card_section :if={@invalidated_by.ok? && not Enum.empty?(@invalidated_by.result)}>
        <.table id="invalidated-by-table" rows={@invalidated_by.result}>
          <:col :let={dep} label={dgettext("dashboard_cache", "Dependency")}>
            <.text_cell label={dep.name} />
          </:col>
          <:col :let={dep} label={dgettext("dashboard_cache", "Times changed")}>
            <.text_cell label={Integer.to_string(dep.self_changes)} />
          </:col>
        </.table>
      </.card_section>
      <.empty_card_section
        :if={@invalidated_by.ok? && Enum.empty?(@invalidated_by.result)}
        title={dgettext("dashboard_cache", "No dependency edges")}
      >
        <:image>
          <img src="/images/empty_table_light.png" data-theme="light" />
          <img src="/images/empty_table_dark.png" data-theme="dark" />
        </:image>
      </.empty_card_section>
    </.card>
  </div>

</div>
