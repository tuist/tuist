<div id="usage">
  <div data-part="page-header">
    <div data-part="header">
      <h1 data-part="title">{dgettext("dashboard_usage", "Usage")}</h1>
      <span data-part="subtitle">
        {dgettext(
          "dashboard_usage",
          "Runner time and cache traffic billed to this account."
        )}
      </span>
    </div>
    <div data-part="date-picker-bar">
      <.dropdown
        id="usage-period-dropdown"
        label={TuistWeb.UsageLive.period_label(@selected_period)}
        secondary_text={dgettext("dashboard_usage", "Billing period:")}
      >
        <.dropdown_item
          :for={period <- @periods}
          value={TuistWeb.UsageLive.period_param(period)}
          label={TuistWeb.UsageLive.period_label(period)}
          patch={TuistWeb.UsageLive.period_patch(@uri, period)}
          data-selected={period == @selected_period}
        >
          <:right_icon :if={period == @selected_period}><.check /></:right_icon>
        </.dropdown_item>
      </.dropdown>
    </div>
  </div>

  <.card
    :if={@runner_breakdown.minutes > 0 or @runners_enabled}
    title={dgettext("dashboard_usage", "Runner usage")}
    icon="server"
    data-part="runner-usage-card"
  >
    <.card_section data-part="runner-usage-card-section">
      <span data-part="info-label">
        {dgettext(
          "dashboard_usage",
          "Billing period %{from} to %{to}. Minutes are measured on the macOS 6 vCPU / 14 GB baseline; a larger machine uses more than one minute per minute it runs.",
          from: Timex.format!(@runner_breakdown.period_start, "{Mshort} {D}"),
          to: Timex.format!(@runner_breakdown.period_end, "{Mshort} {D}, {YYYY}")
        )}
      </span>
      <div data-part="widgets">
        <.widget
          id="widget-runner-minutes"
          title={dgettext("dashboard_usage", "Runner minutes")}
          description={
            dgettext("dashboard_usage", "%{count} free each month",
              count: @runner_breakdown.free_minutes
            )
          }
          value={CldrHelpers.format_number(@runner_breakdown.minutes)}
        />
        <.widget
          id="widget-runner-gross"
          title={dgettext("dashboard_usage", "Usage value")}
          description={dgettext("dashboard_usage", "At the standard rate, before the free tier")}
          value={format_money(@runner_breakdown.gross)}
        />
        <.widget
          id="widget-runner-billed"
          title={dgettext("dashboard_usage", "Billed")}
          description={dgettext("dashboard_usage", "What lands on your invoice")}
          value={format_money(@runner_breakdown.billed)}
        />
      </div>
    </.card_section>
    <.card_section data-part="runner-usage-card-detail-section">
      <div data-part="chart">
        <.chart
          id="runner-spend-chart"
          type="bar"
          extra_options={
            TuistWeb.UsageLive.runner_chart_options(
              TuistWeb.UsageLive.runner_chart_dates(@runner_breakdown)
            )
          }
          series={
            TuistWeb.UsageLive.runner_chart_series(
              @runner_breakdown.by_repository,
              @runner_breakdown.projected_days
            )
          }
          y_axis_min={0}
        />
      </div>
      <div data-part="receipts">
        <div :for={row <- @runner_breakdown.platforms} data-part="receipt">
          <div data-part="heading">
            <span data-part="platform">{TuistWeb.UsageLive.platform_label(row.platform)}</span>
            <span data-part="shape">{TuistWeb.UsageLive.platform_shape(row.platform)}</span>
          </div>
          <dl data-part="lines">
            <div data-part="line">
              <dt>
                {dgettext("dashboard_usage", "%{count} minutes run",
                  count: CldrHelpers.format_number(row.minutes)
                )}
              </dt>
              <dd>{TuistWeb.UsageLive.money_label(row.gross)}</dd>
            </div>
            <% trial_credit = TuistWeb.UsageLive.trial_credit(row) %>
            <div :if={trial_credit} data-part="line" data-kind="credit">
              <dt>{dgettext("dashboard_usage", "Covered by your trial")}</dt>
              <dd>{TuistWeb.UsageLive.credit_label(trial_credit)}</dd>
            </div>
            <div :if={row.included_minutes} data-part="line" data-kind="credit">
              <dt>
                {dgettext("dashboard_usage", "%{count} minutes included",
                  count: row.included_minutes
                )}
              </dt>
              <dd>{TuistWeb.UsageLive.included_credit_label(row)}</dd>
            </div>
            <div data-part="line" data-kind="total">
              <dt>{dgettext("dashboard_usage", "Billed this period")}</dt>
              <dd>{TuistWeb.UsageLive.money_label(row.billed)}</dd>
            </div>
          </dl>
          <% pace = TuistWeb.UsageLive.pace_label(row) %>
          <p :if={pace} data-part="footnote">{pace}</p>
        </div>
        <% coverage = TuistWeb.UsageLive.prepaid_coverage(@prepaid_balance, @runner_breakdown) %>
        <div :if={coverage} data-part="receipt" data-kind="prepaid">
          <div data-part="heading">
            <span data-part="platform">{dgettext("dashboard_usage", "Prepaid credit")}</span>
          </div>
          <dl data-part="lines">
            <div data-part="line">
              <dt>{dgettext("dashboard_usage", "Balance")}</dt>
              <dd>{TuistWeb.UsageLive.money_label(coverage.available)}</dd>
            </div>
            <div data-part="line" data-kind="credit">
              <dt>{dgettext("dashboard_usage", "Covers this period")}</dt>
              <dd>{TuistWeb.UsageLive.credit_label(coverage.covered)}</dd>
            </div>
            <div data-part="line" data-kind="total">
              <dt>{dgettext("dashboard_usage", "Left to pay")}</dt>
              <dd>{TuistWeb.UsageLive.money_label(coverage.due)}</dd>
            </div>
          </dl>
          <p data-part="footnote">
            {dgettext(
              "dashboard_usage",
              "Drawn down when the period is invoiced, so this is what your balance would cover today."
            )}
          </p>
        </div>
      </div>
    </.card_section>
  </.card>

  <.card
    title={dgettext("dashboard_usage", "Cache traffic")}
    icon="chart_column"
    data-part="kura-traffic"
  >
    <div data-part="widgets">
      <.widget
        id="widget-egress"
        title={dgettext("dashboard_usage", "Egress")}
        legend_color="primary"
        description={
          dgettext(
            "dashboard_usage",
            "Bytes sent from the cache to clients (cache downloads) in the selected window."
          )
        }
        value={if @totals.ok?, do: TuistWeb.UsageLive.format_bytes(@totals.result.egress.bytes)}
        loading={!@totals.ok?}
        selected={@analytics_selected_widget == "egress"}
        phx_click="select_widget"
        phx_value_widget="egress"
        trend_value={if @totals.ok?, do: @totals.result.egress.bytes_trend}
        trend_type={:neutral}
        trend_label={@analytics_trend_label}
        empty={@totals.ok? && @totals.result.egress.bytes == 0}
      />
      <.widget
        id="widget-ingress"
        title={dgettext("dashboard_usage", "Ingress")}
        legend_color="secondary"
        description={
          dgettext(
            "dashboard_usage",
            "Bytes received by the cache from clients (cache uploads) in the selected window."
          )
        }
        value={if @totals.ok?, do: TuistWeb.UsageLive.format_bytes(@totals.result.ingress.bytes)}
        loading={!@totals.ok?}
        selected={@analytics_selected_widget == "ingress"}
        phx_click="select_widget"
        phx_value_widget="ingress"
        trend_value={if @totals.ok?, do: @totals.result.ingress.bytes_trend}
        trend_type={:neutral}
        trend_label={@analytics_trend_label}
        empty={@totals.ok? && @totals.result.ingress.bytes == 0}
      />
      <.widget
        id="widget-requests"
        title={dgettext("dashboard_usage", "Requests")}
        legend_color="tertiary"
        description={
          dgettext(
            "dashboard_usage",
            "Number of cache requests served in the selected window."
          )
        }
        value={if @totals.ok?, do: TuistWeb.UsageLive.format_count(@totals.result.request_count)}
        loading={!@totals.ok?}
        selected={@analytics_selected_widget == "requests"}
        phx_click="select_widget"
        phx_value_widget="requests"
        trend_value={if @totals.ok?, do: @totals.result.request_count_trend}
        trend_type={:neutral}
        trend_label={@analytics_trend_label}
        empty={@totals.ok? && @totals.result.request_count == 0}
      />
    </div>
    <.card_section data-part="kura-traffic-card-chart-section">
      <% current_series = TuistWeb.UsageLive.series_for(assigns, @analytics_selected_widget) %>
      <%= cond do %>
        <% !current_series.ok? -> %>
          <.skeleton_chart />
        <% Enum.empty?(current_series.result) or Enum.all?(current_series.result, &(&1.total == 0)) -> %>
          <.empty_card_section
            title={TuistWeb.UsageLive.empty_label()}
            get_started_href="https://tuist.dev/en/docs"
          >
            <:image>
              <img
                src={~p"/images/empty_table_light.png"}
                data-theme="light"
                loading="lazy"
                decoding="async"
              />
              <img
                src={~p"/images/empty_table_dark.png"}
                data-theme="dark"
                loading="lazy"
                decoding="async"
              />
            </:image>
          </.empty_card_section>
        <% true -> %>
          <.chart
            id="usage-traffic-chart"
            type="line"
            extra_options={
              TuistWeb.UsageLive.traffic_chart_options(
                current_series.result |> List.first() |> Map.get(:dates),
                @analytics_selected_widget
              )
            }
            series={TuistWeb.UsageLive.traffic_chart_series(current_series.result)}
            y_axis_min={0}
          />
      <% end %>
    </.card_section>
  </.card>

  <.card
    title={dgettext("dashboard_usage", "Traffic by region")}
    icon="server"
    data-part="kura-traffic-by-region-card"
  >
    <.card_section data-part="kura-traffic-by-region-card-section">
      <%= cond do %>
        <% !@per_region.ok? -> %>
          <.skeleton_chart />
        <% Enum.empty?(@per_region.result) -> %>
          <.empty_card_section
            title={TuistWeb.UsageLive.empty_label()}
            get_started_href="https://tuist.dev/en/docs"
          >
            <:image>
              <img
                src={~p"/images/empty_table_light.png"}
                data-theme="light"
                loading="lazy"
                decoding="async"
              />
              <img
                src={~p"/images/empty_table_dark.png"}
                data-theme="dark"
                loading="lazy"
                decoding="async"
              />
            </:image>
          </.empty_card_section>
        <% true -> %>
          <.table
            id="usage-per-region-table"
            rows={@per_region.result}
            row_key={fn row -> "usage-region-#{row.region}" end}
          >
            <:col :let={row} label={dgettext("dashboard_usage", "Region")}>
              <.text_cell icon="server" label={TuistWeb.UsageLive.region_label(row.region)} />
            </:col>
            <:col :let={row} label={dgettext("dashboard_usage", "Egress")}>
              <.text_cell label={TuistWeb.UsageLive.format_bytes(row.egress_bytes)} />
            </:col>
            <:col :let={row} label={dgettext("dashboard_usage", "Ingress")}>
              <.text_cell label={TuistWeb.UsageLive.format_bytes(row.ingress_bytes)} />
            </:col>
            <:col :let={row} label={dgettext("dashboard_usage", "Requests")}>
              <.text_cell label={TuistWeb.UsageLive.format_count(row.request_count)} />
            </:col>
          </.table>
      <% end %>
    </.card_section>
  </.card>
</div>
