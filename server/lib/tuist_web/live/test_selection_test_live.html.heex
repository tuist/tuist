<div id="test-selection-decision">
  <.button
    label={dgettext("dashboard_tests", "Selection run")}
    data-part="back-button"
    variant="secondary"
    size="medium"
    navigate={run_href(assigns)}
  >
    <:icon_left><.icon name="arrow_left" /></:icon_left>
  </.button>

  <div data-part="header">
    <div data-part="title-group">
      <div data-part="title">
        <div data-part="kind">
          <div data-part="icon"><.icon name="subtask" /></div>
        </div>
        <h1 data-part="label">{@test.name}</h1>
      </div>
      <div data-part="badges">
        <.decision_badge decision={@test.decision} />
        <.badge
          label={"#{module_label(@selected_project)}: #{@test.module_name}"}
          color="primary"
          style="light-fill"
          size="large"
        />
        <.badge
          :if={@test.suite_name != ""}
          label={"#{suite_label(@selected_project)}: #{@test.suite_name}"}
          color="primary"
          style="light-fill"
          size="large"
        />
        <.badge
          :if={@test.decision == "selected" and @run.shard_count > 1}
          label={dgettext("dashboard_tests", "Shard %{index}", index: @test.shard_index)}
          color="neutral"
          style="light-fill"
          size="large"
        />
      </div>
    </div>
    <div data-part="filters">
      <.button
        :if={@outcome}
        label={dgettext("dashboard_tests", "View test case run")}
        variant="secondary"
        size="medium"
        navigate={
          ~p"/#{@selected_account.name}/#{@selected_project.name}/tests/test-cases/runs/#{@test.test_case_run_id}"
        }
        data-part="test-case-run-link"
      >
        <:icon_left><.icon name="dashboard" /></:icon_left>
      </.button>
      <.button
        label={dgettext("dashboard_tests", "View test case")}
        variant="secondary"
        size="medium"
        navigate={
          ~p"/#{@selected_account.name}/#{@selected_project.name}/tests/test-cases/#{@test.test_case_id}"
        }
        data-part="test-case-link"
      >
        <:icon_left><.icon name="exchange" /></:icon_left>
      </.button>
    </div>
  </div>

  <.card
    title={dgettext("dashboard_tests", "Decision / Reason")}
    icon="filter_question"
    data-part="reason-card"
  >
    <.card_section data-part="file-summary-section">
      <.alert
        id="test-selection-test-reason"
        type="secondary"
        status={if @test.decision == "selected", do: "information", else: "success"}
        size="large"
        title={reason_label(@test.reason)}
        description={reason_description(@test.reason, @test.matched_path)}
      />
      <.alert
        :if={@test.decision == "skipped" and @outcome == "failure"}
        id="test-selection-test-miss"
        type="secondary"
        status="error"
        size="large"
        title={dgettext("dashboard_tests", "Missed")}
        description={
          dgettext(
            "dashboard_tests",
            "The selection would have skipped it, but it failed when the dry run ran it anyway."
          )
        }
      />
      <dl data-part="file-details">
        <div>
          <dt>{dgettext("dashboard_tests", "Selection run")}</dt>
          <dd>
            <.link_button
              navigate={run_href(assigns)}
              label={if @run.test_plan != "", do: @run.test_plan, else: @run.scheme}
              variant="secondary"
              size="large"
              underline
            />
          </dd>
        </div>
        <div>
          <dt>{dgettext("dashboard_tests", "Commit")}</dt>
          <dd>
            <.link_button
              navigate={commit_href(assigns)}
              label={short_sha(@run.git_commit_sha)}
              variant="secondary"
              size="large"
              underline
            />
          </dd>
        </div>
        <div>
          <dt>{dgettext("dashboard_tests", "Baseline")}</dt>
          <dd>
            <.link_button
              :if={@run.baseline_sha != ""}
              navigate={coverage_href(assigns, @run.baseline_sha)}
              label={short_sha(@run.baseline_sha)}
              variant="secondary"
              size="large"
              underline
            />
            <span :if={@run.baseline_sha == ""}>{dgettext("dashboard_tests", "None")}</span>
          </dd>
        </div>
        <div>
          <dt>{dgettext("dashboard_tests", "Matched path")}</dt>
          <dd>{if @test.matched_path != "", do: @test.matched_path, else: "–"}</dd>
        </div>
        <div>
          <dt>{dgettext("dashboard_tests", "Est. duration")}</dt>
          <dd>{format_duration(@test.estimated_duration_ms)}</dd>
        </div>
        <div>
          <dt>{dgettext("dashboard_tests", "Outcome")}</dt>
          <dd>{outcome_label(@outcome)}</dd>
        </div>
        <div>
          <dt>{dgettext("dashboard_tests", "Changed files it executed")}</dt>
          <dd>
            {dgettext("dashboard_tests", "%{changed} of %{total}",
              changed: changed_count(assigns),
              total: length(@all_files)
            )}
          </dd>
        </div>
      </dl>
    </.card_section>
  </.card>

  <.card
    title={dgettext("dashboard_tests", "Files it executed in the baseline")}
    icon="file"
    data-part="files-card"
  >
    <.card_section data-part="file-functions-section">
      <div data-part="filters">
        <.form
          for={%{}}
          id="search-test-selection-test-files-form"
          phx-change="search-files"
          phx-debounce="200"
        >
          <.text_input
            type="search"
            id="search-test-selection-test-files"
            name="search"
            placeholder={dgettext("dashboard_tests", "Search by path...")}
            show_suffix={false}
            data-part="search"
            value={@files_search}
          />
        </.form>
      </div>
      <div :if={@files != []} data-part="functions-table">
        <.table id="test-selection-test-files-table" rows={@files} row_key={& &1.path}>
          <:col :let={file} label={dgettext("dashboard_tests", "File")}>
            <.text_and_description_cell
              label={Path.basename(file.path)}
              description={parent_dir(file.path)}
            />
          </:col>
          <:col :let={file} label={dgettext("dashboard_tests", "Since the baseline")}>
            <.status_badge_cell
              :if={file.changed}
              status={file_status(file.status)}
              label={file_status_label(file.status)}
            />
            <.status_badge_cell
              :if={!file.changed}
              status="disabled"
              label={dgettext("dashboard_tests", "Unchanged")}
            />
          </:col>
          <:col :let={file} label={dgettext("dashboard_tests", "Kind")}>
            <.badge_cell
              label={file_kind_label(file.kind)}
              color={file_kind_color(file.kind)}
              style="light-fill"
            />
          </:col>
        </.table>
        <.pagination_group
          :if={@files_total_pages > 1}
          current_page={@files_page}
          number_of_pages={@files_total_pages}
          page_patch={fn page -> "?#{Query.put(@uri.query, "page", page)}" end}
        />
      </div>
      <.coverage_empty
        :if={@files == []}
        title={
          if @all_files == [],
            do: dgettext("dashboard_tests", "The baseline recorded no files for it"),
            else: dgettext("dashboard_tests", "No file matches")
        }
        image="table"
        data-part="empty-files"
      />
    </.card_section>
  </.card>
</div>
