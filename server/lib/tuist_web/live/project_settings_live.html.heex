<div id="project-settings">
  <h1 data-part="title">
    {@selected_project.name}
  </h1>

  <.tab_menu_horizontal>
    <.tab_menu_horizontal_item
      label={dgettext("dashboard_projects", "General")}
      selected={true}
      patch={~p"/#{@selected_account.name}/#{@selected_project.name}/settings"}
    />
    <.tab_menu_horizontal_item
      :if={Tuist.Projects.Project.xcode_project?(@selected_project)}
      label={dgettext("dashboard_projects", "Notifications")}
      selected={false}
      patch={~p"/#{@selected_account.name}/#{@selected_project.name}/settings/notifications"}
    />
    <.tab_menu_horizontal_item
      :if={Tuist.Projects.Project.xcode_project?(@selected_project)}
      label={dgettext("dashboard_projects", "Automations")}
      selected={false}
      patch={~p"/#{@selected_account.name}/#{@selected_project.name}/settings/automations"}
    />
    <.tab_menu_horizontal_item
      label={dgettext("dashboard_projects", "Bundles")}
      selected={false}
      patch={~p"/#{@selected_account.name}/#{@selected_project.name}/settings/bundles"}
    />
  </.tab_menu_horizontal>
  <h2 data-part="subtitle">
    {dgettext("dashboard_projects", "General")}
  </h2>
  <.card_section
    :if={Tuist.Projects.Project.xcode_project?(@selected_project)}
    data-part="preview-access-card-section"
  >
    <div data-part="header">
      <span data-part="title">
        {dgettext("dashboard_projects", "Preview access")}
      </span>
      <span data-part="subtitle">
        {dgettext("dashboard_projects", "Set your previews to be public or private by default.")}
      </span>
    </div>
    <div data-part="content">
      <label data-part="dropdown-label">
        {dgettext("dashboard_projects", "General access")}
      </label>
      <.dropdown
        id="preview-access-dropdown"
        label={
          if @selected_project.default_previews_visibility == :private do
            dgettext("dashboard_projects", "Only organization members")
          else
            dgettext("dashboard_projects", "Anyone with the link")
          end
        }
      >
        <:icon :if={@selected_project.default_previews_visibility == :private}>
          <.icon name="lock" />
        </:icon>
        <:icon :if={@selected_project.default_previews_visibility == :public}>
          <.icon name="world" />
        </:icon>
        <.dropdown_item
          value="private"
          label={dgettext("dashboard_projects", "Only organization members")}
          phx-click="update_preview_access"
          phx-value-visibility="private"
          data-selected={@selected_project.default_previews_visibility == :private}
        >
          <:left_icon><.icon name="lock" /></:left_icon>
          <:right_icon :if={@selected_project.default_previews_visibility == :private}>
            <.icon name="check" />
          </:right_icon>
        </.dropdown_item>
        <.dropdown_item
          value="public"
          label={dgettext("dashboard_projects", "Anyone with the link")}
          phx-click="update_preview_access"
          phx-value-visibility="public"
          data-selected={@selected_project.default_previews_visibility == :public}
        >
          <:left_icon><.icon name="world" /></:left_icon>
          <:right_icon :if={@selected_project.default_previews_visibility == :public}>
            <.icon name="check" />
          </:right_icon>
        </.dropdown_item>
      </.dropdown>
    </div>
  </.card_section>
  <.card_section data-part="test-timing-source-card-section">
    <div data-part="header">
      <div data-part="title-row">
        <span data-part="title">
          {dgettext("dashboard_projects", "Test timing data source")}
        </span>
        <.tooltip
          id="test-timing-source-tooltip"
          size="large"
          title={dgettext("dashboard_projects", "Test timing data source")}
          description={
            dgettext(
              "dashboard_projects",
              "Tuist uses historical CI test durations from the last 30 days to bin-pack test targets into balanced shards. By default it only looks at the project's default branch, but you can point it at a specific branch (for example a release branch with more representative runs) or let it use timing from any branch."
            )
          }
        >
          <:trigger :let={attrs}>
            <span data-part="title-tooltip-trigger" {attrs}>
              <.icon name="info_circle" />
            </span>
          </:trigger>
          <:icon>
            <.icon name="info_circle" />
          </:icon>
        </.tooltip>
      </div>
      <span data-part="subtitle">
        {dgettext(
          "dashboard_projects",
          "Choose which CI runs feed historical timing data for test sharding."
        )}
      </span>
    </div>
    <div data-part="content">
      <div data-part="field">
        <label data-part="dropdown-label">
          {dgettext("dashboard_projects", "Source")}
        </label>
        <.dropdown
          id="test-timing-source-dropdown"
          label={
            if @selected_project.test_timing_source == :any do
              dgettext("dashboard_projects", "Any branch")
            else
              dgettext("dashboard_projects", "A specific branch")
            end
          }
        >
          <.dropdown_item
            value="branch"
            label={dgettext("dashboard_projects", "A specific branch")}
            phx-click="update_test_timing_source"
            phx-value-source="branch"
            data-selected={@selected_project.test_timing_source == :branch}
          >
            <:right_icon :if={@selected_project.test_timing_source == :branch}>
              <.icon name="check" />
            </:right_icon>
          </.dropdown_item>
          <.dropdown_item
            value="any"
            label={dgettext("dashboard_projects", "Any branch")}
            phx-click="update_test_timing_source"
            phx-value-source="any"
            data-selected={@selected_project.test_timing_source == :any}
          >
            <:right_icon :if={@selected_project.test_timing_source == :any}>
              <.icon name="check" />
            </:right_icon>
          </.dropdown_item>
        </.dropdown>
      </div>
      <div :if={@selected_project.test_timing_source == :branch} data-part="field">
        <.form
          for={@test_timing_branch_form}
          id="test-timing-branch-form"
          phx-submit="update_test_timing_branch"
        >
          <.text_input
            type="basic"
            label={dgettext("dashboard_projects", "Branch")}
            sublabel={
              dgettext(
                "dashboard_projects",
                "Defaults to the project's default branch (%{default_branch}) when left empty.",
                default_branch: @selected_project.default_branch
              )
            }
            field={@test_timing_branch_form[:test_timing_branch]}
            placeholder={@selected_project.default_branch}
          />
        </.form>
      </div>
    </div>
  </.card_section>
  <.card_section data-part="rename-card-section">
    <div data-part="header">
      <span data-part="title">
        {dgettext("dashboard_projects", "Rename project")}
      </span>
      <span data-part="subtitle">
        {dgettext("dashboard_projects", "Renaming your project can have unintended side effects.")}
      </span>
    </div>
    <div data-part="content">
      <.form
        data-part="form"
        for={@rename_project_form}
        id="rename-project"
        phx-submit="rename_project"
      >
        <.modal
          id="rename-project-modal"
          title={dgettext("dashboard_projects", "Rename your project?")}
          header_size="large"
          on_dismiss="close_rename_project_modal"
        >
          <:trigger :let={attrs}>
            <.button
              label={dgettext("dashboard_projects", "Rename project")}
              variant="destructive"
              size="medium"
              {attrs}
            />
          </:trigger>
          <.line_divider />
          <.alert
            status="error"
            type="secondary"
            size="small"
            title={dgettext("dashboard_projects", "Renaming can have unexpected consequences")}
          />
          <.text_input
            field={@rename_project_form[:name]}
            type="basic"
            placeholder={dgettext("dashboard_projects", "Project name")}
          />
          <.line_divider />
          <:footer>
            <.modal_footer>
              <:action>
                <.button
                  type="reset"
                  label={dgettext("dashboard_projects", "Cancel")}
                  variant="secondary"
                  phx-click="close_rename_project_modal"
                />
              </:action>
              <:action>
                <.button
                  type="submit"
                  label={dgettext("dashboard_projects", "Rename")}
                  variant="destructive"
                />
              </:action>
            </.modal_footer>
          </:footer>
        </.modal>
      </.form>
    </div>
  </.card_section>
  <.card_section data-part="delete-project-card-section">
    <div data-part="header">
      <span data-part="title">
        {dgettext("dashboard_projects", "Delete project")}
      </span>
      <span data-part="subtitle">
        {dgettext("dashboard_projects", "This action cannot be undone.")}
      </span>
    </div>
    <div data-part="content">
      <.form
        data-part="form"
        for={@delete_project_form}
        id="delete-project-form"
        phx-submit="delete_project"
      >
        <.modal
          id="delete-project-modal"
          title={dgettext("dashboard_projects", "Are you sure you want to delete this?")}
          header_size="large"
          on_dismiss="close_delete_project_modal"
        >
          <:trigger :let={attrs}>
            <.button
              label={dgettext("dashboard_projects", "Delete project")}
              variant="destructive"
              size="medium"
              {attrs}
            />
          </:trigger>
          <.line_divider />
          <.alert
            status="warning"
            type="secondary"
            size="small"
            title={
              dgettext(
                "dashboard_projects",
                "Deleting the project will permanently remove all of its data"
              )
            }
          />
          <.text_input
            label={dgettext("dashboard_projects", "Enter this project's name to confirm")}
            field={@delete_project_form[:name]}
            type="basic"
            placeholder={dgettext("dashboard_projects", "Project name")}
          />
          <.line_divider />
          <:footer>
            <.modal_footer>
              <:action>
                <.button
                  type="reset"
                  label={dgettext("dashboard_projects", "Cancel")}
                  variant="secondary"
                  phx-click="close_delete_project_modal"
                />
              </:action>
              <:action>
                <.button
                  type="submit"
                  label={dgettext("dashboard_projects", "Delete")}
                  variant="destructive"
                />
              </:action>
            </.modal_footer>
          </:footer>
        </.modal>
      </.form>
    </div>
  </.card_section>
</div>
