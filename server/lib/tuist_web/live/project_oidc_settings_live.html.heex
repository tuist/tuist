<div id="project-oidc-settings">
  <h1 data-part="title">
    {@selected_project.name}
  </h1>

  <.tab_menu_horizontal>
    <.tab_menu_horizontal_item
      label={dgettext("dashboard_projects", "General")}
      selected={false}
      patch={~p"/#{@selected_account.name}/#{@selected_project.name}/settings"}
    />
    <.tab_menu_horizontal_item
      :if={Tuist.Projects.Project.xcode_project?(@selected_project)}
      label={dgettext("dashboard_projects", "Notifications")}
      selected={false}
      patch={~p"/#{@selected_account.name}/#{@selected_project.name}/settings/notifications"}
    />
    <.tab_menu_horizontal_item
      :if={
        Tuist.Projects.Project.xcode_project?(@selected_project) or
          Tuist.Projects.Project.bazel_project?(@selected_project)
      }
      label={dgettext("dashboard_projects", "Automations")}
      selected={false}
      patch={~p"/#{@selected_account.name}/#{@selected_project.name}/settings/automations"}
    />
    <.tab_menu_horizontal_item
      :if={Tuist.Projects.Project.supports_bundles?(@selected_project)}
      label={dgettext("dashboard_projects", "Bundles")}
      selected={false}
      patch={~p"/#{@selected_account.name}/#{@selected_project.name}/settings/bundles"}
    />
    <.tab_menu_horizontal_item
      label={dgettext("dashboard_projects", "OIDC")}
      selected={true}
      patch={~p"/#{@selected_account.name}/#{@selected_project.name}/settings/oidc"}
    />
  </.tab_menu_horizontal>

  <h2 data-part="subtitle">
    {dgettext("dashboard_projects", "OIDC")}
  </h2>

  <.card_section data-part="oidc-rules-card-section">
    <div data-part="header">
      <div data-part="title-group">
        <span data-part="title">
          {dgettext("dashboard_projects", "Write access rules")}
        </span>
        <span data-part="subtitle">
          {dgettext(
            "dashboard_projects",
            "Limit which GitHub Actions runs can write to this project with OIDC tokens. Without a rule, any workflow in the linked repository can."
          )}
        </span>
      </div>
    </div>
    <div data-part="content">
      <.alert
        :if={!@has_vcs_connection}
        status="information"
        type="secondary"
        size="medium"
        data-part="github-connect-alert"
        title={
          dgettext(
            "dashboard_projects",
            "Connect this project to a GitHub repository to authenticate CI with OIDC tokens."
          )
        }
      >
        <:action>
          <.link_button
            href={~p"/#{@selected_account.name}/settings/integrations"}
            target="_blank"
            label={dgettext("dashboard_projects", "Connect GitHub")}
            variant="secondary"
          >
            <:icon_right><.external_link /></:icon_right>
          </.link_button>
        </:action>
      </.alert>
      <TuistWeb.Components.OIDCScopeRules.oidc_scope_rules
        id={@rules_id}
        scopes={TuistWeb.Components.OIDCScopeRules.project_scopes()}
        rules={@oidc_rules}
        errors={@oidc_rule_errors}
      />
    </div>
  </.card_section>
</div>
