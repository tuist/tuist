<section id="account-workload-identities">
  <.card_section id="oidc-trust-policies" data-part="oidc-card-section">
    <div data-part="header">
      <span data-part="title">{dgettext("dashboard_account", "Workload identities")}</span>
      <span data-part="subtitle">
        {dgettext(
          "dashboard_account",
          "Allow trusted workloads to access selected projects without long-lived tokens."
        )}
      </span>
      <.link
        href="/en/docs/guides/server/authentication#workload-identity-trust-policies"
        data-part="documentation"
      >
        {dgettext("dashboard_account", "Learn about workload identities")}
      </.link>
    </div>
    <div data-part="content">
      <div
        :for={policy <- @oidc_trust_policies}
        id={"oidc-trust-policy-#{policy.id}"}
        data-part="policy"
      >
        <div data-part="identity">
          <span data-part="name">{policy.name}</span>
          <span data-part="issuer">{policy.issuer}</span>
          <span data-part="details">
            {dgettext("dashboard_account", "JWKS: %{url}", url: policy.jwks_url)}
          </span>
          <span data-part="details">
            {dgettext("dashboard_account", "Audience: %{audience}", audience: policy.audience)}
          </span>
          <span data-part="details">
            {dgettext("dashboard_account", "Claims: %{claims}",
              claims: format_claims(policy.claims)
            )}
          </span>
          <span data-part="details" data-scope="projects">
            {dgettext("dashboard_account", "Projects: %{projects}",
              projects: Enum.map_join(policy.projects, ", ", & &1.name)
            )}
          </span>
        </div>
        <.button
          variant="secondary"
          label={dgettext("dashboard_account", "Remove")}
          phx-click="delete_oidc_trust_policy"
          phx-value-policy-id={policy.id}
        />
      </div>
      <.alert
        :if={@oidc_trust_policies != []}
        id="oidc-workload-setup"
        status="information"
        type="secondary"
        size="large"
        title={dgettext("dashboard_account", "Authenticate your workload")}
      >
        <p>
          {dgettext(
            "dashboard_account",
            "Provide a fresh provider token as TUIST_OIDC_TOKEN, then run:"
          )}
        </p>
        <pre><code>{~s(export TUIST_OIDC_ACCOUNT="#{@selected_account.name}") <> "\ntuist auth login"}</code></pre>
        <p>
          {dgettext("dashboard_account", "For Elixir projects, use mix tuist.login instead.")}
        </p>
      </.alert>
      <.form
        for={@oidc_trust_policy_form}
        id="oidc-trust-policy-form"
        data-part="form"
        phx-change="change_oidc_trust_policy"
        phx-submit="create_oidc_trust_policy"
      >
        <.alert
          :for={error <- @form_errors}
          status="error"
          type="secondary"
          size="small"
          title={error}
        />
        <div id="oidc-template" data-part="template-picker">
          <span data-part="template-label">{dgettext("dashboard_account", "Template")}</span>
          <.select
            id={"oidc-template-select-#{@oidc_template}"}
            name="oidc_template"
            label={dgettext("dashboard_account", "Template")}
            value={@oidc_template}
            on_value_change="select_oidc_template"
          >
            <:item value="custom" label={dgettext("dashboard_account", "Custom provider")} />
            <:item value="fly" label="Fly.io Machines" />
          </.select>
        </div>
        <.text_input
          label={dgettext("dashboard_account", "Name")}
          field={@oidc_trust_policy_form[:name]}
          error={field_error(@oidc_trust_policy_form[:name])}
          type="basic"
          placeholder={dgettext("dashboard_account", "Production service")}
        />
        <div :if={@oidc_template == "fly"} id="oidc-fly-template" data-part="template-fields">
          <.text_input
            id="oidc-fly-organization-slug"
            label={dgettext("dashboard_account", "Organization slug")}
            name="fly_template[organization_slug]"
            value={@fly_template["organization_slug"]}
            type="basic"
            placeholder="my-organization"
            required
          />
          <div data-part="template-ids">
            <.text_input
              id="oidc-fly-organization-id"
              label={dgettext("dashboard_account", "Organization ID")}
              name="fly_template[organization_id]"
              value={@fly_template["organization_id"]}
              type="basic"
              placeholder="123"
              inputmode="numeric"
              required
            />
            <.text_input
              id="oidc-fly-application-id"
              label={dgettext("dashboard_account", "Application ID")}
              name="fly_template[application_id]"
              value={@fly_template["application_id"]}
              type="basic"
              placeholder="456"
              inputmode="numeric"
              required
            />
          </div>
        </div>
        <.text_input
          label={dgettext("dashboard_account", "Audience")}
          field={@oidc_trust_policy_form[:audience]}
          error={field_error(@oidc_trust_policy_form[:audience])}
          type="basic"
          placeholder="tuist"
        />
        <fieldset id="oidc-projects" data-part="project-scope">
          <legend>{dgettext("dashboard_account", "Projects")}</legend>
          <p id="oidc-projects-hint">
            {dgettext(
              "dashboard_account",
              "Select 1 to 100 projects. Unselected and future projects are not accessible."
            )}
          </p>
          <input type="hidden" name="oidc_trust_policy[project_ids][]" value="" />
          <div data-part="project-options">
            <label :for={project <- @projects} data-part="project-option">
              <input
                id={"oidc-project-#{project.id}"}
                type="checkbox"
                name="oidc_trust_policy[project_ids][]"
                value={project.id}
                checked={project_selected?(@oidc_trust_policy_form, project.id)}
                aria-describedby="oidc-projects-hint oidc-projects-error"
              />
              <span>{project.name}</span>
            </label>
          </div>
          <p :if={@projects == []}>
            {dgettext("dashboard_account", "Create a project before adding a workload identity.")}
          </p>
          <span id="oidc-projects-error" data-part="project-error">
            {field_error(@oidc_trust_policy_form[:project_ids])}
          </span>
        </fieldset>
        <.alert
          :if={@oidc_template == "fly" and @identity_overridden?}
          id="oidc-template-overrides"
          status="warning"
          type="secondary"
          size="small"
          title={
            dgettext(
              "dashboard_account",
              "Your manual changes override this template. Review the advanced configuration."
            )
          }
        />
        <.identity_fields
          :if={@oidc_template == "custom"}
          form={@oidc_trust_policy_form}
          claims_input={@claims_input}
        />
        <details
          :if={@oidc_template == "fly"}
          data-part="advanced"
          open={identity_errors?(@oidc_trust_policy_form) or @identity_overridden?}
        >
          <summary>{dgettext("dashboard_account", "Advanced configuration")}</summary>
          <.identity_fields form={@oidc_trust_policy_form} claims_input={@claims_input} />
        </details>
        <.button
          type="submit"
          variant="primary"
          label={dgettext("dashboard_account", "Add trust policy")}
          disabled={@projects == []}
        />
      </.form>
    </div>
  </.card_section>
</section>
