<!DOCTYPE html>
<html lang={Gettext.get_locale()} class="[scrollbar-gutter:stable]">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="csp-nonce" content={get_csp_nonce()} />
    <meta name="csrf-token" content={get_csrf_token()} />
    <%!-- Prerender marketing pages when a link is hovered (moderate
    eagerness), so the navigation is already rendered by click time.
    Chromium-only; other engines ignore the script. App, auth, docs and
    feed URLs are excluded — prerendering those would waste work or open
    sockets/sessions early. --%>
    <script type="speculationrules" nonce={get_csp_nonce()}>
      {
        "prerender": [
          {
            "where": {
              "and": [
                { "href_matches": "/*" },
                { "not": { "href_matches": "/users/*" } },
                { "not": { "href_matches": "/docs*" } },
                { "not": { "href_matches": "/api/*" } },
                { "not": { "href_matches": "/ops/*" } },
                { "not": { "href_matches": "/agent/*" } },
                { "not": { "href_matches": "/*.xml" } },
                { "not": { "href_matches": "/blog/*/iframe.html" } }
              ]
            },
            "eagerness": "moderate"
          }
        ]
      }
    </script>
    <%= if assigns[:new_design] do %>
      <%!-- Theme bootstrap for the redesigned pages (the legacy design is
      light-only, pinned via bundle.css). Runs before the stylesheet loads to
      avoid a flash of the wrong theme. Shares the dashboard's
      "preferred-theme" localStorage key so the theme follows the app, and
      keeps data-theme in sync with the system scheme (Noora's shadow tokens
      key off data-theme, its colors off color-scheme). Canvas hooks resolve
      token colors at mount, so they listen for tuist:theme-change to
      re-resolve. --%>
      <script nonce={get_csp_nonce()}>
        (function() {
          function preferredTheme() {
            try {
              const stored = localStorage.getItem("preferred-theme");
              return stored === null || stored === "null" ? "system" : stored;
            } catch (e) {
              return "system";
            }
          }

          const systemDark = window.matchMedia("(prefers-color-scheme: dark)");

          function applyTheme() {
            const theme = preferredTheme();
            const resolved = theme === "system" ? (systemDark.matches ? "dark" : "light") : theme;
            document.documentElement.style.setProperty("color-scheme", theme === "system" ? "light dark" : theme);
            document.documentElement.setAttribute("data-theme", resolved);
            return resolved;
          }

          applyTheme();

          systemDark.addEventListener("change", function() {
            const before = document.documentElement.getAttribute("data-theme");
            const after = applyTheme();
            if (before !== after) {
              window.dispatchEvent(new CustomEvent("tuist:theme-change", { detail: { theme: after } }));
            }
          });
        })();
      </script>
    <% end %>
    <.live_title>
      {assigns[:head_title] || "Tuist"}
    </.live_title>
    <TuistWeb.LayoutComponents.head_favicon_links />
    <TuistWeb.LayoutComponents.head_meta_meta_tags {assigns} />
    <TuistWeb.LayoutComponents.head_x_meta_tags {assigns} />
    <!-- Language alternates for SEO -->
    <%= for locale <- TuistWeb.Marketing.Localization.all_locales() do %>
      <link
        rel="alternate"
        hreflang={locale}
        href={
          Tuist.Environment.app_url(
            path:
              TuistWeb.Marketing.Localization.localized_href(
                TuistWeb.Marketing.Localization.current_path(assigns),
                locale
              )
          )
        }
      />
    <% end %>
    <link
      rel="alternate"
      hreflang="x-default"
      href={
        Tuist.Environment.app_url(path: TuistWeb.Marketing.Localization.current_path(assigns))
      }
    />
    <script
      :for={
        structured_data <-
          TuistWeb.Marketing.StructuredMarkup.get_json_serialized_structured_data(assigns)
      }
      nonce={get_csp_nonce()}
      type="application/ld+json"
    >
      <%= raw structured_data %>
    </script>
    <!-- Assets -->
    <%= if assigns[:new_design] do %>
      <%!-- Pages can name their largest above-the-fold images (typically CSS
        backgrounds, which the browser would otherwise only discover after
        parsing the stylesheet) so they start downloading with the HTML. --%>
      <%= for href <- assigns[:head_preload_images] || [] do %>
        <link rel="preload" as="image" href={href} fetchpriority="high" />
      <% end %>
      <link phx-track-static rel="stylesheet" href={~p"/marketing/assets/bundle-new.css"} />
    <% else %>
      <link phx-track-static rel="stylesheet" href={~p"/marketing/assets/bundle.css"} />
    <% end %>
    <script defer phx-track-static type="module" src={~p"/marketing/assets/bundle.js"}>
    </script>
    <!-- Mermaid (loaded only on pages that contain a diagram) -->
    <style nonce={get_csp_nonce()}>
      pre.mermaid:not([data-processed="true"]) { visibility: hidden; }
    </style>
    <script nonce={get_csp_nonce()} type="module">
      if (document.querySelector("pre.mermaid")) {
        const { default: mermaid } = await import(
          "https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs"
        );
        const dark = document.documentElement.dataset.theme === "dark";
        const light = {
          primaryColor: "#f1f2f4", primaryBorderColor: "#c7ccd1", primaryTextColor: "#171a1c",
          secondaryColor: "#f9fafa", tertiaryColor: "#fdfdfd", lineColor: "#848f9a",
          textColor: "#171a1c", nodeBorder: "#c7ccd1", nodeTextColor: "#171a1c",
          edgeLabelBackground: "#fdfdfd", fontFamily: "Inter, sans-serif", fontSize: "14px",
        };
        const night = {
          primaryColor: "#22262a", primaryBorderColor: "#464646", primaryTextColor: "#f1f2f4",
          secondaryColor: "#1b1e22", tertiaryColor: "#131619", lineColor: "#848f9a",
          textColor: "#f1f2f4", nodeBorder: "#464646", nodeTextColor: "#f1f2f4",
          edgeLabelBackground: "#131619", fontFamily: "Inter, sans-serif", fontSize: "14px",
        };
        mermaid.initialize({ startOnLoad: false, theme: "base", themeVariables: dark ? night : light });
        // Wait for Inter to load before rendering. Mermaid measures label
        // widths at run time; if it measures with a fallback font the node
        // boxes come out too narrow and clip the labels once Inter swaps in.
        if (document.fonts && document.fonts.ready) {
          await document.fonts.ready;
        }
        await mermaid.run({ querySelector: "pre.mermaid" });
      }
    </script>
    <!-- RSS -->
    <%= if assigns[:head_include_blog_rss_and_atom] do %>
      <link
        rel="alternate"
        type="application/rss+xml"
        title={dgettext("marketing", "Tuist Blog")}
        href={~p"/blog/rss.xml"}
      />
      <link
        rel="alternate"
        type="application/atom+xml"
        title={dgettext("marketing", "Tuist Blog")}
        href={~p"/blog/atom.xml"}
      />
    <% end %>

    <%= if assigns[:head_include_changelog_rss_and_atom] do %>
      <link
        rel="alternate"
        type="application/rss+xml"
        title={dgettext("marketing", "Tuist Changelog")}
        href={~p"/changelog/rss.xml"}
      />
      <link
        rel="alternate"
        type="application/atom+xml"
        title={dgettext("marketing", "Tuist Changelog")}
        href={~p"/changelog/atom.xml"}
      />
    <% end %>

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300..700&family=Space+Mono:ital,wght@0,400;0,700;1,400;1,700&display=swap"
      rel="stylesheet"
    />

    <!-- Analytics -->
    <TuistWeb.LayoutComponents.head_analytics_scripts page_section="marketing" {assigns} />

    <!-- hCaptcha -->
    <script nonce={get_csp_nonce()} src="https://js.hcaptcha.com/1/api.js" async defer>
    </script>
    <TuistWeb.LayoutComponents.head_support_chat_script {assigns} />
    <link rel="canonical" href={Tuist.Environment.app_url(path: @current_path)} />
  </head>
  <body data-scrollable="true">
    <div data-part="content">
      {@inner_content}
    </div>
  </body>
</html>
