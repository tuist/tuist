<% assistants = [
  %{name: "ChatGPT", href: "https://chatgpt.com/?q=What+does+Tuist+do%3F", icon: "brand_chatgpt"},
  %{
    name: "Claude",
    href: "https://claude.ai/new?q=What%20does%20Tuist%20do%3F",
    icon: "brand_claude"
  },
  %{
    name: "Gemini",
    href: "https://gemini.google.com/app/c588db3918397563?q=What%20does%20Tuist%20do%3F",
    icon: "brand_gemini"
  },
  %{name: "Grok", href: "https://grok.com/?q=What%20does%20Tuist%20do%3F", icon: "brand_grok"},
  %{
    name: "Perplexity",
    href: "https://www.perplexity.ai/search?q=What%20does%20Tuist%20do%3F",
    icon: "brand_perplexity"
  }
] %>
<%!-- phx-update="ignore": static markup whose hooks are mounted by
mountStaticHooks (marketing.js) rather than by LiveView, so they work on
LiveView pages before the socket has joined; LiveView leaves the subtree
alone on join. The navbar does the same. --%>
<footer id="marketing-footer-new" phx-update="ignore">
  <div data-part="content">
    <div data-part="main">
      <div data-part="brand">
        <.link href={TuistWeb.Marketing.MarketingHTML.localized_href("/")} data-part="tuist">
          <%!-- One wordmark for both themes (see wordmark_new/1), so nothing
          depends on a theme rule hiding a second image. --%>
          <.wordmark_new data-part="logo" role="img" aria-label="Tuist" />
          <svg data-part="logo-outline" viewBox="0 0 84 32" aria-hidden="true">
            <use href="#footer-wordmark-shape" width="84" height="32" />
          </svg>
        </.link>
        <span
          data-part="soc-badge"
          role="img"
          aria-label={dgettext("marketing", "SOC 2 Type II certified")}
          title={dgettext("marketing", "SOC 2 Type II certified")}
        >
          <.illustration name="transparency-soc-badge" />
        </span>
      </div>
      <nav data-part="columns" aria-label={dgettext("marketing", "Footer navigation")}>
        <section :for={column <- columns} data-part="column">
          <h3 data-part="title">{column.title}</h3>
          <ul data-part="links">
            <li :for={link <- column.links}>
              <.link
                data-part="link"
                href={link.href}
                target={if link[:external], do: "_blank"}
                rel={if link[:external], do: "noopener noreferrer"}
              >
                {link.label}
              </.link>
            </li>
          </ul>
        </section>
      </nav>
    </div>
    <div data-part="ask">
      <span data-part="ask-label">{dgettext("marketing", "Ask about Tuist on")}</span>
      <div data-part="ask-assistants">
        <.button
          :for={assistant <- assistants}
          variant="secondary"
          size="large"
          icon_only
          href={assistant.href}
          target="_blank"
          rel="noopener noreferrer"
          title={assistant.name}
          aria-label={
            dgettext("marketing", "Ask about Tuist on %{assistant}", assistant: assistant.name)
          }
        >
          <Noora.Icon.icon name={assistant.icon} />
        </.button>
      </div>
    </div>
    <div data-part="bar">
      <.link
        data-part="status"
        href="https://status.tuist.dev"
        target="_blank"
        rel="noopener noreferrer"
      >
        <% any_ongoing_incident? = Tuist.Incidents.any_ongoing_incident?() %>
        <.status_badge
          :if={not any_ongoing_incident?}
          label={dgettext("marketing", "All systems normal")}
          status="success"
          type="dot"
        />
        <.status_badge
          :if={any_ongoing_incident?}
          label={dgettext("marketing", "Ongoing incident")}
          status="warning"
          type="dot"
        />
      </.link>
      <div data-part="controls">
        <%!-- The server can't know the visitor's stored preference, so
        "system" (the default) renders selected and the hook re-syncs the
        selection at mount. The id must not start with "marketing-":
        pages.css lays out [id^="marketing-"] containers as flex columns,
        which would stack the button group vertically. --%>
        <.button_group size="small" id="footer-theme-switcher" data-static-hook="ThemeSwitcher">
          <.button_group_item
            icon_only
            data-theme-option="system"
            data-selected
            aria-pressed="true"
            aria-label={dgettext("marketing", "System theme")}
          >
            <Noora.Icon.icon name="device_desktop" />
          </.button_group_item>
          <.button_group_item
            icon_only
            data-theme-option="light"
            aria-pressed="false"
            aria-label={dgettext("marketing", "Light theme")}
          >
            <Noora.Icon.icon name="sun_high" />
          </.button_group_item>
          <.button_group_item
            icon_only
            data-theme-option="dark"
            aria-pressed="false"
            aria-label={dgettext("marketing", "Dark theme")}
          >
            <Noora.Icon.icon name="moon" />
          </.button_group_item>
        </.button_group>
        <% current_language =
          Enum.find(
            TuistWeb.Marketing.Localization.languages(),
            &(&1.code == Gettext.get_locale())
          ) %>
        <%!-- The id must not start with "marketing-": pages.css lays out
        [id^="marketing-"] page containers as flex columns, which would
        break the dropdown's row layout. --%>
        <%!-- Noora's dropdown delivers its items through LiveView portals,
        which never teleport on these static (controller-rendered) pages,
        leaving the panel empty. This is the exact same DOM the component
        produces post-teleport, with the label and items inlined. --%>
        <div
          id="footer-locale-dropdown"
          class="noora-dropdown"
          data-static-hook="NooraDropdown"
          phx-update="ignore"
          data-size="medium"
          data-loop-focus
          data-typeahead
          data-close-on-select="true"
        >
          <button data-part="trigger" type="button">
            <div data-part="label-wrapper">
              <span data-part="label">
                <span id="footer-locale-dropdown-label-target">
                  {(current_language && current_language.native) || "English"}
                </span>
              </span>
            </div>
            <div data-part="indicator">
              <div data-part="indicator-down"><.chevron_down /></div>
              <div data-part="indicator-up"><.chevron_up /></div>
            </div>
          </button>
          <div data-part="positioner">
            <div class="noora-dropdown-content" data-part="content">
              <div id="footer-locale-dropdown-content-target" data-part="items">
                <.dropdown_item
                  :for={language <- TuistWeb.Marketing.Localization.languages()}
                  value={language.code}
                  label={language.native}
                  secondary_text={if language.code != "en", do: language.label}
                  href={
                    TuistWeb.Marketing.Localization.localized_href(
                      TuistWeb.Marketing.Localization.current_path(assigns),
                      language.code
                    )
                  }
                />
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div data-part="wordmark" aria-hidden="true">
      <canvas
        data-part="wordmark-dither"
        id="footer-wordmark-dither"
        data-static-hook="DitherTexture"
        data-pitch="2"
        data-dot="2"
        data-top="0.5"
        data-bottom="0.7"
        data-wave="0.5"
        data-wave-scale="0.5"
        data-levels="0"
        data-speed="5.5"
        data-dither="on"
        data-opacity="0.7"
        data-colors="--marketing-illustration-neutral-1,--marketing-illustration-neutral-5"
        data-mask="#footer-wordmark-shape"
        data-mask-viewbox="84 32"
        data-mask-blur="2"
        data-hover="off"
      ></canvas>
      <%!-- The wordmark silhouette the dither hook rasterizes and blurs into
      its density mask, so the logo's edges dissolve into particles instead
      of being clipped hard. Zero-sized: only its paths are read. --%>
      <.wordmark_new id="footer-wordmark-shape" width="0" height="0" aria-hidden="true" />
    </div>
  </div>
</footer>
