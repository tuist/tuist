<% columns = [
  %{
    title: dgettext("marketing", "Features"),
    links: [
      %{label: dgettext("marketing", "Cache"), href: TuistWeb.Marketing.MarketingHTML.localized_href("/cache")},
      %{label: dgettext("marketing", "Compute"), href: TuistWeb.Marketing.MarketingHTML.localized_href("/compute")},
      %{
        label: dgettext("marketing", "Tests"),
        href: TuistWeb.Marketing.MarketingHTML.localized_href("/selective-testing")
      },
      %{label: dgettext("marketing", "Previews"), href: TuistWeb.Marketing.MarketingHTML.localized_href("/previews")},
      %{
        label: dgettext("marketing", "Generated projects"),
        href: TuistWeb.Marketing.MarketingHTML.localized_href("https://tuist.dev/en/docs/guides/features/projects"),
        external: true
      },
      %{
        label: dgettext("marketing", "Registry"),
        href: TuistWeb.Marketing.MarketingHTML.localized_href("https://tuist.dev/en/docs/guides/features/registry"),
        external: true
      }
    ]
  },
  %{
    title: dgettext("marketing", "Product"),
    links: [
      %{label: dgettext("marketing", "Pricing"), href: TuistWeb.Marketing.MarketingHTML.localized_href("/pricing")},
      %{label: dgettext("marketing", "Changelog"), href: TuistWeb.Marketing.MarketingHTML.localized_href("/changelog")},
      %{
        label: dgettext("marketing", "Documentation"),
        href: TuistWeb.Marketing.MarketingHTML.localized_href("https://tuist.dev/en/docs/"),
        external: true
      },
      %{label: dgettext("marketing", "Download"), href: "/download"}
    ]
  },
  %{
    title: dgettext("marketing", "Community"),
    links: [
      %{label: dgettext("marketing", "Slack"), href: "https://slack.tuist.dev", external: true},
      %{label: dgettext("marketing", "Discourse"), href: "https://community.tuist.dev", external: true},
      %{
        label: dgettext("marketing", "Newsletter"),
        href: TuistWeb.Marketing.MarketingHTML.localized_href("/newsletter")
      },
      %{label: dgettext("marketing", "Issues"), href: "https://github.com/tuist/tuist/issues", external: true}
    ]
  },
  %{
    title: dgettext("marketing", "Company"),
    links: [
      %{label: dgettext("marketing", "About"), href: TuistWeb.Marketing.MarketingHTML.localized_href("/about")},
      %{label: dgettext("marketing", "Blog"), href: TuistWeb.Marketing.MarketingHTML.localized_href("/blog")},
      %{label: dgettext("marketing", "Contact"), href: "mailto:contact@tuist.dev"},
      %{
        label: dgettext("marketing", "Brand assets"),
        href: "https://github.com/tuist/tuist/tree/main/assets",
        external: true
      }
    ]
  },
  %{
    title: dgettext("marketing", "Socials"),
    links: [
      %{label: dgettext("marketing", "Mastodon"), href: "https://fosstodon.org/@tuist", external: true},
      %{label: dgettext("marketing", "GitHub"), href: "https://github.com/tuist", external: true},
      %{label: dgettext("marketing", "Bluesky"), href: "https://bsky.app/profile/tuist.dev", external: true},
      %{label: "X", href: "https://x.com/tuistdev", external: true},
      %{label: dgettext("marketing", "LinkedIn"), href: "https://www.linkedin.com/company/tuistio/", external: true},
      %{label: dgettext("marketing", "Videos"), href: "https://videos.tuist.dev", external: true}
    ]
  },
  %{
    title: dgettext("marketing", "Legal"),
    links: [
      %{
        label: dgettext("marketing", "Terms of service"),
        href: TuistWeb.Marketing.MarketingHTML.localized_href("/terms")
      },
      %{label: dgettext("marketing", "Privacy policy"), href: TuistWeb.Marketing.MarketingHTML.localized_href("/privacy")},
      %{label: dgettext("marketing", "Cookie policy"), href: TuistWeb.Marketing.MarketingHTML.localized_href("/cookies")}
    ]
  }
] %>
<footer id="marketing-footer-new">
  <div data-part="content">
    <div data-part="main">
      <div data-part="brand">
        <.link href={TuistWeb.Marketing.MarketingHTML.localized_href("/")} data-part="tuist">
          <img
            data-part="logo"
            data-theme="light"
            src={~p"/marketing/images/components/navbar/logo-light.svg"}
            alt="Tuist"
            loading="lazy"
          />
          <img
            data-part="logo"
            data-theme="dark"
            src={~p"/marketing/images/components/navbar/logo-dark.svg"}
            alt="Tuist"
            loading="lazy"
          />
        </.link>
        <span data-part="soc-badge" title="SOC 2 Type II Certified">
          <.illustration name="transparency-soc-badge" />
        </span>
      </div>
      <nav data-part="columns" aria-label="Footer navigation">
        <section :for={column <- columns} data-part="column">
          <h3 data-part="title">{column.title}</h3>
          <ul data-part="links">
            <li :for={link <- column.links}>
              <.link
                data-part="link"
                href={link.href}
                target={if link[:external], do: "_blank"}
                rel={if link[:external], do: "noopener noreferrer"}
              >
                {link.label}
              </.link>
            </li>
          </ul>
        </section>
      </nav>
    </div>
    <div data-part="bar">
      <.link
        data-part="status"
        href="https://status.tuist.dev"
        target="_blank"
        rel="noopener noreferrer"
      >
        <% any_ongoing_incident? = Tuist.Incidents.any_ongoing_incident?() %>
        <.status_badge
          :if={not any_ongoing_incident?}
          label={dgettext("marketing", "All systems normal")}
          status="success"
          type="dot"
        />
        <.status_badge
          :if={any_ongoing_incident?}
          label={dgettext("marketing", "Ongoing incident")}
          status="warning"
          type="dot"
        />
      </.link>
      <div data-part="controls">
        <%!-- The server can't know the visitor's stored preference, so
        "system" (the default) renders selected and the hook re-syncs the
        selection at mount. The id must not start with "marketing-":
        pages.css lays out [id^="marketing-"] containers as flex columns,
        which would stack the button group vertically. --%>
        <.button_group size="small" id="footer-theme-switcher" phx-hook="ThemeSwitcher">
          <.button_group_item icon_only data-theme-option="system" data-selected aria-label="System theme">
            <Noora.Icon.icon name="device_desktop" />
          </.button_group_item>
          <.button_group_item icon_only data-theme-option="light" aria-label="Light theme">
            <Noora.Icon.icon name="sun_high" />
          </.button_group_item>
          <.button_group_item icon_only data-theme-option="dark" aria-label="Dark theme">
            <Noora.Icon.icon name="moon" />
          </.button_group_item>
        </.button_group>
        <% current_language =
          Enum.find(
            TuistWeb.Marketing.Localization.languages(),
            &(&1.code == Gettext.get_locale())
          ) %>
        <%!-- The id must not start with "marketing-": pages.css lays out
        [id^="marketing-"] page containers as flex columns, which would
        break the dropdown's row layout. --%>
        <%!-- Noora's dropdown delivers its items through LiveView portals,
        which never teleport on these static (controller-rendered) pages,
        leaving the panel empty. This is the exact same DOM the component
        produces post-teleport, with the label and items inlined. --%>
        <div
          id="footer-locale-dropdown"
          class="noora-dropdown"
          phx-hook="NooraDropdown"
          phx-update="ignore"
          data-size="medium"
          data-loop-focus
          data-typeahead
          data-close-on-select="true"
        >
          <button data-part="trigger" type="button">
            <div data-part="label-wrapper">
              <span data-part="label">
                <span id="footer-locale-dropdown-label-target">
                  {(current_language && current_language.native) || "English"}
                </span>
              </span>
            </div>
            <div data-part="indicator">
              <div data-part="indicator-down"><.chevron_down /></div>
              <div data-part="indicator-up"><.chevron_up /></div>
            </div>
          </button>
          <div data-part="positioner">
            <div class="noora-dropdown-content" data-part="content">
              <div id="footer-locale-dropdown-content-target" data-part="items">
                <.dropdown_item
                  :for={language <- TuistWeb.Marketing.Localization.languages()}
                  value={language.code}
                  label={language.native}
                  secondary_text={if language.code != "en", do: language.label}
                  href={
                    TuistWeb.Marketing.Localization.localized_href(
                      TuistWeb.Marketing.Localization.current_path(assigns),
                      language.code
                    )
                  }
                />
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div data-part="wordmark" aria-hidden="true">
      <canvas
        data-part="wordmark-dither"
        id="footer-wordmark-dither"
        phx-hook="DitherTexture"
        data-pitch="2"
        data-dot="2"
        data-top="0.5"
        data-bottom="0.7"
        data-wave="0.5"
        data-wave-scale="0.5"
        data-levels="0"
        data-speed="5.5"
        data-dither="on"
        data-opacity="0.7"
        data-colors="--marketing-illustration-neutral-1,--marketing-illustration-neutral-5"
        data-mask="#footer-wordmark-shape"
        data-mask-viewbox="84 32"
        data-mask-blur="2"
        data-hover="off"
      >
      </canvas>
      <%!-- The wordmark silhouette (navbar logo paths) that the dither hook
      rasterizes and blurs into its density mask, so the logo's edges
      dissolve into particles instead of being clipped hard. --%>
      <svg id="footer-wordmark-shape" width="0" height="0" aria-hidden="true">
        <path d="M25.2936 21.3441C23.8928 22.3779 22.3966 23.2755 20.8239 23.9788C23.1956 21.286 25.093 18.049 26.5402 15.0482C26.0861 14.1592 25.5129 13.3135 24.8849 12.5421C23.4259 15.3039 21.734 17.9809 19.6776 20.3456C19.4286 20.6261 19.1746 20.9051 18.9152 21.1808C20.4746 16.7253 21.4336 12.1112 22.1684 7.49133C21.4242 6.95278 20.6258 6.47946 19.7804 6.08233C19.0234 9.76934 18.0831 13.4221 16.8805 16.9548C16.3562 18.4852 15.7772 19.9937 15.118 21.4384L14.662 2.72436C14.2242 2.68579 13.7815 2.66675 13.3338 2.66675C12.8862 2.66675 12.4435 2.68532 12.0057 2.72436L11.5491 21.4441C10.8821 19.988 10.3173 18.4761 9.78667 16.9553C8.58403 13.4221 7.64375 9.76934 6.88679 6.08281C6.04138 6.47994 5.24291 6.95325 4.4988 7.4918C5.23402 12.115 6.19406 16.7329 7.75542 21.1913C7.49552 20.9146 7.24007 20.6332 6.98956 20.3461C4.93361 17.9814 3.24131 15.3044 1.78222 12.5426C1.15274 13.3154 0.579581 14.1625 0.125502 15.052C0.606757 16.0591 1.12062 17.0533 1.67451 18.0343C2.85442 20.0447 4.22655 22.1265 5.85165 23.9836C4.27546 23.2793 2.77636 22.3803 1.37311 21.3441C0.84689 22.0503 0.385893 22.8041 0 23.6002C7.13581 31.2438 19.5294 31.2452 26.6667 23.6002C26.2803 22.8041 25.8198 22.0503 25.2936 21.3441Z" />
        <path d="M40.1771 12.0156V14.2943H32.2214V12.0156H40.1771ZM34.5651 8.34375H37.3385V22.276C37.3385 22.8056 37.447 23.1832 37.6641 23.4089C37.8898 23.6259 38.2804 23.7344 38.8359 23.7344C39.0269 23.7344 39.2483 23.73 39.5 23.7214C39.7517 23.7127 39.9644 23.704 40.138 23.6953L40.2943 25.974C40.0425 26 39.7517 26.0174 39.4219 26.026C39.1007 26.0434 38.7882 26.0521 38.4844 26.0521C37.1736 26.0521 36.1927 25.7613 35.5417 25.1797C34.8906 24.5981 34.5651 23.7344 34.5651 22.5885V8.34375ZM47.2411 26.2474C46.295 26.2474 45.4443 26.0434 44.6891 25.6354C43.9339 25.2187 43.3392 24.6068 42.9052 23.7995C42.4799 22.9835 42.2672 21.9766 42.2672 20.7786V12.0156H45.0536V20.4401C45.0536 21.5165 45.3227 22.3411 45.8609 22.9141C46.3991 23.487 47.1413 23.7734 48.0875 23.7734C48.7212 23.7734 49.2854 23.6432 49.7802 23.3828C50.2837 23.1224 50.683 22.7231 50.9781 22.1849C51.2733 21.638 51.4208 20.9523 51.4208 20.1276V12.0156H54.2073V26H51.499V22.5365H52.0328C51.5901 23.7951 50.9651 24.7283 50.1578 25.3359C49.3505 25.9436 48.3783 26.2474 47.2411 26.2474ZM57.2609 26V12.0156H60.0474V26H57.2609ZM58.6672 9.6849C58.1724 9.6849 57.7557 9.51996 57.4172 9.1901C57.0786 8.86024 56.9094 8.46094 56.9094 7.99219C56.9094 7.52344 57.0786 7.12413 57.4172 6.79427C57.7557 6.46441 58.1681 6.29948 58.6542 6.29948C59.149 6.29948 59.5656 6.46441 59.9042 6.79427C60.2514 7.12413 60.425 7.52778 60.425 8.00521C60.425 8.47396 60.2514 8.87326 59.9042 9.20312C59.5656 9.5243 59.1533 9.6849 58.6672 9.6849ZM68.2573 26.3125C67.2069 26.3125 66.2608 26.1519 65.4188 25.8307C64.5854 25.5009 63.9083 25.0148 63.3875 24.3724C62.8753 23.7214 62.5672 22.9184 62.463 21.9635L65.1844 21.7943C65.2972 22.5408 65.6097 23.1094 66.1219 23.5C66.6427 23.8906 67.3415 24.0859 68.2182 24.0859C69.1123 24.0859 69.8155 23.9036 70.3276 23.5391C70.8484 23.1745 71.1089 22.7187 71.1089 22.1719C71.1089 21.7118 70.9309 21.3385 70.575 21.0521C70.2191 20.7569 69.7286 20.5399 69.1036 20.401L66.7729 19.8932C65.4622 19.5981 64.4726 19.1207 63.8042 18.4609C63.1444 17.7925 62.8146 16.9462 62.8146 15.9219C62.8146 15.0972 63.0403 14.3724 63.4917 13.7474C63.9431 13.1137 64.5724 12.6233 65.3797 12.276C66.187 11.9201 67.1245 11.7422 68.1922 11.7422C69.2252 11.7422 70.1323 11.9158 70.9135 12.263C71.7035 12.6102 72.3285 13.1007 72.7885 13.7344C73.2573 14.3681 73.5307 15.1189 73.6089 15.987L71.0047 16.1562C70.9439 15.5312 70.6705 15.0061 70.1844 14.5807C69.7069 14.1554 69.0516 13.9427 68.2182 13.9427C67.437 13.9427 66.8033 14.125 66.3172 14.4896C65.8398 14.8542 65.601 15.3012 65.601 15.8307C65.601 16.3082 65.7747 16.6944 66.1219 16.9896C66.4778 17.276 66.9899 17.4931 67.6583 17.6406L70.0021 18.1615C71.3476 18.4653 72.3372 18.9297 72.9708 19.5547C73.6132 20.1797 73.9344 20.9957 73.9344 22.0026C73.9344 22.8793 73.6913 23.6432 73.2052 24.2943C72.7191 24.9366 72.0464 25.4358 71.187 25.7917C70.3363 26.1389 69.3597 26.3125 68.2573 26.3125ZM83.0167 12.0156V14.2943H75.0609V12.0156H83.0167ZM77.4047 8.34375H80.1781V22.276C80.1781 22.8056 80.2866 23.1832 80.5036 23.4089C80.7293 23.6259 81.12 23.7344 81.6755 23.7344C81.8665 23.7344 82.0878 23.73 82.3396 23.7214C82.5913 23.7127 82.804 23.704 82.9776 23.6953L83.1339 25.974C82.8821 26 82.5913 26.0174 82.2615 26.026C81.9403 26.0434 81.6278 26.0521 81.324 26.0521C80.0132 26.0521 79.0323 25.7613 78.3813 25.1797C77.7302 24.5981 77.4047 23.7344 77.4047 22.5885V8.34375Z" />
      </svg>
    </div>
  </div>
</footer>
