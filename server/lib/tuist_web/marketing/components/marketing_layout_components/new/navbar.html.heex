<% # Row-flow 3x2 grid: the top row items carry a 400x152 illustration.
features_items = [
  %{
    icon: :database,
    title: dgettext("marketing", "Cache"),
    subtitle:
      dgettext(
        "marketing",
        "Reuse build artifacts across your team and CI to avoid recompiling the same code"
      ),
    href: TuistWeb.Marketing.MarketingHTML.localized_href("/cache"),
    illustration: "cache"
  },
  %{
    icon: :dashboard,
    title: dgettext("marketing", "Compute"),
    subtitle:
      dgettext("marketing", "Spin up runners in seconds and scale with your team and agents"),
    href: TuistWeb.Marketing.MarketingHTML.localized_href("/compute"),
    illustration: "compute"
  },
  %{
    icon: :progress_x,
    title: dgettext("marketing", "Tests"),
    subtitle:
      dgettext("marketing", "Test only what changed and catch flaky tests automatically"),
    href: TuistWeb.Marketing.MarketingHTML.localized_href("/selective-testing"),
    illustration: "tests"
  },
  %{
    icon: :devices,
    title: dgettext("marketing", "Previews"),
    subtitle:
      dgettext("marketing", "Share your app instantly with a URL—click and run on any device"),
    href: TuistWeb.Marketing.MarketingHTML.localized_href("/previews")
  },
  %{
    icon: :versions,
    title: dgettext("marketing", "Generated projects"),
    subtitle:
      dgettext(
        "marketing",
        "Simplify modular Xcode projects for easier maintenance and scaling"
      ),
    href: TuistWeb.Marketing.MarketingHTML.localized_href("https://tuist.dev/en/docs/")
  },
  %{
    icon: :download,
    title: dgettext("marketing", "Registry"),
    subtitle:
      dgettext(
        "marketing",
        "Download only what you need — faster, lighter builds locally and on CI"
      ),
    href: TuistWeb.Marketing.MarketingHTML.localized_href("https://tuist.dev/en/docs/")
  }
]

developers_items = [
  %{
    icon: :book,
    title: dgettext("marketing", "Documentation"),
    subtitle: dgettext("marketing", "How to set up and use Tuist"),
    href: TuistWeb.Marketing.MarketingHTML.localized_href("https://tuist.dev/en/docs/")
  },
  %{
    icon: :api,
    title: dgettext("marketing", "API documentation"),
    subtitle: dgettext("marketing", "Build on our REST API"),
    href: "/api/docs"
  },
  %{
    icon: :dashboard,
    title: dgettext("marketing", "Public dashboard"),
    subtitle: dgettext("marketing", "Explore Tuist's features on public dashboard"),
    href: "/tuist/tuist"
  },
  %{
    icon: :download,
    title: dgettext("marketing", "Download"),
    subtitle: dgettext("marketing", "Download Tuist app on different devices"),
    href: "/download"
  }
]

# Ordered for the dropdown's row-flow 2-column grid: left column is
# About/Hive/Customers, right column Slack/Forum/Newsletter/GitHub.
resources_items = [
  %{
    icon: :users,
    title: dgettext("marketing", "About"),
    subtitle: dgettext("marketing", "Learn about Tuist and meet the team"),
    href: TuistWeb.Marketing.MarketingHTML.localized_href("/about")
  },
  %{
    icon: :brand_slack,
    title: dgettext("marketing", "Slack"),
    subtitle: dgettext("marketing", "Join the community slack"),
    href: "https://slack.tuist.dev"
  },
  %{
    icon: :subtask,
    title: dgettext("marketing", "Hive"),
    subtitle:
      dgettext(
        "marketing",
        "Track requests, bug reports, feedback and Grafana alerts in one place"
      ),
    href: "https://hive.tuist.dev"
  },
  %{
    icon: :message_circle,
    title: dgettext("marketing", "Community forum"),
    subtitle: dgettext("marketing", "Join discussions and share ideas on our community forum"),
    href: "https://community.tuist.dev"
  },
  %{
    icon: :building,
    title: dgettext("marketing", "Customers"),
    subtitle: dgettext("marketing", "See how leading teams scale with Tuist"),
    href: TuistWeb.Marketing.MarketingHTML.localized_href("/customers")
  },
  %{
    icon: :news,
    title: dgettext("marketing", "Newsletter"),
    subtitle: dgettext("marketing", "Stay updated - subscribe to our newsletter"),
    href: TuistWeb.Marketing.MarketingHTML.localized_href("/newsletter")
  },
  %{
    icon: :brand_github,
    title: dgettext("marketing", "GitHub"),
    subtitle: dgettext("marketing", "Check our sources, issues and PRs"),
    href: "https://github.com/tuist"
  }
] %>
<header id="marketing-navbar" phx-update="ignore">
  <div data-part="bar">
    <.link href={TuistWeb.Marketing.MarketingHTML.localized_href("/")} data-part="tuist">
      <img
        data-part="logo"
        data-theme="light"
        src={~p"/marketing/images/components/navbar/logo-light.svg"}
        alt="Tuist"
      />
      <img
        data-part="logo"
        data-theme="dark"
        src={~p"/marketing/images/components/navbar/logo-dark.svg"}
        alt="Tuist"
      />
    </.link>
    <nav data-part="menus" id="marketing-navbar-menus" aria-label="Main navigation">
      <div data-part="menu">
        <button
          type="button"
          data-part="action"
          data-nav-trigger="features"
          data-open="false"
          aria-haspopup="true"
          aria-expanded="false"
          aria-controls="marketing-navbar-viewport"
        >
          <span data-part="title">
            {dgettext("marketing", "Features")}
          </span>
          <span data-part="chevron"><.chevron_down /></span>
        </button>
      </div>
      <div data-part="menu">
        <button
          type="button"
          data-part="action"
          data-nav-trigger="developers"
          data-open="false"
          aria-haspopup="true"
          aria-expanded="false"
          aria-controls="marketing-navbar-viewport"
        >
          <span data-part="title">
            {dgettext("marketing", "Developers")}
          </span>
          <span data-part="chevron"><.chevron_down /></span>
        </button>
      </div>
      <div data-part="menu">
        <button
          type="button"
          data-part="action"
          data-nav-trigger="resources"
          data-open="false"
          aria-haspopup="true"
          aria-expanded="false"
          aria-controls="marketing-navbar-viewport"
        >
          <span data-part="title">
            {dgettext("marketing", "Resources")}
          </span>
          <span data-part="chevron"><.chevron_down /></span>
        </button>
      </div>
      <div data-part="menu">
        <div data-part="action">
          <.link
            href={TuistWeb.Marketing.MarketingHTML.localized_href("/pricing")}
            data-part="title"
          >
            {dgettext("marketing", "Pricing")}
          </.link>
        </div>
      </div>
      <div data-part="menu">
        <div data-part="action">
          <.link href={TuistWeb.Marketing.MarketingHTML.localized_href("/blog")} data-part="title">
            {dgettext("marketing", "Blog")}
          </.link>
        </div>
      </div>
    </nav>
    <nav data-part="actions" aria-label="Call to action">
      <.neutral_button
        href="https://slack.tuist.dev"
        target="_blank"
        rel="noopener noreferrer"
        size="large"
        aria-label="Slack"
        data-part="icon"
      >
        <.brand_slack />
      </.neutral_button>
      <.neutral_button
        href="https://github.com/tuist"
        target="_blank"
        rel="noopener noreferrer"
        size="large"
        aria-label="GitHub"
        data-part="icon"
      >
        <.brand_github />
      </.neutral_button>
      <%!-- Language selector hidden during the redesign. Locale routing and
      Accept-Language detection keep working; restore this block to bring the
      switcher back. --%>
      <%!-- <div
        data-part="menu"
        phx-hook="NavbarDropdown"
        id="marketing-navbar-languages-menu"
        data-open="false"
      >
        <div data-part="action" data-open="false">
          <span data-part="title">
            <.language />
          </span>
          <span data-part="chevron"><.chevron_down /></span>
        </div>
        <div data-part="dropdown" data-dropdown="languages" data-open="false">
          <.link
            :for={lang <- TuistWeb.Marketing.Localization.languages()}
            href={
              TuistWeb.Marketing.Localization.localized_href(
                TuistWeb.Marketing.Localization.current_path(assigns),
                lang.code
              )
            }
          >
            {lang.native}
            <span :if={lang.code != "en"}>({lang.label})</span>
          </.link>
        </div>
      </div> --%>
      <.neutral_button
        :if={is_nil(TuistWeb.Authentication.current_user(assigns))}
        size="large"
        href={~p"/users/log_in"}
        label={dgettext("marketing", "Log in")}
        data-part="log-in"
      >
      </.neutral_button>
      <.button
        variant={
          if(is_nil(TuistWeb.Authentication.current_user(assigns)),
            do: "primary",
            else: "secondary"
          )
        }
        size="large"
        href={
          if(is_nil(TuistWeb.Authentication.current_user(assigns)),
            do: ~p"/users/register",
            else:
              TuistWeb.Authentication.signed_in_path(
                TuistWeb.Authentication.current_user(assigns)
              )
          )
        }
        label={
          if(is_nil(TuistWeb.Authentication.current_user(assigns)),
            do: dgettext("marketing", "Sign up"),
            else: dgettext("marketing", "Dashboard")
          )
        }
      >
      </.button>

      <.neutral_button
        size="large"
        data-part="mobile-menu-button"
        phx-hook="MobileMenu"
        id="mobile-menu-button"
        data-state="closed"
      >
        <Noora.Icon.icon
          id="mobile-menu-icon"
          name="menu"
          active_name="close"
          transition="morph"
          watch="[data-part='mobile-menu-button']"
          active_state="open"
        />
      </.neutral_button>
    </nav>
  </div>
  <%!-- Shared dropdown viewport (Radix NavigationMenu pattern): one panel
  that stays in place while the active content animates in/out with
  direction-aware motion, driven by the NavbarMegaMenu hook. --%>
  <div
    data-part="viewport"
    id="marketing-navbar-viewport"
    phx-hook="NavbarMegaMenu"
    phx-update="ignore"
    data-open="false"
  >
    <div data-part="panel">
      <div data-part="content" data-dropdown="features" data-state="closed">
      <.link
        :for={item <- features_items}
        href={item.href}
        target={if String.starts_with?(item.href, "http"), do: "_blank", else: nil}
        rel={if String.starts_with?(item.href, "http"), do: "noopener noreferrer", else: nil}
        data-part="feature"
      >
        <h3 data-part="title">
          {item.title} <.arrow_right />
        </h3>
        <p data-part="subtitle">
          {item.subtitle}
        </p>
        <div
          :if={Map.has_key?(item, :illustration)}
          data-part="illustration"
          data-illustration={item.illustration}
          aria-hidden="true"
        >
          <TuistWeb.Marketing.MarketingIllustrations.illustration name={item.illustration} />
        </div>
      </.link>
    </div>
    <div data-part="content" data-dropdown="developers" data-state="closed">
      <nav data-part="links">
        <.link
          :for={item <- developers_items}
          href={item.href}
          target={if String.starts_with?(item.href, "http"), do: "_blank", else: nil}
          rel={if String.starts_with?(item.href, "http"), do: "noopener noreferrer", else: nil}
          data-part="link"
        >
          <h3 data-part="title">
            {item.title} <.arrow_right />
          </h3>
          <p data-part="subtitle">
            {item.subtitle}
          </p>
        </.link>
      </nav>
      <aside data-part="changelog">
        <canvas
          data-part="dither"
          id="marketing-navbar-changelog-dither"
          phx-hook="DitherTexture"
          data-pitch="2"
          data-dot="2"
          data-top="0"
          data-bottom="0.95"
          data-wave="0.335"
          data-wave-scale="2.5"
          data-levels="0"
          data-speed="1"
          data-dither="on"
          data-opacity="0.3"
          aria-hidden="true"
        >
        </canvas>
        <header data-part="header">
          <h3 data-part="title">{dgettext("marketing", "Changelog")}</h3>
          <.link_button
            label={dgettext("marketing", "View all")}
            href={TuistWeb.Marketing.MarketingHTML.localized_href("/changelog")}
            variant="secondary"
          />
        </header>
        <ul data-part="list">
          <li
            :for={entry <- Tuist.Marketing.Changelog.get_entries() |> Enum.take(3)}
            data-part="entry"
          >
            <.link href={
              TuistWeb.Marketing.MarketingHTML.localized_href("/changelog##{entry.id}")
            }>
              <div data-part="content">
                <p data-part="title">{entry.title}</p>
                <time data-part="date">
                  {Timex.format!(entry.date, "{Mfull} {D}, {YYYY}")}
                </time>
              </div>
              <.tag label={entry.category} />
            </.link>
          </li>
        </ul>
      </aside>
    </div>
    <div data-part="content" data-dropdown="resources" data-state="closed">
      <.link
        :for={item <- resources_items}
        href={item.href}
        target={if String.starts_with?(item.href, "http"), do: "_blank", else: nil}
        rel={if String.starts_with?(item.href, "http"), do: "noopener noreferrer", else: nil}
        data-part="resource"
      >
        <h3 data-part="title">
          {item.title} <.arrow_right />
        </h3>
        <p data-part="subtitle">
          {item.subtitle}
        </p>
      </.link>
      <div data-part="spacer" aria-hidden="true"></div>
    </div>
    </div>
  </div>
  <nav data-part="mobile-menus" aria-label="Mobile navigation">
    <div data-part="menu" phx-hook="MobileMenuDropdown" id="mobile-menu-features">
      <div data-part="action">
        <h3 data-part="title">{dgettext("marketing", "Features")}</h3>
        <span data-part="chevron"><.chevron_down /></span>
      </div>
      <div data-part="dropdown">
        <.link
          :for={item <- features_items}
          href={item.href}
          target={if String.starts_with?(item.href, "http"), do: "_blank", else: nil}
          rel={if String.starts_with?(item.href, "http"), do: "noopener noreferrer", else: nil}
          data-part="item"
        >
          {item.title}
        </.link>
      </div>
    </div>
    <div data-part="menu" phx-hook="MobileMenuDropdown" id="mobile-menu-developers">
      <div data-part="action">
        <h3 data-part="title">{dgettext("marketing", "Developers")}</h3>
        <span data-part="chevron"><.chevron_down /></span>
      </div>
      <div data-part="dropdown">
        <.link
          :for={item <- developers_items}
          href={item.href}
          target={if String.starts_with?(item.href, "http"), do: "_blank", else: nil}
          rel={if String.starts_with?(item.href, "http"), do: "noopener noreferrer", else: nil}
          data-part="item"
        >
          {item.title}
        </.link>
        <%!-- The desktop dropdown surfaces the changelog as a dedicated
        aside, which the mobile menu doesn't have — so it's a plain link
        here. --%>
        <.link
          href={TuistWeb.Marketing.MarketingHTML.localized_href("/changelog")}
          data-part="item"
        >
          {dgettext("marketing", "Changelog")}
        </.link>
      </div>
    </div>
    <div data-part="menu" phx-hook="MobileMenuDropdown" id="mobile-menu-resources">
      <div data-part="action">
        <h3 data-part="title">{dgettext("marketing", "Resources")}</h3>
        <span data-part="chevron"><.chevron_down /></span>
      </div>
      <div data-part="dropdown">
        <.link
          :for={item <- resources_items}
          href={item.href}
          target={if String.starts_with?(item.href, "http"), do: "_blank", else: nil}
          rel={if String.starts_with?(item.href, "http"), do: "noopener noreferrer", else: nil}
          data-part="item"
        >
          {item.title}
        </.link>
      </div>
    </div>
    <.link
      href={TuistWeb.Marketing.MarketingHTML.localized_href("/pricing")}
      data-part="item"
    >
      {dgettext("marketing", "Pricing")}
    </.link>
    <.link href={TuistWeb.Marketing.MarketingHTML.localized_href("/blog")} data-part="item">
      {dgettext("marketing", "Blog")}
    </.link>
    <.link
      href="https://slack.tuist.dev"
      target="_blank"
      rel="noopener noreferrer"
      data-part="item"
    >
      Slack
    </.link>
    <.link
      href="https://github.com/tuist"
      target="_blank"
      rel="noopener noreferrer"
      data-part="item"
    >
      GitHub
    </.link>
    <div data-part="theme">
      <h3 data-part="title">{dgettext("marketing", "Theme")}</h3>
      <%!-- "system" (the default) renders selected; the hook re-syncs the
      selection from the stored preference at mount. The id must not start
      with "marketing-": pages.css lays out [id^="marketing-"] containers as
      flex columns, which would stack the button group vertically. --%>
      <.button_group size="small" id="mobile-menu-theme-switcher" phx-hook="ThemeSwitcher">
        <.button_group_item icon_only data-theme-option="system" data-selected aria-label="System theme">
          <Noora.Icon.icon name="device_desktop" />
        </.button_group_item>
        <.button_group_item icon_only data-theme-option="light" aria-label="Light theme">
          <Noora.Icon.icon name="sun_high" />
        </.button_group_item>
        <.button_group_item icon_only data-theme-option="dark" aria-label="Dark theme">
          <Noora.Icon.icon name="moon" />
        </.button_group_item>
      </.button_group>
    </div>
  </nav>
</header>
