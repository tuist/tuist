<main
  id="marketing-globe"
  phx-hook="CacheGlobe"
  data-snapshot={JSON.encode!(@snapshot)}
  data-demo={to_string(@demo)}
>
  <%!-- The page stands alone (no shared navbar, footer or CTA): a display
  you can leave on a screen. The only chrome is the wordmark, linking home. --%>
  <header data-part="navbar">
    <.link
      href={TuistWeb.Marketing.MarketingHTML.localized_href("/")}
      data-part="tuist"
      aria-label="Tuist"
    >
      <TuistWeb.Marketing.MarketingComponents.wordmark
        data-part="logo"
        role="img"
        aria-hidden="true"
      />
    </.link>
  </header>

  <header data-part="header">
    <%!-- The globe: the cache page's DitherGlobe — wireframe-less
    stippled sphere on the marketing dither ramp — sized to bleed off the
    card's right and bottom edges. Its markers are the five public
    serving regions; the CacheGlobe hook lights the ones with recent
    activity. --%>
    <figure data-part="illustration" aria-hidden="true">
      <canvas
        id="marketing-globe-canvas"
        data-part="globe"
        phx-hook="DitherGlobe"
        phx-update="ignore"
        data-size="1.15"
        data-pitch="2"
        data-tilt-x="0.12"
        data-tilt-z="-0.26"
        data-speed="0.12"
        data-meridians="0"
        data-parallels="0"
        data-density="85"
        data-shade="13"
        data-land="55"
        data-ocean="18"
        data-offset-x="0"
        data-offset-y="40"
        data-markers={@markers}
      ></canvas>
      <span data-part="fade"></span>
      <%!-- Instant first paint: a tiny inline dot-sphere drawn while the
      HTML streams in, so the hero never sits empty waiting for the
      marketing bundle. The DitherGlobe hook repaints the full globe over
      it as soon as it mounts. The CSP nonce is required — without it the
      browser blocks the inline script. --%>
      <script nonce={@csp_nonce}>
        (() => {
          var c = document.getElementById("marketing-globe-canvas");
          if (!c || c.getAttribute("width")) return;
          var host = c.parentElement;
          var r = host.getBoundingClientRect();
          var w = Math.round(r.width);
          var h = Math.round(r.height);
          if (!w || !h) return;
          var dpr = Math.min(devicePixelRatio || 1, 2);
          c.width = w * dpr;
          c.height = h * dpr;
          var x = c.getContext("2d");
          x.setTransform(dpr, 0, 0, dpr, 0, 0);
          var d = c.dataset;
          var rad = (Math.min(w, h) / 2) * (+d.size || 1);
          var cx = w / 2 + (+d.offsetX || 0);
          var cy = h / 2 + (+d.offsetY || 0);
          var probe = document.createElement("span");
          probe.style.color = "var(--marketing-cache-globe-dither-mid)";
          host.appendChild(probe);
          x.fillStyle = getComputedStyle(probe).color;
          probe.remove();
          var ga = Math.PI * (3 - Math.sqrt(5));
          var seed = 7;
          for (var i = 0; i < 6000; i++) {
            var y = 1 - ((i + 0.5) * 2) / 6000;
            var rr = Math.sqrt(1 - y * y);
            var t = ga * i;
            var px = Math.cos(t) * rr;
            var pz = Math.sin(t) * rr;
            if (pz < 0.05) continue;
            seed = (seed * 1103515245 + 12345) & 2147483647;
            if (seed / 2147483647 > 0.4) continue;
            var gx = Math.round((cx + px * rad) / 2) * 2;
            var gy = Math.round((cy - y * rad) / 2) * 2;
            x.fillRect(gx, gy, 2, 2);
          }
        })();
      </script>
    </figure>
    <span data-part="eyebrow">{dgettext("marketing", "The Tuist cache, around the world")}</span>
    <h1 data-part="title">
      <span data-part="line">{dgettext("marketing", "Built once.")}</span>
      <span data-part="line">{dgettext("marketing", "Shared everywhere.")}</span>
    </h1>
    <p data-part="subtitle">
      {dgettext("marketing", "Less time compiling. More time creating.")}
      {dgettext("marketing", "Watch compiled code find its next build.")}
    </p>
    <nav data-part="actions">
      <.button
        href={TuistWeb.Marketing.MarketingHTML.localized_href("/cache")}
        label={dgettext("marketing", "Meet the cache")}
      />
      <.button
        href={if @demo, do: @current_path, else: @current_path <> "?demo=true"}
        variant="secondary"
        label={
          if @demo,
            do: dgettext("marketing", "View live activity"),
            else: dgettext("marketing", "Try demo")
        }
      />
    </nav>
  </header>

  <section data-part="activity" aria-labelledby="marketing-globe-activity-title">
    <div data-part="text">
      <span data-part="eyebrow">{dgettext("marketing", "Live activity")}</span>
      <h2 data-part="title" id="marketing-globe-activity-title">
        {dgettext("marketing", "A little less waiting. All around the world.")}
      </h2>
      <p data-part="description">
        {dgettext(
          "marketing",
          "Download requests served by Tuist's managed cache regions since midnight, Coordinated Universal Time. Activity arrives in batches and refreshes every 30 seconds."
        )}
      </p>
    </div>

    <%!-- The counters are filled by the hook (phx-update="ignore" keeps
    the formatted numbers through LiveView patches); the server only ships
    the snapshot on the main element. --%>
    <div data-part="stats">
      <div data-part="stat" data-stat="downloads">
        <span data-part="value" id="globe-total" phx-update="ignore">—</span>
        <span data-part="label">{dgettext("marketing", "Cache downloads today")}</span>
      </div>
      <div data-part="stat">
        <span data-part="value" id="globe-bytes" phx-update="ignore">—</span>
        <span data-part="label">{dgettext("marketing", "of compiled work delivered")}</span>
      </div>
      <div data-part="stat">
        <span data-part="value" id="globe-recent" phx-update="ignore">—</span>
        <span data-part="label">{dgettext("marketing", "downloads in the last 5 minutes")}</span>
      </div>
    </div>

    <div
      data-part="regions"
      role="list"
      aria-label={dgettext("marketing", "Cache serving regions")}
    >
      <div
        :for={region <- @snapshot.regions}
        data-part="region"
        role="listitem"
        data-region={region.id}
        id={"globe-region-#{region.id}"}
        phx-update="ignore"
      >
        <span data-part="light" aria-hidden="true"></span>
        <span data-part="name">{region.name}</span>
        <span data-part="value">—</span>
        <span data-part="bar" aria-hidden="true"></span>
      </div>
    </div>

    <div data-part="toolbar">
      <div id="globe-status" data-part="status" phx-update="ignore" role="status">
        <span data-part="dot" aria-hidden="true"></span>
        <span data-status="live" hidden>{dgettext("marketing", "Live activity")}</span>
        <span data-status="demo" hidden>{dgettext("marketing", "Demo · illustrative data")}</span>
        <span data-status="waiting">{dgettext("marketing", "Waiting for cache activity")}</span>
        <span data-status="idle" hidden>{dgettext("marketing", "Waiting for new cache activity")}</span>
        <span data-status="stale" hidden>{dgettext(
          "marketing",
          "Activity delayed · showing last update"
        )}</span>
        <span data-status="unavailable" hidden>{dgettext(
          "marketing",
          "Live activity temporarily unavailable"
        )}</span>
        <span data-status="offline" hidden>{dgettext(
          "marketing",
          "Reconnecting · showing last update"
        )}</span>
      </div>
      <div id="globe-controls" data-part="controls" phx-update="ignore">
        <button type="button" data-action="motion" aria-pressed="false">
          <span data-motion="pause">{dgettext("marketing", "Pause motion")}</span>
          <span data-motion="resume" hidden>{dgettext("marketing", "Resume motion")}</span>
        </button>
        <button
          type="button"
          data-action="fullscreen"
          aria-label={dgettext("marketing", "Enter full screen")}
        >
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            aria-hidden="true"
          ><path d="M8 3H3v5m13-5h5v5M3 16v5h5m13-5v5h-5" /></svg>
          <span>{dgettext("marketing", "Full screen")}</span>
        </button>
      </div>
    </div>

    <details data-part="about">
      <summary>{dgettext("marketing", "About this view")}</summary>
      <p>
        {dgettext(
          "marketing",
          "The counter shows download requests served by Tuist's managed cache regions, not unique binaries. Activity arrives in batches and refreshes every 30 seconds. Lights represent serving regions, not developer locations or routes between regions. No customer or project information is shown. Demo mode uses illustrative data."
        )}
      </p>
    </details>
  </section>
</main>
