<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <%= for entry <- @entries do %>
    <url>
      <loc><%= entry.loc %></loc>
      <%= if entry.lastmod do %>
      <lastmod><%= entry.lastmod %></lastmod>
      <% end %>
    </url>
  <% end %>
</urlset>
