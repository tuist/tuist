<TuistWeb.Marketing.Layouts.marketing {assigns}>
  <main id="marketing-about">
    <header data-part="header">
      <h1 data-part="title">
        {dgettext("marketing", "Automation only moves as fast as the loop it runs in.")}
      </h1>
      <p data-part="subtitle">
        {dgettext(
          "marketing",
          "Tuist compresses that loop. Builds, tests, and the retries in between finish in seconds instead of minutes, so your developers stay in flow, your CI stops burning time, and the agents in your pipeline can think, try, and correct their way to code that works."
        )}
      </p>
    </header>
    <div data-part="blueprint" aria-hidden="true">
      <div data-part="cluster">
        <div data-part="row">
          <div data-part="box"></div>
          <div data-part="box"></div>
          <div data-part="box"></div>
        </div>
        <div data-part="row">
          <div data-part="box"></div>
          <div data-part="box"></div>
          <div data-part="box"></div>
        </div>
      </div>
      <div data-part="panel"></div>
      <div data-part="cluster">
        <div data-part="row">
          <div data-part="box"></div>
          <div data-part="box"></div>
        </div>
        <div data-part="row">
          <div data-part="box"></div>
          <div data-part="box"></div>
          <div data-part="box"></div>
          <div data-part="box"></div>
        </div>
      </div>
    </div>
    <section data-part="content">
      <span data-part="eyebrow">{dgettext("marketing", "Mission")}</span>
      <div data-part="main">
        <h2 data-part="title">
          <span data-part="line">{dgettext("marketing", "We want developers to build")}</span>
          <span data-part="line">{dgettext("marketing", "better software, faster.")}</span>
        </h2>
        <% shopify_link =
          ~s(<a href="https://www.shopify.com/" data-part="link" target="_blank" rel="noopener noreferrer">Shopify</a>) %>
        <article data-part="body">
          <p>
            {raw(
              dgettext(
                "marketing",
                "We're obsessed with helping developers build better software, faster. That obsession comes from doing the work at scale ourselves. Our team spent years shipping the tools behind mobile at %{shopify}, and Tuist is what we learned along the way.",
                shopify: shopify_link
              )
            )}
          </p>
          <p>
            {dgettext(
              "marketing",
              "Tuist started as a client-side toolkit for the Apple ecosystem. We turned it into a business so we could do what we love most, full time: building the infrastructure and technology to support the full diversity of build toolchains developers use today. Whatever you build with, we want the toolchain underneath to feel invisible."
            )}
          </p>
          <p>
            {dgettext(
              "marketing",
              "Then AI happened, and optimizing your toolchain stopped being a luxury only large teams could afford. Every developer, and every agent working alongside them, needs the same fast, reliable feedback loops. That's what we're building next, with a stubborn commitment to sparking joy in the people who use it."
            )}
          </p>
          <.link_button
            label={dgettext("marketing", "Learn more")}
            href="https://handbook.tuist.dev/"
            variant="secondary"
            size="large"
          >
            <:icon_right><.chevron_right /></:icon_right>
          </.link_button>
        </article>
      </div>
      <div data-part="team">
        <span data-part="eyebrow">{dgettext("marketing", "Team")}</span>
        <header data-part="header">
          <h2 data-part="title">{dgettext("marketing", "Meet the team behind Tuist")}</h2>
          <p data-part="subtitle">
            {dgettext(
              "marketing",
              "We’re a small, passionate team that cares deeply about developer experience and takes pride in crafting tools with care and attention to detail."
            )}
          </p>
        </header>
        <ul data-part="members">
          <li data-part="member">
            <figure data-part="photo" data-member="pedro" aria-hidden="true">
              <canvas
                data-part="dither"
                id="member-dither-pedro"
                phx-hook="DitherBlocks"
                data-seed="11"
                data-blocks="26"
                data-pitch="2"
                data-dot="1"
                data-opacity="1"
              ></canvas>
              <span data-part="portrait"></span>
            </figure>
            <div data-part="info">
              <h3 data-part="name">Pedro Piñera</h3>
              <p data-part="role">{dgettext("marketing", "Founder and CEO")}</p>
            </div>
          </li>
          <li data-part="member">
            <figure data-part="photo" data-member="marek" aria-hidden="true">
              <canvas
                data-part="dither"
                id="member-dither-marek"
                phx-hook="DitherBlocks"
                data-seed="42"
                data-blocks="26"
                data-pitch="2"
                data-dot="1"
                data-opacity="1"
              ></canvas>
              <span data-part="portrait"></span>
            </figure>
            <div data-part="info">
              <h3 data-part="name">Marek Fořt</h3>
              <p data-part="role">{dgettext("marketing", "Founder and CTO")}</p>
            </div>
          </li>
          <li data-part="member">
            <figure data-part="photo" data-member="asmit" aria-hidden="true">
              <canvas
                data-part="dither"
                id="member-dither-asmit"
                phx-hook="DitherBlocks"
                data-seed="73"
                data-blocks="26"
                data-pitch="2"
                data-dot="1"
                data-opacity="1"
              ></canvas>
              <span data-part="portrait"></span>
            </figure>
            <div data-part="info">
              <h3 data-part="name">Asmit Malakannawar</h3>
              <p data-part="role">{dgettext("marketing", "Senior Product Designer")}</p>
            </div>
          </li>
          <li data-part="member">
            <figure data-part="photo" data-member="eduardo" aria-hidden="true">
              <canvas
                data-part="dither"
                id="member-dither-eduardo"
                phx-hook="DitherBlocks"
                data-seed="104"
                data-blocks="26"
                data-pitch="2"
                data-dot="1"
                data-opacity="1"
              ></canvas>
              <span data-part="portrait"></span>
            </figure>
            <div data-part="info">
              <h3 data-part="name">Eduardo Nunes</h3>
              <p data-part="role">{dgettext("marketing", "Senior Software Engineer")}</p>
            </div>
          </li>
        </ul>
      </div>
    </section>
    <div data-part="features-divider" aria-hidden="true">
      <canvas
        data-part="dither"
        id="about-cta-divider-top-dither"
        phx-hook="DitherTexture"
        data-pitch="2"
        data-dot="2"
        data-top="0"
        data-bottom="0.95"
        data-wave="0.335"
        data-wave-scale="2.5"
        data-levels="0"
        data-speed="1"
        data-phase="22.1"
        data-dither="on"
        data-opacity="0.3"
      ></canvas>
    </div>

    <section data-part="cta" aria-labelledby="cta-title">
      <span data-part="eyebrow">{dgettext("marketing", "Hola! Hello! Hallo! Olá! Namaste! Ahoj!")}</span>
      <h2 id="cta-title">{dgettext("marketing", "Your platform team, as a service")}</h2>
      <div data-part="actions" role="group" aria-labelledby="cta-title">
        <.button href={~p"/users/register"} label={dgettext("marketing", "Get started")} />
        <.button
          href="https://cal.tuist.dev/team/tuist/tuist?overlayCalendar=true"
          target="_blank"
          rel="noopener noreferrer"
          variant="secondary"
          label={dgettext("marketing", "Talk to us")}
        />
      </div>
    </section>

    <div data-part="features-divider" aria-hidden="true">
      <canvas
        data-part="dither"
        id="about-cta-divider-bottom-dither"
        phx-hook="DitherTexture"
        data-pitch="2"
        data-dot="2"
        data-top="0"
        data-bottom="0.95"
        data-wave="0.335"
        data-wave-scale="2.5"
        data-levels="0"
        data-speed="1"
        data-phase="29.6"
        data-dither="on"
        data-opacity="0.3"
      ></canvas>
    </div>
  </main>
</TuistWeb.Marketing.Layouts.marketing>
