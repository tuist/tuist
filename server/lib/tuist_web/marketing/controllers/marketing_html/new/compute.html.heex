                <pre data-part="term-line"><span data-part="term-user">runner@f992d97f ~/work</span> <span data-part="term-sign">$</span> ps aux --sort=-%cpu | head</pre>
                <pre data-part="term-line" data-line="head">USER          PID %CPU %MEM      VSZ    RSS TTY      STAT START   TIME COMMAND</pre>
                <pre data-part="term-line">runner         36  1.3  0.8 34903288  89760 ?        Sl   12:18   0:01 /home/runner/…</pre>
                <pre data-part="term-line">runner         10  0.1  0.0     4924   1232 ?        S    12:18   0:00 bash /usr/loc…</pre>
                <pre data-part="term-line">runner          1  0.0  0.0     4792    324 ?        S    12:18   0:00 bash /usr/loc…</pre>
                <pre data-part="term-line">runner          2  0.0  0.0  1231752   5440 ?        Sl   12:18   0:00 /usr/local/bi…</pre>
                <pre data-part="term-line">runner         16  0.0  0.0     4928    356 ?        S    12:18   0:00 /bin/bash ./r…</pre>
              </div>
            </div>
          </figure>
          <div data-part="text">
            <h4 data-part="title">{dgettext("marketing", "Debug where it failed")}</h4>
            <p data-part="description">
              {dgettext(
                "marketing",
                "Connect to a running machine through your terminal or VNC and investigate failures in the environment where they actually happened."
              )}
            </p>
          </div>
