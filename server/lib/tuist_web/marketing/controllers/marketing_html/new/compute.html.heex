                <div data-part="blocks">
                  <span :for={_ <- 1..24} data-part="block"></span>
                </div>
              </div>
            </div>
          </figure>
          <div data-part="text">
            <h3 data-part="title">{dgettext("marketing", "Cache-ready by default")}</h3>
            <p data-part="description">
              {dgettext(
                "marketing",
                "Persistent volumes and colocated caching keep build data close to your runners for faster reads, writes, and repeat jobs."
              )}
            </p>
          </div>
        </div>
      </div>
      <%!-- Band heading introducing the grid (Figma: 1200-wide, 64px gap
      above and below); its top hairline closes the showcase band. --%>
      <h3 data-part="subheading" id="compute-grid-title">
        {dgettext("marketing", "Everything else, built in")}
      </h3>
      <%!-- 2x2 feature grid divided by hairlines, same cell recipe as the
      cache page. Each figure reserves the artwork's slot until the real
      illustrations land. Card titles are h4 — they sit under the band
      heading in the outline. --%>
      <div data-part="grid" aria-labelledby="compute-grid-title">
        <div data-part="cell">
          <%!-- Rack of runners: the home page's RunnerGrid hook at the
          comp's 10x4 / 40px-cell size, churning at a calmer cadence. The
          stat line's count is written by the hook. --%>
          <figure data-part="illustration" data-illustration="spin-up" aria-hidden="true">
            <canvas
              data-part="rack"
              id="compute-runner-rack"
              phx-hook="RunnerGrid"
              data-fill="none"
              data-dither="none"
              data-cols="10"
              data-rows="4"
              data-cell="40"
              data-gap="8"
              data-grid-x="3"
              data-grid-top="0"
              data-target="15"
              data-min="11"
              data-max="18"
              data-swap="4200"
              data-flicker="1600"
            ></canvas>
          </figure>
          <div data-part="text">
            <h4 data-part="title">{dgettext("marketing", "Scale without the queue")}</h4>
            <p data-part="description">
              {dgettext(
                "marketing",
                "Spin up runners in seconds and scale with your team and your agents without managing your own fleet."
              )}
            </p>
          </div>
        </div>
        <div data-part="cell">
          <%!-- The Mac dissolving into a dot field (comp: 687x193 stage,
          cut by the card's right edge). Hardware outline inline from the
          export; the ~1900-dot field regenerates procedurally on the
          canvas (ComputeMacDither) with random dots twinkling. --%>
          <figure data-part="illustration" data-illustration="platforms" aria-hidden="true">
            <div data-part="mac-stage">
              <canvas
                data-part="dots"
                id="compute-mac-dither"
                phx-hook="ComputeMacDither"
                data-edge="506"
                data-top="2"
                data-bottom="176"
              ></canvas>
              <svg
                data-part="mac"
                viewBox="0 0 687 193"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
              >
                <rect x="288" y="1" width="398" height="175" stroke-width="1.5" />
                <path d="M319 176H656L636 191.5H339L319 176Z" stroke-width="1.5" />
                <rect x="350" y="134" width="9" height="20" rx="4.5" stroke-width="1.5" />
                <rect x="379" y="134" width="9" height="20" rx="4.5" stroke-width="1.5" />
                <rect x="411" y="141" width="55" height="6" rx="3" stroke-width="1.5" />
                <rect x="618" y="141" width="6" height="6" rx="3" stroke-width="1.5" />
              </svg>
            </div>
          </figure>
          <div data-part="text">
            <h4 data-part="title">{dgettext("marketing", "Powerful compute, ready")}</h4>
            <p data-part="description">
              {dgettext(
                "marketing",
                "Run CI and agent workloads on M4 Pro Macs or Linux machines sized for the job."
              )}
            </p>
          </div>
        </div>
        <div data-part="cell">
          <%!-- Debug session (comp: 512-wide stage): job header over a
          terminal running ps, the tail rows melting out. Code stays
          untranslated like the other cards' annotations. --%>
          <figure data-part="illustration" data-illustration="ephemeral" aria-hidden="true">
            <div data-part="session">
              <div data-part="session-head">
                <span data-part="session-icon">
                  <svg viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg"><circle
                    cx="8"
                    cy="8"
                    r="6"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-dasharray="2.6 2.6"
                    stroke-linecap="round"
                  /></svg>
                </span>
                <span data-part="session-title">Server deployment · Deploy to tuist-staging</span>
              </div>
              <div data-part="terminal">
                <pre data-part="term-line"><span data-part="term-user">runner@f992d97f ~/work</span> <span data-part="term-sign">$</span> ps aux --sort=-%cpu | head</pre>
                <pre data-part="term-line" data-line="head">USER          PID %CPU %MEM      VSZ    RSS TTY      STAT START   TIME COMMAND</pre>
                <pre data-part="term-line">runner         36  1.3  0.8 34903288  89760 ?        Sl   12:18   0:01 /home/runner/…</pre>
                <pre data-part="term-line">runner         10  0.1  0.0     4924   1232 ?        S    12:18   0:00 bash /usr/loc…</pre>
                <pre data-part="term-line">runner          1  0.0  0.0     4792    324 ?        S    12:18   0:00 bash /usr/loc…</pre>
                <pre data-part="term-line">runner          2  0.0  0.0  1231752   5440 ?        Sl   12:18   0:00 /usr/local/bi…</pre>
                <pre data-part="term-line">runner         16  0.0  0.0     4928    356 ?        S    12:18   0:00 /bin/bash ./r…</pre>
              </div>
            </div>
          </figure>
          <div data-part="text">
            <h4 data-part="title">{dgettext("marketing", "Debug where it failed")}</h4>
            <p data-part="description">
              {dgettext(
                "marketing",
                "Connect to a running machine through your terminal or VNC and investigate failures in the environment where they actually happened."
              )}
            </p>
          </div>
        </div>
        <div data-part="cell">
          <%!-- Version pills (comp: 788x156): three staggered rows on
          24px gaps, the current versions ringed purple near the middle,
          the rows melting out at the card's edges via the mask. --%>
          <figure data-part="illustration" data-illustration="scaling" aria-hidden="true">
            <div data-part="pills">
              <div data-part="pill-row">
                <span data-part="pill">macOS 12.6</span>
                <span data-part="pill">macOS 13</span>
                <span data-part="pill">macOS 14.5</span>
                <span data-part="pill">macOS 15</span>
                <span data-part="pill" data-state="soft">macOS 26.4</span>
                <span data-part="pill">macOS 26.2</span>
                <span data-part="pill">macOS 15.6</span>
                <span data-part="pill">macOS 14.7</span>
              </div>
              <div data-part="pill-row">
                <span data-part="pill">Xcode 14.3</span>
                <span data-part="pill">Xcode 15</span>
                <span data-part="pill">Xcode 16</span>
                <span data-part="pill" data-state="current">Xcode 27</span>
                <span data-part="pill">Xcode 26.6</span>
                <span data-part="pill">Xcode 26.4</span>
                <span data-part="pill">Xcode 16.4</span>
                <span data-part="pill">Xcode 15.2</span>
              </div>
              <div data-part="pill-row">
                <span data-part="pill">macOS 11</span>
                <span data-part="pill">macOS 12</span>
                <span data-part="pill">macOS 13.5</span>
                <span data-part="pill">macOS 14.2</span>
                <span data-part="pill" data-state="soft">macOS 26.3</span>
                <span data-part="pill">macOS 15.2</span>
                <span data-part="pill">macOS 12.5</span>
                <span data-part="pill">macOS 13.2</span>
              </div>
            </div>
          </figure>
          <div data-part="text">
            <h4 data-part="title">{dgettext("marketing", "Stay current with Apple")}</h4>
            <p data-part="description">
              {dgettext(
                "marketing",
                "Run your workflows on current Xcode and macOS versions without maintaining images or installing toolchains yourself."
              )}
            </p>
          </div>
        </div>
      </div>
    </section>

    <%!-- CTA framed by dithered divider bands, same recipe as the cache
    page's closing CTA. --%>
    <div data-part="features-divider" aria-hidden="true">
      <canvas
        data-part="dither"
        id="compute-cta-divider-top-dither"
        phx-hook="DitherTexture"
        data-pitch="2"
        data-dot="2"
        data-top="0"
        data-bottom="0.95"
        data-wave="0.335"
        data-wave-scale="2.5"
        data-levels="0"
        data-speed="1"
        data-phase="22.1"
        data-dither="on"
        data-opacity="0.3"
      ></canvas>
    </div>

    <section data-part="cta" aria-labelledby="cta-title">
      <span data-part="eyebrow">{dgettext("marketing", "What are you waiting for?")}</span>
      <h2 id="cta-title">{dgettext("marketing", "Supercharge your app development")}</h2>
      <nav data-part="actions" aria-label="Primary actions">
        <.button href={~p"/users/register"} label={dgettext("marketing", "Get started")} />
        <.button
          href="https://cal.tuist.dev/team/tuist/tuist?overlayCalendar=true"
          target="_blank"
          rel="noopener noreferrer"
          variant="secondary"
          label={dgettext("marketing", "Talk to us")}
        />
      </nav>
    </section>

    <div data-part="features-divider" aria-hidden="true">
      <canvas
        data-part="dither"
        id="compute-cta-divider-bottom-dither"
        phx-hook="DitherTexture"
        data-pitch="2"
        data-dot="2"
        data-top="0"
        data-bottom="0.95"
        data-wave="0.335"
        data-wave-scale="2.5"
        data-levels="0"
        data-speed="1"
        data-phase="29.6"
        data-dither="on"
        data-opacity="0.3"
      ></canvas>
    </div>
  </main>
</TuistWeb.Marketing.Layouts.marketing>
