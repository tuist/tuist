8C20.75 18.7293 20.4601 19.4286 19.9443 19.9443C19.4286 20.4601 18.7293 20.75 18 20.75C17.2707 20.75 16.5714 20.4601 16.0557 19.9443C15.721 19.6097 15.4834 19.1973 15.3564 18.75H8.64355C8.51663 19.1973 8.27897 19.6097 7.94434 19.9443C7.42861 20.4601 6.72935 20.75 6 20.75C5.27065 20.75 4.57139 20.4601 4.05566 19.9443C3.53994 19.4286 3.25 18.7293 3.25 18C3.25 17.2707 3.53994 16.5714 4.05566 16.0557C4.3903 15.721 4.80267 15.4834 5.25 15.3564V8.64258C4.80277 8.51563 4.39024 8.27891 4.05566 7.94434C3.53994 7.42861 3.25 6.72935 3.25 6C3.25 5.27065 3.53994 4.57139 4.05566 4.05566C4.57139 3.53994 5.27065 3.25 6 3.25C6.72935 3.25 7.42861 3.53994 7.94434 4.05566C8.27897 4.3903 8.51663 4.80267 8.64355 5.25H15.3564C15.4834 4.80267 15.721 4.3903 16.0557 4.05566C16.5714 3.53994 17.2707 3.25 18 3.25C18.7293 3.25 19.4286 3.53994 19.9443 4.05566C20.4601 4.57139 20.75 5.27065 20.75 6Z" /></svg>
                    <span data-part="title">Persistent volume</span>
                  </span>
                  <span data-part="subtitle">local · incremental</span>
                </div>
                <div data-part="blocks">
                  <span :for={_ <- 1..10} data-part="block"></span>
                </div>
              </div>
              <div data-part="node" data-node="cache">
                <div data-part="text">
                  <span data-part="heading">
                    <svg
                      data-part="glyph"
                      viewBox="142.5 289 18 18"
                      xmlns="http://www.w3.org/2000/svg"
                    ><path d="M156.938 299.637C156.648 299.818 156.311 299.978 155.94 300.117C154.735 300.569 153.138 300.812 151.5 300.812C149.862 300.812 148.265 300.569 147.06 300.117C146.689 299.978 146.352 299.818 146.062 299.637V302.5C146.062 302.585 146.106 302.737 146.334 302.944C146.562 303.15 146.931 303.368 147.455 303.564C148.5 303.956 149.956 304.188 151.5 304.188C153.044 304.188 154.5 303.956 155.545 303.564C156.069 303.368 156.438 303.15 156.666 302.944C156.894 302.737 156.938 302.585 156.938 302.5V299.637ZM156.938 295.137C156.648 295.318 156.311 295.478 155.94 295.617C154.735 296.069 153.138 296.312 151.5 296.312C149.862 296.312 148.265 296.069 147.06 295.617C146.689 295.478 146.352 295.318 146.062 295.137V298C146.062 298.085 146.106 298.237 146.334 298.444C146.562 298.65 146.931 298.868 147.455 299.064C148.5 299.456 149.956 299.688 151.5 299.688C153.044 299.688 154.5 299.456 155.545 299.064C156.069 298.868 156.438 298.65 156.666 298.444C156.894 298.237 156.938 298.085 156.938 298V295.137ZM156.938 293.5C156.938 293.415 156.894 293.263 156.666 293.056C156.438 292.85 156.069 292.632 155.545 292.436C154.5 292.044 153.044 291.812 151.5 291.812C149.956 291.812 148.5 292.044 147.455 292.436C146.931 292.632 146.562 292.85 146.334 293.056C146.106 293.263 146.062 293.415 146.062 293.5C146.062 293.585 146.106 293.737 146.334 293.944C146.562 294.15 146.931 294.368 147.455 294.564C148.5 294.956 149.956 295.188 151.5 295.188C153.044 295.188 154.5 294.956 155.545 294.564C156.069 294.368 156.438 294.15 156.666 293.944C156.894 293.737 156.938 293.585 156.938 293.5ZM158.062 302.5C158.062 303.012 157.79 303.444 157.421 303.778C157.052 304.112 156.542 304.392 155.94 304.617C154.735 305.069 153.138 305.312 151.5 305.312C149.862 305.312 148.265 305.069 147.06 304.617C146.458 304.392 145.948 304.112 145.579 303.778C145.21 303.444 144.938 303.012 144.938 302.5V293.5C144.938 292.988 145.21 292.556 145.579 292.222C145.948 291.888 146.458 291.608 147.06 291.383C148.265 290.93