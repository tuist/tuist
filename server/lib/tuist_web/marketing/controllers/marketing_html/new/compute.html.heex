<%!-- Redesigned compute page (styles in css/new/routes/compute.css). Same
frame recipe as the cache page: left-aligned hero card, features frame
(intro text + two full-width showcase cards + 2x2 grid), CTA between
dithered dividers. --%>
<TuistWeb.Marketing.Layouts.marketing {assigns}>
  <main id="marketing-compute">
    <%!-- Hero card: same left-aligned 600px frame as the cache hero. The
    background blueprint mosaic — a gap-free tiling of 40/80/120/160
    squares with corner dots, some flickering purple — is drawn on the
    canvas by the ComputeHeroGrid hook. --%>
    <header data-part="header">
      <div
        data-part="illustration"
        aria-hidden="true"
        id="compute-hero-grid"
        phx-hook="ComputeHeroGrid"
      >
        <canvas data-part="canvas"></canvas>
      </div>
      <h1 data-part="title">
        <span data-part="line">{dgettext("marketing", "Stop waiting on the")}</span>
        <span data-part="line">{dgettext("marketing", "queue.")}</span>
      </h1>
      <p data-part="subtitle">
        {dgettext(
          "marketing",
          "Runners that spin up in seconds and scale with your team and your agents."
        )}
      </p>
      <%!-- The one-line migration: swap the runs-on label. Code stays
      untranslated, like the illustrations' annotations. The added line
      types out once per page load behind a blinking terminal cursor
      (ComputeHeroDiff); the typed/cursor spans stay glued together on one
      line so no whitespace opens between the text and the caret. --%>
      <div data-part="diff" aria-hidden="true" id="compute-hero-diff" phx-hook="ComputeHeroDiff">
        <span data-part="line" data-line="removed">
          <span data-part="sign">-</span>
          <span data-part="code">runs-on: macos-latest</span>
        </span>
        <span data-part="line" data-line="added">
          <span data-part="sign">+</span>
          <span data-part="code"><span data-part="typed">runs-on: tuist-macos</span><span data-part="cursor"></span></span>
        </span>
      </div>
      <%!-- First-paint arm for the typewriter: stashes and clears the
      added line before the browser paints, so the full text never
      flashes ahead of the hook's typing. Skips under reduced motion.
      The CSP nonce is required — without it the browser blocks the
      inline script and the hook's fallback arming takes over. The
      watchdog restores the line if the hook never takes over (a stale
      or failed bundle.js) — an empty strip must not outlive the arm. --%>
      <script nonce={TuistWeb.CSP.get_csp_nonce()}>
        (() => {
          if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
          var diff = document.getElementById("compute-hero-diff");
          var typed = diff && diff.querySelector('[data-part="typed"]');
          if (!typed) return;
          typed.dataset.text = typed.textContent;
          typed.textContent = "";
          diff.setAttribute("data-armed", "");
          setTimeout(() => {
            if (typed.textContent === "" && !diff.hasAttribute("data-typing")) {
              typed.textContent = typed.dataset.text;
              diff.removeAttribute("data-armed");
            }
          }, 3000);
        })();
      </script>
      <.button
        href={
          TuistWeb.Marketing.MarketingHTML.localized_href(
            "https://tuist.dev/en/docs/guides/features/runners"
          )
        }
        variant="secondary"
        label={dgettext("marketing", "Read docs")}
      />
    </header>

    <section data-part="features" aria-labelledby="compute-features-title">
      <div data-part="text">
        <span data-part="eyebrow">{dgettext("marketing", "Features")}</span>
        <h2 data-part="title" id="compute-features-title">
          {dgettext("marketing", "Compute without the infrastructure work")}
        </h2>
        <p data-part="description">
          {dgettext(
            "marketing",
            "Fast macOS and Linux runners that scale with your workloads and plug directly into the rest of the Tuist platform."
          )}
        </p>
      </div>
      <%!-- Two full-width showcase cards, each a full-bleed illustration
      slot over its text block, stacked flush so the hairlines read as one
      continuous frame with the grid below. The diagrams are placeholders
      until the real illustrations land. --%>
      <div data-part="showcase">
        <div data-part="cell">
          <%!-- Pixel rebuild of the comp's 1129x517 scene: HTML cards
          absolutely positioned over a single wires SVG sharing the same
          coordinate space (so connectors meet card edges exactly), with
          Noora badges as the trace/hit/miss/cpu chips. Decorative
          (aria-hidden), labels untranslated like the other cards'
          annotations. The whole stage scales as one unit on narrow
          viewports. --%>
          <figure data-part="illustration" data-illustration="build-platform" aria-hidden="true">
            <div data-part="scene" id="compute-build-platform" phx-hook="ComputeBuildPlatform">
              <div data-part="card" data-box="runner">
                <span data-part="label">TUIST RUNNER · MAC-M4-PRO</span>
                <span data-part="status"></span>
              </div>
              <div data-part="card" data-box="xcodebuild">
                <span data-part="label">XCODEBUILD</span>
              </div>
              <svg
                data-part="wires"
                data-layout="desktop"
                viewBox="0 0 1129 517"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
              >
                <g data-wire="solid">
                  <path d="M170 322H225.5" />
                  <path d="M331.5 243V257.5" />
                  <path d="M432 358H464.5" />
                  <path d="M347.5 407V392.5" />
                  <path d="M672.5 193H854.5" />
                  <path d="M672.5 291H854.5" />
                  <path d="M672.5 389H854.5" />
                </g>
                <g data-wire="strong">
                  <path d="M759.5 291H779.5" />
                </g>
                <g data-wire="dashed">
                  <path d="M656.5 46.5H1100.5V389H1030" data-march="reverse" />
                  <path d="M1030 193H1100.5" data-march="forward" />
                  <path d="M1030 291H1100.5" data-march="forward" />
                  <path d="M432 436H747.5V487H853.5" data-march="forward" />
                </g>
                <g data-wire="arrow">
                  <path d="M225.5 318L229.5 322L225.5 326" />
                  <path d="M327.5 257.5L331.5 261.5L335.5 257.5" />
                  <path d="M464.5 354L468.5 358L464.5 362" />
                  <path d="M343.5 392.5L347.5 388.5L351.5 392.5" />
                  <path d="M854.5 189L858.5 193L854.5 197" />
                  <path d="M854.5 287L858.5 291L854.5 295" />
                  <path d="M854.5 385L858.5 389L854.5 393" />
                  <path d="M853.5 483L857.5 487L853.5 491" />
                  <path d="M652.5 42.5L648.5 46.5L652.5 50.5" />
                </g>
              </svg>
              <%!-- Mobile wires: the same scene stacked vertically on a
              541-wide stage (commit, runner, chips row, stat-card row,
              Tuist cache, dashboard), with the dashed returns rising from
              the dashboard back up to the stat cards. CSS swaps this in
              for the desktop wires at the mobile breakpoint. --%>
              <svg
                data-part="wires"
                data-layout="mobile"
                viewBox="0 0 541 930"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
              >
                <g data-wire="solid">
                  <path d="M270.5 58V116.5" />
                  <path d="M150.5 246V260.5" />
                  <path d="M251 361H283.5" />
                  <path d="M166.5 410V395.5" />
                  <path d="M85 500V612" />
                  <path d="M270 500V612" />
                  <path d="M455 500V612" />
                </g>
                <g data-wire="strong">
                  <path d="M260 556H280" />
                </g>
                <g data-wire="dashed">
                  <path d="M178 500V724" data-march="forward" />
                  <path d="M270 840V678" data-march="reverse" />
                  <path d="M189 885H85V678" data-march="reverse" />
                  <path d="M351 885H455V678" data-march="reverse" />
                </g>
                <g data-wire="arrow">
                  <path d="M266.5 116.5L270.5 120.5L274.5 116.5" />
                  <path d="M146.5 260.5L150.5 264.5L154.5 260.5" />
                  <path d="M283.5 357L287.5 361L283.5 365" />
                  <path d="M162.5 395.5L166.5 391.5L170.5 395.5" />
                  <path d="M81 614L85 618L89 614" />
                  <path d="M266 614L270 618L274 614" />
                  <path d="M451 614L455 618L459 614" />
                  <path d="M174 724L178 728L182 724" />
                </g>
              </svg>
              <div data-part="box" data-box="commit">
                <span data-part="title">a3f92e1</span>
                <span data-part="subtitle">feat: offline sync</span>
              </div>
              <div data-part="box" data-box="ci-job">
                <span data-part="title">CI job #1042</span>
                <span data-part="subtitle">passed · 4m 12s</span>
              </div>
              <div data-part="box" data-box="workspace">
                <span data-part="title">App.xcworkspace</span>
                <span data-part="subtitle">scheme App</span>
              </div>
              <div data-part="box" data-box="targets">
                <span data-part="title">24 targets</span>
                <span data-part="subtitle">compile + link</span>
              </div>
              <div data-part="box" data-box="cache-client">
                <span data-part="title">cache client</span>
                <span data-part="subtitle">content-addressed</span>
              </div>
              <div data-part="box" data-box="dashboard">
                <span data-part="window-dots"></span>
                <span data-part="brand">
                  <svg
                    data-part="logo"
                    viewBox="499.5 35.5 18 19.3"
                    xmlns="http://www.w3.org/2000/svg"
                  >
                    <path d="M516.573 48.1072C515.628 48.805 514.618 49.4109 513.556 49.8856C515.157 48.068 516.438 45.883 517.415 43.8575C517.108 43.2574 516.721 42.6865 516.297 42.1659C515.312 44.0301 514.17 45.8371 512.782 47.4332C512.614 47.6225 512.443 47.8109 512.268 47.997C513.32 44.9895 513.968 41.875 514.464 38.7566C513.961 38.3931 513.422 38.0736 512.852 37.8055C512.341 40.2942 511.706 42.7598 510.894 45.1444C510.54 46.1775 510.15 47.1957 509.705 48.1709L509.397 35.5389C509.101 35.5129 508.803 35.5 508.5 35.5C508.198 35.5 507.899 35.5125 507.604 35.5389L507.296 48.1747C506.845 47.1918 506.464 46.1713 506.106 45.1447C505.294 42.7598 504.66 40.2942 504.149 37.8058C503.578 38.0739 503.039 38.3934 502.537 38.7569C503.033 41.8775 503.681 44.9946 504.735 48.0041C504.559 47.8173 504.387 47.6274 504.218 47.4335C502.83 45.8374 501.688 44.0304 500.703 42.1662C500.278 42.6878 499.891 43.2596 499.585 43.86C499.91 44.5398 500.256 45.211 500.63 45.8731C501.427 47.2301 502.353 48.6353 503.45 49.8888C502.386 49.4135 501.374 48.8066 500.427 48.1072C500.072 48.5839 499.76 49.0927 499.5 49.6301C504.317 54.7895 512.682 54.7904 517.5 49.6301C517.239 49.0927 516.928 48.5839 516.573 48.1072Z" />
                  </svg>
                  <span data-part="name">Tuist dashboard</span>
                </span>
              </div>
              <div data-part="box" data-box="build-performance">
                <span data-part="title">Build performance</span>
                <span data-part="subtitle">per-target timings</span>
              </div>
              <div data-part="box" data-box="cache-activity">
                <span data-part="title">Cache activity</span>
                <span data-part="subtitle">92% hit ratio</span>
              </div>
              <div data-part="box" data-box="machine-metrics">
                <span data-part="title">Machine metrics</span>
                <span data-part="subtitle">cpu 71% · mem 18/48</span>
              </div>
              <div data-part="box" data-box="tuist-cache">
                <%!-- Subtle Bayer grain from the page dividers' recipe,
                behind the text. --%>
                <canvas
                  data-part="dither"
                  id="compute-tuist-cache-dither"
                  phx-hook="DitherTexture"
                  data-pitch="2"
                  data-dot="2"
                  data-top="0"
                  data-bottom="0.85"
                  data-wave="0.3"
                  data-wave-scale="2.5"
                  data-levels="0"
                  data-speed="1"
                  data-phase="11"
                  data-dither="on"
                  data-opacity="0.3"
                ></canvas>
                <span data-part="title">Tuist cache</span>
                <span data-part="subtitle">colocated node</span>
              </div>
              <span data-part="chip" data-chip="trace">
                <.badge label="trace" color="neutral" style="light-fill" size="large" />
              </span>
              <span data-part="chip" data-chip="hit">
                <.badge label="hit · 134" color="success" style="light-fill" size="large" />
              </span>
              <span data-part="chip" data-chip="miss">
                <.badge label="miss · 8" color="destructive" style="light-fill" size="large" />
              </span>
              <span data-part="chip" data-chip="cpu">
                <.badge label="cpu · mem" color="neutral" style="light-fill" size="large" />
              </span>
            </div>
          </figure>
          <div data-part="text">
            <h3 data-part="title">{dgettext("marketing", "Built into your build platform")}</h3>
            <p data-part="description">
              {dgettext(
                "marketing",
                "Go from a CI job to the Xcode or Gradle build behind it, with build performance, cache activity, and machine metrics connected in one place."
              )}
            </p>
          </div>
        </div>
        <div data-part="cell">
          <%!-- Pixel rebuild of the cache-ready comp (desktop 901x347,
          mobile 458x406 stages): two runner nodes writing through their
          persistent volumes into the colocated cache. Same recipe as the
          build-platform scene — HTML nodes over per-layout wires SVGs,
          block grids as CSS grids, icons lifted verbatim from the export.
          Static for now; animation comes later. --%>
          <figure data-part="illustration" data-illustration="cache-ready" aria-hidden="true">
            <div data-part="scene" id="compute-cache-ready" phx-hook="ComputeCacheReady">
              <svg
                data-part="wires"
                data-layout="desktop"
                viewBox="-80 0 1061 347"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
              >
                <%!-- Static dashed return: runner A around the left
                margin into the cache's flank. Not animated. --%>
                <g data-wire="dashed">
                  <path d="M0 28H-52Q-60 28 -60 36V301Q-60 309 -52 309H121.5" />
                  <path d="M890 28H942Q950 28 950 36V301Q950 309 942 309H778" />
                </g>
                <g data-wire="solid">
                  <path d="M152 56V123" />
                  <path d="M747 56V123" />
                  <path d="M300 165H375.5Q383.5 165 383.5 173V265.5" data-flow="deposit" />
                  <path d="M517.5 271.5V173Q517.5 165 525.5 165H584.5" data-flow="serve" />
                </g>
                <g data-wire="arrow">
                  <path d="M148 123L152 127L156 123" />
                  <path d="M743 123L747 127L751 123" />
                  <path d="M379.5 265.5L383.5 269.5L387.5 265.5" />
                  <path d="M584.5 161L588.5 165L584.5 169" />
                  <path d="M121.5 305L125.5 309L121.5 313" />
                  <path d="M778 305L774 309L778 313" />
                </g>
              </svg>
              <svg
                data-part="wires"
                data-layout="mobile"
                viewBox="0 0 458 406"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
              >
                <g data-wire="solid">
                  <path d="M100.5 92V144.5" />
                  <path d="M357.5 92V144.5" />
                  <path d="M200 212H217Q225 212 225 220V327" data-flow="deposit" />
                  <path d="M233 332V220Q233 212 241 212H253.5" data-flow="serve" />
                </g>
                <g data-wire="arrow">
                  <path d="M96.5 144.5L100.5 148.5L104.5 144.5" />
                  <path d="M353.5 144.5L357.5 148.5L361.5 144.5" />
                  <path d="M221 327L225 331L229 327" />
                  <path d="M253.5 208L257.5 212L253.5 216" />
                </g>
              </svg>
              <%!-- Streak overlay for the deposit/serve loop, drawn by the
              ComputeCacheReady hook. Above the wires, below the nodes. --%>
              <canvas data-part="pulses"></canvas>
              <div data-part="node" data-node="runner-a">
                <span data-part="machine">
                  <svg
                    data-part="os"
                    viewBox="56.4 20.4 13.5 16.5"
                    fill="none"
                    xmlns="http://www.w3.org/2000/svg"
                  ><path
                    d="M57.5 29.696C57.5 27.6785 58.3025 25.256 60.7145 25.256C61.598 25.256 62.5782 26.0638 63.125 26.0638C63.6635 26.0638 64.7863 25.166 65.9375 25.256C66.3785 25.286 67.928 25.6663 68.75 26.8708C68.6825 26.9075 66.7257 27.5405 66.7407 29.2917C66.7632 31.3887 68.7275 31.706 68.75 31.7142C68.75 33.3282 66.7408 35.75 65.5355 35.75C64.3302 35.75 64.1795 35.3465 63.125 35.3465C62.0638 35.3465 61.5883 35.7125 60.7145 35.75C59.1073 35.75 57.5 32.1178 57.5 29.696Z"
                    stroke-width="1.125"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  /><path
                    d="M64.5607 22.5607C64.2794 22.842 63.8978 23 63.5 23C63.5 22.6022 63.658 22.2206 63.9393 21.9393C64.2206 21.658 64.6022 21.5 65 21.5C65 21.8978 64.842 22.2794 64.5607 22.5607Z"
                    stroke-width="1.125"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  /></svg>
                  <span data-part="mini"></span>
                </span>
                <span data-part="name">mac-m4-pro · job #1042</span>
              </div>
              <div data-part="node" data-node="runner-b">
                <span data-part="machine">
                  <svg
                    data-part="os"
                    viewBox="674.1 21.6 15 15"
                    fill="none"
                    xmlns="http://www.w3.org/2000/svg"
                  ><path
                    d="M685.792 25.5575C685.023 24.7697 684.053 24.2088 682.987 23.936M680.008 23.936C678.924 24.2139 677.94 24.7897 677.167 25.598M675.756 28.0092C675.585 28.5735 675.499 29.1598 675.499 29.7492C675.499 30.3027 675.574 30.839 675.715 31.3482M677.185 33.9192C677.954 34.7169 678.93 35.2854 680.004 35.5617M683.004 35.5617C684.074 35.2848 685.046 34.7174 685.814 33.9222M687.286 31.3497C687.429 30.8291 687.501 30.2915 687.501 29.7515C687.501 29.1785 687.421 28.6242 687.271 28.0992M679.999 23.75C679.999 24.1478 680.157 24.5294 680.439 24.8107C680.72 25.092 681.101 25.25 681.499 25.25C681.897 25.25 682.279 25.092 682.56 24.8107C682.841 24.5294 682.999 24.1478 682.999 23.75C682.999 23.3522 682.841 22.9706 682.56 22.6893C682.279 22.408 681.897 22.25 681.499 22.25C681.101 22.25 680.72 22.408 680.439 22.6893C680.157 22.9706 679.999 23.3522 679.999 23.75ZM674.75 32.75C674.75 33.1478 674.908 33.5294 675.189 33.8107C675.471 34.092 675.852 34.25 676.25 34.25C676.648 34.25 677.029 34.092 677.311 33.8107C677.592 33.5294 677.75 33.1478 677.75 32.75C677.75 32.3522 677.592 31.9706 677.311 31.6893C677.029 31.408 676.648 31.25 676.25 31.25C675.852 31.25 675.471 31.408 675.189 31.6893C674.908 31.9706 674.75 32.3522 674.75 32.75ZM685.251 32.75C685.251 33.1478 685.409 33.5294 685.69 33.8107C685.971 34.092 686.353 34.25 686.751 34.25C687.149 34.25 687.53 34.092 687.811 33.8107C688.093 33.5294 688.251 33.1478 688.251 32.75C688.251 32.3522 688.093 31.9706 687.811 31.6893C687.53 31.408 687.149 31.25 686.751 31.25C686.353 31.25 685.971 31.408 685.69 31.6893C685.409 31.9706 685.251 32.3522 685.251 32.75Z"
                    stroke-width="1.125"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  /></svg>
                  <span data-part="mini"></span>
                </span>
                <span data-part="name">linux · job #1057</span>
              </div>
              <div data-part="node" data-node="volume-a">
                <div data-part="text">
                  <span data-part="heading">
                    <svg
                      data-part="glyph"
                      viewBox="0 0 24 24"
                      xmlns="http://www.w3.org/2000/svg"
