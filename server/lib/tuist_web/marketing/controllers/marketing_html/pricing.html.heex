<% signed_in? = not is_nil(TuistWeb.Authentication.current_user(assigns))

plans = [
  %{
    id: "air",
    name: dgettext("marketing", "Air"),
    description: dgettext("marketing", "Get started with no credit card required"),
    price: dgettext("marketing", "Free"),
    price_extra: nil,
    cta_label:
      if(signed_in?,
        do: dgettext("marketing", "Current plan"),
        else: dgettext("marketing", "Get started")
      ),
    cta_href: ~p"/users/register",
    cta_variant: "secondary",
    popular: false,
    traits: [
      dgettext("marketing", "Free under tier limits"),
      dgettext("marketing", "All features, no credit card required"),
      dgettext("marketing", "Community support via forum")
    ]
  },
  %{
    id: "pro",
    name: dgettext("marketing", "Pro"),
    description: dgettext("marketing", "Usage-based pricing after free tier"),
    price: "$0",
    price_extra: dgettext("marketing", "and up"),
    cta_label:
      if(signed_in?,
        do: dgettext("marketing", "Upgrade now"),
        else: dgettext("marketing", "Upgrade on the go")
      ),
    cta_href: ~p"/users/register",
    cta_variant: "primary",
    popular: true,
    traits: [
      dgettext("marketing", "Pay nothing if below free tier limits"),
      dgettext("marketing", "Pay only for what you use per feature"),
      dgettext("marketing", "Standard support via Slack and email")
    ]
  },
  %{
    id: "enterprise",
    name: dgettext("marketing", "Enterprise"),
    description: dgettext("marketing", "Create your plan or self-host your instance"),
    price: dgettext("marketing", "Custom"),
    price_extra: nil,
    cta_label: dgettext("marketing", "Contact us"),
    cta_href: "https://cal.tuist.dev/team/tuist/tuist",
    cta_variant: "secondary",
    popular: false,
    traits: [
      dgettext("marketing", "Tailored agreement for specific needs"),
      dgettext("marketing", "Self-host your instance of Tuist"),
      dgettext("marketing", "Priority support via Slack channel")
    ]
  }
]

base_price = [
  %{
    name: dgettext("marketing", "Base price"),
    description: nil,
    hint: nil,
    values: [
      dgettext("marketing", "Free"),
      %{
        price: "$0 " <> dgettext("marketing", "and up"),
        description: dgettext("marketing", "Price per unit above free tier")
      },
      %{
        price: dgettext("marketing", "Custom"),
        description: dgettext("marketing", "Usage/seat based pricing")
      }
    ]
  }
]

metered = [
  %{
    name: dgettext("marketing", "Cache egress"),
    description:
      dgettext(
        "marketing",
        "Data downloaded from the Module, Xcode, Gradle, and Bazel caches. Uploads and storage are free."
      ),
    hint: dgettext("marketing", "How is egress measured?"),
    hint_text:
      dgettext(
        "marketing",
        "Every cache shares one allowance each billing period, and traffic from Tuist Runners counts at half."
      ),
    values: [
      "100 GB",
      %{
        value: "100 GB",
        description: "+ $0.10 " <> dgettext("marketing", "per additional GB")
      },
      dgettext("marketing", "Custom")
    ]
  },
  %{
    name: dgettext("marketing", "Cache requests"),
    description: dgettext("marketing", "Downloads served from any of your caches."),
    hint: dgettext("marketing", "How are requests counted?"),
    hint_text:
      dgettext(
        "marketing",
        "Each download from a cache is one request. Every cache shares one allowance each billing period, and requests from Tuist Runners count at half."
      ),
    values: [
      "1M",
      %{
        value: "1M",
        description: "+ $0.01 " <> dgettext("marketing", "per additional 1,000")
      },
      dgettext("marketing", "Custom")
    ]
  },
  %{
    name: dgettext("marketing", "Tuist Runners"),
    description:
      dgettext(
        "marketing",
        "Managed macOS and Linux runners next to your cache, billed per minute of job time."
      ),
    hint: nil,
    link: %{label: dgettext("marketing", "See every machine and rate"), href: "#runners"},
    values: [
      dgettext("marketing", "100 macOS minutes"),
      %{
        value: dgettext("marketing", "100 macOS minutes"),
        description:
          dgettext(
            "marketing",
            "+ from %{macos}/min on macOS and %{linux}/min on Linux",
            macos: "$0.05",
            linux: "$0.001"
          )
      },
      dgettext("marketing", "Custom")
    ]
  },
  %{
    name: dgettext("marketing", "Test Insights"),
    description:
      dgettext(
        "marketing",
        "Track test results over time and catch flaky tests before they slow your team down."
      ),
    hint: dgettext("marketing", "Which test cases are billed?"),
    hint_text:
      dgettext(
        "marketing",
        "Only passing test cases are billed. Failed and skipped test cases, and tests run on Tuist Runners, are free."
      ),
    values: [
      dgettext("marketing", "5M passing test cases"),
      %{
        value: dgettext("marketing", "5M passing test cases"),
        description: "+ $2 " <> dgettext("marketing", "per additional million")
      },
      dgettext("marketing", "Custom")
    ]
  },
  %{
    name: dgettext("marketing", "Selective Testing"),
    description:
      dgettext(
        "marketing",
        "Speed up test runs by skipping test suites (test targets) whose tests are not impacted by the changes."
      ),
    hint: nil,
    values: [
      dgettext("marketing", "Unlimited"),
      dgettext("marketing", "Unlimited"),
      dgettext("marketing", "Unlimited")
    ]
  }
]

included = [
  %{
    name: dgettext("marketing", "Generated Projects"),
    description:
      dgettext(
        "marketing",
        "Turn projects defined with a Swift-DSL into Xcode workspaces and projects."
      ),
    hint: nil,
    values: [
      dgettext("marketing", "Unlimited"),
      dgettext("marketing", "Unlimited"),
      dgettext("marketing", "Unlimited")
    ]
  },
  %{
    name: dgettext("marketing", "Previews"),
    description:
      dgettext(
        "marketing",
        "Preview your project apps in simulator or devices with one click/command."
      ),
    hint: nil,
    values: [
      dgettext("marketing", "Unlimited"),
      dgettext("marketing", "Unlimited"),
      dgettext("marketing", "Unlimited")
    ]
  },
  %{
    name: dgettext("marketing", "Registry"),
    description:
      dgettext(
        "marketing",
        "Download only what you need — faster, lighter builds locally and on CI."
      ),
    hint: nil,
    values: [
      dgettext("marketing", "Unlimited"),
      dgettext("marketing", "Unlimited"),
      dgettext("marketing", "Unlimited")
    ]
  },
  %{
    name: dgettext("marketing", "Build Insights"),
    description:
      dgettext(
        "marketing",
        "Explore what is making your builds slow and speed up your builds."
      ),
    hint: nil,
    values: [
      dgettext("marketing", "Unlimited"),
      dgettext("marketing", "Unlimited"),
      dgettext("marketing", "Unlimited")
    ]
  },
  %{
    name: dgettext("marketing", "Bundle Insights"),
    description:
      dgettext(
        "marketing",
        "Track and reduce app size by spotting duplicate assets and bloated resources."
      ),
    hint: nil,
    values: [
      dgettext("marketing", "Unlimited"),
      dgettext("marketing", "Unlimited"),
      dgettext("marketing", "Unlimited")
    ]
  },
  %{
    name: dgettext("marketing", "Self-hosting Tuist instance"),
    description:
      dgettext(
        "marketing",
        "Host Tuist server on your own infrastructure for complete control and data sovereignty."
      ),
    hint: nil,
    values: [:unavailable, :unavailable, :available]
  },
  %{
    name: dgettext("marketing", "Tailored legal terms"),
    description:
      dgettext(
        "marketing",
        "Custom legal agreements and terms of service tailored to your organization's needs."
      ),
    hint: nil,
    values: [:unavailable, :unavailable, :available]
  },
  %{
    name: dgettext("marketing", "Support"),
    description:
      dgettext("marketing", "Get help when you need it through various support channels."),
    hint: nil,
    values: [
      %{
        level: dgettext("marketing", "Community support"),
        description: dgettext("marketing", "via Discourse forum")
      },
      %{
        level: dgettext("marketing", "Standard support"),
        description: dgettext("marketing", "via Slack and email")
      },
      %{
        level: dgettext("marketing", "Priority support"),
        description: dgettext("marketing", "via Slack and email")
      }
    ]
  }
]

features = base_price ++ metered ++ included

runner_platforms = [
  %{
    id: "macos",
    name: "macOS",
    description: "Apple M5 Pro",
    machines: [
      %{vcpus: 8, memory_gb: 24, price: "$0.05"},
      %{vcpus: 16, memory_gb: 48, price: "$0.10"}
    ]
  },
  %{
    id: "linux",
    name: "Linux",
    description: "x86-64",
    machines: [
      %{vcpus: 1, memory_gb: 2, price: "$0.001"},
      %{vcpus: 2, memory_gb: 4, price: "$0.002"},
      %{vcpus: 2, memory_gb: 8, price: "$0.0024"},
      %{vcpus: 4, memory_gb: 8, price: "$0.004"},
      %{vcpus: 4, memory_gb: 16, price: "$0.0048"},
      %{vcpus: 8, memory_gb: 16, price: "$0.008"},
      %{vcpus: 8, memory_gb: 32, price: "$0.0096"},
      %{vcpus: 16, memory_gb: 32, price: "$0.016"},
      %{vcpus: 16, memory_gb: 64, price: "$0.0192"}
    ]
  }
]

runner_terms = [
  %{
    title: dgettext("marketing", "100 free macOS and 2,500 free Linux minutes every month"),
    description:
      dgettext(
        "marketing",
        "Included on every plan, Air too. Linux minutes are counted on a 2 vCPU / 8 GB machine, so a smaller one runs longer."
      )
  },
  %{
    title: dgettext("marketing", "100 GB of cache volumes free"),
    description:
      dgettext(
        "marketing",
        "Keep dependencies and build outputs between jobs. Beyond 100 GB per account, storage is %{price} per GB-month.",
        price: "$0.10"
      )
  },
  %{
    title: dgettext("marketing", "Yearly and volume discounts"),
    description:
      dgettext(
        "marketing",
        "Commit for a year or run at higher volume and we'll lower your rate."
      )
  }
] %>
<%!-- Redesigned pricing page (styles in css/routes/pricing.css). --%>
<TuistWeb.Marketing.Layouts.marketing {assigns}>
  <main id="marketing-pricing">
    <header data-part="header">
      <h1 data-part="title">
        {dgettext("marketing", "Start for free, pay as you go")}
      </h1>
      <p data-part="subtitle">
        {dgettext(
          "marketing",
          "Get started with Tuist at no cost, and only invest more when you're ready for higher limits or personalized support."
        )}
      </p>
    </header>

    <section data-part="pricing" aria-labelledby="pricing-plans-title">
      <div data-part="plans">
        <div data-part="text">
          <span data-part="eyebrow">{dgettext("marketing", "Plans")}</span>
          <h2 data-part="title" id="pricing-plans-title">
            {dgettext("marketing", "Pricing plans")}
          </h2>
        </div>
        <div data-part="grid">
          <article
            :for={plan <- plans}
            data-part="plan"
            data-plan={plan.id}
            data-popular={plan.popular}
          >
            <div data-part="head">
              <h3 data-part="name">{plan.name}</h3>
              <.badge
                :if={plan.popular}
                label={dgettext("marketing", "Popular")}
                color="primary"
                style="light-fill"
              />
            </div>
            <p data-part="description">{plan.description}</p>
            <div data-part="price">
              <span data-part="value">{plan.price}</span>
              <span :if={plan.price_extra} data-part="extra">{plan.price_extra}</span>
            </div>
            <ul data-part="traits">
              <li :for={trait <- plan.traits} data-part="trait">
                <.system_check />
                <span>{trait}</span>
              </li>
            </ul>
            <.button
              variant={plan.cta_variant}
              size="large"
              label={plan.cta_label}
              href={plan.cta_href}
            />
          </article>
        </div>
      </div>

      <div data-part="compare">
        <div data-part="text">
          <span data-part="eyebrow">{dgettext("marketing", "Features")}</span>
          <h2 data-part="title" id="pricing-compare-title">
            {dgettext("marketing", "Compare features across plans")}
          </h2>
          <p data-part="description">
            {dgettext(
              "marketing",
              "You're only charged for the features you use, based on your usage, and only after you exceed a free threshold."
            )}
          </p>
        </div>
        <%!-- Tab/mobile collapse the table to a single plan column, picked
        with this button group (hidden on desktop, see pricing.css). The
        picker box sticks under the navbar while the table scrolls, so the
        plan can be switched from anywhere in the table. The box also
        renders the table's header row (blank corner + plan name) itself,
        so the header stays stuck beneath the switcher as one element; the
        table's own header row is hidden on tab/mobile. The
        PricingPlanSelect hook swaps the .active plan in both, and measures
        the navbar height for the sticky offset. --%>
        <%!-- The stack is the picker box's sticky containing block, so the
        box lets go at the table's end instead of riding on over the FAQ;
        its bottom margin (the CTA row's measured height) makes it let go
        one row early, so the CTA row is never covered. --%>
        <div data-part="table-stack">
          <div data-part="plan-picker">
            <div data-part="plan-picker-controls">
              <.button_group
                size="large"
                id="pricing-plan-select"
                data-part="plan-select"
                phx-hook="PricingPlanSelect"
                phx-update="ignore"
                role="group"
                aria-label={dgettext("marketing", "Plan")}
              >
                <.button_group_item
                  :for={{plan, index} <- Enum.with_index(plans)}
                  label={plan.name}
                  data-plan-option={index}
                  data-selected={index == 0}
                  aria-pressed={if index == 0, do: "true", else: "false"}
                />
              </.button_group>
            </div>
            <div data-part="plan-picker-head" aria-hidden="true">
              <span data-part="plan-picker-blank"></span>
              <span
                :for={{plan, index} <- Enum.with_index(plans)}
                data-part="plan-picker-plan"
                data-plan-index={index}
                class={if index == 0, do: "active"}
              >
                {plan.name}
              </span>
            </div>
          </div>
          <div data-part="table-frame">
            <table data-part="table">
              <thead data-part="head">
                <tr data-part="row">
                  <td data-part="cell-blank"></td>
                  <th
                    :for={{plan, index} <- Enum.with_index(plans)}
                    data-part="cell-plan"
                    data-popular={plan.popular}
                    data-plan-index={index}
                    class={if index == 0, do: "active"}
                    scope="col"
                  >
                    {plan.name}
                  </th>
                </tr>
              </thead>
              <tbody data-part="body">
                <tr :for={feature <- features} data-part="row">
                  <th data-part="cell-feature" scope="row">
                    <div data-part="feature-name">{feature.name}</div>
                    <div :if={feature.description} data-part="feature-description">
                      {feature.description}
                    </div>
                    <.tooltip
                      :if={not is_nil(feature.hint) and not is_nil(feature[:hint_text])}
                      id={"#{feature.name}-hint"}
                      size="large"
                      description={feature.hint_text}
                      title={feature.name}
                    >
                      <:trigger :let={attrs}>
                        <span {attrs}>
                          <.hint_text label={feature.hint} />
                        </span>
                      </:trigger>
                    </.tooltip>
                    <a :if={feature[:link]} href={feature.link.href} data-part="feature-link">
                      {feature.link.label}
                    </a>
                  </th>
                  <td
                    :for={{value, index} <- Enum.with_index(feature.values)}
                    data-part="cell-value"
                    data-plan-index={index}
                    class={if index == 0, do: "active"}
                    data-available={
                      cond do
                        value == :available -> true
                        value == :unavailable -> false
                        true -> nil
                      end
                    }
                  >
                    <%= cond do %>
                      <% value == :available -> %>
                        <.system_check />
                      <% value == :unavailable -> %>
                        <.math_x />
                      <% is_map(value) and Map.has_key?(value, :price) -> %>
                        <div data-part="value">{value.price}</div>
                        <div data-part="description">{value.description}</div>
                      <% is_map(value) and Map.has_key?(value, :value) -> %>
                        <div data-part="value">{value.value}</div>
                        <div data-part="description">{value.description}</div>
                      <% is_map(value) and Map.has_key?(value, :level) -> %>
                        <div data-part="value">{value.level}</div>
                        <div data-part="description">{value.description}</div>
                      <% true -> %>
                        {value}
                    <% end %>
                  </td>
                </tr>
                <tr data-part="row">
                  <td data-part="cell-feature"></td>
                  <td
                    :for={{plan, index} <- Enum.with_index(plans)}
                    data-part="cell-cta"
                    data-plan-index={index}
                    class={if index == 0, do: "active"}
                  >
                    <.button
                      variant={plan.cta_variant}
                      size="large"
                      label={plan.cta_label}
                      href={plan.cta_href}
                    />
                  </td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <div data-part="runners" id="runners">
        <div data-part="text">
          <span data-part="eyebrow">{dgettext("marketing", "Compute")}</span>
          <h2 data-part="title" id="pricing-runners-title">
            {dgettext("marketing", "Tuist Runners")}
          </h2>
          <p data-part="description">
            {dgettext(
              "marketing",
              "Run macOS and Linux CI jobs next to your cache, on any plan. You pay per minute of job time with no rounding up to whole minutes, and machine boot and cleanup are on us."
            )}
          </p>
        </div>

        <%!-- Per-platform machine data, shared by the toolbar's pickers and
        the price cards. Every price on a platform is padded to the same
        number of decimals ($0.002 → $0.0020), so the figure keeps one shape
        and the odometer reels roll between machines instead of rebuilding. --%>
        <% runner_cards =
          for {platform, index} <- Enum.with_index(runner_platforms) do
            decimals =
              platform.machines
              |> Enum.map(&(&1.price |> String.split(".") |> List.last() |> String.length()))
              |> Enum.max()

            machines =
              Enum.map(platform.machines, fn machine ->
                amount = machine.price |> String.trim_leading("$") |> String.to_float()

                %{
                  vcpus: machine.vcpus,
                  memory_gb: machine.memory_gb,
                  price: "$" <> :erlang.float_to_binary(amount, decimals: decimals),
                  hourly: "$" <> :erlang.float_to_binary(amount * 60, decimals: 2),
                  spec:
                    dgettext("marketing", "%{vcpus} vCPU · %{memory} GB",
                      vcpus: machine.vcpus,
                      memory: machine.memory_gb
                    )
                }
              end)

            selected =
              Enum.find(machines, &(&1.vcpus == 2 and &1.memory_gb == 8)) || hd(machines)

            %{
              platform: platform,
              illustration: "runners-#{platform.id}",
              active: index == 0,
              machines: machines,
              selected: selected,
              ratio: div(selected.memory_gb, selected.vcpus),
              vcpu_steps: machines |> Enum.map(& &1.vcpus) |> Enum.uniq(),
              ratios:
                machines
                |> Enum.map(&div(&1.memory_gb, &1.vcpus))
                |> Enum.uniq()
                |> Enum.sort()
            }
          end

        # The hourly figure is its own element, so the translated sentence is
        # split around it; a translation that drops %{price} keeps its text
        # and gets the figure after it instead of crashing the page.
        {hourly_before, hourly_after} =
          case dgettext("marketing", "≈ %{price} per hour of job time", price: "\0")
               |> String.split("\0", parts: 2) do
            [prefix, suffix] -> {prefix, suffix}
            [whole] -> {whole <> " ", ""}
          end

        per_minute = dgettext("marketing", "/min") %>

        <%!-- Platform toggle on the left; the active platform's machine
        pickers on the right. --%>
        <div data-part="toolbar">
          <.button_group
            size="large"
            id="pricing-runner-platform-select"
            data-part="platform-select"
            phx-hook="PricingRunnerPlatformSelect"
            phx-update="ignore"
            role="group"
            aria-label={dgettext("marketing", "Platform")}
          >
            <.button_group_item
              :for={card <- runner_cards}
              label={card.platform.name}
              data-platform-option={card.platform.id}
              aria-controls={"pricing-runners-platform-#{card.platform.id}"}
              data-selected={card.active}
              aria-pressed={if card.active, do: "true", else: "false"}
            />
          </.button_group>

          <div
            :for={card <- runner_cards}
            id={"pricing-runners-controls-#{card.platform.id}"}
            data-part="controls"
            data-platform={card.platform.id}
            data-active={card.active}
            phx-update="ignore"
          >
            <div data-part="control">
              <span data-part="control-label">{dgettext("marketing", "vCPU")}</span>
              <.button_group size="medium" role="group" aria-label={dgettext("marketing", "vCPU")}>
                <.button_group_item
                  :for={vcpus <- card.vcpu_steps}
                  label={to_string(vcpus)}
                  data-machine-vcpus={vcpus}
                  data-selected={vcpus == card.selected.vcpus}
                  aria-pressed={if vcpus == card.selected.vcpus, do: "true", else: "false"}
                />
              </.button_group>
            </div>
            <div :if={length(card.ratios) > 1} data-part="control">
              <span data-part="control-label">{dgettext("marketing", "Memory")}</span>
              <.button_group
                size="medium"
                role="group"
                aria-label={dgettext("marketing", "Memory per vCPU")}
              >
                <.button_group_item
                  :for={ratio <- card.ratios}
                  label={dgettext("marketing", "%{memory} GB / vCPU", memory: ratio)}
                  data-machine-ratio={ratio}
                  data-selected={ratio == card.ratio}
                  aria-pressed={if ratio == card.ratio, do: "true", else: "false"}
                />
              </.button_group>
            </div>
          </div>
        </div>

        <div data-part="platforms">
          <article
            :for={card <- runner_cards}
            id={"pricing-runners-platform-#{card.platform.id}"}
            data-part="platform"
            data-platform={card.platform.id}
            data-active={card.active}
            aria-label={card.platform.name}
            phx-hook="PricingRunnerMachineSelect"
            phx-update="ignore"
            data-controls={"pricing-runners-controls-#{card.platform.id}"}
            data-machines={Jason.encode!(card.machines)}
            data-default-vcpus={card.selected.vcpus}
            data-default-gb={card.selected.memory_gb}
          >
            <div data-part="art" aria-hidden="true">
              <.illustration name={card.illustration} />
            </div>
            <div data-part="machine">
              <p data-part="spec">
                {card.platform.description} ·
                <span data-machine-out="spec">{card.selected.spec}</span>
              </p>
              <p data-part="price" aria-live="polite">
                <span data-part="figure" data-machine-out="price">{card.selected.price}</span><span data-part="unit">{per_minute}</span>
              </p>
              <p data-part="hourly">
                {hourly_before}<span data-machine-out="hourly">{card.selected.hourly}</span>{hourly_after}
              </p>
            </div>
          </article>
          <ul data-part="terms">
            <li :for={term <- runner_terms} data-part="term">
              <div data-part="term-title">{term.title}</div>
              <div data-part="term-description">{term.description}</div>
            </li>
          </ul>
        </div>

        <%!-- The cards show one machine at a time, so every rate is also
        listed here for screen readers, crawlers, and the Markdown
        conversion (the agent guides link here rather than quote rates). --%>
        <div class="sr-only">
          <h3>{dgettext("marketing", "All Tuist Runners machines and rates")}</h3>
          <div :for={platform <- runner_platforms}>
            <h4>{platform.name} ({platform.description})</h4>
            <ul>
              <li :for={machine <- platform.machines}>
                {dgettext("marketing", "%{vcpus} vCPU · %{memory} GB",
                  vcpus: machine.vcpus,
                  memory: machine.memory_gb
                )}: {machine.price}{per_minute}
              </li>
            </ul>
          </div>
        </div>

        <div data-part="access">
          <p data-part="access-text">
            {dgettext(
              "marketing",
              "Tuist Runners are invite-only while we scale capacity. Tell us about your workloads and we'll get you set up, including yearly and volume pricing."
            )}
          </p>
          <.button
            href="https://cal.tuist.dev/team/tuist/tuist?overlayCalendar=true"
            target="_blank"
            rel="noopener noreferrer"
            variant="secondary"
            size="large"
            label={dgettext("marketing", "Request access")}
          />
        </div>
      </div>

      <div data-part="faq">
        <div data-part="text">
          <span data-part="eyebrow">{dgettext("marketing", "FAQs")}</span>
          <h2 data-part="title" id="pricing-faq-title">
            {dgettext("marketing", "Frequently asked questions")}
          </h2>
        </div>
        <div data-part="questions">
          <details :for={{question, answer} <- @faqs} data-part="question">
            <summary data-part="summary">
              <span data-part="label">{question}</span>
              <span
                data-part="chevron"
                class="noora-neutral-button"
                data-size="medium"
                data-icon-only
                aria-hidden="true"
              ><.chevron_down /></span>
            </summary>
            <div data-part="answer">{raw(HtmlSanitizeEx.basic_html(answer))}</div>
          </details>
        </div>
      </div>
    </section>

    <%!-- CTA framed by dithered divider bands, same recipe as the home
    and cache pages' closing CTA. --%>
    <div data-part="features-divider" aria-hidden="true">
      <canvas
        data-part="dither"
        id="pricing-cta-divider-top-dither"
        phx-hook="DitherTexture"
        data-pitch="2"
        data-dot="2"
        data-top="0"
        data-bottom="0.95"
        data-wave="0.335"
        data-wave-scale="2.5"
        data-levels="0"
        data-speed="1"
        data-phase="22.1"
        data-dither="on"
        data-opacity="0.3"
      ></canvas>
    </div>

    <section data-part="cta" aria-labelledby="cta-title">
      <span data-part="eyebrow">{dgettext("marketing", "Hola! Hello! Hallo! Olá! Namaste! Ahoj!")}</span>
      <h2 id="cta-title">{dgettext("marketing", "Unlock your team's full potential")}</h2>
      <div data-part="actions" role="group" aria-labelledby="cta-title">
        <.button href={~p"/users/register"} label={dgettext("marketing", "Get started")} />
        <.button
          href="https://cal.tuist.dev/team/tuist/tuist?overlayCalendar=true"
          target="_blank"
          rel="noopener noreferrer"
          variant="secondary"
          label={dgettext("marketing", "Talk to us")}
        />
      </div>
    </section>

    <div data-part="features-divider" aria-hidden="true">
      <canvas
        data-part="dither"
        id="pricing-cta-divider-bottom-dither"
        phx-hook="DitherTexture"
        data-pitch="2"
        data-dot="2"
        data-top="0"
        data-bottom="0.95"
        data-wave="0.335"
        data-wave-scale="2.5"
        data-levels="0"
        data-speed="1"
        data-phase="29.6"
        data-dither="on"
        data-opacity="0.3"
      ></canvas>
    </div>
  </main>
</TuistWeb.Marketing.Layouts.marketing>
