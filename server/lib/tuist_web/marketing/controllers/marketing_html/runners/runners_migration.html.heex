<%!-- The migration, one variant per CI: the line a job changes to run on
Tuist (the runs-on label, the tag, the agent queue, or the Bitrise pool's
stack). The hub passes every provider and gets a switch; a provider page
passes its own and shows just that diff. Code stays untranslated, like the
illustrations' annotations. The added line types out behind a blinking
terminal cursor, once per page load (ComputeHeroDiff); the typed/cursor
spans stay glued together on one line so no whitespace opens between the
text and the caret. --%>
<% diffs = runners_diffs(@providers) %>
<% {selected, _, _, _} = hd(diffs) %>
<div data-part="migration" id="compute-hero-migration" phx-hook="ComputeHeroDiff">
  <.button_group
    :if={length(diffs) > 1}
    data-part="ci-switch"
    aria-label={dgettext("marketing", "CI provider")}
  >
    <.button_group_item
      :for={{ci, label, _removed, _added} <- diffs}
      label={label}
      data-ci={ci}
      data-selected={ci == selected}
      aria-pressed={to_string(ci == selected)}
    />
  </.button_group>
  <div data-part="diff" data-ci={selected} aria-hidden="true" id="compute-hero-diff">
    <span :for={{ci, _label, removed, added} <- diffs} data-part="variant" data-ci={ci}>
      <span data-part="line" data-line="removed">
        <span data-part="sign">-</span>
        <span data-part="code">{removed}</span>
      </span>
      <span data-part="line" data-line="added">
        <span data-part="sign">+</span>
        <span data-part="code"><span data-part="typed">{added}</span><span data-part="cursor"></span></span>
      </span>
    </span>
  </div>
</div>
<%!-- First-paint arm for the typewriter: stashes and clears the added
lines before the browser paints, so the full text never flashes ahead of
the hook's typing. Skips under reduced motion. The CSP nonce is required:
without it the browser blocks the inline script and the hook's fallback
arming takes over. The watchdog restores the lines if the hook never takes
over (a stale or failed bundle.js): an empty strip must not outlive the
arm. --%>
<script nonce={TuistWeb.CSP.get_csp_nonce()}>
  (() => {
    if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    var diff = document.getElementById("compute-hero-diff");
    var typed = diff ? diff.querySelectorAll('[data-part="typed"]') : [];
    if (!typed.length) return;
    typed.forEach((span) => {
      span.dataset.text = span.textContent;
      span.textContent = "";
    });
    diff.setAttribute("data-armed", "");
    setTimeout(() => {
      if (!diff.hasAttribute("data-typing") && !diff.hasAttribute("data-hooked")) {
        typed.forEach((span) => (span.textContent = span.dataset.text));
        diff.removeAttribute("data-armed");
      }
    }, 3000);
  })();
</script>
