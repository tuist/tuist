      "outcome": "selected",
      "run": {
        "CoreTests/DiscountTests/testTenPercentOff": {
          "reason": "impacted",
          "matched_path": "Core/Sources/Discount.swift"
        },
        "CoreTests/DiscountTests/testZeroPercentKeepsPrice": {
          "reason": "impacted",
          "matched_path": "Core/Sources/Discount.swift"
        },
        "AppTests/CartTests/totalSumsItems()": {
          "reason": "no_evidence"
        },
        "AppTests/CartTests/discountAppliesToTotal()": {
          "reason": "no_evidence"
        },
        "AppUITests/ShopUITests/testApplyingDiscountUpdatesTotal": {
          "reason": "impacted",
          "matched_path": "Core/Sources/Discount.swift"
        }
      },
      "skip": {
        "CoreTests/MoneyTests/testFormatsDollars": "unaffected",
        "CoreTests/MoneyTests/testAddsAmounts": "unaffected",
        "AppUITests/ShopUITests/testShowsCatalog": "unaffected"
      },
      "notes": "Money.swift differs from the baseline, but the run at run/carried-evidence/1 executed MoneyTests and testShowsCatalog with today's Money.swift, and the checkout reproduces those versions. Without them, both would be impacted by Money.swift. CoreTests' hash at the checkout differs from the one stored at run/carried-evidence/1, so it reaches coverage; CatalogTests matches the baseline's."
    },
