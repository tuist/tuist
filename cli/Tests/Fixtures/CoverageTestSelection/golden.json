      ],
      "CatalogTests/CatalogLoadingTests/testLookupBySKU": [
        "Catalog/Sources/Catalog.swift",
        "CatalogTests/CatalogLoadingTests.swift"
      ],
      "CatalogTests/CatalogFixtureTests/testFixtureParses": [
