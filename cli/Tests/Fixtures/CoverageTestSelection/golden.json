        "CatalogTests/CatalogLoadingTests.swift"
      ]
    },
    "targets": {
      "CoreTests": [],
      "CatalogTests": [
        "Catalog/Sources/Search.swift",
        "CatalogTests/SearchTests.swift"
      ],
      "AppTests": [
        "App/Sources/Cart.swift",
