  "scenarios": [
    {
      "name": "source_change",
      "case": "A source change in one file",
      "runs": [
        {
          "ref": "baseline",
          "branch": "main"
        }
      ],
      "checkout": {
        "ref": "checkout/source-change",
        "branch": "feature/source-change"
      },
      "changed_files": [
        {
          "path": "Core/Sources/Discount.swift",
          "status": "M",
          "affected_modules": [
            "CoreTests",
            "AppTests",
            "AppUITests"
          ]
        }
      ],
      "hash": {
        "skipped": [
          "CatalogTests"
        ]
      },
      "outcome": "selected",
      "run": {
        "CoreTests/DiscountTests/testTenPercentOff": {
          "reason": "impacted",
          "matched_path": "Core/Sources/Discount.swift"
        },
        "CoreTests/DiscountTests/testZeroPercentKeepsPrice": {
          "reason": "impacted",
          "matched_path": "Core/Sources/Discount.swift"
        },
        "AppTests/CartTests/totalSumsItems()": {
          "reason": "no_evidence"
        },
        "AppTests/CartTests/discountAppliesToTotal()": {
          "reason": "no_evidence"
        },
        "AppUITests/ShopUITests/testApplyingDiscountUpdatesTotal": {
          "reason": "impacted",
          "matched_path": "Core/Sources/Discount.swift"
        }
      },
      "skip": {
        "CoreTests/MoneyTests/testFormatsDollars": "unaffected",
        "CoreTests/MoneyTests/testAddsAmounts": "unaffected",
        "AppUITests/ShopUITests/testShowsCatalog": "unaffected"
      },
      "notes": "Only the tests whose evidence includes Discount.swift run, plus the Swift Testing tests of AppTests, whose hash changed."
    },
