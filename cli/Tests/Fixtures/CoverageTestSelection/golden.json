        "CatalogTests/CatalogFixtureTests.swift"
      ],
      "AppUITests/ShopUITests/testShowsCatalog": [
        "App/Sources/Cart.swift",
        "App/Sources/ShopApp.swift",
        "Catalog/Sources/Catalog.swift",
        "Core/Sources/Money.swift",
        "AppUITests/ShopUITests.swift"
