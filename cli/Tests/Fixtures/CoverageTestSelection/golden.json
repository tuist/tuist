    {
      "name": "failed_at_baseline",
      "case": "A test that failed at the baseline",
      "runs": [
        {
          "ref": "baseline",
          "branch": "main",
          "env": {
            "TEST_RUNNER_TESTBED_FAILING_TESTS": "MoneyTests/testAddsAmounts"
          },
          "expect": "testAddsAmounts fails; every other test passes"
        }
      ],
      "checkout": {
        "ref": "checkout/failed-at-baseline",
        "branch": "feature/failed-at-baseline"
      },
      "changed_files": [
        {
          "path": "docs/notes.md",
          "status": "M",
          "affected_modules": []
        }
      ],
      "hash": {
        "skipped": [
          "CatalogTests",
          "AppTests"
        ]
      },
      "outcome": "selected",
      "run": {
        "CoreTests/MoneyTests/testAddsAmounts": {
          "reason": "failed_last_run"
        }
      },
      "skip": {
        "CoreTests/MoneyTests/testFormatsDollars": "unaffected",
        "CoreTests/DiscountTests/testTenPercentOff": "unaffected",
        "CoreTests/DiscountTests/testZeroPercentKeepsPrice": "unaffected",
        "AppUITests/ShopUITests/testShowsCatalog": "unaffected",
        "AppUITests/ShopUITests/testApplyingDiscountUpdatesTotal": "unaffected"
      },
      "notes": "The checkout changes no hashed input, but CoreTests failed at the baseline, so its hash was never stored and it reaches coverage. The only CoreTests test that runs is the one that failed."
    },
