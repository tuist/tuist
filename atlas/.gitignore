# The directory Mix will write compiled artifacts to.
/_build/

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix downloads your dependencies sources to.
/deps/

# Where 3rd-party dependencies like ExDoc output generated docs.
/doc/

# Ignore .fetch files in case you like to edit your project deps locally.
/.fetch

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore arcatlas artifacts (built via "mix arcatlas.build").
*.ez

# Temporary files, for example, from tests.
/tmp/
/.atlas-dev-instance

# Ignore package tarball (built via "mix hex.build").
atlas-*.tar

# Ignore assets that are produced by build tools.
/priv/static/assets/

# Ignore digested assets cache.
/priv/static/cache_manifest.json

# In case you use Node.js/npm, you want to ignore these.
npm-debug.log
/assets/node_modules/
/workers/inbox/node_modules/

# Blick code-review artifacts
/.blick/runs/

# Claude Code agent-local state
/.claude/

# Local Pingen client credentials used for development and deployment setup.
/pingen

# Contract templates are stored in the private atlas-object-storage bucket,
# not in git. See priv/contracts/templates/README.md. The placeholder
# stubs are whitelisted so the test suite can still assert the template
# layout without shipping the real content.
/priv/contracts/templates/*.docx
/priv/contracts/templates/*/*.docx
!/priv/contracts/templates/2026-02/annex-2-dpa.docx
!/priv/contracts/templates/2026-02/annex-3-daa.docx
!/priv/contracts/templates/2026-02/annex-4-sla.docx
!/priv/contracts/templates/2026-02/msa.docx
!/priv/contracts/templates/2026-02/order-form-self-hosted.docx
!/priv/contracts/templates/2026-02/order-form-tuist-hosted.docx
