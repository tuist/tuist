<main class="layout">
  <AtlasWeb.AccountMenu.headerbar current_user={@current_user} current_path={@current_path} />
  <.line_divider />
  <section class="layout__main">
    <.sidebar>
      <.sidebar_group
        id="sidebar-overview"
        label={gettext("Overview")}
        icon="chart_dots"
        collapsible={false}
      >
        <.sidebar_item
          label={gettext("Tuist")}
          icon="chart_dots"
          navigate={~p"/"}
          selected={@current_path == ~p"/"}
        />
        <.sidebar_item
          label={gettext("Tasks")}
          icon="circle_check"
          navigate={~p"/tasks"}
          selected={@current_path == ~p"/tasks"}
        />
      </.sidebar_group>
      <.sidebar_group
        id="sidebar-commercial"
        label={gettext("Commercial")}
        icon="briefcase"
        collapsible={false}
      >
        <.sidebar_group
          id="sidebar-sales"
          label={gettext("Sales")}
          icon="trending_up"
          navigate={~p"/commercial/sales"}
          selected={@current_path == ~p"/commercial/sales"}
          default_open={String.starts_with?(@current_path, "/commercial/sales")}
        >
          <.sidebar_item
            label={gettext("Accounts")}
            icon="building"
            navigate={
              ~p"/commercial/sales/accounts?#{%{"filter_lifecycle_op" => "==", "filter_lifecycle_val" => "prospect"}}"
            }
            selected={String.starts_with?(@current_path, "/commercial/sales/accounts")}
          />
          <.sidebar_item
            label={gettext("Feature interest")}
            icon="message_circle"
            navigate={~p"/commercial/sales/feature-interests"}
            selected={String.starts_with?(@current_path, "/commercial/sales/feature-interests")}
          />
          <.sidebar_item
            :if={Atlas.Users.has_scope?(@current_user, "licenses:read")}
            label={gettext("Licenses")}
            icon="lock"
            navigate={~p"/commercial/sales/licenses"}
            selected={@current_path == ~p"/commercial/sales/licenses"}
          />
        </.sidebar_group>
        <.sidebar_group
          :if={Atlas.Users.has_scope?(@current_user, "finance:read")}
          id="sidebar-finance"
          label={gettext("Finance")}
          icon="chart_donut_4"
          navigate={~p"/commercial/finance"}
          selected={@current_path == ~p"/commercial/finance"}
          default_open={String.starts_with?(@current_path, "/commercial/finance")}
        >
          <.sidebar_item
            label={gettext("Vendor costs")}
            icon="building"
            navigate={~p"/commercial/finance/vendors"}
            selected={@current_path == ~p"/commercial/finance/vendors"}
          />
        </.sidebar_group>
        <.sidebar_group
          id="sidebar-gtm"
          label={gettext("GTM")}
          icon="bulb"
          default_open={String.starts_with?(@current_path, "/commercial/gtm")}
        >
          <.sidebar_item
            label={gettext("Content")}
            icon="file_text"
            navigate={~p"/commercial/gtm/content"}
            selected={String.starts_with?(@current_path, "/commercial/gtm/content")}
          />
          <.sidebar_item
            label={gettext("Outreach")}
            icon="trending_up"
            navigate={~p"/commercial/gtm/outreach"}
            selected={String.starts_with?(@current_path, "/commercial/gtm/outreach")}
          />
          <.sidebar_item
            label={gettext("Social")}
            icon="message_circle"
            navigate={~p"/commercial/gtm/social"}
            selected={String.starts_with?(@current_path, "/commercial/gtm/social")}
          />
        </.sidebar_group>
        <.sidebar_item
          label={gettext("Support")}
          icon="message_circle"
          navigate={~p"/commercial/support"}
          selected={String.starts_with?(@current_path, "/commercial/support")}
        />
      </.sidebar_group>
      <.sidebar_group
        id="sidebar-outbound"
        label={gettext("Outbound")}
        icon="send"
        collapsible={false}
      >
        <.sidebar_item
          label={gettext("Email")}
          icon="mail"
          navigate={~p"/outbound/email"}
          selected={String.starts_with?(@current_path, "/outbound/email")}
        />
        <.sidebar_item
          :if={Atlas.Users.has_scope?(@current_user, "letters:read")}
          label={gettext("Postal")}
          icon="mail"
          navigate={~p"/outbound/postal"}
          selected={@current_path == ~p"/outbound/postal"}
        />
      </.sidebar_group>
      <.sidebar_group
        id="sidebar-engineering"
        label={gettext("Engineering")}
        icon="code"
        collapsible={false}
      >
        <.sidebar_item
          label={gettext("Projects")}
          icon="folder"
          navigate={~p"/engineering/projects"}
          selected={String.starts_with?(@current_path, "/engineering/projects")}
        />
        <.sidebar_item
          label={gettext("Domains")}
          icon="list_tree"
          navigate={~p"/engineering/domains"}
          selected={String.starts_with?(@current_path, "/engineering/domains")}
        />
        <.sidebar_item
          label={gettext("Errors")}
          icon="alert_circle"
          navigate={~p"/engineering/errors"}
          selected={String.starts_with?(@current_path, "/engineering/errors")}
        />
        <.sidebar_item
          label={gettext("Postmortems")}
          icon="file_text"
          navigate={~p"/engineering/postmortems"}
          selected={String.starts_with?(@current_path, "/engineering/postmortems")}
        />
        <.sidebar_item
          label={gettext("Specs")}
          icon="schema"
          navigate={~p"/engineering/specs"}
          selected={String.starts_with?(@current_path, "/engineering/specs")}
        />
      </.sidebar_group>
      <.sidebar_group
        id="sidebar-people"
        label={gettext("People")}
        icon="users"
        collapsible={false}
      >
        <.sidebar_item
          :if={!Atlas.Demo.enabled?()}
          id="sidebar-people-directory"
          label={gettext("Directory")}
          icon="users"
          navigate={~p"/people"}
          selected={@current_path == ~p"/people"}
        />
        <.sidebar_item
          id="sidebar-time-off"
          label={gettext("Time off")}
          icon="calendar_week"
          navigate={~p"/people/time-off"}
          selected={String.starts_with?(@current_path, "/people/time-off")}
        />
      </.sidebar_group>
      <.sidebar_group
        :if={Atlas.Users.has_scope?(@current_user, "assets:read")}
        id="sidebar-operations"
        label={gettext("Operations")}
        icon="server"
        collapsible={false}
      >
        <.sidebar_group
          id="sidebar-hardware"
          label={gettext("Hardware")}
          icon="server"
          navigate={~p"/operations/hardware"}
          selected={@current_path == ~p"/operations/hardware"}
          default_open={String.starts_with?(@current_path, "/operations/hardware")}
        >
          <.sidebar_item
            label={gettext("Data centers")}
            icon="building"
            navigate={~p"/operations/hardware/data-centers"}
            selected={String.starts_with?(@current_path, "/operations/hardware/data-centers")}
          />
          <.sidebar_item
            label={gettext("Insurance")}
            icon="lock"
            navigate={~p"/operations/hardware/insurance"}
            selected={String.starts_with?(@current_path, "/operations/hardware/insurance")}
          />
          <.sidebar_item
            label={gettext("Financings")}
            icon="credit_card"
            navigate={~p"/operations/hardware/financings"}
            selected={String.starts_with?(@current_path, "/operations/hardware/financings")}
          />
        </.sidebar_group>
      </.sidebar_group>
      <.sidebar_group
        :if={Atlas.Users.has_scope?(@current_user, "automation:read")}
        id="sidebar-automation"
        label={gettext("Automation")}
        icon="schema"
        collapsible={false}
      >
        <.sidebar_item
          label={gettext("Workflows")}
          icon="schema"
          navigate={~p"/automation/workflows"}
          selected={String.starts_with?(@current_path, "/automation/workflows")}
        />
        <.sidebar_item
          label={gettext("Behaviors")}
          icon="devices_code"
          navigate={~p"/automation/behaviors"}
          selected={String.starts_with?(@current_path, "/automation/behaviors")}
        />
        <.sidebar_item
          label={gettext("Executions")}
          icon="history"
          navigate={~p"/automation/executions"}
          selected={String.starts_with?(@current_path, "/automation/executions")}
        />
        <.sidebar_item
          label={gettext("Schedules")}
          icon="calendar_week"
          navigate={~p"/automation/schedules"}
          selected={String.starts_with?(@current_path, "/automation/schedules")}
        />
        <.sidebar_item
          label={gettext("Webhooks")}
          icon="webhook"
          navigate={~p"/automation/webhooks"}
          selected={String.starts_with?(@current_path, "/automation/webhooks")}
        />
        <.sidebar_item
          label={gettext("Approvals")}
          icon="circle_check"
          navigate={~p"/automation/approvals"}
          selected={String.starts_with?(@current_path, "/automation/approvals")}
        />
      </.sidebar_group>
      <.sidebar_group
        id="sidebar-library"
        label={gettext("Library")}
        icon="book"
        collapsible={false}
      >
        <.sidebar_item
          :if={Atlas.Users.has_scope?(@current_user, "documents:read")}
          label={gettext("Documents")}
          icon="file"
          navigate={~p"/library/documents"}
          selected={String.starts_with?(@current_path, "/library/documents")}
        />
        <.sidebar_item
          label={gettext("Notes")}
          icon="file_text"
          navigate={~p"/library/notes"}
          selected={String.starts_with?(@current_path, "/library/notes")}
        />
        <.sidebar_item
          label={gettext("Moodboard")}
          icon="photo"
          navigate={~p"/library/moodboard"}
          selected={String.starts_with?(@current_path, "/library/moodboard")}
        />
      </.sidebar_group>
      <.sidebar_group
        :if={Atlas.Users.has_scope?(@current_user, "admin:read")}
        id="sidebar-admin"
        label={gettext("Admin")}
        icon="settings"
        collapsible={false}
      >
        <.sidebar_item
          label={gettext("Audit")}
          icon="history"
          navigate={~p"/admin/audit"}
          selected={@current_path == ~p"/admin/audit"}
        />
        <.sidebar_item
          label={gettext("Users")}
          icon="users"
          navigate={~p"/admin/users"}
          selected={@current_path == ~p"/admin/users"}
        />
        <.sidebar_item
          label={gettext("Roles")}
          icon="lock"
          navigate={~p"/admin/roles"}
          selected={String.starts_with?(@current_path, "/admin/roles")}
        />
        <.sidebar_item
          label={gettext("MCPs")}
          icon="server"
          navigate={~p"/admin/mcps"}
          selected={String.starts_with?(@current_path, "/admin/mcps")}
        />
        <.sidebar_item
          label={gettext("Sessions")}
          icon="message_circle"
          navigate={~p"/admin/sessions"}
          selected={String.starts_with?(@current_path, "/admin/sessions")}
        />
        <.sidebar_item
          label={gettext("Memory")}
          icon="search"
          navigate={~p"/admin/memory"}
          selected={String.starts_with?(@current_path, "/admin/memory")}
        />
        <.sidebar_item
          label={gettext("Inference")}
          icon="lock"
          navigate={~p"/admin/inference"}
          selected={String.starts_with?(@current_path, "/admin/inference")}
        />
      </.sidebar_group>
    </.sidebar>
    <div class="layout__content">
      <div
        :if={!Atlas.Demo.enabled?()}
        id="presence-visibility"
        phx-hook="Presence"
        phx-update="ignore"
      >
      </div>
      <div :if={@presence_here != []} id="also-here" data-part="also-here" role="status">
        <span>{gettext("Also here")}</span>
        <.avatar
          :for={person <- @presence_here}
          id={"here-#{person.id}"}
          name={person.name}
          size="small"
        />
        <span>{Enum.map_join(@presence_here, ", ", & &1.name)}</span>
      </div>
      {@inner_content}
    </div>
  </section>
  <.search_palette
    query={@search_palette_query}
    accounts={@search_palette_accounts}
    form={@search_palette_form}
  />
</main>
