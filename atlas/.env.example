# Select a version from https://github.com/tuist/tuist/releases?q=atlas%40
ATLAS_VERSION=
ATLAS_HOST=localhost
# Use an organization hostname for production and Google sign-in.
ATLAS_ALLOWED_EMAIL_DOMAIN=example.org
POSTGRES_PASSWORD=
# Generate independent values: openssl rand -hex 64 (signing keys)
SECRET_KEY_BASE=
GUARDIAN_SECRET_KEY=
# Generate: openssl rand -base64 32. Keep this key with your backups.
ENCRYPTION_KEY=
# Required for sign-in, optional when only evaluating public documentation.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Upstream tools are opt-in for standalone installations.
MCP_PROXY_SERVERS=[]
# Erlang detects available processors and container quotas by default.
# Uncomment to choose an explicit scheduler count instead.
# ERL_FLAGS=+S 2:2
