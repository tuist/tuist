#!/bin/sh

# Sets and samples the release environment.
# It will be sourced before the release starts.

# Sentry release tag. CI sets it directly on the Deployment via Helm;
# fall back to ATLAS_GIT_COMMIT (if a future surface starts setting it)
# and finally to the compiled release version for local boots.
if [ -z "$SENTRY_RELEASE" ]; then
  export SENTRY_RELEASE="${ATLAS_GIT_COMMIT:-${RELEASE_VSN}}"
fi
