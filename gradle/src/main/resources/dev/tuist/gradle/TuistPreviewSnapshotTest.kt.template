import java.io.File
import java.lang.reflect.Proxy

/**
 * Renders every Compose @Preview with Paparazzi. When the Tuist plugin runs the test, each image is
 * written with a JSON file in Sentry's snapshot format, for `tuistUploadSnapshots` to upload.
 */
@RunWith(Parameterized::class)
class TuistPreviewSnapshotTest(private val preview: TuistPreview) {
    companion object {
        @JvmStatic
        @Parameterized.Parameters(name = "{0}")
        fun previews(): List<TuistPreview> = TuistPreview.scan().also { previews ->
            // Every preview, even when `--tests` runs only some, so Tuist skips the rest
            // instead of reporting them removed.
            System.getProperty("tuist.snapshots.outputDir")?.let(::File)?.let { directory ->
                directory.mkdirs()
                File(directory, "tuist-all-image-names.txt").writeText(previews.joinToString("\n") { "${it.fileName}.png" })
            }
        }
    }

    @get:Rule
    val paparazzi = Paparazzi(
        deviceConfig = preview.deviceConfig(),
        theme = __THEME__,
        renderingMode = if (preview.info.showSystemUi) SessionParams.RenderingMode.NORMAL else SessionParams.RenderingMode.SHRINK,
        showSystemUi = preview.info.showSystemUi,
        snapshotHandler = TuistPreviewWriter(preview),
    )

    @Test
    fun snapshot() {
        paparazzi.snapshot {
            if (preview.info.showBackground) {
                val color = if (preview.info.backgroundColor != 0L) Color(preview.info.backgroundColor) else Color.White
                Box(Modifier.background(color)) { preview.composable() }
            } else {
                preview.composable()
            }
        }
    }
}

class TuistPreview(val composable: ComposablePreview<AndroidPreviewInfo>, val displayName: String) {
    val info: AndroidPreviewInfo get() = composable.previewInfo

    /** The preview's group, or the file it is declared in. */
    val group: String get() = info.group.ifEmpty { composable.declaringClass.substringAfterLast('.').removeSuffix("Kt") }

    val fileName: String get() = displayName.replace(Regex("[^A-Za-z0-9._-]"), "_")

    private val isDark: Boolean get() = info.uiMode and UI_MODE_NIGHT_MASK == UI_MODE_NIGHT_YES

    /** The preview's settings that differ from the defaults, named as Sentry names them. */
    val tags: Map<String, String>
        get() = buildMap {
            if (info.name.isNotEmpty()) put("preview_name", info.name)
            if (info.uiMode != 0) put("ui_mode", if (isDark) "dark" else "light")
            if (info.locale.isNotEmpty()) put("locale", info.locale)
            if (info.fontScale != 1f) put("font_scale", info.fontScale.toString())
            if (info.device.isNotEmpty()) put("device", info.device)
            if (info.widthDp > 0) put("width_dp", info.widthDp.toString())
            if (info.heightDp > 0) put("height_dp", info.heightDp.toString())
            if (info.apiLevel > 0) put("api_level", info.apiLevel.toString())
            if (info.showSystemUi) put("show_system_ui", "true")
            if (info.showBackground) put("show_background", "true")
        }

    fun deviceConfig(): DeviceConfig {
        val base = DeviceConfig.PIXEL_5
        val dpi = base.density.dpiValue
        return base.copy(
            nightMode = if (isDark) NightMode.NIGHT else NightMode.NOTNIGHT,
            fontScale = info.fontScale,
            locale = info.locale.ifEmpty { base.locale },
            screenWidth = if (info.widthDp > 0) info.widthDp * dpi / 160 else base.screenWidth,
            screenHeight = if (info.heightDp > 0) info.heightDp * dpi / 160 else base.screenHeight,
        )
    }

    fun sidecar(): String {
        val tagsJson = tags.entries.joinToString(",") { (key, value) -> "${json(key)}:${json(value)}" }
        val context = "{\"class_name\":${json(composable.declaringClass)},\"method_name\":${json(composable.methodName)}}"
        return "{\"display_name\":${json(displayName)},\"group\":${json(group)},\"tags\":{$tagsJson},\"context\":$context}"
    }

    override fun toString(): String = displayName

    companion object {
        private const val UI_MODE_NIGHT_MASK = 0x30
        private const val UI_MODE_NIGHT_YES = 0x20

        private fun json(value: String): String =
            "\"" + value.replace("\\", "\\\\").replace("\"", "\\\"").replace("\n", "\\n") + "\""

        /**
         * Every preview with a stable, unique display name: `File.Function`, then the preview's
         * name and parameter index, then its settings when previews would still share a name.
         */
        fun scan(): List<TuistPreview> {
            val previews = AndroidComposablePreviewScanner()
                .scanPackageTrees(__PACKAGE_TREES__)__INCLUDE_PRIVATE__
                .getPreviews()
            val named = previews.map { preview ->
                val file = preview.declaringClass.substringAfterLast('.').removeSuffix("Kt")
                val name = listOfNotNull(
                    "$file.${preview.methodName}",
                    preview.previewInfo.name.ifEmpty { null },
                    preview.previewIndex?.toString(),
                ).joinToString("_")
                TuistPreview(preview, name)
            }
            return named.groupBy { it.displayName }.flatMap { (name, group) ->
                if (group.size == 1) {
                    group
                } else {
                    group.map { TuistPreview(it.composable, (listOf(name) + it.tags.values).joinToString("_")) }
                        .sortedBy { it.displayName }
                        .mapIndexed { index, it -> if (index == 0) it else TuistPreview(it.composable, "${it.displayName}_$index") }
                }
            }.map { TuistPreview(it.composable, it.displayName.replace(' ', '_')) }.sortedBy { it.displayName }
        }
    }
}

/** Writes each rendered preview to the directory the Tuist plugin passes, and nothing otherwise. */
class TuistPreviewWriter(private val preview: TuistPreview) : SnapshotHandler {
    private val directory = System.getProperty("tuist.snapshots.outputDir")?.let(::File)

    // Unit tests compile against android.jar, which has no java.awt, so the frame handler, which
    // receives a BufferedImage, is a proxy that writes the image through ImageIO reflectively.
    override fun newFrameHandler(snapshot: Snapshot, frameCount: Int, fps: Int): SnapshotHandler.FrameHandler =
        Proxy.newProxyInstance(javaClass.classLoader, arrayOf(SnapshotHandler.FrameHandler::class.java)) { proxy, method, arguments ->
            when (method.name) {
                "handle" -> write(arguments!![0])
                "equals" -> proxy === arguments!![0]
                "hashCode" -> System.identityHashCode(proxy)
                "toString" -> "TuistPreviewWriter(${preview.displayName})"
                else -> null
            }
        } as SnapshotHandler.FrameHandler

    private fun write(image: Any) {
        val directory = directory ?: return
        directory.mkdirs()
        Class.forName("javax.imageio.ImageIO")
            .getMethod("write", Class.forName("java.awt.image.RenderedImage"), String::class.java, File::class.java)
            .invoke(null, image, "PNG", File(directory, "${preview.fileName}.png"))
        File(directory, "${preview.fileName}.json").writeText(preview.sidecar())
    }

    override fun close() = Unit
}
